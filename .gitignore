# Locally-built EDA toolchain (prjtrellis/ecppack, OpenLane) — never committed. Also holds the
# assembled ChipFoundry/Caravel shuttle submissions (tools/caravel_submissions/<project>):
# hundreds of MB of OpenLane output, REGENERATED by scripts/caravel-submission.sh <project> from
# the run the project's wrapper ledger vouches for (codegen_sva::caravel_project). The tracked
# provenance is that ledger plus the project's precheck ledger — never the artifacts themselves.
/tools

# Local cargo config (mold linker — not available in CI)
.cargo/

# The private workspace: its own repository, kept on disk beside the product, never committed here
/work

# Third-party checkouts and fetched references (proof-kernel corpora, SAT solvers, LAPACK, puzzle
# corpora, sibling tools): one local-only tree, each checkout carrying its own .git
/external

