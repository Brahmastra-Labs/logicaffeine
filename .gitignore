# Rust
target/
target-wasmaot/
# Local-only work, kept on the owner's machines and never committed. local/chip/ holds parked
# chip-synthesis work at the paths it had in the tree (local/chip/<path> came from <path>).
/local/
# Coverage and mutation runs — generated/ephemeral, never commit (regenerated by the
# run-*.sh scripts). Committed instead: .config/coverage/{crate-summary.json,thresholds.toml,
# BASELINE.md}, .config/mutants.toml, .config/mutants/{known-survivors.txt,test-scope.txt}, and
# fuzz seed corpora.
target-mutants/
mutants.out/
.config/coverage/summary.json
crates/*/fuzz/artifacts/
crates/*/fuzz/corpus/
# Cargo.lock IS committed: the e2e harness (crates/logicaffeine_tests/tests/common)
# seeds it into every generated project so dependency resolution is pinned to the
# exact versions the workspace tests against, and the published `largo` binary wants
# a locked build. A gitignored lockfile made CI's fresh checkout fail every e2e
# `seed_lockfile` with NotFound.

# Dioxus
dist/
.dioxus/

# Generated crate docs (built in CI)
apps/logicaffeine_web/public/crates/

# Node
node_modules/
.wrangler/

# OS
.DS_Store

# Process and tool residue: pid files, probe/trace droppings
*.pid
*.probe
.z3-trace

# Agent worktrees — git worktrees of this repo, never content of it
/.codex-worktrees/

# Python bytecode
__pycache__/
*.pyc

# Dev artifacts
*.pdf
# ...except the flamegraph-breakdown chart, a published benchmark artifact the web app
# serves as a download (staged into public/data/ by scripts/web/stage-web-data.sh). CI's fresh
# checkout can't re-profile (needs perf/strace/sudo), so the PDF itself is tracked.
!benchmarks/profile/flamegraphs.pdf
test_results*.txt
test-output*.log
# scripts/web/curriculum-review.sh output bundle
curriculum_bundle.txt

# Test run logs (scripts/run-all-tests.sh)
/logs

# Planning docs — local working notes, never committed. The guides beside them in docs/
# stay tracked: largo compiles them in, llms-full.txt is built from them, and doc_examples
# runs their examples.
/docs/plans/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Benchmarks (build artifacts and raw data; latest.json + history/ are tracked)
benchmarks/.logos-bench-target/
benchmarks/.ct/
benchmarks/bin/
# stdlib-parity rival binaries — rebuilt by scripts/bench/bench-parity.sh from the tracked
# main.{c,go,lg,rs,py}; 1.5GB of compiler output, never committed. No lock reads them: the
# parity tests read catalog/*.json + PARITY_LEDGER.md.
benchmarks/parity/bench/*/bin/
benchmarks/generated/
