/-!
@case      T04-017
@tier      4 · Recursion and pattern matching
@title     Equation lemmas (`f.eq_def`, `f.eq_1`) — not generated by LOGOS
@lean      f.eq_def, f.eq_1 … f.eq_n, `simp [f]`, `rw [f]`, `unfold f`
@expect    degrade
@target    The `Fix` + `Match` definition alone (T04-001). Every Lean proof step that cited an
           equation lemma must be re-expressed as an appeal to LOGOS's *definitional*
           unfolding — `add_definition` is delta-transparent (context.rs:442) and `Fix`/`Match`
           reduce in `normalize` — i.e. as `refl`/`simp`/`decide` rather than as a rewrite by a
           named lemma.
@evidence  kernel/src/context.rs:442 (`add_definition(name, ty, body)` — a delta-TRANSPARENT
           definition; nothing else is recorded and no auxiliary lemma is produced);
           kernel/src/context.rs:434 (`add_declaration` is the only other declaration form, and
           it is an axiom);
           there is no equation-lemma generator anywhere in `crates/logicaffeine_kernel/src` —
           `recursor::derive_recursor` (recursor.rs:36) is the sole derived-artifact producer
           and it emits only `I_rec`;
           kernel/src/reduction.rs:48-69 (`normalize` is the unfolding mechanism, with a hard
           fuel of 10000 and a SILENT partial return when it is exhausted);
           LOGOS_FACTS, Surface A tactic list (`simp`/0 — **no lemma-list argument**;
           `rewrite`/1 takes a named hypothesis and rewrites EVERY occurrence)
@loss      EQUATION_LEMMA_NAMES. Lean's `f.eq_def` and per-equation `f.eq_1 … f.eq_n` are real
           constants with real statements, citable by name from any other module. After
           translation they do not exist. Any Lean proof of the form `rw [f]`, `simp [f]`,
           `unfold f`, or `exact f.eq_2 ..` has no name to cite. This is acceptable because
           the *content* survives definitionally — `f args` and its unfolding are definitionally
           equal in LOGOS, so the facts remain provable — but the proof text must change, and a
           translator that leaves the citation in place emits an unresolvable `Global`.
@loss      EQUATION_GRANULARITY. Lean generates one lemma per *source equation*; LOGOS's
           unfolding is per *constructor case*. A Lean source with overlapping or nested
           patterns has equation lemmas whose statements carry side conditions (`n ≠ 0`, "and
           the earlier patterns did not match"). Those side conditions have no LOGOS
           counterpart at all, because the pattern structure they refer to was compiled away
           (T04-008). Where the source cites such a conditional equation lemma, the case is
           `reject`, not `degrade`.
@guard     Catches emitting `Global("dbl_eq_def")` because the Lean `Expr` mentioned
           `dbl.eq_def`. `get_global` (context.rs:449) returns `None` and the failure lands at
           the use site, arbitrarily far from the definition.
@guard     Catches the "fix it with an axiom" move: `add_declaration("dbl_eq_def", <the
           equation's type>)`. `add_declaration` is unchecked (context.rs:434), so this asserts
           an equation nobody verified. For a correct equation it is merely redundant; for a
           mis-translated one it *entrenches the mistranslation as an axiom*, and every later
           proof that "works" is evidence of nothing.
@guard     Catches assuming a LOGOS `simp` can take the definition as a lemma. The script
           `simp` is **arity 0** and has no lemma-list argument (LOGOS_FACTS, Surface A); the
           literate surface's `simp` likewise. `rw`/`rewrite` takes a **named hypothesis**, not
           a term and not a global. So `rw [dbl]` has no mechanical counterpart — it must
           become `simp`, `decide`, or `refl` relying on delta/iota, and whether that succeeds
           is a property of the goal, not a mechanical rewrite.
@guard     Catches relying on unfolding without budgeting for it. Because there are no equation
           lemmas, every appeal to a definition's behaviour goes through `normalize`, which has
           a hard fuel of 10000 and **silently returns a partially reduced term** when it runs
           out (reduction.rs:52-69). A Lean proof that used one targeted `rw [f]` becomes a
           full normalisation in LOGOS, and on a large term it can silently fail to close.
@guard     Catches treating `f.eq_def` and `f.eq_1` as interchangeable. `eq_def` unfolds to the
           whole `match`; `eq_i` is one branch, possibly with side conditions. Only the former
           has a definitional counterpart.
@oracle    The emitted term typechecks; the translator's output contains no `Global` whose name
           ends in `_eq_def` or `_eq_<n>` and introduces no axiom for one; every Lean proof
           step citing an equation lemma is either re-expressed definitionally or reported; and
           the loss record contains EQUATION_LEMMA_NAMES.
-/

namespace T04_017

/-- A plain structural definition. Lean generates `dbl.eq_def` and `dbl.eq_1`/`dbl.eq_2`. -/
def dbl : Nat → Nat
  | 0 => 0
  | n + 1 => dbl n + 2

/-- The equation lemma exists as a citable constant in Lean. -/
example : ∀ x, dbl x = match x with | 0 => 0 | n + 1 => dbl n + 2 := dbl.eq_def

/-- Proofs that cite it by name. Each of these must be re-expressed definitionally. -/
example : dbl 0 = 0 := by rw [dbl]
example (n : Nat) : dbl (n + 1) = dbl n + 2 := by rw [dbl]
example : dbl 3 = 6 := by simp [dbl]

/-- The same fact, proved *definitionally* — this is the shape that survives translation,
    because `add_definition` is delta-transparent and `Fix`/`Match` reduce in `normalize`. -/
example : dbl 3 = 6 := rfl
example (n : Nat) : dbl (n + 1) = dbl n + 2 := rfl

/-- A definition with OVERLAPPING equations: its `eq_2` carries the side condition that the
    first equation did not apply. That side condition refers to pattern structure which is
    compiled away in LOGOS, so citing it is `reject`, not `degrade` — see T04-009. -/
def firstNonZero : List Nat → Nat
  | [] => 0
  | 0 :: t => firstNonZero t
  | x :: _ => x

example : firstNonZero [0, 0, 5] = 5 := rfl

/-- `unfold`, a third spelling of the same citation. -/
example : dbl 2 = 4 := by unfold dbl; rfl

end T04_017
