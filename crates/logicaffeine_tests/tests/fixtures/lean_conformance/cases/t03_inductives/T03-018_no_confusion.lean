/-!
@case      T03-018
@tier      3 · Inductives and structures
@title     `noConfusion` / `injection` — the constructor-disjointness principles are not
           generated by LOGOS
@lean      `Foo.noConfusion`, `Foo.noConfusionType`, the `injection` tactic, `Nat.succ.inj`,
           `cases h` on an equation between constructors, `Foo.rec` auxiliaries
@target    (none — no sound translation of a term that *mentions* `noConfusion`)
@expect    reject
@diag      E_NO_CONFUSION_UNAVAILABLE — must name the inductive whose `noConfusion`,
           `noConfusionType`, `injEq` or `.inj` lemma the source term mentions, and state that
           LOGOS generates no such declaration. Must emit no LOGOS output for the term, and in
           particular must not axiomatise the principle.
@evidence  the string `noConfusion` does not occur anywhere in
           `crates/logicaffeine_kernel/src` — there is no generator, no auxiliary-declaration
           pass, and no name for it; kernel/src/context.rs:253-255, :419-428, :545-560,
           :562-614, :623-652 (the complete set of inductive-registration entry points: each
           adds a header and constructors and *nothing else* — no `.rec`, no `.casesOn`, no
           `.noConfusion`, no `.injEq`);
           kernel/src/recursor.rs:36 (`derive_recursor` is the only auxiliary LOGOS can
           synthesise, and it must be requested explicitly and `add_definition`ed by the
           caller); kernel/src/term.rs:443-545 (`Term` has `Match` but no equation-hypothesis
           form — see T04-012 — so a match cannot even *observe* which constructor it took);
           kernel/src/prelude.rs:1439-1470 (`Eq` and its derived eliminators `Eq_rec_dep` /
           `Eq_rec`: J and substitution are available, **disjointness and injectivity are
           not** — neither follows from J alone without a large elimination that builds a
           discriminating family)
@guard     Catches axiomatising the principle. `add_declaration("Nat_noConfusion", …)` is one
           line and makes everything compile. It is also an unaudited extension of the trusted
           base with a statement whose *own* proof is exactly what is missing, and LOGOS has no
           `#print axioms` — the `declarations` map is the only record (context.rs:517-522).
           A translator that does this converts every `injection`-based proof in the source
           into an assumption.
@guard     Catches the "obvious" hand-proof. Constructor disjointness (`Zero ≠ Succ n`) *is*
           provable in LOGOS, but only by **large elimination**: build a `Match` on the
           discriminant returning `True` for one constructor and `False` for the others, then
           transport along the equation. That requires the inductive to admit elimination into
           `Type`/`Prop` with a *varying* motive — which is fine for a `Type 0` inductive but is
           refused for a non-subsingleton `Prop` inductive by the large-elimination gate
           (type_checker.rs:277-290). So the principle is available for `Nat` and `Bool` and
           **unavailable** for the propositions where `injection` is most often used in Lean.
           A translator must know which side of that line each inductive falls on.
@guard     Catches the injectivity half. `Succ n = Succ m → n = m` needs a *projection* out of
           the constructor — again a `Match`, this time returning the argument, with a default
           for the other constructors. For a constructor whose argument type is not inhabited
           in the other branches there is no default to give, because LOGOS's `Match` requires
           one case per constructor with no wildcard and no impossible-case elimination
           (type_checker.rs:253-266, :631-638). Injectivity for a constructor storing a value of
           an *empty-in-that-branch* type is therefore not constructible.
@guard     Catches translating a Lean *tactic* proof that used `injection`, `cases h` on an
           equation, `simp` with `injEq`, or `omega`'s constructor reasoning, by reproducing the
           tactic. None of those exist on any LOGOS surface; the only thing that may be
           translated is the elaborated proof **term**, and that term mentions
           `Foo.noConfusion` explicitly.
@guard     Catches assuming `Foo.rec` brings disjointness with it. It does not: LOGOS's
           `derive_recursor` (recursor.rs:36) synthesises an eliminator only, and it is not even
           registered unless the caller `add_definition`s it.
@oracle    Translator exits non-zero with E_NO_CONFUSION_UNAVAILABLE for any term mentioning a
           `noConfusion`, `noConfusionType`, `injEq` or `.inj` constant, and writes no
           declaration — in particular no `add_declaration` naming any of them. Where the
           translator instead *constructs* the principle by large elimination, it must first
           check the target inductive against `is_subsingleton_prop` and refuse when the gate
           would block it.
-/

namespace T03_018

inductive Colour where
  | red
  | green
  | blue
  deriving DecidableEq

/-- Constructor **disjointness**. Lean's elaborated proof term is
    `Colour.noConfusion h` — a constant that does not exist in LOGOS. -/
example : Colour.red ≠ Colour.green := by
  intro h
  exact Colour.noConfusion h

/-- The same fact via `decide`, whose elaborated term goes through the derived
    `DecidableEq` instead — a *different* translation problem (T03-023), not this one. -/
example : Colour.red ≠ Colour.blue := by decide

/-- The large-elimination construction that *is* available for a `Type 0` inductive: a
    discriminating family built with `Match`, then transport. This is what a translator would
    have to synthesise in place of `noConfusion`. -/
def isRed : Colour → Prop
  | Colour.red => True
  | Colour.green => False
  | Colour.blue => False

example : Colour.red ≠ Colour.green := by
  intro h
  have : isRed Colour.green := h ▸ True.intro
  exact this

inductive Chain where
  | stop : Chain
  | link : Nat → Chain → Chain

/-- Constructor **injectivity**. Lean's term is `Chain.link.inj` / `Chain.noConfusion`. -/
example (a b : Nat) (s t : Chain) (h : Chain.link a s = Chain.link b t) : a = b := by
  injection h

/-- The `injEq` simp lemma Lean generates for the same purpose. -/
example (a b : Nat) (s t : Chain) :
    (Chain.link a s = Chain.link b t) = (a = b ∧ s = t) := by
  simp [Chain.link.injEq]

/-- The hand-built injectivity a translator would have to emit: a `Match`-based projection
    with a default for the other constructor. Note that a default is *required* — LOGOS's
    `Match` has no wildcard and no impossible-case elimination. -/
def linkHead : Chain → Nat
  | Chain.stop => 0
  | Chain.link a _ => a

example (a b : Nat) (s t : Chain) (h : Chain.link a s = Chain.link b t) : a = b := by
  have : linkHead (Chain.link a s) = linkHead (Chain.link b t) := by rw [h]
  exact this

/-- Disjointness on a **`Prop`** inductive — the case where the large-elimination workaround is
    blocked. `Tri` has three constructors, so `is_subsingleton_prop` is false and the
    discriminating `Match` into `Prop` is still legal (Prop → Prop), but the analogous
    construction into `Type` is not. Lean's own `noConfusion` for a `Prop` inductive is
    likewise `Prop`-valued. -/
inductive Tri : Prop where
  | a : Tri
  | b : Tri
  | c : Tri

/-- And the reason it does not help: by proof irrelevance every two inhabitants of a `Prop`
    are *equal*, so `Tri.a ≠ Tri.b` is refutable, not provable. Constructor disjointness is a
    `Type`-level phenomenon, and a translator that reaches for `noConfusion` on a `Prop`
    inductive has already made a category error. -/
example : Tri.a = Tri.b := rfl

/-- `Nat` in the prelude is the highest-stakes instance: `Zero ≠ Succ n` and
    `Succ n = Succ m → n = m` are used by essentially every arithmetic proof, and LOGOS
    generates neither. -/
example (n : Nat) : Nat.zero ≠ Nat.succ n := by
  intro h
  exact Nat.noConfusion h

example (n m : Nat) (h : Nat.succ n = Nat.succ m) : n = m := by
  injection h

end T03_018
