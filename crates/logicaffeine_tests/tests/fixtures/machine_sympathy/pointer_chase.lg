## To native args () -> Seq of Text
## To native parseInt (s: Text) -> Int

## Main
Let n be parseInt(item 2 of args()).
Let mutable next be a new Seq of Int.
Repeat for i from 1 to n:
    Push i to next.
Let mutable seed be 17.
Let mutable i be n.
While i is at least 2:
    Set seed to (seed * 1103515245 + 12345) % 2147483648.
    Let j be 1 + (seed / 65536) % (i - 1).
    Let t be item i of next.
    Set item i of next to item j of next.
    Set item j of next to t.
    Set i to i - 1.
Let mutable p be item 1 of next.
Let mutable cycle be 1.
While p is not 1:
    Set p to item p of next.
    Set cycle to cycle + 1.
Let mutable q be 1.
Repeat for step from 1 to n * 8 + 3:
    Set q to item q of next.
Show cycle.
Show q.
