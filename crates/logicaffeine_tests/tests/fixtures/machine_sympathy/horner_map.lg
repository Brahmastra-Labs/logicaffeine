## To native args () -> Seq of Text
## To native parseInt (s: Text) -> Int

## To poly (x: Float) -> Float:
    Let mutable p be 1.0 / 17.0.
    Repeat for k from 1 to 16:
        Set p to 1.0 / (17.0 - k) + p * x.
    Return p.

## Main
Let n be parseInt(item 2 of args()).
Let mutable xs be a new Seq of Float.
Let mutable ys be a new Seq of Float.
Repeat for i from 1 to n:
    Push ((i * 7) % 16) / 16.0 to xs.
    Push 0.0 to ys.
Repeat for i from 1 to n:
    Set item i of ys to poly(item i of xs).
Let mutable checksum be 0.0.
Repeat for v in ys:
    Set checksum to checksum + v.
Show checksum.
