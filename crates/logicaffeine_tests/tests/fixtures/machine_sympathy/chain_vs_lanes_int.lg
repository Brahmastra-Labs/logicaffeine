## To native args () -> Seq of Text
## To native parseInt (s: Text) -> Int

## Main
Let n be parseInt(item 2 of args()).
Let mutable data be a new Seq of Int.
Let mutable seed be 11.
Repeat for i from 1 to n:
    Set seed to (seed * 1103515245 + 12345) % 2147483648.
    Push (seed / 65536) % 1000 to data.
Let mutable chain be 0.
Repeat for x in data:
    Set chain to chain + x.
Let mutable a0 be 0.
Let mutable a1 be 0.
Let mutable a2 be 0.
Let mutable a3 be 0.
Let mutable a4 be 0.
Let mutable a5 be 0.
Let mutable a6 be 0.
Let mutable a7 be 0.
Let mutable i be 1.
While i + 7 is at most n:
    Set a0 to a0 + item i of data.
    Set a1 to a1 + item (i + 1) of data.
    Set a2 to a2 + item (i + 2) of data.
    Set a3 to a3 + item (i + 3) of data.
    Set a4 to a4 + item (i + 4) of data.
    Set a5 to a5 + item (i + 5) of data.
    Set a6 to a6 + item (i + 6) of data.
    Set a7 to a7 + item (i + 7) of data.
    Set i to i + 8.
While i is at most n:
    Set a0 to a0 + item i of data.
    Set i to i + 1.
Show chain.
Show ((a0 + a1) + (a2 + a3)) + ((a4 + a5) + (a6 + a7)).
