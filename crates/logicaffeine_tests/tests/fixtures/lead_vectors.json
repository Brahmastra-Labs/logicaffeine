    {"input": "user@192.168.0.1", "valid": false, "error": "invalid_email", "reason": "malformed", "note": "all-digit top-level label (a bare IP)"},
    {"input": "user@example.123", "valid": false, "error": "invalid_email", "reason": "malformed", "note": "all-digit top-level label"},
