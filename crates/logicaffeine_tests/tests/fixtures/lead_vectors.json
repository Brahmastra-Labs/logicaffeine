{
  "description": "Shared validation vectors for the pricing lead form. Two validators walk this file and must agree on every case: the page's `apps/logicaffeine_web/src/ui/pages/pricing/lead.rs` (unit tests in `crates/logicaffeine_tests/unit/logicaffeine_web/ui/pages/pricing/lead/tests.rs`) and the worker's `services/leads/src/lead.js` (vitest in `services/leads/src`). A change to a rule changes this file first.",
  "version": 1,
  "shape": {
    "email[]": "{ input: string | null, valid: bool, note: string, input_length?: int, and when valid: normalized: string, when invalid: error: \"invalid_email\", reason: \"required\" | \"malformed\" }",
    "phone[]": "{ input: string | null, valid: bool, note: string, input_length?: int, and when valid: normalized: string | null, digits: string | null (both null for no phone), when invalid: error: \"invalid_phone\", reason: \"bad_character\" | \"misplaced_plus\" | \"too_long\" | \"too_few_digits\" | \"too_many_digits\" }",
    "input_length": "the input's length in characters; every character of an input that carries it is ASCII",
    "trim_set": "code points, each \"U+XXXX\" or an inclusive range \"U+XXXX..U+YYYY\""
  },
  "trim_set": [
    "U+0009..U+000D",
    "U+0020",
    "U+0085",
    "U+00A0",
    "U+1680",
    "U+2000..U+200A",
    "U+2028",
    "U+2029",
    "U+202F",
    "U+205F",
    "U+3000",
    "U+FEFF"
  ],
  "rules": {
    "trim": "Both fields are trimmed of leading and trailing code points in trim_set: the Unicode White_Space set plus U+FEFF, and nothing else. Rust: `c.is_whitespace() || c == '\\u{FEFF}'`. JavaScript's String.prototype.trim keeps U+0085 and Rust's str::trim keeps U+FEFF, so neither built-in is the rule. Characters inside are never trimmed or rewritten.",
    "email": [
      "required: null, or empty after trimming.",
      "malformed: anything else that breaks a rule below.",
      "Every character is printable ASCII, U+0021-U+007E.",
      "At most 254 characters.",
      "Exactly one @, splitting a local part from a domain.",
      "Local part: 1-64 characters from A-Z a-z 0-9 ! # $ % & ' * + / = ? ^ _ ` { | } ~ - and '.', with no dot first, last, or next to another dot.",
      "Domain: two or more labels separated by single dots; each label 1-63 characters from A-Z a-z 0-9 -, neither starting nor ending with a hyphen; the last label 2-63 characters and not all digits.",
      "Normalized form: the trimmed local part as typed, '@', the domain lower-cased."
    ],
    "phone": [
      "Optional: null, empty, or whitespace only is valid and normalizes to null, with digits null.",
      "Otherwise, after trimming, the first failing check, in this order, names the reason:",
      "bad_character: a character other than 0-9, space (U+0020), +, (, ), -, '.'.",
      "misplaced_plus: a + anywhere but the first character.",
      "too_long: more than 32 characters.",
      "too_few_digits: fewer than 7 digits.",
      "too_many_digits: more than 15 digits (the E.164 bound).",
      "Normalized form: the trimmed string as typed; digits: its digits alone, in order."
    ],
    "worker": "The worker checks email before phone and answers 400 { ok: false, error, reason } for the first invalid field. A JSON value that is neither a string nor null is `malformed` for either field; a missing field is treated as null."
  },
  "email": [
    {"input": "user@example.com", "valid": true, "normalized": "user@example.com", "note": "plain address"},
    {"input": "  user@example.com  ", "valid": true, "normalized": "user@example.com", "note": "ASCII spaces trimmed"},
    {"input": "\tuser@example.com\r\n", "valid": true, "normalized": "user@example.com", "note": "tab, CR and LF trimmed"},
    {"input": "\u00a0user@example.com\u00a0", "valid": true, "normalized": "user@example.com", "note": "no-break space (U+00A0) trimmed"},
    {"input": "\ufeffuser@example.com", "valid": true, "normalized": "user@example.com", "note": "byte-order mark (U+FEFF) trimmed; Rust's str::trim keeps it"},
    {"input": "\u0085user@example.com", "valid": true, "normalized": "user@example.com", "note": "next line (U+0085) trimmed; JavaScript's String.trim keeps it"},
    {"input": "\u3000user@example.com\u2028", "valid": true, "normalized": "user@example.com", "note": "ideographic space and line separator trimmed"},
    {"input": "User.Name@Example.COM", "valid": true, "normalized": "User.Name@example.com", "note": "domain lower-cased, local part kept as typed"},
    {"input": "USER@EXAMPLE.XN--P1AI", "valid": true, "normalized": "USER@example.xn--p1ai", "note": "upper-case punycode domain lower-cased"},
    {"input": "first.last+tag@sub.example.co.uk", "valid": true, "normalized": "first.last+tag@sub.example.co.uk", "note": "dots, plus tag, deep domain"},
    {"input": "o'brien@example.ie", "valid": true, "normalized": "o'brien@example.ie", "note": "apostrophe is atext"},
    {"input": "!#$%&'*+/=?^_`{|}~-@example.com", "valid": true, "normalized": "!#$%&'*+/=?^_`{|}~-@example.com", "note": "every atext symbol"},
    {"input": "1234567890@example.com", "valid": true, "normalized": "1234567890@example.com", "note": "all-digit local part"},
    {"input": "user_name-1@my-domain.io", "valid": true, "normalized": "user_name-1@my-domain.io", "note": "underscore in local part, hyphen in domain"},
    {"input": "a@b.co", "valid": true, "normalized": "a@b.co", "note": "shortest sane address"},
    {"input": "user@123.example.com", "valid": true, "normalized": "user@123.example.com", "note": "all-digit label that is not the top-level one"},
    {"input": "user@example.c0m", "valid": true, "normalized": "user@example.c0m", "note": "top-level label with a digit but not all digits"},
    {"input": "user@ex--ample.com", "valid": true, "normalized": "user@ex--ample.com", "note": "inner double hyphen in a label"},
    {"input": "user@xn--bcher-kva.de", "valid": true, "normalized": "user@xn--bcher-kva.de", "note": "punycode IDN domain"},
    {"input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@example.com", "valid": true, "normalized": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@example.com", "note": "local part at its 64-character limit", "input_length": 76},
    {"input": "user@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com", "valid": true, "normalized": "user@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com", "note": "domain label at its 63-character limit", "input_length": 72},
    {"input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc", "valid": true, "normalized": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc", "note": "whole address at its 254-character limit", "input_length": 254},
    {"input": null, "valid": false, "error": "invalid_email", "reason": "required", "note": "null"},
    {"input": "", "valid": false, "error": "invalid_email", "reason": "required", "note": "empty string"},
