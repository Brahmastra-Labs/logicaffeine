    {"input": "user name@example.com", "valid": false, "error": "invalid_email", "reason": "malformed", "note": "space inside the local part"},
    {"input": "user@exam ple.com", "valid": false, "error": "invalid_email", "reason": "malformed", "note": "space inside the domain"},
