    {"input": "user@.example.com", "valid": false, "error": "invalid_email", "reason": "malformed", "note": "leading dot in the domain"},
    {"input": "user@-example.com", "valid": false, "error": "invalid_email", "reason": "malformed", "note": "label starts with a hyphen"},
    {"input": "user@example-.com", "valid": false, "error": "invalid_email", "reason": "malformed", "note": "label ends with a hyphen"},
