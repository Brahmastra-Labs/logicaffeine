## To native chr (code: Int) -> Text

# The operator spellings: generated by optimize::core_operators from semantics::operator_overloads.
## To opToStr (op: Text) -> Text:
    Let opLength be length of op.
    If opLength equals 1:
        If op equals "%":
            Return " % ".
        If op equals "&":
            Return " & ".
        If op equals "*":
            Return " * ".
        If op equals "+":
            Return " + ".
        If op equals "-":
            Return " - ".
        If op equals "/":
            Return " / ".
        If op equals "<":
            Return " is less than ".
        If op equals ">":
            Return " is greater than ".
        If op equals "^":
            Return " xor ".
        If op equals "|":
            Return " | ".
    If opLength equals 2:
        If op equals "!=":
            Return " is not ".
        If op equals "&&":
            Return " and ".
        If op equals "**":
            Return " ** ".
        If op equals "//":
            Return " // ".
        If op equals "<<":
            Return " shifted left by ".
        If op equals "<=":
            Return " is at most ".
        If op equals "==":
            Return " equals ".
        If op equals ">=":
            Return " is at least ".
        If op equals ">>":
            Return " shifted right by ".
        If op equals "||":
            Return " or ".
    If opLength equals 7:
        If op equals "exact /":
            Return " / ".
    If opLength equals 11:
        If op equals "followed by":
            Return " followed by ".
    If opLength equals 13:
        If op equals "combined with":
            Return " combined with ".
    If opLength equals 16:
        If op equals "is approximately":
            Return " is approximately ".
    Return " {op} ".
# The operator spellings end.

## To joinExprs (parts: Seq of Text, sep: Text) -> Text:
    Let mutable result be "".
    Let mutable first be true.
    Repeat for p in parts:
        If first:
            Set result to p.
            Set first to false.
        Otherwise:
            Set result to "{result}{sep}{p}".
    Return result.

## To escapePiece (ec: Text) -> Text:
    Let bs be chr(92).
    If ec equals bs:
        Return "{bs}{bs}".
    If ec equals chr(34):
        Return "{bs}{ec}".
    If ec equals chr(10):
        Return "{bs}n".
    If ec equals chr(9):
        Return "{bs}t".
    If ec equals chr(13):
        Return "{bs}r".
    If ec equals chr(0):
        Return "{bs}0".
    If ec equals chr(123):
        Return "{ec}{ec}".
    If ec equals chr(125):
        Return "{ec}{ec}".
    Return ec.

## To textBody (tb: Text) -> Text:
    Let mutable tbOut be "".
    Repeat for tbc in tb:
        Let tbPiece be escapePiece(tbc).
        Set tbOut to "{tbOut}{tbPiece}".
    Return tbOut.

## To decompileDigits (ddText: Text) -> Int:
    Let mutable ddValue be 0.
    Repeat for ddCh in ddText:
        Set ddValue to ddValue * 10 + parseInt(ddCh).
    Return ddValue.

## To decompileFractionNanos (dfStamp: Text) -> Int:
    Let mutable dfReading be false.
    Let mutable dfDigits be 0.
    Let mutable dfCount be 0.
    Repeat for dfCh in dfStamp:
        If dfCh equals "Z":
            Set dfReading to false.
        If dfReading:
            Set dfDigits to dfDigits * 10 + parseInt(dfCh).
            Set dfCount to dfCount + 1.
        If dfCh equals ".":
            Set dfReading to true.
    While dfCount is less than 9:
        Set dfDigits to dfDigits * 10.
        Set dfCount to dfCount + 1.
    Return dfDigits.

## To decompileDurationNanos (dnDuration: Duration) -> Int:
    Let dnEpoch be 1970-01-01 at 12:00am.
    Let dnInstant be dnEpoch + dnDuration.
    Let dnWhole be seconds_between(dnEpoch, dnInstant).
    Let dnFraction be decompileFractionNanos(format_timestamp(dnInstant)).
    If dnFraction is greater than 0 and dnInstant is less than dnEpoch:
        Return dnWhole * 1000000000 + (dnFraction - 1000000000).
    Return dnWhole * 1000000000 + dnFraction.

## To decompileDuration (sdDuration: Duration) -> Text:
    Let sdNanos be decompileDurationNanos(sdDuration).
    If sdNanos is at least 0:
        Return "{sdNanos}ns".
    If sdNanos equals (0 - 9223372036854775807 - 1):
        Return "0ns - 9223372036854775807ns - 1ns".
    Let sdMagnitude be 0 - sdNanos.
    Return "0ns - {sdMagnitude}ns".

## To decompileTwoDigits (tdValue: Int) -> Text:
    If tdValue is less than 10:
        Return "0{tdValue}".
    Return "{tdValue}".

## To decompileClock (dcHour: Int) and (dcMinute: Int) -> Text:
    Let dcMinuteText be decompileTwoDigits(dcMinute).
    If dcHour equals 0:
        Return "12:{dcMinuteText}am".
    If dcHour is less than 12:
        Return "{dcHour}:{dcMinuteText}am".
    If dcHour equals 12:
        Return "12:{dcMinuteText}pm".
    Let dcAfternoon be dcHour - 12.
    Return "{dcAfternoon}:{dcMinuteText}pm".

## To decompileDate (sdaDate: Date) -> Text:
    Let sdaYear be year_of(sdaDate).
    If sdaYear is less than 0 or sdaYear is greater than 9999:
        Let sdaMonth be month_of(sdaDate).
        Let sdaDay be day_of(sdaDate).
        Return "makeDate({sdaYear}, {sdaMonth}, {sdaDay})".
    Return "{sdaDate}".

## To decompileMoment (smMoment: Moment) -> Text:
    Let smDate be date_of(smMoment).
    Let smClock be decompileClock(hour_of(smMoment), minute_of(smMoment)).
    Let smPast be second_of(smMoment) * 1000000000 + decompileFractionNanos(format_timestamp(smMoment)).
    If smPast equals 0:
        Return "{smDate} at {smClock}".
    Return "{smDate} at {smClock} + {smPast}ns".

## To decompileTime (stTime: Time) -> Text:
    Let stShown be "{stTime}".
    Let mutable stAt be 0.
    Let mutable stHourText be "".
    Let mutable stMinuteText be "".
    Let mutable stSecondText be "".
    Repeat for stCh in stShown:
        Set stAt to stAt + 1.
        If stAt is at most 2:
            Set stHourText to "{stHourText}{stCh}".
        If stAt is at least 4 and stAt is at most 5:
            Set stMinuteText to "{stMinuteText}{stCh}".
        If stAt is at least 7 and stAt is at most 8:
            Set stSecondText to "{stSecondText}{stCh}".
    Let stHour be decompileDigits(stHourText).
    Let stMinute be decompileDigits(stMinuteText).
    Let stSecond be decompileDigits(stSecondText).
    Let stFraction be decompileFractionNanos("{stShown}Z").
    If stSecond equals 0 and stFraction equals 0:
        Return decompileClock(stHour, stMinute).
    Let stNanos be ((stHour * 60 + stMinute) * 60 + stSecond) * 1000000000 + stFraction.
    Return "time_of(1970-01-01 at 12:00am + {stNanos}ns)".

## To decompileChar (scChar: Char) -> Text:
    Let scText be "{scChar}".
    Let bs be chr(92).
    Let tick be chr(96).
    If scText equals chr(10):
        Return "{tick}{bs}n{tick}".
    If scText equals chr(9):
        Return "{tick}{bs}t{tick}".
    If scText equals chr(13):
        Return "{tick}{bs}r{tick}".
    If scText equals chr(0):
        Return "{tick}{bs}0{tick}".
    If scText equals bs:
        Return "{tick}{bs}{bs}{tick}".
    If scText equals tick:
        Return "{tick}{bs}{tick}{tick}".
    Return "{tick}{scText}{tick}".

## To decompileAtom (e: CExpr) -> Text:
    Let daS be decompileExpr(e).
    Inspect e:
        When CInt (daI):
            Return daS.
        When CFloat (daF):
            Return daS.
        When CBool (daB):
            Return daS.
        When CText (daT):
            Return daS.
        When CVar (daV):
            Return daS.
        When CBinOp (daOp, daL, daR):
            Return daS.
        When CList (daItems):
            Return daS.
        When CTuple (daTup):
            Return daS.
        When CCall (daFn, daArgs):
            Return daS.
        When CInterpolatedString (daParts):
            Return daS.
        Otherwise:
            Return "({daS})".

## To decompileIsSetType (dstName: Text) -> Bool:
    If dstName equals "Set":
        Return true.
    Let mutable dstChars be a new Seq of Text.
    Repeat for dstCh in dstName:
        Push dstCh to dstChars.
    Let mutable dstAt be 1.
    Repeat for dstPrefixCh in "Set of ":
        If dstAt is greater than length of dstChars:
            Return false.
        If item dstAt of dstChars is not dstPrefixCh:
            Return false.
        Set dstAt to dstAt + 1.
    Return true.

## To decompileIsDeclaredDefault (e: CExpr) -> Bool:
    Inspect e:
        When CDeclaredDefault (iddType):
            Return true.
        Otherwise:
            Return false.

## To decompileShowsNoField (fields: Seq of CExpr) -> Bool:
    Repeat for snfField in fields:
        If not decompileIsDeclaredDefault(snfField):
            Return false.
    Return true.

## To decompileOperand (e: CExpr) -> Text:
    Let doS be decompileExpr(e).
    Inspect e:
        When CNewSeq (doSeqElem):
            Return "({doS})".
        When CNewSet (doSetElem):
            Return "({doS})".
        When CNew (doTypeName, doFieldNames, doFields):
            Return "({doS})".
        When CNewVariant (doTag, doNames, doVals):
            Return "({doS})".
        When CSpelled (doSpelledCode, doSpelledAwaits):
            Return "({doS})".
        Otherwise:
            Return doS.

## To decompileExpr (e: CExpr) -> Text:
    Inspect e:
        When CInt (v):
            Return "{v}".
        When CBool (v):
            If v:
                Return "true".
            Return "false".
        When CText (v):
            Let q be chr(34).
            Let vBody be textBody(v).
            Return "{q}{vBody}{q}".
        When CFloat (v):
            Let fs be "{v}".
            If (fs contains ".") or (fs contains "e") or (fs contains "inf") or (fs contains "NaN"):
                Return fs.
            Return "{fs}.0".
        When CVar (v):
            Return v.
        When CBinOp (op, left, right):
            Let ls be decompileOperand(left).
            Let rs be decompileOperand(right).
            Let opS be opToStr(op).
            Return "({ls}{opS}{rs})".
        When CNot (inner):
            Let innerStr be decompileExpr(inner).
            Return "not {innerStr}".
        When CCall (fname, args):
            Let argParts be a new Seq of Text.
            Repeat for a in args:
                Let argS be decompileExpr(a).
                Push argS to argParts.
            Let argStr be joinExprs(argParts, ", ").
            Return "{fname}({argStr})".
        When CList (items):
            Let itemParts be a new Seq of Text.
            Repeat for it in items:
                Let its be decompileExpr(it).
                Push its to itemParts.
            Let itemStr be joinExprs(itemParts, ", ").
            Return "[{itemStr}]".
        When CIndex (coll, idx):
            Let cs be decompileAtom(coll).
            Let mutable idxS be decompileAtom(idx).
            Inspect idx:
                When CCall (ixFn, ixArgs):
                    Set idxS to "({idxS})".
                Otherwise:
                    Let ixAtom be true.
            Return "item {idxS} of {cs}".
        When CLen (target):
            Let ts be decompileAtom(target).
            Return "length of {ts}".
        When CFieldAccess (target, field):
            Let ts be decompileAtom(target).
            Return "{field} of {ts}".
        When CNewVariant (tag, names, vals):
            If length of names equals 0:
                Return "a new {tag}".
            Let vParts be a new Seq of Text.
            Let mutable vi be 1.
            Repeat for nm in names:
                Let vl be item vi of vals.
                Let vs be decompileAtom(vl).
                Push "{nm} {vs}" to vParts.
                Set vi to vi + 1.
            Let vStr be joinExprs(vParts, " and ").
            Return "a new {tag} with {vStr}".
        When COptionSome (inner):
            Let innerS be decompileExpr(inner).
            Return "some({innerS})".
        When COptionNone:
            Return "nothing".
        When CNothing:
            Return "nothing".
        When CTuple (items):
            Let tParts be a new Seq of Text.
            Repeat for ti in items:
                Let tis be decompileExpr(ti).
                Push tis to tParts.
            Let tStr be joinExprs(tParts, ", ").
            Return "({tStr})".
        When CMapGet (target, key):
            Let ts be decompileAtom(target).
            Let ks be decompileAtom(key).
            Return "item {ks} of {ts}".
        When CNewSeq (decSeqElem1):
            Let seqElemText be decompileTypeAtom(decSeqElem1).
            Return "a new Seq of {seqElemText}".
        When CNewSet (decSetElem1):
            Let setElemText be decompileTypeAtom(decSetElem1).
            Return "a new Set of {setElemText}".
        When CRange (start, end):
            Let ss be decompileExpr(start).
            Let es be decompileExpr(end).
            Return "{ss} to {es}".
        When CSlice (coll, startIdx, endIdx):
            Let cs be decompileAtom(coll).
            Let ss be decompileAtom(startIdx).
            Let es be decompileAtom(endIdx).
            Return "items {ss} through {es} of {cs}".
        When CCopy (target):
            Let ts be decompileAtom(target).
            Return "copy of {ts}".
        When CContains (coll, elem):
            Let cs be decompileAtom(coll).
            Let es be decompileAtom(elem).
            Return "{cs} contains {es}".
        When CUnion (left, right):
            Let ls be decompileExpr(left).
            Let rs be decompileExpr(right).
            Return "{ls} union {rs}".
        When CIntersection (left, right):
            Let ls be decompileExpr(left).
            Let rs be decompileExpr(right).
            Return "{ls} intersection {rs}".
        When CNew (typeName, fieldNames, fields):
            If length of fieldNames equals 0:
                If typeName equals "Map":
                    Return "a new Map of Text to Int".
                If typeName equals "Set":
                    Return "a new Set of Int".
                Return "a new {typeName}".
            If decompileIsSetType(typeName):
                Let sParts be a new Seq of Text.
                Repeat for sElem in fields:
                    Push decompileExpr(sElem) to sParts.
                Let sStr be joinExprs(sParts, ", ").
                Return "{{{sStr}}}".
            If decompileIsMapType(typeName):
                Let mParts be a new Seq of Text.
                Let mutable mi be 1.
                Repeat for mkey in fieldNames:
                    Let mks be decompileExpr(a new CText with value mkey).
                    Let mvs be decompileExpr(item mi of fields).
                    Push "{mks}: {mvs}" to mParts.
                    Set mi to mi + 1.
                Let mStr be joinExprs(mParts, ", ").
                Return "{{{mStr}}}".
            Let fParts be a new Seq of Text.
            Let mutable fi be 1.
            Repeat for fname in fieldNames:
                Let fv be item fi of fields.
                If not decompileIsDeclaredDefault(fv):
                    Let fvs be decompileAtom(fv).
                    Push "{fname} {fvs}" to fParts.
                Set fi to fi + 1.
            If length of fParts equals 0:
                Return "a new {typeName}".
            Let fStr be joinExprs(fParts, " and ").
            Return "a new {typeName} with {fStr}".
        When CClosure (params, body, captured):
            Let cpStr be decompileClosureParams(params).
            If decompileReturnOnly(body):
                Inspect item 1 of body:
                    When CReturn (cre):
                        Let creS be decompileExpr(cre).
                        Return "({cpStr}) -> {creS}".
            Return "({cpStr}) ->:".
        When CCallExpr (target, args):
            Let ordered be decompileWrittenConstruction(target, args).
            If length of ordered is greater than 0:
                Return ordered.
            Let ts be decompileAtom(target).
            Let argParts be a new Seq of Text.
            Repeat for a in args:
                Let aStr be decompileExpr(a).
                Push aStr to argParts.
            Let argStr be joinExprs(argParts, ", ").
            Return "{ts}({argStr})".
        When CInterpolatedString (parts):
            Let lb be chr(123).
            Let rb be chr(125).
            Let mutable result be "".
            Repeat for p in parts:
                Inspect p:
                    When CLiteralPart (v):
                        Let litBody be textBody(v).
                        Set result to "{result}{litBody}".
                    When CFormattedPart (fpExpr, fpSpec, fpForm, fpSize):
                        Let fpShown be decompileExpr(fpExpr).
                        Set result to "{result}{lb}{fpShown}:{fpSpec}{rb}".
                    When CExprPart (expr):
                        Inspect expr:
                            When CInterpolatedString (innerParts):
                                Let innerShown be decompileExpr(expr).
                                Let innerLen be length of innerShown.
                                Let mutable innerBody be "".
                                Let mutable innerAt be 1.
                                Repeat for innerCh in innerShown:
                                    If innerAt is greater than 1 and innerAt is less than innerLen:
                                        Set innerBody to "{innerBody}{innerCh}".
                                    Set innerAt to innerAt + 1.
                                Set result to "{result}{innerBody}".
                            When CInt (iv):
                                Set result to "{result}{iv}".
                            When CText (tv):
                                Let tvBody be textBody(tv).
                                Set result to "{result}{tvBody}".
                            When CBool (bv):
                                If bv:
                                    Set result to "{result}true".
                                Otherwise:
                                    Set result to "{result}false".
                            When CFloat (fv):
                                Set result to "{result}{fv}".
                            Otherwise:
                                Let es be decompileExpr(expr).
                                Set result to "{result}{lb}{es}{rb}".
            Let q be chr(34).
            Return "{q}{result}{q}".
        When CDuration (spelledDuration):
            Return decompileDuration(spelledDuration).
        When CDate (spelledDate):
            Return decompileDate(spelledDate).
        When CMoment (spelledMoment):
            Return decompileMoment(spelledMoment).
        When CSpan (spelledSpan):
            Return "{spelledSpan}".
        When CTime (spelledTime):
            Return decompileTime(spelledTime).
        When CChar (spelledChar):
            Return decompileChar(spelledChar).
        When CTimeNow:
            Return "now".
        When CDateToday:
            Return "today".
        When CEscExpr (code):
            Return code.
        When CSpelled (spelledCode, spelledAwaits):
            Return spelledCode.
        When CManifestOf (zn):
            Let zoneS be decompileExpr(zn).
            Return "the manifest of {zoneS}".
        When CChunkAt (idx, zn):
            Let idxS be decompileExpr(idx).
            Let zoneS be decompileExpr(zn).
            Return "the chunk at {idxS} in {zoneS}".
        Otherwise:
            Return "<?expr?>".

## To makePad (indent: Int) -> Text:
    Let mutable pad be "".
    Let mutable pi be 0.
    While pi is less than indent:
        Set pad to "{pad}    ".
        Set pi to pi + 1.
    Return pad.

## To decompileClosureParams (cParams: Seq of Text) -> Text:
    Let cParts be a new Seq of Text.
    Repeat for cParam in cParams:
        Push "{cParam}: Any" to cParts.
    Return joinExprs(cParts, ", ").

## To decompileWrittenConstruction (wcTarget: CExpr, wcArgs: Seq of CExpr) -> Text:
    Inspect wcTarget:
        When CClosure (wcParams, wcBody, wcCaptured):
            If not decompileReturnOnly(wcBody):
                Return "".
            Inspect item 1 of wcBody:
                When CReturn (wcBuilt):
                    Inspect wcBuilt:
                        When CNew (wcType, wcNames, wcFields):
                            Return decompileWrittenFields(wcType, wcNames, wcFields, wcParams, wcArgs).
                        When CNewVariant (wcTag, wcVNames, wcVFields):
                            Return decompileWrittenFields(wcTag, wcVNames, wcVFields, wcParams, wcArgs).
                        Otherwise:
                            Return "".
        Otherwise:
            Return "".

## To decompileWrittenFields (wfType: Text) and (wfNames: Seq of Text) and (wfFields: Seq of CExpr) and (wfParams: Seq of Text) and (wfArgs: Seq of CExpr) -> Text:
    Let wfParts be a new Seq of Text.
    Let mutable wfPi be 1.
    Repeat for wfParam in wfParams:
        Let wfFi be decompileFieldNaming(wfFields, wfParam).
        If wfFi is greater than 0:
            Let wfName be item wfFi of wfNames.
            Let wfArg be decompileAtom(item wfPi of wfArgs).
            Push "{wfName} {wfArg}" to wfParts.
        Set wfPi to wfPi + 1.
    Let mutable wfHi be 1.
    Repeat for wfHeldField in wfFields:
        If not decompileNamesAParam(wfHeldField, wfParams):
            Let wfHeldName be item wfHi of wfNames.
            Let wfHeldValue be decompileAtom(wfHeldField).
            Push "{wfHeldName} {wfHeldValue}" to wfParts.
        Set wfHi to wfHi + 1.
    If length of wfParts equals 0:
        Return "a new {wfType}".
    Let wfStr be joinExprs(wfParts, " and ").
    Return "a new {wfType} with {wfStr}".

## To decompileNamesAParam (npExpr: CExpr) and (npParams: Seq of Text) -> Bool:
    Repeat for npParam in npParams:
        If decompileIsVar(npExpr, npParam):
            Return true.
    Return false.

## To decompileFieldNaming (fnFields: Seq of CExpr) and (fnParam: Text) -> Int:
    Let mutable fnI be 1.
    Repeat for fnField in fnFields:
        If decompileIsVar(fnField, fnParam):
            Return fnI.
        Set fnI to fnI + 1.
    Return 0.

## To decompileIsVar (ivExpr: CExpr) and (ivName: Text) -> Bool:
    Inspect ivExpr:
        When CVar (ivVar):
            Return ivVar equals ivName.
        Otherwise:
            Return false.

## To decompileReturnOnly (roBody: Seq of CStmt) -> Bool:
    If length of roBody is not 1:
        Return false.
    Inspect item 1 of roBody:
        When CReturn (roExpr):
            Return true.
        Otherwise:
            Return false.

## To decompileBlockClosure (bcExpr: CExpr, bcIndent: Int) -> Text:
    Inspect bcExpr:
        When CClosure (bcParams, bcBody, bcCaptured):
            If decompileReturnOnly(bcBody):
                Return "".
            Let bcParamStr be decompileClosureParams(bcParams).
            Let bcBlock be decompileBlock(bcBody, bcIndent + 1).
            Let bcNl be chr(10).
            Return "({bcParamStr}) ->:{bcNl}{bcBlock}".
        Otherwise:
            Return "".

## To decompileStmt (s: CStmt, indent: Int) -> Text:
    Let pad be makePad(indent).
    Let nl be chr(10).
    Inspect s:
        When CLet (name, expr):
            Let letBlock be decompileBlockClosure(expr, indent).
            If length of letBlock is greater than 0:
                Return "{pad}Let {name} be {letBlock}".
            Let es be decompileExpr(expr).
            Return "{pad}Let {name} be {es}.{nl}".
        When CSet (name, expr):
            Let setBlock be decompileBlockClosure(expr, indent).
            If length of setBlock is greater than 0:
                Return "{pad}Set {name} to {setBlock}".
            Let es be decompileExpr(expr).
            Return "{pad}Set {name} to {es}.{nl}".
        When CShow (expr):
            Let es be decompileExpr(expr).
            Return "{pad}Show {es}.{nl}".
        When CReturn (expr):
            Inspect expr:
                When CNothing:
                    Return "{pad}Return.{nl}".
                Otherwise:
                    Let es be decompileExpr(expr).
                    Return "{pad}Return {es}.{nl}".
        When CIf (cond, thenB, elseB):
            Let thenEmpty be length of thenB equals 0.
            Let elseEmpty be length of elseB equals 0.
            If thenEmpty and elseEmpty:
                Return "".
            Let cs be decompileExpr(cond).
            Let innerPadIf be makePad(indent + 1).
            If thenEmpty:
                Let negCs be "not ({cs})".
                Let elseS be decompileBlock(elseB, indent + 1).
                Return "{pad}If {negCs}:{nl}{elseS}".
            Let thenS be decompileBlock(thenB, indent + 1).
            Let mutable ifResult be "{pad}If {cs}:{nl}{thenS}".
            If not elseEmpty:
                Let elseS be decompileBlock(elseB, indent + 1).
                Set ifResult to "{ifResult}{pad}Otherwise:{nl}{elseS}".
            Return ifResult.
        When CRepeat (var, coll, body):
            If length of body equals 0:
                Return "".
            Inspect coll:
                When CRange (rgStart, rgEnd):
                    Let rgS be decompileAtom(rgStart).
                    Let rgE be decompileExpr(rgEnd).
                    Let rgBody be decompileBlock(body, indent + 1).
                    Return "{pad}Repeat for {var} from {rgS} to {rgE}:{nl}{rgBody}".
                Otherwise:
                    Let rgSkip be true.
            Let cs be decompileExpr(coll).
            Let bs be decompileBlock(body, indent + 1).
            Return "{pad}Repeat for {var} in {cs}:{nl}{bs}".
        When CWhile (cond, body):
            If length of body equals 0:
                Return "".
            Let cs be decompileExpr(cond).
            Let bs be decompileBlock(body, indent + 1).
            Return "{pad}While {cs}:{nl}{bs}".
        When CBreak:
            Return "{pad}Break.{nl}".
        When CPush (expr, target):
            Let es be decompileAtom(expr).
            Return "{pad}Push {es} to {target}.{nl}".
        When CSetIdx (tgt, idx, val):
            Let idxS be decompileAtom(idx).
            Let vs be decompileExpr(val).
            Return "{pad}Set item {idxS} of {tgt} to {vs}.{nl}".
        When CSetField (tgt, field, val):
            Let vs be decompileExpr(val).
            Return "{pad}Set {tgt}'s {field} to {vs}.{nl}".
        When CAtPath (atRoot, atPath, atBody):
            Return decompileBlock(atBody, indent).
        When CInspect (target, arms):
            Let ts be decompileExpr(target).
            Let mutable result be "{pad}Inspect {ts}:{nl}".
            Let bodyPad be makePad(indent + 2).
            Repeat for arm in arms:
                Inspect arm:
                    When CWhen (varName, bindings, armBody):
                        Let innerPad be "{pad}    ".
                        Let bs be decompileBlock(armBody, indent + 2).
                        If length of armBody equals 0:
                            Set bs to "{bodyPad}Let skip be true.{nl}".
                        If length of bindings is greater than 0:
                            Let bindStr be joinExprs(bindings, ", ").
                            Set result to "{result}{innerPad}When {varName} ({bindStr}):{nl}{bs}".
                        Otherwise:
                            Set result to "{result}{innerPad}When {varName}:{nl}{bs}".
                    When COtherwise (otherwiseBody):
                        Let innerPad2 be "{pad}    ".
                        Let obStr be decompileBlock(otherwiseBody, indent + 2).
                        If length of otherwiseBody equals 0:
                            Set obStr to "{bodyPad}Let skip be true.{nl}".
                        Set result to "{result}{innerPad2}Otherwise:{nl}{obStr}".
            Return result.
        When CCallS (name, args):
            Let argParts be a new Seq of Text.
            Repeat for a in args:
                Let aStr be decompileExpr(a).
                Push aStr to argParts.
            Let argStr be joinExprs(argParts, ", ").
            Return "{pad}{name}({argStr}).{nl}".
        When CMapSet (tgt, key, val):
            Let ks be decompileAtom(key).
            Let vs be decompileExpr(val).
            Return "{pad}Set item {ks} of {tgt} to {vs}.{nl}".
        When CPop (target):
            Return "{pad}Pop from {target}.{nl}".
        When CPopInto (target, into):
            Return "{pad}Pop from {target} into {into}.{nl}".
        When CRepeatRange (var, start, end, body):
            If length of body equals 0:
                Return "".
            Let ss be decompileAtom(start).
            Let es be decompileExpr(end).
            Let bs be decompileBlock(body, indent + 1).
            Return "{pad}Repeat for {var} from {ss} to {es}:{nl}{bs}".
        When CForceDynamic (fdName):
            Return "".
        When CAdd (elem, target):
            Let es be decompileAtom(elem).
            Return "{pad}Add {es} to {target}.{nl}".
        When CRemove (elem, target):
            Let es be decompileAtom(elem).
            Return "{pad}Remove {es} from {target}.{nl}".
        When CStructDef (name, fieldNames):
            Let fStr be joinExprs(fieldNames, ", ").
            Return "{pad}Define struct {name} with fields {fStr}.{nl}".
        When CEnumDef (name, variants):
            Let vStr be joinExprs(variants, ", ").
            Return "{pad}Define enum {name} with variants {vStr}.{nl}".
        When CRuntimeAssert (cond, msg):
            Let cs be decompileExpr(cond).
            Let ms be decompileExpr(msg).
            Return "{pad}Assert that {cs}, otherwise {ms}.{nl}".
        When CHardAssert (cond, msg):
            Let cs be decompileExpr(cond).
            Let ms be decompileExpr(msg).
            Return "{pad}Require that {cs}, otherwise {ms}.{nl}".
        When CFail (reason):
            Let rs be decompileExpr(reason).
            Return "{pad}Fail with {rs}.{nl}".
        When CGive (expr, target):
            Let es be decompileAtom(expr).
            Return "{pad}Give {es} to {target}.{nl}".
        When CEscStmt (code):
            Return "{pad}{code}{nl}".
        When CSleep (duration):
            Let ds be decompileExpr(duration).
            Return "{pad}Sleep {ds}.{nl}".
        When CReadConsole (target):
            Return "{pad}Read console into {target}.{nl}".
        When CReadFile (path, target):
            Let ps be decompileAtom(path).
            Return "{pad}Read file {ps} into {target}.{nl}".
        When CWriteFile (path, content):
            Let ps be decompileExpr(path).
            Let cs be decompileAtom(content).
            Return "{pad}Write {cs} to file {ps}.{nl}".
        When CCheckPolicy (dcpSubject, dcpObject, dcpCapability, dcpRule, dcpAlts, dcpSource):
            If dcpCapability:
                Return "{pad}Check that {dcpSubject} can {dcpRule} {dcpObject}.{nl}".
            Return "{pad}Check that {dcpSubject} is {dcpRule}.{nl}".
        When CCheck (predicate, msg):
            Let ps be decompileExpr(predicate).
            Let ms be decompileExpr(msg).
            Return "{pad}Check {ps}, {ms}.{nl}".
        When CAssert (proposition):
            Let ps be decompileExpr(proposition).
            Return "{pad}Assert {ps}.{nl}".
        When CTrust (proposition, justification):
            Let ps be decompileExpr(proposition).
            Let q be chr(34).
            Return "{pad}Trust {ps}, {q}{justification}{q}.{nl}".
        When CRequire (dependency):
            Let q be chr(34).
            Return "{pad}Require {q}{dependency}{q}.{nl}".
        When CMerge (target, other):
            Let os be decompileAtom(other).
            Return "{pad}Merge {os} into {target}.{nl}".
        When CJoin (target, other):
            Let os be decompileAtom(other).
            Return "{pad}Converge {os} into {target}.{nl}".
        When CIncrease (target, amount):
            Let amtS be decompileExpr(amount).
            Return "{pad}Increase {target} by {amtS}.{nl}".
        When CDecrease (target, amount):
            Let amtS be decompileExpr(amount).
            Return "{pad}Decrease {target} by {amtS}.{nl}".
        When CAppendToSeq (target, value):
            Let vs be decompileAtom(value).
            Return "{pad}Append {vs} to {target}.{nl}".
        When CResolveTo (rtTarget, rtValue):
            Let rtValueS be decompileExpr(rtValue).
            Return "{pad}Resolve {rtTarget} to {rtValueS}.{nl}".
        When CResolve (target):
            Return "{pad}Resolve {target}.{nl}".
        When CSync (target, channel):
            Let cs be decompileExpr(channel).
            Return "{pad}Sync {target} with {cs}.{nl}".
        When CMount (target, path):
            Let ps be decompileExpr(path).
            Return "{pad}Mount {target} at {ps}.{nl}".
        When CConcurrent (branches):
            Let mutable result be "{pad}Concurrent:{nl}".
            Repeat for branch in branches:
                Let bs be decompileBlock(branch, indent + 1).
                Set result to "{result}{bs}".
            Return result.
        When CParallel (branches):
            Let mutable result be "{pad}Parallel:{nl}".
            Repeat for branch in branches:
                Let bs be decompileBlock(branch, indent + 1).
                Set result to "{result}{bs}".
            Return result.
        When CLaunchTask (body, handle):
            Let bs be decompileBlock(body, indent + 1).
            Return "{pad}Launch task {handle}:{nl}{bs}".
        When CStopTask (handle):
            Let hs be decompileExpr(handle).
            Return "{pad}Stop task {hs}.{nl}".
        When CSelect (branches):
            Let mutable selStr be "{pad}Select:{nl}".
            Repeat for selBr in branches:
                Inspect selBr:
                    When CSelectRecv (selChan, selVar, selBody):
                        Let selBodyStr be decompileBlock(selBody, indent + 1).
                        Set selStr to "{selStr}{pad}    When receiving {selVar} from {selChan}:{nl}{selBodyStr}".
                    When CSelectTimeout (selDur, selBody):
                        Let selDurStr be decompileExpr(selDur).
                        Let selBodyStr be decompileBlock(selBody, indent + 1).
                        Set selStr to "{selStr}{pad}    After {selDurStr}:{nl}{selBodyStr}".
            Return selStr.
        When CCreatePipe (name, capacity):
            Let cs be decompileExpr(capacity).
            Return "{pad}Create pipe {name} with capacity {cs}.{nl}".
        When CSendPipe (chan, value):
            Let vs be decompileAtom(value).
            Return "{pad}Send {vs} to pipe {chan}.{nl}".
        When CReceivePipe (chan, target):
            Return "{pad}Receive from pipe {chan} into {target}.{nl}".
        When CTrySendPipe (chan, value):
            Let vs be decompileAtom(value).
            Return "{pad}Try send {vs} to pipe {chan}.{nl}".
        When CTryReceivePipe (chan, target):
            Return "{pad}Try receive from pipe {chan} into {target}.{nl}".
        When CSpawn (agentType, target):
            Return "{pad}Spawn {agentType} as {target}.{nl}".
        When CSendMessage (target, msg):
            Let ts be decompileExpr(target).
            Let ms be decompileAtom(msg).
            Return "{pad}Send message {ms} to {ts}.{nl}".
        When CStreamMessage (target, values):
            Let ts be decompileExpr(target).
            Let vs be decompileAtom(values).
            Return "{pad}Stream {vs} to {ts}.{nl}".
        When CAwaitMessage (target):
            Return "{pad}Await message from {target}.{nl}".
        When CListen (addr, handler):
            Let addrS be decompileExpr(addr).
            Return "{pad}Listen on {addrS} with handler {handler}.{nl}".
        When CConnectTo (addr, target):
            Let addrS be decompileExpr(addr).
            Return "{pad}Connect to {addrS} as {target}.{nl}".
        When CZone (name, kind, body):
            Let bs be decompileBlock(body, indent + 1).
            Let q be chr(34).
            Return "{pad}Inside a new zone called {q}{name}{q}:{nl}{bs}".
        Otherwise:
            Return "{pad}<?stmt?>{nl}".

## To decompileBlock (stmts: Seq of CStmt, indent: Int) -> Text:
    Let mutable result be "".
    Repeat for s in stmts:
        Let ss be decompileStmt(s, indent).
        Set result to "{result}{ss}".
    Return result.

## To collectExprCallNames (e: CExpr) -> Seq of Text:
    Let result be a new Seq of Text.
    Inspect e:
        When CCall (fname, args):
            Push fname to result.
            Repeat for a in args:
                Let sub be collectExprCallNames(a).
                Repeat for sn in sub:
                    Push sn to result.
        When CBinOp (op, left, right):
            Let ls be collectExprCallNames(left).
            Repeat for ln in ls:
                Push ln to result.
            Let rs be collectExprCallNames(right).
            Repeat for rn in rs:
                Push rn to result.
        When CNot (inner):
            Let ns be collectExprCallNames(inner).
            Repeat for nn in ns:
                Push nn to result.
        When CList (items):
            Repeat for it in items:
                Let itns be collectExprCallNames(it).
                Repeat for itn in itns:
                    Push itn to result.
        When CIndex (coll, idx):
            Let cs be collectExprCallNames(coll).
            Repeat for cn in cs:
                Push cn to result.
            Let xs be collectExprCallNames(idx).
            Repeat for xn in xs:
                Push xn to result.
        When CLen (target):
            Let ts be collectExprCallNames(target).
            Repeat for tn in ts:
                Push tn to result.
        When CFieldAccess (target, field):
            Let ts be collectExprCallNames(target).
            Repeat for tn in ts:
                Push tn to result.
        When CNewVariant (tag, nms, vals):
            Repeat for v in vals:
                Let vs be collectExprCallNames(v).
                Repeat for vn in vs:
                    Push vn to result.
        When COptionSome (inner):
            Let ns be collectExprCallNames(inner).
            Repeat for nn in ns:
                Push nn to result.
        When CTuple (items):
            Repeat for it in items:
                Let ts be collectExprCallNames(it).
                Repeat for tn in ts:
                    Push tn to result.
        When CMapGet (target, key):
            Let ts be collectExprCallNames(target).
            Repeat for tn in ts:
                Push tn to result.
            Let ks be collectExprCallNames(key).
            Repeat for kn in ks:
                Push kn to result.
        When CRange (start, end):
            Let ss be collectExprCallNames(start).
            Repeat for sn in ss:
                Push sn to result.
            Let es be collectExprCallNames(end).
            Repeat for en in es:
                Push en to result.
        When CCopy (target):
            Let ts be collectExprCallNames(target).
            Repeat for tn in ts:
                Push tn to result.
        When CContains (coll, elem):
            Let cs be collectExprCallNames(coll).
            Repeat for cn in cs:
                Push cn to result.
            Let es be collectExprCallNames(elem).
            Repeat for en in es:
                Push en to result.
        When CNew (typeName, fieldNames, fields):
            Repeat for fv in fields:
                Let fs be collectExprCallNames(fv).
                Repeat for fn1 in fs:
                    Push fn1 to result.
        When CCallExpr (target, args):
            Let ts be collectExprCallNames(target).
            Repeat for tn in ts:
                Push tn to result.
            Repeat for a in args:
                Let argNames be collectExprCallNames(a).
                Repeat for an in argNames:
                    Push an to result.
        When CInterpolatedString (parts):
            Repeat for p in parts:
                Inspect p:
                    When CExprPart (expr):
                        Let ps be collectExprCallNames(expr).
                        Repeat for pn in ps:
                            Push pn to result.
                    When CFormattedPart (fpCallExpr, fpCallSpec, fpCallForm, fpCallSize):
                        Let fps be collectExprCallNames(fpCallExpr).
                        Repeat for fpn in fps:
                            Push fpn to result.
                    Otherwise:
                        Let skip be true.
        When CSlice (coll, startIdx, endIdx):
            Let cs be collectExprCallNames(coll).
            Repeat for cn in cs:
                Push cn to result.
            Let ss be collectExprCallNames(startIdx).
            Repeat for sn in ss:
                Push sn to result.
            Let es be collectExprCallNames(endIdx).
            Repeat for en in es:
                Push en to result.
        When CUnion (left, right):
            Let ls be collectExprCallNames(left).
            Repeat for ln in ls:
                Push ln to result.
            Let rs be collectExprCallNames(right).
            Repeat for rn in rs:
                Push rn to result.
        When CIntersection (left, right):
            Let ls be collectExprCallNames(left).
            Repeat for ln in ls:
                Push ln to result.
            Let rs be collectExprCallNames(right).
            Repeat for rn in rs:
                Push rn to result.
        Otherwise:
            Let skip be true.
    Return result.

## To collectCallNames (stmts: Seq of CStmt) -> Seq of Text:
    Let result be a new Seq of Text.
    Repeat for s in stmts:
        Inspect s:
            When CLet (name, expr):
                Let ns be collectExprCallNames(expr).
                Repeat for n in ns:
                    Push n to result.
            When CSet (name, expr):
                Let ns be collectExprCallNames(expr).
                Repeat for n in ns:
                    Push n to result.
            When CShow (expr):
                Let ns be collectExprCallNames(expr).
                Repeat for n in ns:
                    Push n to result.
            When CReturn (expr):
                Let ns be collectExprCallNames(expr).
                Repeat for n in ns:
                    Push n to result.
            When CFail (reason):
                Let failNames be collectExprCallNames(reason).
                Repeat for failName in failNames:
                    Push failName to result.
            When CHardAssert (hcond, hmsg):
                Let hcs be collectExprCallNames(hcond).
                Repeat for hc in hcs:
                    Push hc to result.
                Let hms be collectExprCallNames(hmsg).
                Repeat for hm in hms:
                    Push hm to result.
            When CRuntimeAssert (rcond, rmsg):
                Let rcs be collectExprCallNames(rcond).
                Repeat for rc in rcs:
                    Push rc to result.
                Let rms be collectExprCallNames(rmsg).
                Repeat for rm in rms:
                    Push rm to result.
            When CIf (cond, thenB, elseB):
                Let cs be collectExprCallNames(cond).
                Repeat for cn in cs:
                    Push cn to result.
                Let ts be collectCallNames(thenB).
                Repeat for tn in ts:
                    Push tn to result.
                Let es be collectCallNames(elseB).
                Repeat for en in es:
                    Push en to result.
            When CRepeat (var, coll, body):
                Let cs be collectExprCallNames(coll).
                Repeat for cn in cs:
                    Push cn to result.
                Let bs be collectCallNames(body).
                Repeat for bn in bs:
                    Push bn to result.
            When CWhile (cond, body):
                Let cs be collectExprCallNames(cond).
                Repeat for cn in cs:
                    Push cn to result.
                Let bs be collectCallNames(body).
                Repeat for bn in bs:
                    Push bn to result.
            When CRepeatRange (rangeVar, rangeStart, rangeEnd, rangeBody):
                Repeat for rsn in collectExprCallNames(rangeStart):
                    Push rsn to result.
                Repeat for ren in collectExprCallNames(rangeEnd):
                    Push ren to result.
                Repeat for rbn in collectCallNames(rangeBody):
                    Push rbn to result.
            When CPush (expr, target):
                Let ns be collectExprCallNames(expr).
                Repeat for n in ns:
                    Push n to result.
            When CSetIdx (tgt, idx, val):
                Let idns be collectExprCallNames(idx).
                Repeat for idn in idns:
                    Push idn to result.
                Let vs be collectExprCallNames(val).
                Repeat for vn in vs:
                    Push vn to result.
            When CSetField (tgt, field, val):
                Let vs be collectExprCallNames(val).
                Repeat for vn in vs:
                    Push vn to result.
            When CAtPath (atRoot, atPath, atBody):
                Repeat for atName in collectCallNames(atBody):
                    Push atName to result.
            When CInspect (target, arms):
                Let ts be collectExprCallNames(target).
                Repeat for tn in ts:
                    Push tn to result.
                Repeat for arm in arms:
                    Inspect arm:
                        When CWhen (varName, bindings, armBody):
                            Let abs be collectCallNames(armBody).
                            Repeat for abn in abs:
                                Push abn to result.
                        When COtherwise (armBody):
                            Let obs be collectCallNames(armBody).
                            Repeat for obn in obs:
                                Push obn to result.
            When CCallS (cname, args):
                Push cname to result.
                Repeat for a in args:
                    Let as1 be collectExprCallNames(a).
                    Repeat for an in as1:
                        Push an to result.
            When CMapSet (tgt, key, val):
                Let ks be collectExprCallNames(key).
                Repeat for kn in ks:
                    Push kn to result.
                Let vs be collectExprCallNames(val).
                Repeat for vn in vs:
                    Push vn to result.
            Otherwise:
                Let skip be true.
    Return result.

## To decompileFunc (f: CFunc) -> Text:
    Let nl be chr(10).
    Inspect f:
        When CFuncDef (fname, fparams, fparamTypes, freturnType, fbody):
            Let mutable header be "## To {fname}".
            Let mutable first be true.
            Let mutable pidx be 1.
            Let ptLen be length of fparamTypes.
            Repeat for p in fparams:
                Let ptype be "Any".
                If pidx is at most ptLen:
                    Set ptype to item pidx of fparamTypes.
                If first:
                    Set header to "{header} ({p}: {ptype})".
                    Set first to false.
                Otherwise:
                    Set header to "{header} and ({p}: {ptype})".
                Set pidx to pidx + 1.
            Set header to "{header} -> {freturnType}:".
            Let mutable bodyStr be decompileBlock(fbody, 1).
            If length of bodyStr equals 0:
                Set bodyStr to "    Return.{nl}".
            Return "{header}{nl}{bodyStr}{nl}".
        Otherwise:
            Return "".

## To decompileIsMapType (mapTypeName: Text) -> Bool:
    If mapTypeName equals "Map":
        Return true.
    Let mutable dmtChars be a new Seq of Text.
    Repeat for dmtCh in mapTypeName:
        Push dmtCh to dmtChars.
    Let mutable dmtAt be 1.
    Repeat for dmtPrefixCh in "Map of ":
        If dmtAt is greater than length of dmtChars:
            Return false.
        If item dmtAt of dmtChars is not dmtPrefixCh:
            Return false.
        Set dmtAt to dmtAt + 1.
    Return true.

## To decompileTypeAtom (typeText: Text) -> Text:
    If typeText contains " ":
        Return "({typeText})".
    Return typeText.
