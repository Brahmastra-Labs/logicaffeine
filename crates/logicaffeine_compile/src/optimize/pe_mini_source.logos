                Push (a new CTrySendPipe with chan tspPipe and value peTspValue) to blockResult.
            When CTryReceivePipe (trpPipe, trpTarget):
                Push (a new CTryReceivePipe with chan trpPipe and target trpTarget) to blockResult.
            When CSpawn (spawnType, spawnTarget):
                Push (a new CSpawn with agentType spawnType and target spawnTarget) to blockResult.
            When CSendMessage (smTarget, smMsg):
                Let peSmTarget be peExprM(smTarget, state).
                Let peSmMsg be peExprM(smMsg, state).
                Push (a new CSendMessage with target peSmTarget and msg peSmMsg) to blockResult.
            When CStreamMessage (stTarget, stVals):
                Let peStTarget be peExprM(stTarget, state).
                Let peStVals be peExprM(stVals, state).
                Push (a new CStreamMessage with target peStTarget and values peStVals) to blockResult.
            When CAwaitMessage (amTarget):
                Push (a new CAwaitMessage with target amTarget) to blockResult.
            When CListen (listenAddr, listenHandler):
                Let peListenAddr be peExprM(listenAddr, state).
                Push (a new CListen with addr peListenAddr and handler listenHandler) to blockResult.
            When CConnectTo (connAddr, connTarget):
                Let peConnAddr be peExprM(connAddr, state).
                Push (a new CConnectTo with addr peConnAddr and target connTarget) to blockResult.
            When CZone (zoneName, zoneKind, zoneBody):
                Let peZoneBody be peBlockM(zoneBody, state).
                Push (a new CZone with name zoneName and kind zoneKind and body peZoneBody) to blockResult.
    Return blockResult.

## To validateExtractReturnM (result: CExpr) and (bodyStmts: Seq of CStmt) -> CExpr:
    Inspect result:
        When CVar (retName):
            If retName equals "__no_return__":
                Return result.
            If retName equals "__unresolvable":
                Return result.
            Repeat for s in bodyStmts:
                Inspect s:
                    When CLet (letName, letExpr):
                        If letName equals retName:
                            Return a new CVar with name "__no_return__".
                    Otherwise:
                        Let skip be true.
            Return result.
        Otherwise:
            Return result.

## To extractReturnM (stmts: Seq of CStmt) -> CExpr:
    Let mutable idx be length of stmts.
    While idx is at least 1:
        Let s be item idx of stmts.
        Inspect s:
            When CReturn (retExpr):
                Return retExpr.
            Otherwise:
                Set idx to idx - 1.
    Return a new CVar with name "__no_return__".

## To peWithoutM (pwColl: CExpr) and (pwElem: CExpr) -> CExpr:
    Let mutable pwKey be "".
    Let mutable pwKnown be false.
    Inspect pwColl:
        When CNew (pwTag, pwNames, pwVals):
            If pwTag equals "Set":
                If isStaticM(pwElem):
                    Set pwKey to exprToKeyPartM(pwElem).
                    Set pwKnown to true.
            If peIsMapTypeM(pwTag):
                Inspect pwElem:
                    When CText (pwText):
                        Set pwKey to pwText.
                        Set pwKnown to true.
                    Otherwise:
                        Let pwSkip be true.
            If pwKnown:
                Let pwKeptNames be a new Seq of Text.
                Let pwKeptVals be a new Seq of CExpr.
                Let mutable pwAt be 1.
                Repeat for pwName in pwNames:
                    If pwName is not pwKey:
                        Push pwName to pwKeptNames.
                        Push item pwAt of pwVals to pwKeptVals.
                    Set pwAt to pwAt + 1.
                Return a new CNew with typeName pwTag and fieldNames pwKeptNames and fields pwKeptVals.
        When CNewVariant (pwvTag, pwvNames, pwvVals):
            If peIsMapTypeM(pwvTag):
                Inspect pwElem:
                    When CText (pwvText):
                        Let pwvKeptNames be a new Seq of Text.
                        Let pwvKeptVals be a new Seq of CExpr.
                        Let mutable pwvAt be 1.
                        Repeat for pwvName in pwvNames:
                            If pwvName is not pwvText:
                                Push pwvName to pwvKeptNames.
                                Push item pwvAt of pwvVals to pwvKeptVals.
                            Set pwvAt to pwvAt + 1.
                        Return a new CNewVariant with tag pwvTag and fnames pwvKeptNames and fvals pwvKeptVals.
                    Otherwise:
                        Let pwvSkip be true.
        Otherwise:
            Let pwOther be true.
    Return a new CVar with name "__pe_no_unfold".

## To peCharCountM (pcText: Text) -> Int:
    Let mutable pcCount be 0.
    Repeat for pcCh in pcText:
        Set pcCount to pcCount + 1.
    Return pcCount.

## To peSpacesM (psCount: Int) -> Text:
    Let mutable psOut be "".
    Let mutable psAt be 0.
    While psAt is less than psCount:
        Set psOut to "{psOut} ".
        Set psAt to psAt + 1.
    Return psOut.

## To peFormattedTextM (ftText: Text) and (ftForm: Text) and (ftSize: Int) -> Text:
    If ftForm equals "$":
        Return "${ftText}".
    If ftForm equals ".":
        Return ftText.
    Let ftGap be ftSize - peCharCountM(ftText).
    If ftGap is at most 0:
        Return ftText.
    If ftForm equals "<":
        Return "{ftText}{peSpacesM(ftGap)}".
    If ftForm equals "^":
        Let ftLeft be ftGap / 2.
        Return "{peSpacesM(ftLeft)}{ftText}{peSpacesM(ftGap - ftLeft)}".
    Return "{peSpacesM(ftGap)}{ftText}".

## To peSpecNameM (snCache: mutable Map of Text to CExpr) and (snKey: Text) and (snBase: Text) -> Text:
    Let snSlot be "__pe_name__{snKey}".
    If snCache contains snSlot:
        Let snSlotRead be "{snSlot}".
        Let snHeld be item snSlotRead of snCache.
        Inspect snHeld:
            When CText (snName):
                Return snName.
            Otherwise:
                Let snSkip be true.
    Let mutable snCount be 1.
    Let snCountKey be "__pe_name_count".
    If snCache contains snCountKey:
        Let snCountRead be "{snCountKey}".
        Let snCountHeld be item snCountRead of snCache.
        Inspect snCountHeld:
            When CInt (snPrev):
                Set snCount to snPrev + 1.
            Otherwise:
                Let snSkip2 be true.
    Let snCountBind be "{snCountKey}".
    miniSeBind(snCache, snCountBind, a new CInt with value snCount).
    Let snFresh be "{snBase}__{snCount}".
    Let snSlotBind be "{snSlot}".
    Let snFreshCopy be "{snFresh}".
    miniSeBind(snCache, snSlotBind, a new CText with value snFreshCopy).
    Return snFresh.

## To peIsMapTypeM (mapTypeName: Text) -> Bool:
    If mapTypeName equals "Map":
        Return true.
    Return mapTypeName contains "Map of ".
