## A PEMiniState is one of:
    A PEMiniR with env Map of Text to CVal and funcs Map of Text to CFunc and depth Int and staticEnv Map of Text to CExpr and memoCache Map of Text to CExpr and onStackM Seq of Text.

## To makePeState (e: Map of Text to CVal) and (f: Map of Text to CFunc) and (d: Int) -> PEMiniState:
    Return a new PEMiniR with env e and funcs f and depth d and staticEnv (a new Map of Text to CExpr) and memoCache (a new Map of Text to CExpr) and onStackM (a new Seq of Text).

## To peEnvM (st: PEMiniState) -> Map of Text to CVal:
    Inspect st:
        When PEMiniR (e, f, d, se, mc, os):
            Return e.

## To peFuncsM (st: PEMiniState) -> Map of Text to CFunc:
    Inspect st:
        When PEMiniR (e, f, d, se, mc, os):
            Return f.

## To peDepthM (st: PEMiniState) -> Int:
    Inspect st:
        When PEMiniR (e, f, d, se, mc, os):
            Return d.

## To peMemoCacheM (st: PEMiniState) -> Map of Text to CExpr:
    Inspect st:
        When PEMiniR (e, f, d, se, mc, os):
            Return mc.

## To peStaticEnvM (st: PEMiniState) -> Map of Text to CExpr:
    Inspect st:
        When PEMiniR (e, f, d, se, mc, os):
            Return se.

## To peOnStackM (st: PEMiniState) -> Seq of Text:
    Inspect st:
        When PEMiniR (e, f, d, se, mc, os):
            Return os.

## To peStateWithEnvDepthM (st: PEMiniState) and (newEnv: Map of Text to CVal) and (d: Int) -> PEMiniState:
    Inspect st:
        When PEMiniR (e, f, oldD, se, mc, os):
            Return a new PEMiniR with env newEnv and funcs f and depth d and staticEnv (a new Map of Text to CExpr) and memoCache mc and onStackM os.

## To peStateWithEnvDepthStaticM (st: PEMiniState) and (newEnv: Map of Text to CVal) and (d: Int) and (newSe: Map of Text to CExpr) -> PEMiniState:
    Inspect st:
        When PEMiniR (e, f, oldD, se, mc, os):
            Return a new PEMiniR with env newEnv and funcs f and depth d and staticEnv newSe and memoCache mc and onStackM os.

## To miniEnvBind (m: mutable Map of Text to CVal) and (k: Text) and (v: CVal):
    Set item k of m to v.

## To miniEnvDrop (m: mutable Map of Text to CVal) and (k: Text):
    Remove k from m.

## To miniSeBind (m: mutable Map of Text to CExpr) and (k: Text) and (v: CExpr):
    Set item k of m to v.

## To miniSeDrop (m: mutable Map of Text to CExpr) and (k: Text):
    Remove k from m.

## To miniOsPush (s: mutable Seq of Text) and (v: Text):
    Push v to s.

## To isCopyPropSafeM (e: CExpr) -> Bool:
    Inspect e:
        When CNewSeq (peMSeqElem1):
            Return false.
        When CNewSet (peMSetElem1):
            Return false.
        When CDeclaredDefault (cpDefaultType):
            Return false.
        Otherwise:
            Return true.

## To isPeValueForCopyPropM (e: CExpr) -> Bool:
    Let sv be isStaticValueM(e).
    If sv:
        Return true.
    Inspect e:
        When CList (cpvItems):
            Return true.
        When CTuple (cpvTup):
            Return true.
        When CNew (cpvTy, cpvNames, cpvVals):
            Return true.
        When CNewVariant (cpvTag, cpvNms, cpvVls):
            Return true.
        When COptionSome (cpvInner):
            Return true.
        When CRange (cpvS, cpvE):
            Return true.
        Otherwise:
            Return false.

## To exprRefsAnyMutatedM (e: CExpr) and (muts: Seq of Text) -> Bool:
    Inspect e:
        When CVar (ravVn):
            Repeat for ravM in muts:
                If ravVn is equal to ravM:
                    Return true.
            Return false.
        When CBinOp (ravOp, ravL, ravR):
            Let ravA be exprRefsAnyMutatedM(ravL, muts).
            If ravA:
                Return true.
            Return exprRefsAnyMutatedM(ravR, muts).
        When CNot (ravNi):
            Return exprRefsAnyMutatedM(ravNi, muts).
        When CIndex (ravIc, ravIi):
            Let ravB be exprRefsAnyMutatedM(ravIc, muts).
            If ravB:
                Return true.
            Return exprRefsAnyMutatedM(ravIi, muts).
        When CLen (ravLt):
            Return exprRefsAnyMutatedM(ravLt, muts).
        When CFieldAccess (ravFt, ravFf):
            Return exprRefsAnyMutatedM(ravFt, muts).
        When CMapGet (ravMt, ravMk):
            Let ravC be exprRefsAnyMutatedM(ravMt, muts).
            If ravC:
                Return true.
            Return exprRefsAnyMutatedM(ravMk, muts).
        When CContains (ravCc, ravCe):
            Let ravD be exprRefsAnyMutatedM(ravCc, muts).
            If ravD:
                Return true.
            Return exprRefsAnyMutatedM(ravCe, muts).
        When CSlice (ravSc, ravSs, ravSe):
            Let ravE be exprRefsAnyMutatedM(ravSc, muts).
            If ravE:
                Return true.
            Let ravF be exprRefsAnyMutatedM(ravSs, muts).
            If ravF:
                Return true.
            Return exprRefsAnyMutatedM(ravSe, muts).
        When CUnion (ravUl, ravUr):
            Let ravG be exprRefsAnyMutatedM(ravUl, muts).
            If ravG:
                Return true.
            Return exprRefsAnyMutatedM(ravUr, muts).
        When CIntersection (ravIl, ravIr):
            Let ravH be exprRefsAnyMutatedM(ravIl, muts).
            If ravH:
                Return true.
            Return exprRefsAnyMutatedM(ravIr, muts).
        When CCopy (ravCt):
            Return exprRefsAnyMutatedM(ravCt, muts).
        When CInt (ravVi):
            Return false.
        When CBool (ravVb):
            Return false.
        When CText (ravVt):
            Return false.
        When CFloat (ravVf):
            Return false.
        When CDuration (ravAtomDuration):
            Return false.
        When CDate (ravAtomDate):
            Return false.
        When CMoment (ravAtomMoment):
            Return false.
        When CSpan (ravAtomSpan):
            Return false.
        When CTime (ravAtomTime):
            Return false.
        When CChar (ravAtomChar):
            Return false.
        Otherwise:
            Return true.

## To shouldCopyPropM (e: CExpr) and (muts: Seq of Text) -> Bool:
    Let scpSv be isPeValueForCopyPropM(e).
    If scpSv:
        Return true.
    Let scpRm be exprRefsAnyMutatedM(e, muts).
    If scpRm:
        Return false.
    Return true.

## To isStaticM (e: CExpr) -> Bool:
    Inspect e:
        When CInt (v):
            Return true.
        When CBool (v):
            Return true.
        When CText (v):
            Return true.
        When CFloat (v):
            Return true.
        When CDuration (stAtomDuration):
            Return true.
        When CDate (stAtomDate):
            Return true.
        When CMoment (stAtomMoment):
            Return true.
        When CSpan (stAtomSpan):
            Return true.
        When CTime (stAtomTime):
            Return true.
        When CChar (stAtomChar):
            Return true.
        When CList (items):
            Repeat for elem in items:
                Let s be isStaticM(elem).
                If not s:
                    Return false.
            Return true.
        When CNewVariant (tag, names, vals):
            Repeat for v in vals:
                Let s be isStaticM(v).
                If not s:
                    Return false.
            Return true.
        When CTuple (items):
            Repeat for elem in items:
                Let s be isStaticM(elem).
                If not s:
                    Return false.
            Return true.
        When COptionSome (inner):
            Return isStaticM(inner).
        When COptionNone:
            Return true.
        When CNewSeq (peMSeqElem2):
            Return true.
        When CNewSet (peMSetElem2):
            Return true.
        When CNew (typeName, fieldNames, fieldExprs):
            Repeat for fe in fieldExprs:
                Let s be isStaticM(fe).
                If not s:
                    Return false.
            Return true.
        When CRange (start, end):
            Let s1 be isStaticM(start).
            Let s2 be isStaticM(end).
            Return (s1 and s2).
        When CCopy (target):
            Return isStaticM(target).
        When CClosure (clp, clb, clc):
            Return true.
        Otherwise:
            Return false.

## To isStaticValueM (e: CExpr) -> Bool:
    Inspect e:
        When CNewSeq (peMSeqElem3):
            Return false.
        When CNewSet (peMSetElem3):
            Return false.
        Otherwise:
            Return isStaticM(e).

## To allStaticM (args: Seq of CExpr) -> Bool:
    Repeat for a in args:
        Let s be isStaticM(a).
        If not s:
            Return false.
    Return true.

## To makeCycleKeyM (fnName: Text) and (args: Seq of CExpr) -> Text:
    Let key be "spec_{fnName}".
    Repeat for a in args:
        If isStaticM(a):
            Let part be exprToKeyPartM(a).
            Set key to keyJoinM(key, "s{part}").
        Otherwise:
            Set key to keyJoinM(key, "d").
    Return key.

## To checkVNothingM (v: CVal) -> Bool:
    Inspect v:
        When VNothing:
            Return true.
        Otherwise:
            Return false.

## To exprToValM (e: CExpr) -> CVal:
    Inspect e:
        When CInt (v):
            Return a new VInt with value v.
        When CBool (v):
            Return a new VBool with value v.
        When CText (v):
            Return a new VText with value v.
        When CFloat (v):
            Return a new VFloat with value v.
        When CDuration (evAtomDuration):
            Return a new VDuration with value evAtomDuration.
        When CDate (evAtomDate):
            Return a new VDate with value evAtomDate.
        When CMoment (evAtomMoment):
            Return a new VMoment with value evAtomMoment.
        When CSpan (evAtomSpan):
            Return a new VSpan with value evAtomSpan.
        When CTime (evAtomTime):
            Return a new VTime with value evAtomTime.
        When CChar (evAtomChar):
            Return a new VChar with value evAtomChar.
        When CList (items):
            Let vals be a new Seq of CVal.
            Repeat for elem in items:
                Push exprToValM(elem) to vals.
            Return a new VSeq with items vals.
        When CNewVariant (tag, names, vals):
            Let vvals be a new Seq of CVal.
            Repeat for v in vals:
                Push exprToValM(v) to vvals.
            Return a new VVariant with typeName tag and variantName tag and fields vvals.
        When CNew (typeName, fieldNames, fieldExprs):
            If peIsMapTypeM(typeName):
                Return a new VMap with entries a new Map of Text to CVal.
            Let vvals be a new Seq of CVal.
            Repeat for fe in fieldExprs:
                Push exprToValM(fe) to vvals.
            Return a new VVariant with typeName typeName and variantName typeName and fields vvals.
        When CCopy (target):
            Return exprToValM(target).
        Otherwise:
            Return a new VNothing.

## To valToExprM (v: CVal) -> CExpr:
    Inspect v:
        When VInt (n):
            Return a new CInt with value n.
        When VBool (b):
            Return a new CBool with value b.
        When VText (s):
            Return a new CText with value s.
        When VFloat (f):
            Return a new CFloat with value f.
        When VDuration (veAtomDuration):
            Return a new CDuration with value veAtomDuration.
        When VDate (veAtomDate):
            Return a new CDate with value veAtomDate.
        When VMoment (veAtomMoment):
            Return a new CMoment with value veAtomMoment.
        When VSpan (veAtomSpan):
            Return a new CSpan with value veAtomSpan.
        When VTime (veAtomTime):
            Return a new CTime with value veAtomTime.
        When VChar (veAtomChar):
            Return a new CChar with value veAtomChar.
        When VSeq (items):
            Let exprs be a new Seq of CExpr.
            Repeat for elem in items:
                Push valToExprM(elem) to exprs.
            Return a new CList with items exprs.
        When VOption (inner, present):
            If present:
                Return a new COptionSome with inner (valToExprM(inner)).
            Return a new COptionNone.
        When VMap (entries):
            Return a new CNew with typeName "Map" and fieldNames (a new Seq of Text) and fields (a new Seq of CExpr).
        Otherwise:
            Return a new CVar with name "__unresolvable".

## To evalBinOpM (binOp: Text) and (lv: CVal) and (rv: CVal) -> CVal:
    Return peFoldOperatorM(binOp, lv, rv).

# The specializer's operators: generated by optimize::core_operators from semantics::operator_overloads.
## To peFoldOperatorM (fbOp: Text) and (fbLeft: CVal) and (fbRight: CVal) -> CVal:
    Inspect fbLeft:
        When VInt (fbLeftInt):
            Inspect fbRight:
                When VInt (fbRightInt):
                    If fbOp equals "%":
                        If fbRightInt equals 0:
                            Return a new VNothing.
                        Return a new VInt with value (fbLeftInt % fbRightInt).
                    If fbOp equals "&":
                        Return a new VInt with value (fbLeftInt & fbRightInt).
                    If fbOp equals "*":
                        Return a new VInt with value (fbLeftInt * fbRightInt).
                    If fbOp equals "**":
                        If fbRightInt is less than 0:
                            Return a new VNothing.
                        Return a new VInt with value (fbLeftInt ** fbRightInt).
                    If fbOp equals "+":
                        Return a new VInt with value (fbLeftInt + fbRightInt).
                    If fbOp equals "-":
                        Return a new VInt with value (fbLeftInt - fbRightInt).
                    If fbOp equals "/":
                        If fbRightInt equals 0:
                            Return a new VNothing.
                        Return a new VInt with value (fbLeftInt / fbRightInt).
                    If fbOp equals "//":
                        If fbRightInt equals 0:
                            Return a new VNothing.
                        Return a new VInt with value (fbLeftInt // fbRightInt).
                    If fbOp equals "<":
                        Return a new VBool with value (fbLeftInt is less than fbRightInt).
                    If fbOp equals "<<":
                        Return a new VInt with value (fbLeftInt shifted left by fbRightInt).
                    If fbOp equals "<=":
                        Return a new VBool with value (fbLeftInt is at most fbRightInt).
                    If fbOp equals ">":
                        Return a new VBool with value (fbLeftInt is greater than fbRightInt).
                    If fbOp equals ">=":
                        Return a new VBool with value (fbLeftInt is at least fbRightInt).
                    If fbOp equals ">>":
                        Return a new VInt with value (fbLeftInt shifted right by fbRightInt).
                    If fbOp equals "^":
                        Return a new VInt with value (fbLeftInt xor fbRightInt).
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftInt combined with fbRightInt).
                    If fbOp equals "is approximately":
                        Return a new VBool with value (fbLeftInt is approximately fbRightInt).
                    If fbOp equals "|":
                        Return a new VInt with value (fbLeftInt | fbRightInt).
                    If fbOp equals "==":
                        Return a new VBool with value (fbLeftInt equals fbRightInt).
                    If fbOp equals "!=":
                        Return a new VBool with value (fbLeftInt is not fbRightInt).
                    Return a new VNothing.
                When VFloat (fbRightReal):
                    If fbOp equals "*":
                        Return a new VFloat with value (fbLeftInt * fbRightReal).
                    If fbOp equals "**":
                        Return a new VFloat with value (fbLeftInt ** fbRightReal).
                    If fbOp equals "+":
                        Return a new VFloat with value (fbLeftInt + fbRightReal).
                    If fbOp equals "-":
                        Return a new VFloat with value (fbLeftInt - fbRightReal).
                    If fbOp equals "/":
                        If fbRightReal equals 0.0:
                            Return a new VNothing.
                        Return a new VFloat with value (fbLeftInt / fbRightReal).
                    If fbOp equals "//":
                        If fbRightReal equals 0.0:
                            Return a new VNothing.
                        Return a new VFloat with value (fbLeftInt // fbRightReal).
                    If fbOp equals "<":
                        Return a new VBool with value (fbLeftInt is less than fbRightReal).
                    If fbOp equals "<=":
                        Return a new VBool with value (fbLeftInt is at most fbRightReal).
                    If fbOp equals ">":
                        Return a new VBool with value (fbLeftInt is greater than fbRightReal).
                    If fbOp equals ">=":
                        Return a new VBool with value (fbLeftInt is at least fbRightReal).
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftInt combined with fbRightReal).
                    If fbOp equals "is approximately":
                        Return a new VBool with value (fbLeftInt is approximately fbRightReal).
                    If fbOp equals "==":
                        Return a new VBool with value (fbLeftInt equals fbRightReal).
                    If fbOp equals "!=":
                        Return a new VBool with value (fbLeftInt is not fbRightReal).
                    Return a new VNothing.
                When VText (fbRightText):
                    If fbOp equals "+":
                        Return a new VText with value (fbLeftInt + fbRightText).
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftInt combined with fbRightText).
                    Return a new VNothing.
                When VBool (fbRightBool):
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftInt combined with fbRightBool).
                    Return a new VNothing.
                When VDuration (fbRightDuration):
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftInt combined with fbRightDuration).
                    Return a new VNothing.
                When VDate (fbRightDate):
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftInt combined with fbRightDate).
                    Return a new VNothing.
                When VMoment (fbRightMoment):
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftInt combined with fbRightMoment).
                    Return a new VNothing.
                When VSpan (fbRightSpan):
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftInt combined with fbRightSpan).
                    Return a new VNothing.
                When VTime (fbRightTime):
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftInt combined with fbRightTime).
                    Return a new VNothing.
                When VChar (fbRightChar):
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftInt combined with fbRightChar).
                    Return a new VNothing.
                Otherwise:
                    Return a new VNothing.
        When VFloat (fbLeftReal):
            Inspect fbRight:
                When VInt (fbRightInt):
                    If fbOp equals "*":
                        Return a new VFloat with value (fbLeftReal * fbRightInt).
                    If fbOp equals "**":
                        Return a new VFloat with value (fbLeftReal ** fbRightInt).
                    If fbOp equals "+":
                        Return a new VFloat with value (fbLeftReal + fbRightInt).
                    If fbOp equals "-":
                        Return a new VFloat with value (fbLeftReal - fbRightInt).
                    If fbOp equals "/":
                        If fbRightInt equals 0:
                            Return a new VNothing.
                        Return a new VFloat with value (fbLeftReal / fbRightInt).
                    If fbOp equals "//":
                        If fbRightInt equals 0:
                            Return a new VNothing.
                        Return a new VFloat with value (fbLeftReal // fbRightInt).
                    If fbOp equals "<":
                        Return a new VBool with value (fbLeftReal is less than fbRightInt).
                    If fbOp equals "<=":
                        Return a new VBool with value (fbLeftReal is at most fbRightInt).
                    If fbOp equals ">":
                        Return a new VBool with value (fbLeftReal is greater than fbRightInt).
                    If fbOp equals ">=":
                        Return a new VBool with value (fbLeftReal is at least fbRightInt).
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftReal combined with fbRightInt).
                    If fbOp equals "is approximately":
                        Return a new VBool with value (fbLeftReal is approximately fbRightInt).
                    If fbOp equals "==":
                        Return a new VBool with value (fbLeftReal equals fbRightInt).
                    If fbOp equals "!=":
                        Return a new VBool with value (fbLeftReal is not fbRightInt).
                    Return a new VNothing.
                When VFloat (fbRightReal):
                    If fbOp equals "*":
                        Return a new VFloat with value (fbLeftReal * fbRightReal).
                    If fbOp equals "**":
                        Return a new VFloat with value (fbLeftReal ** fbRightReal).
                    If fbOp equals "+":
                        Return a new VFloat with value (fbLeftReal + fbRightReal).
                    If fbOp equals "-":
                        Return a new VFloat with value (fbLeftReal - fbRightReal).
                    If fbOp equals "/":
                        If fbRightReal equals 0.0:
                            Return a new VNothing.
                        Return a new VFloat with value (fbLeftReal / fbRightReal).
                    If fbOp equals "//":
                        If fbRightReal equals 0.0:
                            Return a new VNothing.
                        Return a new VFloat with value (fbLeftReal // fbRightReal).
                    If fbOp equals "<":
                        Return a new VBool with value (fbLeftReal is less than fbRightReal).
                    If fbOp equals "<=":
                        Return a new VBool with value (fbLeftReal is at most fbRightReal).
                    If fbOp equals ">":
                        Return a new VBool with value (fbLeftReal is greater than fbRightReal).
                    If fbOp equals ">=":
                        Return a new VBool with value (fbLeftReal is at least fbRightReal).
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftReal combined with fbRightReal).
                    If fbOp equals "is approximately":
                        Return a new VBool with value (fbLeftReal is approximately fbRightReal).
                    If fbOp equals "==":
                        Return a new VBool with value (fbLeftReal equals fbRightReal).
                    If fbOp equals "!=":
                        Return a new VBool with value (fbLeftReal is not fbRightReal).
                    Return a new VNothing.
                When VText (fbRightText):
                    If fbOp equals "+":
                        Return a new VText with value (fbLeftReal + fbRightText).
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftReal combined with fbRightText).
                    Return a new VNothing.
                When VBool (fbRightBool):
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftReal combined with fbRightBool).
                    Return a new VNothing.
                When VDuration (fbRightDuration):
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftReal combined with fbRightDuration).
                    Return a new VNothing.
                When VDate (fbRightDate):
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftReal combined with fbRightDate).
                    Return a new VNothing.
                When VMoment (fbRightMoment):
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftReal combined with fbRightMoment).
                    Return a new VNothing.
                When VSpan (fbRightSpan):
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftReal combined with fbRightSpan).
                    Return a new VNothing.
                When VTime (fbRightTime):
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftReal combined with fbRightTime).
                    Return a new VNothing.
                When VChar (fbRightChar):
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftReal combined with fbRightChar).
                    Return a new VNothing.
                Otherwise:
                    Return a new VNothing.
        When VText (fbLeftText):
            Inspect fbRight:
                When VInt (fbRightInt):
                    If fbOp equals "+":
                        Return a new VText with value (fbLeftText + fbRightInt).
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftText combined with fbRightInt).
                    Return a new VNothing.
                When VFloat (fbRightReal):
                    If fbOp equals "+":
                        Return a new VText with value (fbLeftText + fbRightReal).
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftText combined with fbRightReal).
                    Return a new VNothing.
                When VText (fbRightText):
                    If fbOp equals "+":
                        Return a new VText with value (fbLeftText + fbRightText).
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftText combined with fbRightText).
                    If fbOp equals "==":
                        Return a new VBool with value (fbLeftText equals fbRightText).
                    If fbOp equals "!=":
                        Return a new VBool with value (fbLeftText is not fbRightText).
                    Return a new VNothing.
                When VBool (fbRightBool):
                    If fbOp equals "+":
                        Return a new VText with value (fbLeftText + fbRightBool).
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftText combined with fbRightBool).
                    Return a new VNothing.
                When VDuration (fbRightDuration):
                    If fbOp equals "+":
                        Return a new VText with value (fbLeftText + fbRightDuration).
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftText combined with fbRightDuration).
                    Return a new VNothing.
                When VDate (fbRightDate):
                    If fbOp equals "+":
                        Return a new VText with value (fbLeftText + fbRightDate).
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftText combined with fbRightDate).
                    Return a new VNothing.
                When VMoment (fbRightMoment):
                    If fbOp equals "+":
                        Return a new VText with value (fbLeftText + fbRightMoment).
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftText combined with fbRightMoment).
                    Return a new VNothing.
                When VSpan (fbRightSpan):
                    If fbOp equals "+":
                        Return a new VText with value (fbLeftText + fbRightSpan).
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftText combined with fbRightSpan).
                    Return a new VNothing.
                When VTime (fbRightTime):
                    If fbOp equals "+":
                        Return a new VText with value (fbLeftText + fbRightTime).
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftText combined with fbRightTime).
                    Return a new VNothing.
                When VChar (fbRightChar):
                    If fbOp equals "+":
                        Return a new VText with value (fbLeftText + fbRightChar).
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftText combined with fbRightChar).
                    Return a new VNothing.
                Otherwise:
                    Return a new VNothing.
        When VBool (fbLeftBool):
            Inspect fbRight:
                When VInt (fbRightInt):
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftBool combined with fbRightInt).
                    Return a new VNothing.
                When VFloat (fbRightReal):
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftBool combined with fbRightReal).
                    Return a new VNothing.
                When VText (fbRightText):
                    If fbOp equals "+":
                        Return a new VText with value (fbLeftBool + fbRightText).
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftBool combined with fbRightText).
                    Return a new VNothing.
                When VBool (fbRightBool):
                    If fbOp equals "&":
                        Return a new VBool with value (fbLeftBool & fbRightBool).
                    If fbOp equals "^":
                        Return a new VBool with value (fbLeftBool xor fbRightBool).
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftBool combined with fbRightBool).
                    If fbOp equals "|":
                        Return a new VBool with value (fbLeftBool | fbRightBool).
                    If fbOp equals "==":
                        Return a new VBool with value (fbLeftBool equals fbRightBool).
                    If fbOp equals "!=":
                        Return a new VBool with value (fbLeftBool is not fbRightBool).
                    If fbOp equals "&&":
                        Return a new VBool with value (fbLeftBool and fbRightBool).
                    If fbOp equals "||":
                        Return a new VBool with value (fbLeftBool or fbRightBool).
                    Return a new VNothing.
                When VDuration (fbRightDuration):
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftBool combined with fbRightDuration).
                    Return a new VNothing.
                When VDate (fbRightDate):
                    If fbOp equals "combined with":
                        Return a new VText with value (fbLeftBool combined with fbRightDate).
                    Return a new VNothing.
