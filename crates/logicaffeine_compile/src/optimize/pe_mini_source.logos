        When CAwaitMessage (sk59x0):
            Let mutable sk59k be "CAwaitMessage".
            Set sk59k to keyJoinM(sk59k, sk59x0).
            Return sk59k.
        When CListen (sk60x0, sk60x1):
            Let mutable sk60k be "CListen".
            Set sk60k to keyJoinM(sk60k, exprToKeyPartM(sk60x0)).
            Set sk60k to keyJoinM(sk60k, sk60x1).
            Return sk60k.
        When CConnectTo (sk61x0, sk61x1):
            Let mutable sk61k be "CConnectTo".
            Set sk61k to keyJoinM(sk61k, exprToKeyPartM(sk61x0)).
