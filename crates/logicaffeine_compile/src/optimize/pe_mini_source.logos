        When CAppendToSeq (sk41x0, sk41x1):
            Let mutable sk41k be "CAppendToSeq".
            Set sk41k to keyJoinM(sk41k, sk41x0).
            Set sk41k to keyJoinM(sk41k, exprToKeyPartM(sk41x1)).
            Return sk41k.
        When CResolve (sk42x0):
            Let mutable sk42k be "CResolve".
            Set sk42k to keyJoinM(sk42k, sk42x0).
            Return sk42k.
        When CResolveTo (sk43x0, sk43x1):
            Let mutable sk43k be "CResolveTo".
            Set sk43k to keyJoinM(sk43k, sk43x0).
            Set sk43k to keyJoinM(sk43k, exprToKeyPartM(sk43x1)).
            Return sk43k.
        When CSync (sk44x0, sk44x1):
            Let mutable sk44k be "CSync".
            Set sk44k to keyJoinM(sk44k, sk44x0).
            Set sk44k to keyJoinM(sk44k, exprToKeyPartM(sk44x1)).
            Return sk44k.
        When CMount (sk45x0, sk45x1):
            Let mutable sk45k be "CMount".
            Set sk45k to keyJoinM(sk45k, sk45x0).
            Set sk45k to keyJoinM(sk45k, exprToKeyPartM(sk45x1)).
            Return sk45k.
        When CConcurrent (sk46x0):
            Let mutable sk46k be "CConcurrent".
            Set sk46k to keyJoinM(sk46k, blocksToKeyPartM(sk46x0)).
            Return sk46k.
        When CParallel (sk47x0):
            Let mutable sk47k be "CParallel".
            Set sk47k to keyJoinM(sk47k, blocksToKeyPartM(sk47x0)).
            Return sk47k.
        When CLaunchTask (sk48x0, sk48x1):
            Let mutable sk48k be "CLaunchTask".
            Set sk48k to keyJoinM(sk48k, stmtsToKeyPartM(sk48x0)).
            Set sk48k to keyJoinM(sk48k, sk48x1).
            Return sk48k.
        When CStopTask (sk49x0):
            Let mutable sk49k be "CStopTask".
            Set sk49k to keyJoinM(sk49k, exprToKeyPartM(sk49x0)).
            Return sk49k.
        When CSelect (sk50x0):
            Let mutable sk50k be "CSelect".
            Set sk50k to keyJoinM(sk50k, branchesToKeyPartM(sk50x0)).
            Return sk50k.
        When CCreatePipe (sk51x0, sk51x1):
            Let mutable sk51k be "CCreatePipe".
            Set sk51k to keyJoinM(sk51k, sk51x0).
            Set sk51k to keyJoinM(sk51k, exprToKeyPartM(sk51x1)).
            Return sk51k.
        When CSendPipe (sk52x0, sk52x1):
            Let mutable sk52k be "CSendPipe".
            Set sk52k to keyJoinM(sk52k, sk52x0).
            Set sk52k to keyJoinM(sk52k, exprToKeyPartM(sk52x1)).
            Return sk52k.
        When CReceivePipe (sk53x0, sk53x1):
            Let mutable sk53k be "CReceivePipe".
            Set sk53k to keyJoinM(sk53k, sk53x0).
            Set sk53k to keyJoinM(sk53k, sk53x1).
            Return sk53k.
        When CTrySendPipe (sk54x0, sk54x1):
            Let mutable sk54k be "CTrySendPipe".
            Set sk54k to keyJoinM(sk54k, sk54x0).
            Set sk54k to keyJoinM(sk54k, exprToKeyPartM(sk54x1)).
