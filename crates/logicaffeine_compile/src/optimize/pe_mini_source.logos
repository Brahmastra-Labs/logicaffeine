            Return sk27k.
        When CSleep (sk28x0):
            Let mutable sk28k be "CSleep".
            Set sk28k to keyJoinM(sk28k, exprToKeyPartM(sk28x0)).
            Return sk28k.
        When CReadConsole (sk29x0):
            Let mutable sk29k be "CReadConsole".
            Set sk29k to keyJoinM(sk29k, sk29x0).
            Return sk29k.
        When CReadFile (sk30x0, sk30x1):
            Let mutable sk30k be "CReadFile".
            Set sk30k to keyJoinM(sk30k, exprToKeyPartM(sk30x0)).
            Set sk30k to keyJoinM(sk30k, sk30x1).
            Return sk30k.
        When CWriteFile (sk31x0, sk31x1):
            Let mutable sk31k be "CWriteFile".
            Set sk31k to keyJoinM(sk31k, exprToKeyPartM(sk31x0)).
            Set sk31k to keyJoinM(sk31k, exprToKeyPartM(sk31x1)).
            Return sk31k.
        When CCheck (sk32x0, sk32x1):
            Let mutable sk32k be "CCheck".
            Set sk32k to keyJoinM(sk32k, exprToKeyPartM(sk32x0)).
            Set sk32k to keyJoinM(sk32k, exprToKeyPartM(sk32x1)).
            Return sk32k.
        When CCheckPolicy (sk33x0, sk33x1, sk33x2, sk33x3, sk33x4, sk33x5):
            Let mutable sk33k be "CCheckPolicy".
            Set sk33k to keyJoinM(sk33k, sk33x0).
            Set sk33k to keyJoinM(sk33k, sk33x1).
            Set sk33k to keyJoinM(sk33k, "{sk33x2}").
            Set sk33k to keyJoinM(sk33k, sk33x3).
            Set sk33k to keyJoinM(sk33k, alternativesToKeyPartM(sk33x4)).
            Set sk33k to keyJoinM(sk33k, sk33x5).
            Return sk33k.
        When CAssert (sk34x0):
            Let mutable sk34k be "CAssert".
            Set sk34k to keyJoinM(sk34k, exprToKeyPartM(sk34x0)).
            Return sk34k.
        When CTrust (sk35x0, sk35x1):
            Let mutable sk35k be "CTrust".
            Set sk35k to keyJoinM(sk35k, exprToKeyPartM(sk35x0)).
            Set sk35k to keyJoinM(sk35k, sk35x1).
            Return sk35k.
        When CRequire (sk36x0):
            Let mutable sk36k be "CRequire".
            Set sk36k to keyJoinM(sk36k, sk36x0).
            Return sk36k.
        When CMerge (sk37x0, sk37x1):
            Let mutable sk37k be "CMerge".
            Set sk37k to keyJoinM(sk37k, sk37x0).
            Set sk37k to keyJoinM(sk37k, exprToKeyPartM(sk37x1)).
            Return sk37k.
        When CJoin (sk38x0, sk38x1):
            Let mutable sk38k be "CJoin".
            Set sk38k to keyJoinM(sk38k, sk38x0).
            Set sk38k to keyJoinM(sk38k, exprToKeyPartM(sk38x1)).
            Return sk38k.
        When CIncrease (sk39x0, sk39x1):
            Let mutable sk39k be "CIncrease".
            Set sk39k to keyJoinM(sk39k, sk39x0).
