# The specializer's operators end.

## To checkLiteralM (e: CExpr) -> Bool:
    Inspect e:
        When CInt (v):
            Return true.
        When CBool (v):
            Return true.
        When CText (v):
            Return true.
        When CDuration (litAtomDuration):
            Return true.
        When CDate (litAtomDate):
            Return true.
        When CMoment (litAtomMoment):
            Return true.
        When CSpan (litAtomSpan):
            Return true.
        When CTime (litAtomTime):
            Return true.
        When CChar (litAtomChar):
            Return true.
        Otherwise:
            Return false.

# The memo keys: every value and statement keyed by its whole structure.
## To keyJoinM (acc: Text) and (part: Text) -> Text:
    Let n be length of part.
    Return "{acc}_{n}_{part}".


## To exprToKeyPartM (e: CExpr) -> Text:
    Inspect e:
        When CInt (v):
            Return "i{v}".
        When CBool (v):
            If v:
                Return "btrue".
            Return "bfalse".
        When CText (v):
            Return "t{v}".
        When CFloat (v):
            Return "f{v}".
        When CList (items):
            Let mutable parts be "l".
            Repeat for elem in items:
                Let ep be exprToKeyPartM(elem).
                Set parts to keyJoinM(parts, ep).
            Return parts.
        When CNewVariant (tag, names, vals):
            Let mutable parts be keyJoinM(keyJoinM("v", tag), textsToKeyPartM(names)).
            Repeat for fv in vals:
                Let vp be exprToKeyPartM(fv).
                Set parts to keyJoinM(parts, vp).
            Return parts.
        When CTuple (items):
            Let mutable parts be "tp".
            Repeat for elem in items:
                Let ep be exprToKeyPartM(elem).
                Set parts to keyJoinM(parts, ep).
            Return parts.
        When COptionSome (inner):
            Let ip be exprToKeyPartM(inner).
            Return keyJoinM("s", ip).
        When COptionNone:
            Return "none".
        When CNothing:
            Return "nothing".
        When CDeclaredDefault (kpDefaultType):
            Return keyJoinM("default", kpDefaultType).
        When CSpelled (kpSpelledCode, kpSpelledAwaits):
            Return keyJoinM(keyJoinM("spelled", kpSpelledCode), kpSpelledAwaits).
        When CNewSeq (peSeqElem7):
            Return keyJoinM("seq", peSeqElem7).
        When CNewSet (peSetElem6):
            Return keyJoinM("set", peSetElem6).
        When CVar (varName):
            Return "var{varName}".
        When CBinOp (op, left, right):
            Let lp be exprToKeyPartM(left).
            Let rp be exprToKeyPartM(right).
            Let opTag be "op{op}".
            Let s1 be keyJoinM(opTag, lp).
            Return keyJoinM(s1, rp).
        When CNot (inner):
            Let ip be exprToKeyPartM(inner).
            Return keyJoinM("nt", ip).
        When CCall (fnName, args):
            Let mutable parts be "call{fnName}".
            Repeat for a in args:
                Let ap be exprToKeyPartM(a).
                Set parts to keyJoinM(parts, ap).
            Return parts.
        When CIndex (coll, idx):
            Let cp be exprToKeyPartM(coll).
            Let ip be exprToKeyPartM(idx).
            Let s1 be keyJoinM("idx", cp).
            Return keyJoinM(s1, ip).
        When CLen (target):
            Let tp be exprToKeyPartM(target).
            Return keyJoinM("len", tp).
        When CMapGet (mapExpr, key):
            Let mp be exprToKeyPartM(mapExpr).
            Let kp be exprToKeyPartM(key).
            Let s1 be keyJoinM("mg", mp).
            Return keyJoinM(s1, kp).
        When CFieldAccess (target, field):
            Let tp be exprToKeyPartM(target).
            Let s1 be keyJoinM("fa", field).
            Return keyJoinM(s1, tp).
        When CNew (typeName, fieldNames, fieldExprs):
            Let mutable parts be keyJoinM(keyJoinM("nw", typeName), textsToKeyPartM(fieldNames)).
            Repeat for fv in fieldExprs:
                Let vp be exprToKeyPartM(fv).
                Set parts to keyJoinM(parts, vp).
            Return parts.
        When CRange (start, end):
            Let sp be exprToKeyPartM(start).
            Let ep be exprToKeyPartM(end).
            Let s1 be keyJoinM("r", sp).
            Return keyJoinM(s1, ep).
        When CSlice (coll, startIdx, endIdx):
            Let cp be exprToKeyPartM(coll).
            Let sp be exprToKeyPartM(startIdx).
            Let ep be exprToKeyPartM(endIdx).
            Let s1 be keyJoinM("sl", cp).
            Let s2 be keyJoinM(s1, sp).
            Return keyJoinM(s2, ep).
        When CCopy (target):
            Let tp be exprToKeyPartM(target).
            Return keyJoinM("cp", tp).
        When CContains (coll, elem):
            Let cp be exprToKeyPartM(coll).
            Let ep be exprToKeyPartM(elem).
            Let s1 be keyJoinM("ct", cp).
            Return keyJoinM(s1, ep).
        When CUnion (left, right):
            Let lp be exprToKeyPartM(left).
            Let rp be exprToKeyPartM(right).
            Let s1 be keyJoinM("un", lp).
            Return keyJoinM(s1, rp).
        When CIntersection (left, right):
            Let lp be exprToKeyPartM(left).
            Let rp be exprToKeyPartM(right).
            Let s1 be keyJoinM("ix", lp).
            Return keyJoinM(s1, rp).
        When CClosure (params, body, captured):
            Return keyJoinM(keyJoinM(keyJoinM("cl", textsToKeyPartM(params)), stmtsToKeyPartM(body)), textsToKeyPartM(captured)).
        When CCallExpr (target, args):
            Let tp be exprToKeyPartM(target).
            Return keyJoinM(keyJoinM("ce", tp), exprsToKeyPartM(args)).
        When CInterpolatedString (parts):
            Let mutable ps be "is".
            Repeat for p in parts:
                Inspect p:
                    When CLiteralPart (litVal):
                        Let litTag be "lt{litVal}".
                        Set ps to keyJoinM(ps, litTag).
                    When CExprPart (epExpr):
                        Let pp be exprToKeyPartM(epExpr).
                        Set ps to keyJoinM(ps, pp).
                    When CFormattedPart (fpkExpr, fpkSpec, fpkForm, fpkSize):
                        Let fpkTag be "fs{fpkSpec}".
                        Set ps to keyJoinM(ps, fpkTag).
                        Let fpkPart be exprToKeyPartM(fpkExpr).
                        Set ps to keyJoinM(ps, fpkPart).
            Return ps.
        When CDuration (kpDuration):
            Return keyJoinM("duration", format_timestamp(1970-01-01 at 12:00am + kpDuration)).
        When CDate (kpDate):
            Return keyJoinM("date", "{kpDate}").
        When CMoment (kpMoment):
            Return keyJoinM("moment", format_timestamp(kpMoment)).
        When CSpan (kpSpan):
            Return keyJoinM("span", "{kpSpan}").
        When CTime (kpTime):
            Return keyJoinM("time", "{kpTime}").
        When CChar (kpChar):
            Return keyJoinM("char", "{kpChar}").
        When CTimeNow:
            Return "tnow".
        When CDateToday:
            Return "today".
        When CEscExpr (code):
            Return keyJoinM("esc", code).
        When CManifestOf (ek0x0):
            Let mutable ek0k be "CManifestOf".
            Set ek0k to keyJoinM(ek0k, exprToKeyPartM(ek0x0)).
            Return ek0k.
        When CChunkAt (ek1x0, ek1x1):
            Let mutable ek1k be "CChunkAt".
            Set ek1k to keyJoinM(ek1k, exprToKeyPartM(ek1x0)).
            Set ek1k to keyJoinM(ek1k, exprToKeyPartM(ek1x1)).
            Return ek1k.
        Otherwise:
            Return "unk".

## To stmtToKeyPartM (sk: CStmt) -> Text:
    Inspect sk:
        When CLet (sk0x0, sk0x1):
            Let mutable sk0k be "CLet".
