# The declared defaults: generated by optimize::core_defaults from interpreter::DECLARED_DEFAULTS.
## To coreDeclaredDefault (typeName: Text) -> CVal:
    Let nameLength be length of typeName.
    If nameLength equals 3:
        If (typeName equals "RGA"):
            Return a new VCrdt with kind "SharedSequence" and state a new Map of Text to CVal.
        If (typeName equals "Int"):
            Return a new VInt with value 0.
        If (typeName equals "Map"):
            Return a new VMap with entries a new Map of Text to CVal.
        If (typeName equals "Seq"):
            Return a new VSeq with items a new Seq of CVal.
        If (typeName equals "Set"):
            Return a new VSet with items a new Seq of CVal.
    If nameLength equals 4:
        If (typeName equals "Bool"):
            Return a new VBool with value false.
        If (typeName equals "Char"):
            Return a new VChar with value `\0`.
        If (typeName equals "View") or (typeName equals "Byte"):
            Return a new VInt with value 0.
        If (typeName equals "List"):
            Return a new VSeq with items a new Seq of CVal.
        If (typeName equals "Text"):
            Return a new VText with value "".
    If nameLength equals 5:
        If (typeName equals "Tally"):
            Return a new VCrdt with kind "Tally" and state a new Map of Text to CVal.
        If (typeName equals "ORSet") or (typeName equals "ORMap"):
            Return a new VError with msg "the self-interpreter holds no `{typeName}`: it awaits the CRDT family".
        If (typeName equals "Float"):
            Return a new VFloat with value 0.0.
        If (typeName equals "Event"):
            Return a new VInt with value 0.
    If nameLength equals 6:
        If (typeName equals "String"):
            Return a new VText with value "".
    If nameLength equals 7:
        If (typeName equals "Element"):
            Return a new VInt with value 0.
        If (typeName equals "HashMap"):
            Return a new VMap with entries a new Map of Text to CVal.
        If (typeName equals "HashSet"):
            Return a new VSet with items a new Seq of CVal.
    If nameLength equals 8:
        If (typeName equals "GCounter"):
            Return a new VCrdt with kind "ConvergentCount" and state a new Map of Text to CVal.
    If nameLength equals 9:
        If (typeName equals "PNCounter"):
            Return a new VCrdt with kind "Tally" and state a new Map of Text to CVal.
        If (typeName equals "SharedSet") or (typeName equals "SharedMap"):
            Return a new VError with msg "the self-interpreter holds no `{typeName}`: it awaits the CRDT family".
    If nameLength equals 14:
        If (typeName equals "SharedSequence"):
            Return a new VCrdt with kind "SharedSequence" and state a new Map of Text to CVal.
    If nameLength equals 15:
        If (typeName equals "ConvergentCount"):
            Return a new VCrdt with kind "ConvergentCount" and state a new Map of Text to CVal.
    If nameLength equals 17:
        If (typeName equals "SharedSet_AddWins"):
            Return a new VError with msg "the self-interpreter holds no `{typeName}`: it awaits the CRDT family".
    If nameLength equals 19:
        If (typeName equals "SharedSequence_YATA"):
            Return a new VCrdt with kind "SharedSequence" and state a new Map of Text to CVal.
    If nameLength equals 20:
        If (typeName equals "SharedSet_RemoveWins"):
            Return a new VError with msg "the self-interpreter holds no `{typeName}`: it awaits the CRDT family".
    If nameLength equals 21:
        If (typeName equals "CollaborativeSequence"):
            Return a new VCrdt with kind "SharedSequence" and state a new Map of Text to CVal.
    Return a new VNothing.
# The declared defaults end.

## To coreIsAggregate (agV: CVal) -> Bool:
    Inspect agV:
        When VSeq (agSeq):
            Return true.
        When VSet (agSet):
            Return true.
        When VMap (agMap):
            Return true.
        When VStruct (agTn, agFields):
            Return true.
        When VTuple (agTuple):
            Return true.
        When VVariant (agTy, agVn, agFs):
            Return true.
        Otherwise:
            Return false.

## To coreShared (shEnv: Map of Text to CVal) and (shName: Text) -> Bool:
    Let shKey be "&{shName}".
    If shEnv contains shKey:
        Return coreTruthy(item shKey of shEnv).
    Return false.

## To coreSetShared (ssEnv: mutable Map of Text to CVal) and (ssName: Text) and (ssShared: Bool):
    Let ssKey be "&{ssName}".
    Set item ssKey of ssEnv to a new VBool with value ssShared.

## To coreBodyWrites (bwBody: Seq of CStmt) and (bwColl: CExpr) and (bwFuncs: Map of Text to CFunc) -> Bool:
    Inspect bwColl:
        When CVar (bwName):
            Return coreStmtsWrite(bwBody, bwName, bwFuncs).
        Otherwise:
            Return false.

## To coreStmtsWrite (swStmts: Seq of CStmt) and (swName: Text) and (swFuncs: Map of Text to CFunc) -> Bool:
    Repeat for swS in swStmts:
        If coreStmtWrites(swS, swName, swFuncs):
            Return true.
    Return false.

## To coreCallWrites (cwFn: Text) and (cwArgs: Seq of CExpr) and (cwName: Text) and (cwFuncs: Map of Text to CFunc) -> Bool:
    If not (cwFuncs contains cwFn):
        Return false.
    Let cwFunc be item cwFn of cwFuncs.
    Inspect cwFunc:
        When CFuncDef (cwDn, cwParams, cwTypes, cwRet, cwBody):
            Let mutable cwI be 1.
            Repeat for cwA in cwArgs:
                If cwI is at most (length of cwTypes):
                    If (item cwI of cwTypes) contains "mutable":
                        Inspect cwA:
                            When CVar (cwAv):
                                If cwAv equals cwName:
                                    Return true.
                            Otherwise:
                                Let cwSkipA be true.
                Set cwI to cwI + 1.
        Otherwise:
            Let cwSkipF be true.
    Return false.

## To coreHeadWrites (hwE: CExpr) and (hwName: Text) and (hwFuncs: Map of Text to CFunc) -> Bool:
    Inspect hwE:
        When CCall (hwFn, hwArgs):
            Return coreCallWrites(hwFn, hwArgs, hwName, hwFuncs).
        Otherwise:
            Return false.

## To coreStmtWrites (wS: CStmt) and (wName: Text) and (wFuncs: Map of Text to CFunc) -> Bool:
    Inspect wS:
        When CLet (wLn, wLe):
            Return coreHeadWrites(wLe, wName, wFuncs).
        When CSet (wSn, wSe):
            If wSn equals wName:
                Return true.
            Return coreHeadWrites(wSe, wName, wFuncs).
        When CShow (wShown):
            Return coreHeadWrites(wShown, wName, wFuncs).
        When CPush (wPe, wPt):
            Return wPt equals wName.
        When CSetIdx (wXt, wXi, wXv):
            Return wXt equals wName.
        When CMapSet (wMt, wMk, wMv):
            Return wMt equals wName.
        When CPop (wPt2):
            Return wPt2 equals wName.
        When CPopInto (wPiT, wPiI):
            Return (wPiT equals wName) or (wPiI equals wName).
        When CAdd (wAe, wAt):
            Return wAt equals wName.
        When CRemove (wRe, wRt):
            Return wRt equals wName.
        When CSetField (wFt, wFf, wFv):
            Return wFt equals wName.
        When CCallS (wCn, wCa):
            Return coreCallWrites(wCn, wCa, wName, wFuncs).
        When CIf (wIc, wIt, wIe):
            If coreStmtsWrite(wIt, wName, wFuncs):
                Return true.
            Return coreStmtsWrite(wIe, wName, wFuncs).
        When CWhile (wWc, wWb):
            Return coreStmtsWrite(wWb, wName, wFuncs).
        When CRepeat (wRv, wRc, wRb):
            Return coreStmtsWrite(wRb, wName, wFuncs).
        When CRepeatRange (wQv, wQs, wQe, wQb):
            Return coreStmtsWrite(wQb, wName, wFuncs).
        When CInspect (wNt, wArms):
            Repeat for wArm in wArms:
                Inspect wArm:
                    When CWhen (wWn, wWbs, wWbody):
                        If coreStmtsWrite(wWbody, wName, wFuncs):
                            Return true.
                    When COtherwise (wOb):
                        If coreStmtsWrite(wOb, wName, wFuncs):
                            Return true.
            Return false.
        Otherwise:
            Return false.

## To coreShareRefs (srEnv: mutable Map of Text to CVal) and (srExpr: CExpr):
    Inspect srExpr:
        When CVar (srName):
            If srEnv contains srName:
                If coreIsAggregate(item srName of srEnv):
                    coreSetShared(srEnv, srName, true).
        When CList (srItems):
            Repeat for srItem in srItems:
                coreShareRefs(srEnv, srItem).
        When CTuple (srTuple):
            Repeat for srTx in srTuple:
                coreShareRefs(srEnv, srTx).
        When CNew (srTy, srFns, srFvs):
            Repeat for srFv in srFvs:
                coreShareRefs(srEnv, srFv).
        When CNewVariant (srTag, srVns, srVvs):
            Repeat for srVv in srVvs:
                coreShareRefs(srEnv, srVv).
        When COptionSome (srInner):
            coreShareRefs(srEnv, srInner).
        When CCall (srFn, srArgs):
            Repeat for srArg in srArgs:
                coreShareRefs(srEnv, srArg).
        When CCallExpr (srTarget, srCallArgs):
            Repeat for srCa in srCallArgs:
                coreShareRefs(srEnv, srCa).
        Otherwise:
            Let srSkip be true.

## To coreFreshExpr (feExpr: CExpr) -> Bool:
    Inspect feExpr:
        When CList (feItems):
            Return true.
        When CNewSeq (feSeqTy):
            Return true.
        When CNewSet (feSetTy):
            Return true.
        When CNew (feTy, feFns, feFvs):
            Return true.
        When CNewVariant (feTag, feVns, feVvs):
            Return true.
        When CTuple (feTuple):
            Return true.
        When COptionSome (feInner):
            Return true.
        Otherwise:
            Return false.

## To coreMarkBound (mbEnv: mutable Map of Text to CVal) and (mbName: Text):
    If mbEnv contains mbName:
        If coreIsAggregate(item mbName of mbEnv):
            coreSetShared(mbEnv, mbName, true).

## To coreKeysOf (kfEnv: Map of Text to CVal) -> Seq of Text:
    Let mutable kfOut be a new Seq of Text.
    Repeat for (kfK, kfV) in kfEnv:
        If not (kfK contains "&"):
            Push kfK to kfOut.
    Return kfOut.

## To coreScopeKeys (skEnv: Map of Text to CVal) and (skKeys: Seq of Text) -> Map of Text to CVal:
    Let mutable skOut be a new Map of Text to CVal.
    Repeat for skK in skKeys:
        If skEnv contains skK:
            Set item skK of skOut to item skK of skEnv.
        Let skMark be "&{skK}".
        If skEnv contains skMark:
            Set item skMark of skOut to item skMark of skEnv.
    Return skOut.

## To coreCallBody (cbBody: Seq of CStmt) and (cbEnv: Map of Text to CVal) and (cbFuncs: Map of Text to CFunc) and (cbParams: Seq of Text) -> CoreOut:
    Let cbOut be coreExecBlock(cbBody, cbEnv, cbFuncs).
    Let mutable cbKeys be copy of cbParams.
    Push "replicas()" to cbKeys.
    Return a new CoreReturn with result coreOutResult(cbOut) and env coreScopeKeys(coreOutEnv(cbOut), cbKeys).

## To coreExecBlock (stmts: Seq of CStmt) and (env0: Map of Text to CVal) and (funcs: Map of Text to CFunc) -> CoreOut:
    Let mutable env be env0.
    Repeat for s in stmts:
        Inspect s:
            When CLet (name, expr):
                Let letVal be coreEval(expr, env, funcs).
                If coreFails(letVal):
                    Fail with coreFailureText(letVal).
                If coreIsAggregate(letVal):
                    coreShareRefs(env, expr).
                Set item name of env to letVal.
                If coreIsAggregate(letVal):
                    coreSetShared(env, name, not coreFreshExpr(expr)).
            When CSet (name, expr):
                Let setVal be coreEval(expr, env, funcs).
                If coreFails(setVal):
                    Fail with coreFailureText(setVal).
                If not (env contains name):
                    Fail with "Undefined variable: {name}".
                If coreIsAggregate(setVal):
                    coreShareRefs(env, expr).
                Set item name of env to setVal.
                If coreIsAggregate(setVal):
                    coreSetShared(env, name, not coreFreshExpr(expr)).
            When CIf (cond, thenBlock, elseBlock):
                Let cv be coreEval(cond, env, funcs).
                If coreFails(cv):
                    Fail with coreFailureText(cv).
                If coreTruthy(cv):
                    Let ifKeys be coreKeysOf(env).
                    Let ifOut be coreExecBlock(thenBlock, env, funcs).
                    Set env to coreScopeKeys(coreOutEnv(ifOut), ifKeys).
                    If coreOutExits(ifOut):
                        Return coreWithEnv(ifOut, env).
                Otherwise:
                    Let elseKeys be coreKeysOf(env).
                    Let elseOut be coreExecBlock(elseBlock, env, funcs).
                    Set env to coreScopeKeys(coreOutEnv(elseOut), elseKeys).
                    If coreOutExits(elseOut):
                        Return coreWithEnv(elseOut, env).
            When CWhile (whileCond, whileBody):
                Let whileKeys be coreKeysOf(env).
                While true:
                    Let wcv be coreEval(whileCond, env, funcs).
                    If coreFails(wcv):
                        Fail with coreFailureText(wcv).
                    If not coreTruthy(wcv):
                        Break.
                    Let whileIterOut be coreExecBlock(whileBody, env, funcs).
                    Set env to coreScopeKeys(coreOutEnv(whileIterOut), whileKeys).
                    Inspect whileIterOut:
                        When CoreBreak (wbEnv):
                            Break.
                        When CoreReturn (wrVal, wrEnv):
                            Return a new CoreReturn with result wrVal and env env.
                        Otherwise:
                            Let skip be true.
            When CReturn (expr):
                Let retVal be coreEval(expr, env, funcs).
                If coreFails(retVal):
                    Fail with coreFailureText(retVal).
                Return a new CoreReturn with result retVal and env env.
            When CShow (expr):
                Let v be coreEval(expr, env, funcs).
                If coreFails(v):
                    Fail with coreFailureText(v).
                Let shown be valToText(v).
                Show shown.
            When CCallS (name, argExprs):
                Let argVals be a new Seq of CVal.
                Repeat for a in argExprs:
                    Let callArgVal be coreEval(a, env, funcs).
                    If coreFails(callArgVal):
                        Fail with coreFailureText(callArgVal).
                    Push callArgVal to argVals.
                Let csInFuncs be (funcs contains name).
                If csInFuncs:
                    Let func be item name of funcs.
                    Inspect func:
                        When CFuncDef (fname, params, fnParamTypes, fnReturnType, body):
                            Let callEnv be coreFrame(env).
                            Let mutable cidx be 1.
                            Repeat for p in params:
                                Set item p of callEnv to item cidx of argVals.
                                coreMarkBound(callEnv, p).
                                Set cidx to cidx + 1.
                            Let callOut be coreCallBody(body, callEnv, funcs, params).
                            coreTakeReplicas(coreOutEnv(callOut), env).
                            coreWriteBack(params, fnParamTypes, argExprs, coreOutEnv(callOut), env).
                        Otherwise:
                            Let skip be true.
                Otherwise:
                    If coreBuiltinKnown(name):
                        Let csBuiltin be coreBuiltin(name, argVals).
                        If coreFails(csBuiltin):
                            Fail with coreFailureText(csBuiltin).
                    Otherwise:
                        Let csInEnv be (env contains name).
                        If csInEnv:
                            Let envVal be item name of env.
                            Inspect envVal:
                                When VClosure (csParams, csBody, csCapturedEnv):
                                    Let mutable csCallEnv be coreClosureFrame(csCapturedEnv, env).
                                    Let mutable csCopyIdx be 1.
                                    While csCopyIdx is at most (length of csParams):
                                        If csCopyIdx is at most (length of argVals):
                                            Set item (item csCopyIdx of csParams) of csCallEnv to item csCopyIdx of argVals.
                                            coreMarkBound(csCallEnv, item csCopyIdx of csParams).
                                        Set csCopyIdx to csCopyIdx + 1.
                                    Let csOut be coreCallBody(csBody, csCallEnv, funcs, csParams).
                                    coreTakeReplicas(coreOutEnv(csOut), env).
                                Otherwise:
                                    Let skip be true.
            When CPush (valExpr, collName):
                Let v be coreEval(valExpr, env, funcs).
                If coreFails(v):
                    Fail with coreFailureText(v).
                If not (env contains collName):
                    Fail with "Undefined variable: {collName}".
                If coreIsAggregate(v):
                    coreShareRefs(env, valExpr).
                Let seq be item collName of env.
                Inspect seq:
                    When VSeq (items):
                        If coreShared(env, collName):
                            Let mutable mutItems be copy of items.
                            Push v to mutItems.
                            Set item collName of env to a new VSeq with items mutItems.
                            coreSetShared(env, collName, false).
                        Otherwise:
                            Let mutable ownItems be items.
                            Push v to ownItems.
                            Set item collName of env to a new VSeq with items ownItems.
                    Otherwise:
                        Fail with "Can only push to a List".
            When CSetIdx (collName, idxExpr, valExpr):
                Let iv be coreEval(idxExpr, env, funcs).
                If coreFails(iv):
                    Fail with coreFailureText(iv).
                Let v be coreEval(valExpr, env, funcs).
                If coreFails(v):
                    Fail with coreFailureText(v).
                If not (env contains collName):
                    Fail with "Undefined variable: {collName}".
                Let seq be item collName of env.
                Inspect seq:
                    When VSeq (items):
                        Inspect iv:
                            When VInt (i):
                                If (i equals 0) or (i is greater than (length of items)) or (i is less than (0 - (length of items))):
                                    Fail with "Index {i} out of bounds".
                                If coreIsAggregate(v):
                                    coreShareRefs(env, valExpr).
                                If coreShared(env, collName):
                                    Let mutable mutItems be copy of items.
                                    Set item i of mutItems to v.
                                    Set item collName of env to a new VSeq with items mutItems.
                                    coreSetShared(env, collName, false).
                                Otherwise:
                                    Let mutable ownItems be items.
                                    Set item i of ownItems to v.
                                    Set item collName of env to a new VSeq with items ownItems.
                            Otherwise:
                                Fail with "List index must be an integer".
                    When VMap (mapData):
                        If coreIsAggregate(v):
                            coreShareRefs(env, valExpr).
                        Set item collName of env to a new VMap with entries coreMapSet(mapData, iv, v).
                    Otherwise:
                        Let setIndexedName be coreTypeName(seq).
                        Fail with "Cannot index into {setIndexedName}".
            When CMapSet (mapName, keyExpr, valExpr):
                Let kv be coreEval(keyExpr, env, funcs).
                If coreFails(kv):
                    Fail with coreFailureText(kv).
                Let v be coreEval(valExpr, env, funcs).
                If coreFails(v):
                    Fail with coreFailureText(v).
                If not (env contains mapName):
                    Fail with "Undefined variable: {mapName}".
                Let mv be item mapName of env.
                Inspect mv:
                    When VSeq (msItems):
                        Inspect kv:
                            When VInt (msAt):
                                If (msAt equals 0) or (msAt is greater than (length of msItems)) or (msAt is less than (0 - (length of msItems))):
                                    Fail with "Index {msAt} out of bounds".
                                If coreIsAggregate(v):
                                    coreShareRefs(env, valExpr).
                                If coreShared(env, mapName):
                                    Let mutable msMutItems be copy of msItems.
                                    Set item msAt of msMutItems to v.
                                    Set item mapName of env to a new VSeq with items msMutItems.
                                    coreSetShared(env, mapName, false).
                                Otherwise:
                                    Let mutable msOwnItems be msItems.
                                    Set item msAt of msOwnItems to v.
                                    Set item mapName of env to a new VSeq with items msOwnItems.
                            Otherwise:
                                Fail with "List index must be an integer".
                    When VMap (mapData):
                        If coreIsAggregate(v):
                            coreShareRefs(env, valExpr).
                        Set item mapName of env to a new VMap with entries coreMapSet(mapData, kv, v).
                    Otherwise:
                        Let msIndexedName be coreTypeName(mv).
                        Fail with "Cannot index into {msIndexedName}".
            When CPop (popTarget):
                If not (env contains popTarget):
                    Fail with "Undefined variable: {popTarget}".
                Let seq be item popTarget of env.
                Inspect seq:
                    When VSeq (seqItems):
                        Let seqLen be length of seqItems.
                        If seqLen equals 0:
                            Fail with "Cannot pop from {popTarget}: it is empty".
                        If seqLen is greater than 0:
                            Let mutable newItems be a new Seq of CVal.
                            Let mutable pi be 1.
                            While pi is less than seqLen:
                                Push item pi of seqItems to newItems.
                                Set pi to pi + 1.
                            Set item popTarget of env to a new VSeq with items newItems.
                    Otherwise:
                        Let popLength be coreLengthOf(seq).
                        Inspect popLength:
                            When VError (popLengthMsg):
                                Fail with popLengthMsg.
                            Otherwise:
                                Fail with "Can only pop from a List".
            When CPopInto (piTarget, piInto):
                If not (env contains piTarget):
                    Fail with "Undefined variable: {piTarget}".
                Let piSeq be item piTarget of env.
                Inspect piSeq:
                    When VSeq (piItems):
                        Let piLen be length of piItems.
                        If piLen equals 0:
                            Fail with "Cannot pop from {piTarget}: it is empty".
                        Let mutable piKept be a new Seq of CVal.
                        Let mutable piAt be 1.
                        While piAt is less than piLen:
                            Push item piAt of piItems to piKept.
                            Set piAt to piAt + 1.
                        Set item piInto of env to item piLen of piItems.
                        coreMarkBound(env, piInto).
                        Set item piTarget of env to a new VSeq with items piKept.
                    Otherwise:
                        Let piLength be coreLengthOf(piSeq).
                        Inspect piLength:
                            When VError (piLengthMsg):
                                Fail with piLengthMsg.
                            Otherwise:
                                Fail with "Can only pop from a List".
            When CAdd (addElem, addTarget):
                Let addValHolder be a new Seq of CVal.
                Let addVal be coreEval(addElem, env, funcs).
                If coreFails(addVal):
                    Fail with coreFailureText(addVal).
                Push addVal to addValHolder.
                If not (env contains addTarget):
                    Fail with "Undefined variable: {addTarget}".
                Let addColl be item addTarget of env.
                Inspect addColl:
                    When VSet (addItems):
                        If not coreSetHolds(addItems, item 1 of addValHolder):
                            If coreIsAggregate(item 1 of addValHolder):
                                coreShareRefs(env, addElem).
                            If coreShared(env, addTarget):
                                Let mutable addNew be copy of addItems.
                                Push item 1 of addValHolder to addNew.
                                Set item addTarget of env to a new VSet with items addNew.
                                coreSetShared(env, addTarget, false).
                            Otherwise:
                                Let mutable addOwn be addItems.
                                Push item 1 of addValHolder to addOwn.
                                Set item addTarget of env to a new VSet with items addOwn.
                    Otherwise:
                        Fail with "Can only add to a Set".
            When CRemove (remElem, remTarget):
                Let remVal be coreEval(remElem, env, funcs).
                If coreFails(remVal):
                    Fail with coreFailureText(remVal).
                If not (env contains remTarget):
                    Fail with "Undefined variable: {remTarget}".
                Let remColl be item remTarget of env.
                Inspect remColl:
                    When VMap (remEntries):
                        Let remKey be coreMapKey(remVal).
                        Let mutable remLeft be copy of remEntries.
                        If remLeft contains remKey:
                            Remove remKey from remLeft.
                        Set item remTarget of env to a new VMap with entries remLeft.
                    When VSet (remItems):
                        Let mutable remNew be a new Seq of CVal.
                        Repeat for remItem in remItems:
                            If not coreEquals(remItem, remVal):
                                Push remItem to remNew.
                        Set item remTarget of env to a new VSet with items remNew.
                    Otherwise:
                        Fail with "Can only remove from a Set or Map".
            When CSetField (sfTarget, sfField, sfValExpr):
                Let sfVal be coreEval(sfValExpr, env, funcs).
                If coreFails(sfVal):
                    Fail with coreFailureText(sfVal).
                If not (env contains sfTarget):
                    Fail with "Undefined variable: {sfTarget}".
                Let sfObj be item sfTarget of env.
                Inspect sfObj:
                    When VStruct (sfTypeName, sfFields):
                        If coreIsAggregate(sfVal):
                            coreShareRefs(env, sfValExpr).
                        If coreShared(env, sfTarget):
                            Let mutable sfMut be copy of sfFields.
                            Set item sfField of sfMut to sfVal.
                            Set item sfTarget of env to a new VStruct with typeName sfTypeName and fields sfMut.
                            coreSetShared(env, sfTarget, false).
                        Otherwise:
                            Let mutable sfOwn be sfFields.
                            Set item sfField of sfOwn to sfVal.
                            Set item sfTarget of env to a new VStruct with typeName sfTypeName and fields sfOwn.
                    When VMap (sfMapData):
                        Let mutable sfMutMap be copy of sfMapData.
                        Set item sfField of sfMutMap to sfVal.
                        Set item sfTarget of env to a new VMap with entries sfMutMap.
                    Otherwise:
                        Fail with "Cannot set field on non-struct value".
            When CAtPath (apRoot, apPath, apBody):
                If not (env contains apRoot):
                    Fail with "Undefined variable: {apRoot}".
                Let mutable apHolders be a new Seq of CVal.
                Let mutable apHere be item apRoot of env.
                Let mutable apPlace be apRoot.
                Repeat for apField in apPath:
                    Push apHere to apHolders.
                    Let apNext be coreFieldOf(apHere, apField).
                    If coreFails(apNext):
                        Fail with coreFailureText(apNext).
                    Set apHere to apNext.
                    Set apPlace to "{apPlace}'s {apField}".
                Set item apPlace of env to apHere.
                Let apOut be coreExecBlock(apBody, env, funcs).
                If coreOutExits(apOut):
                    Return apOut.
                Set env to coreOutEnv(apOut).
                Let mutable apValue be item apPlace of env.
                Remove apPlace from env.
                Let mutable apDepth be length of apPath.
                While apDepth is at least 1:
                    Set apValue to coreWithField(item apDepth of apHolders, item apDepth of apPath, apValue).
                    Set apDepth to apDepth - 1.
                Set item apRoot of env to apValue.
            When CStructDef (sdName, sdFieldNames):
                Let skip be true.
            When CEnumDef (edName, edVariants):
                Let skip be true.
            When CInspect (inspTarget, inspArms):
                Let inspVal be coreEval(inspTarget, env, funcs).
                If coreFails(inspVal):
                    Fail with coreFailureText(inspVal).
                Let mutable inspTag be "".
                Let mutable inspFields be a new Seq of CVal.
                Let mutable inspNamedFields be a new Map of Text to CVal.
                Let mutable inspIsMap be false.
                Inspect inspVal:
                    When VVariant (ivt, ivn, ivf):
                        Set inspTag to ivn.
                        Set inspFields to ivf.
                    When VOption (ioInner, ioPresent):
                        If ioPresent:
                            Set inspTag to "Some".
                            Push ioInner to inspFields.
                        Otherwise:
                            Set inspTag to "None".
                    When VMap (mapData):
                        Set inspIsMap to true.
                        Let tagEntry be item "__tag" of mapData.
                        Inspect tagEntry:
                            When VText (tagStr):
                                Set inspTag to tagStr.
                            Otherwise:
                                Let skip be true.
                        Set inspNamedFields to mapData.
                    Otherwise:
                        Let skip be true.
                Let inspKeys be coreKeysOf(env).
                Let mutable inspMatched be false.
                Repeat for arm in inspArms:
                    If not inspMatched:
                        Inspect arm:
                            When CWhen (armName, armBindings, armBody):
                                If armName equals inspTag:
                                    Set inspMatched to true.
                                    If inspIsMap:
                                        Let fnamesEntry be item "__fnames__" of inspNamedFields.
                                        Let mutable inspFnameSeq be a new Seq of CVal.
                                        Inspect fnamesEntry:
                                            When VSeq (fnameItems):
                                                Set inspFnameSeq to fnameItems.
                                            Otherwise:
                                                Let skip be true.
                                        Let mutable abiM be 1.
                                        While abiM is at most (length of armBindings):
                                            If abiM is at most (length of inspFnameSeq):
                                                Let fnameVal be item abiM of inspFnameSeq.
                                                Let mutable fnameStr be "".
                                                Inspect fnameVal:
                                                    When VText (fns):
                                                        Set fnameStr to fns.
                                                    Otherwise:
                                                        Let skip be true.
                                                Let abLookup be item fnameStr of inspNamedFields.
                                                Set item (item abiM of armBindings) of env to abLookup.
                                                coreMarkBound(env, item abiM of armBindings).
                                            Set abiM to abiM + 1.
                                    Otherwise:
                                        Let mutable abi2 be 1.
                                        While abi2 is at most (length of armBindings):
                                            If abi2 is at most (length of inspFields):
                                                Set item (item abi2 of armBindings) of env to item abi2 of inspFields.
                                                coreMarkBound(env, item abi2 of armBindings).
                                            Set abi2 to abi2 + 1.
                                    Let armOut be coreExecBlock(armBody, env, funcs).
                                    Set env to coreScopeKeys(coreOutEnv(armOut), inspKeys).
                                    If coreOutExits(armOut):
                                        Return coreWithEnv(armOut, env).
                            When COtherwise (owBody):
                                If not inspMatched:
                                    Set inspMatched to true.
                                    Let owOut be coreExecBlock(owBody, env, funcs).
                                    Set env to coreScopeKeys(coreOutEnv(owOut), inspKeys).
                                    If coreOutExits(owOut):
                                        Return coreWithEnv(owOut, env).
            When CRepeat (repVar, repCollExpr, repBody):
                Let repCV be coreEval(repCollExpr, env, funcs).
                If coreFails(repCV):
                    Fail with coreFailureText(repCV).
                Let repRefusal be coreIterRefusal(repCV).
                If repRefusal is not "":
                    Fail with repRefusal.
                Let mutable repItems be coreIterItems(repCV).
                If coreBodyWrites(repBody, repCollExpr, funcs):
                    Set repItems to copy of repItems.
                Otherwise:
                    coreShareRefs(env, repCollExpr).
                Let repKeys be coreKeysOf(env).
                Repeat for repItem in repItems:
                    Let repKey be "{repVar}".
                    Set item repKey of env to repItem.
                    coreMarkBound(env, repKey).
                    Let repIterOut be coreExecBlock(repBody, env, funcs).
                    Set env to coreScopeKeys(coreOutEnv(repIterOut), repKeys).
                    Inspect repIterOut:
                        When CoreBreak (rbEnv):
                            Break.
                        When CoreReturn (rrVal, rrEnv):
                            Return a new CoreReturn with result rrVal and env env.
                        Otherwise:
                            Let skip be true.
            When CRepeatRange (rrVar, rrStartExpr, rrEndExpr, rrBody):
                Let rrSV be coreEval(rrStartExpr, env, funcs).
                If coreFails(rrSV):
                    Fail with coreFailureText(rrSV).
                Let rrEV be coreEval(rrEndExpr, env, funcs).
                If coreFails(rrEV):
                    Fail with coreFailureText(rrEV).
                Inspect rrSV:
                    When VInt (rrStart):
                        Inspect rrEV:
                            When VInt (rrEnd):
                                Let rrKeys be coreKeysOf(env).
                                Repeat for rrI from rrStart to rrEnd:
                                    Let rrKey be "{rrVar}".
                                    Set item rrKey of env to a new VInt with value rrI.
                                    Let rrIterOut be coreExecBlock(rrBody, env, funcs).
                                    Set env to coreScopeKeys(coreOutEnv(rrIterOut), rrKeys).
                                    Inspect rrIterOut:
                                        When CoreBreak (rgEnv):
                                            Break.
                                        When CoreReturn (rgVal, rgEnv):
                                            Return a new CoreReturn with result rgVal and env env.
                                        Otherwise:
                                            Let skip be true.
                            Otherwise:
                                Let skip be true.
                    Otherwise:
                        Let skip be true.
            When CBreak:
                Return a new CoreBreak with env env.
            When CRuntimeAssert (raCond, raMsg):
                coreHoldContract(raCond, raMsg, env, funcs).
            When CHardAssert (haCond, haMsg):
                coreHoldContract(haCond, haMsg, env, funcs).
            When CFail (failReason):
                Let failVal be coreEval(failReason, env, funcs).
                If coreFails(failVal):
                    Fail with coreFailureText(failVal).
                Fail with valToText(failVal).
            When CGive (giveExpr, giveTarget):
                Let giveVal be coreEval(giveExpr, env, funcs).
                If coreFails(giveVal):
                    Fail with coreFailureText(giveVal).
                Set item giveTarget of env to giveVal.
            When CEscStmt (escCode):
                Fail with "`Escape to Rust:` holds raw Rust code, which only the Rust backends compile. Use `largo build` or `largo run` to compile and run this program.".
            When CSleep (sleepDur):
                Let sleepVal be coreEval(sleepDur, env, funcs).
                If coreFails(sleepVal):
                    Fail with coreFailureText(sleepVal).
                Inspect sleepVal:
                    When VDuration (sleepDuration):
                        Sleep sleepDuration.
                    When VInt (sleepMillis):
                        Sleep sleepMillis.
                    Otherwise:
                        Let sleepType be coreTypeName(sleepVal).
                        Fail with "Sleep requires Duration or Int, got {sleepType}".
            When CReadConsole (rcTarget):
                Set item rcTarget of env to (a new VText with value "").
            When CReadFile (rfPath, rfTarget):
                Set item rfTarget of env to (a new VText with value "").
            When CWriteFile (wfPath, wfContent):
                Let skip be true.
            When CCheckPolicy (cpSubject, cpObject, cpCapability, cpRule, cpAlts, cpSource):
                If not (env contains cpSubject):
                    Fail with "Undefined variable: {cpSubject}".
                Let cpSubjectVal be item cpSubject of env.
                Let mutable cpObjectVal be a new VNothing.
                If cpCapability and (cpObject is not ""):
                    If not (env contains cpObject):
                        Fail with "Undefined variable: {cpObject}".
                    Set cpObjectVal to item cpObject of env.
                Let cpFailure be corePolicyCheck(cpSubjectVal, cpObjectVal, cpCapability, cpRule, cpAlts, cpSource).
                If cpFailure is not "":
                    Fail with cpFailure.
            When CCheck (chkPred, chkMsg):
                Let chkVal be coreEval(chkPred, env, funcs).
                If coreFails(chkVal):
                    Fail with coreFailureText(chkVal).
                Inspect chkVal:
                    When VBool (chkB):
                        If chkB is not true:
                            Let chkMsgVal be coreEval(chkMsg, env, funcs).
                            If coreFails(chkMsgVal):
                                Fail with coreFailureText(chkMsgVal).
                            Let chkMsgText be valToText(chkMsgVal).
                            Fail with "Security Check Failed: {chkMsgText}".
                    Otherwise:
                        Let skip be true.
            When CAssert (assertProp):
                Let skip be true.
            When CTrust (trustProp, trustJust):
                Let skip be true.
            When CRequire (reqDep):
                Let skip be true.
            When CMerge (mergeTarget, mergeOther):
                Let mergeOut be coreMergeInto(mergeTarget, mergeOther, false, env, funcs).
                Set env to coreOutEnv(mergeOut).
            When CJoin (joinTarget, joinOther):
                Let joinOut be coreMergeInto(joinTarget, joinOther, true, env, funcs).
                Set env to coreOutEnv(joinOut).
            When CIncrease (incTarget, incAmountExpr):
                Let incAmount be coreEval(incAmountExpr, env, funcs).
                If coreFails(incAmount):
                    Fail with coreFailureText(incAmount).
                Inspect incAmount:
                    When VInt (incBy):
                        Let incBumped be coreCounterStep(incTarget, incBy, env).
                        If coreFails(incBumped):
                            Fail with coreFailureText(incBumped).
                        Set item incTarget of env to incBumped.
                    Otherwise:
                        Fail with "CRDT increment amount must be an integer".
            When CDecrease (decTarget, decAmountExpr):
                Let decAmount be coreEval(decAmountExpr, env, funcs).
                If coreFails(decAmount):
                    Fail with coreFailureText(decAmount).
                Inspect decAmount:
                    When VInt (decBy):
                        Let decBumped be coreCounterStep(decTarget, 0 - decBy, env).
                        If coreFails(decBumped):
                            Fail with coreFailureText(decBumped).
                        Set item decTarget of env to decBumped.
                    Otherwise:
                        Fail with "CRDT decrement amount must be an integer".
            When CAppendToSeq (asTarget, asValueExpr):
                Let asValue be coreEval(asValueExpr, env, funcs).
                If coreFails(asValue):
                    Fail with coreFailureText(asValue).
                If not (env contains asTarget):
                    Fail with "Undefined variable: {asTarget}".
                Let asTargetVal be item asTarget of env.
                Inspect asTargetVal:
                    When VSeq (asItems):
                        Let mutable asMutSeq be copy of asItems.
                        Push asValue to asMutSeq.
                        Set item asTarget of env to a new VSeq with items asMutSeq.
                    When VCrdt (asKind, asState):
                        Let asAppended be coreRgaAppended(asTargetVal, asValue).
                        If coreFails(asAppended):
                            Fail with coreFailureText(asAppended).
                        Set item asTarget of env to asAppended.
                    Otherwise:
                        Let asTargetName be coreTypeName(asTargetVal).
                        Fail with "Cannot append to {asTargetName}".
            When CResolve (resTarget):
                Let skip be true.
            When CResolveTo (rtTarget, rtValueExpr):
                Let rtValue be coreEval(rtValueExpr, env, funcs).
                If coreFails(rtValue):
                    Fail with coreFailureText(rtValue).
                If not (env contains rtTarget):
                    Fail with "Undefined variable: {rtTarget}".
                Let rtHeld be item rtTarget of env.
                Inspect rtHeld:
                    When VCrdt (rtKind, rtState):
                        Fail with "cannot resolve a {rtKind}".
                    Otherwise:
                        Set item rtTarget of env to rtValue.
            When CSync (syncTarget, syncChannel):
                Let skip be true.
            When CMount (mountTarget, mountPath):
                Let skip be true.
            When CConcurrent (concBranches):
                Repeat for concBranch in concBranches:
                    Let concOut be coreExecBlock(concBranch, env, funcs).
                    Set env to coreOutEnv(concOut).
            When CParallel (parBranches):
                Repeat for parBranch in parBranches:
                    Let parOut be coreExecBlock(parBranch, env, funcs).
                    Set env to coreOutEnv(parOut).
            When CLaunchTask (ltBody, ltHandle):
                Let ltOut be coreExecBlock(ltBody, env, funcs).
                Set env to coreOutEnv(ltOut).
                Set item ltHandle of env to a new VText with value "task_handle".
            When CStopTask (stHandle):
                Let skip be true.
            When CSelect (selBranches):
                Repeat for selBranch in selBranches:
                    Inspect selBranch:
                        When CSelectRecv (selPipe, selVar, selBody):
                            Let selPipeHas be (env contains selPipe).
                            If selPipeHas:
                                Let selPipeVal be item selPipe of env.
                                Inspect selPipeVal:
                                    When VSeq (selPipeItems):
                                        If (length of selPipeItems) is greater than 0:
                                            Set item selVar of env to item 1 of selPipeItems.
                                            Let mutable selNewPipe be a new Seq of CVal.
                                            Let mutable selPi be 2.
                                            While selPi is at most (length of selPipeItems):
                                                Push item selPi of selPipeItems to selNewPipe.
                                                Set selPi to selPi + 1.
                                            Set item selPipe of env to a new VSeq with items selNewPipe.
                                            Let selRecvOut be coreExecBlock(selBody, env, funcs).
                                            Set env to coreOutEnv(selRecvOut).
                                    Otherwise:
                                        Let skip be true.
                        When CSelectTimeout (selDur, selBody):
                            Let selTimeoutOut be coreExecBlock(selBody, env, funcs).
                            Set env to coreOutEnv(selTimeoutOut).
            When CCreatePipe (cpName, cpCapacity):
                Set item cpName of env to a new VSeq with items (a new Seq of CVal).
            When CSendPipe (spPipe, spValueExpr):
                Let spVal be coreEval(spValueExpr, env, funcs).
                If coreFails(spVal):
                    Fail with coreFailureText(spVal).
                Let spPipeVal be item spPipe of env.
                Inspect spPipeVal:
                    When VSeq (spItems):
                        Let mutable spMut be copy of spItems.
                        Push spVal to spMut.
                        Set item spPipe of env to a new VSeq with items spMut.
                    Otherwise:
                        Let skip be true.
            When CReceivePipe (rpPipe, rpTarget):
                Let rpPipeVal be item rpPipe of env.
                Inspect rpPipeVal:
                    When VSeq (rpItems):
                        If (length of rpItems) is greater than 0:
                            Set item rpTarget of env to item 1 of rpItems.
                            Let mutable rpNew be a new Seq of CVal.
                            Let mutable rpI be 2.
                            While rpI is at most (length of rpItems):
                                Push item rpI of rpItems to rpNew.
                                Set rpI to rpI + 1.
                            Set item rpPipe of env to a new VSeq with items rpNew.
                    Otherwise:
                        Let skip be true.
            When CTrySendPipe (tspPipe, tspValueExpr):
                Let tspVal be coreEval(tspValueExpr, env, funcs).
                If coreFails(tspVal):
                    Fail with coreFailureText(tspVal).
                Let tspPipeVal be item tspPipe of env.
                Inspect tspPipeVal:
                    When VSeq (tspItems):
                        Let mutable tspMut be copy of tspItems.
                        Push tspVal to tspMut.
                        Set item tspPipe of env to a new VSeq with items tspMut.
                    Otherwise:
                        Let skip be true.
            When CTryReceivePipe (trpPipe, trpTarget):
                Let trpPipeVal be item trpPipe of env.
                Inspect trpPipeVal:
                    When VSeq (trpItems):
                        If (length of trpItems) is greater than 0:
                            Set item trpTarget of env to item 1 of trpItems.
                            Let mutable trpNew be a new Seq of CVal.
                            Let mutable trpI be 2.
                            While trpI is at most (length of trpItems):
                                Push item trpI of trpItems to trpNew.
                                Set trpI to trpI + 1.
                            Set item trpPipe of env to a new VSeq with items trpNew.
                        Otherwise:
                            Set item trpTarget of env to a new VNothing.
                    Otherwise:
                        Set item trpTarget of env to a new VNothing.
            When CSpawn (spawnType, spawnTarget):
                Set item spawnTarget of env to a new VText with value "agent_handle".
            When CSendMessage (smTarget, smMsg):
                Let skip be true.
            When CAwaitMessage (amTarget):
                Set item amTarget of env to a new VNothing.
            When CListen (listenAddr, listenHandler):
                Let skip be true.
            When CConnectTo (connAddr, connTarget):
                Set item connTarget of env to a new VText with value "connection".
            When CZone (zoneName, zoneKind, zoneBody):
                Let zoneOut be coreExecBlock(zoneBody, env, funcs).
                Set env to coreOutEnv(zoneOut).
                If coreOutExits(zoneOut):
                    Return zoneOut.
            Otherwise:
                Let skip be true.
    Return a new CoreNext with env env.

## To coreHoldContract (cond: CExpr) and (reason: CExpr) and (env: Map of Text to CVal) and (funcs: Map of Text to CFunc):
    Let mutable contractEnv be env.
    Let contractHolds be coreEval(cond, contractEnv, funcs).
    If coreFails(contractHolds):
        Fail with coreFailureText(contractHolds).
    If coreTruthy(contractHolds):
        Return.
    Let contractReason be coreEval(reason, contractEnv, funcs).
    If coreFails(contractReason):
        Fail with coreFailureText(contractReason).
    Inspect contractReason:
        When VText (contractText):
            Fail with contractText.
        Otherwise:
            Let reasonType be coreTypeName(contractReason).
            Fail with "The reason after `otherwise` must be Text, but it was {reasonType}.".

## To coreRun (runStmts: Seq of CStmt) and (runFuncs: Map of Text to CFunc) and (runArgs: Seq of Text):
    Let runArgVals be a new Seq of CVal.
    Repeat for runArg in runArgs:
        Push a new VText with value runArg to runArgVals.
    Let mutable runEnv be a new Map of Text to CVal.
    Set item "args()" of runEnv to a new VSeq with items runArgVals.
    Let runOut be coreExecBlock(runStmts, runEnv, runFuncs).

## To coreIsMapType (mapTypeName: Text) -> Bool:
    If mapTypeName equals "Map":
        Return true.
    Return mapTypeName contains "Map of ".
