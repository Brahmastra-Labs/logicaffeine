
## To coreSeqText (stItems: Seq of CVal) -> Text:
    Let mutable stInts be a new Seq of Int.
    Let mutable stTexts be a new Seq of Text.
    Let mutable stReals be a new Seq of Real.
    Let mutable stBools be a new Seq of Bool.
    Let mutable stOther be false.
    Repeat for stV in stItems:
        Inspect stV:
            When VInt (stN):
                Push stN to stInts.
            When VText (stT):
                Push stT to stTexts.
            When VFloat (stF):
                Push stF to stReals.
            When VBool (stB):
                Push stB to stBools.
            Otherwise:
                Set stOther to true.
    If stOther:
        Return coreRowsText(stItems).
    If length of stItems equals 0:
        Return "[]".
    Let stFirst be item 1 of stItems.
    Inspect stFirst:
        When VInt (stFirstInt):
            If (length of stTexts) + (length of stReals) + (length of stBools) equals 0:
                Return "{stInts}".
        When VText (stFirstText):
            If (length of stInts) + (length of stReals) + (length of stBools) equals 0:
                Return "{stTexts}".
        When VFloat (stFirstReal):
            If (length of stInts) + (length of stTexts) + (length of stBools) equals 0:
                Return "{stReals}".
        When VBool (stFirstBool):
            If (length of stInts) + (length of stTexts) + (length of stReals) equals 0:
                Return "{stBools}".
        Otherwise:
            Let stNoKind be true.
    Return coreJoinedSeqText(stItems).

## To coreRowsAll (raItems: Seq of CVal) and (raKind: Text) -> Bool:
    Repeat for raV in raItems:
        Inspect raV:
            When VSeq (raRow):
                Repeat for raX in raRow:
                    If not (coreKindOf(raX) equals raKind):
                        Return false.
            Otherwise:
                Return false.
    Return true.

## To coreKindOf (koV: CVal) -> Text:
    Inspect koV:
        When VInt (koN):
            Return "Int".
        When VText (koT):
            Return "Text".
        When VFloat (koF):
            Return "Real".
        When VBool (koB):
            Return "Bool".
        Otherwise:
            Return "".

## To coreIntRows (rkIntItems: Seq of CVal) -> Seq of Seq of Int:
    Let mutable rkIntOut be a new Seq of Seq of Int.
    Repeat for rkIntV in rkIntItems:
        Inspect rkIntV:
            When VSeq (rkIntRow):
                Let mutable rkIntHost be a new Seq of Int.
                Repeat for rkIntX in rkIntRow:
                    Inspect rkIntX:
                        When VInt (rkIntHeld):
                            Push rkIntHeld to rkIntHost.
                        Otherwise:
                            Let rkIntSkip be true.
                Push rkIntHost to rkIntOut.
            Otherwise:
                Let rkIntSkipRow be true.
    Return rkIntOut.

## To coreTextRows (rkTextItems: Seq of CVal) -> Seq of Seq of Text:
    Let mutable rkTextOut be a new Seq of Seq of Text.
    Repeat for rkTextV in rkTextItems:
        Inspect rkTextV:
            When VSeq (rkTextRow):
                Let mutable rkTextHost be a new Seq of Text.
                Repeat for rkTextX in rkTextRow:
                    Inspect rkTextX:
                        When VText (rkTextHeld):
                            Push rkTextHeld to rkTextHost.
                        Otherwise:
                            Let rkTextSkip be true.
                Push rkTextHost to rkTextOut.
            Otherwise:
                Let rkTextSkipRow be true.
    Return rkTextOut.

## To coreRealRows (rkRealItems: Seq of CVal) -> Seq of Seq of Real:
    Let mutable rkRealOut be a new Seq of Seq of Real.
    Repeat for rkRealV in rkRealItems:
        Inspect rkRealV:
            When VSeq (rkRealRow):
                Let mutable rkRealHost be a new Seq of Real.
                Repeat for rkRealX in rkRealRow:
                    Inspect rkRealX:
                        When VFloat (rkRealHeld):
                            Push rkRealHeld to rkRealHost.
                        Otherwise:
                            Let rkRealSkip be true.
                Push rkRealHost to rkRealOut.
            Otherwise:
                Let rkRealSkipRow be true.
    Return rkRealOut.

## To coreBoolRows (rkBoolItems: Seq of CVal) -> Seq of Seq of Bool:
    Let mutable rkBoolOut be a new Seq of Seq of Bool.
    Repeat for rkBoolV in rkBoolItems:
        Inspect rkBoolV:
            When VSeq (rkBoolRow):
                Let mutable rkBoolHost be a new Seq of Bool.
                Repeat for rkBoolX in rkBoolRow:
                    Inspect rkBoolX:
                        When VBool (rkBoolHeld):
                            Push rkBoolHeld to rkBoolHost.
                        Otherwise:
                            Let rkBoolSkip be true.
                Push rkBoolHost to rkBoolOut.
            Otherwise:
                Let rkBoolSkipRow be true.
    Return rkBoolOut.

## To coreRowsText (rtItems: Seq of CVal) -> Text:
    If coreRowsAll(rtItems, "Int"):
        Return "{coreIntRows(rtItems)}".
    If coreRowsAll(rtItems, "Text"):
        Return "{coreTextRows(rtItems)}".
    If coreRowsAll(rtItems, "Real"):
        Return "{coreRealRows(rtItems)}".
    If coreRowsAll(rtItems, "Bool"):
        Return "{coreBoolRows(rtItems)}".
    Return coreJoinedSeqText(rtItems).

## To coreJoinedSeqText (jsItems: Seq of CVal) -> Text:
    Let seqText be joinVals(jsItems).
    Return "[{seqText}]".

## To valToText (v: CVal) -> Text:
    Inspect v:
        When VInt (n):
            Return "{n}".
        When VFloat (f):
            Return "{f}".
        When VBool (b):
            Return "{b}".
        When VText (s):
            Return s.
        When VSeq (items):
            Return coreSeqText(items).
        When VMap (m):
            If m contains "__tag":
                Return variantText(m).
            Let mapParts be a new Seq of Text.
            Repeat for (mapKey, mapVal) in m:
                Let mapKeyText be valToText(coreMapPairKey(mapVal)).
                Let mapValText be valToText(coreMapPairValue(mapVal)).
                Push "{mapKeyText}: {mapValText}" to mapParts.
            Let mapText be joinTexts(mapParts).
            Return "{{{mapText}}}".
        When VSet (setItems):
            Let setText be joinVals(setItems).
            Return "{{{setText}}}".
        When VOption (optInner, optPresent):
            If optPresent:
                Return valToText(optInner).
            Otherwise:
                Return "nothing".
        When VTuple (tupItems):
            Let tupParts be a new Seq of Text.
            Repeat for ti in tupItems:
                Push valToText(ti) to tupParts.
            Let mutable tupResult be "(".
            Let mutable tupIdx be 1.
            Let tupLen be length of tupParts.
            Repeat for tp in tupParts:
                Set tupResult to "{tupResult}{tp}".
                If tupIdx is less than tupLen:
                    Set tupResult to "{tupResult}, ".
                Set tupIdx to tupIdx + 1.
            Set tupResult to "{tupResult})".
            Return tupResult.
        When VStruct (sTypeName, sFields):
            Let structParts be a new Seq of Text.
            Repeat for (fieldName, fieldVal) in sFields:
                Let fieldValText be valToText(fieldVal).
                Push "{fieldName}: {fieldValText}" to structParts.
            Let structText be joinTexts(structParts).
            Return "{sTypeName} {{ {structText} }}".
        When VVariant (vTypeName, vVarName, vFields):
            If length of vFields equals 0:
                Return vVarName.
            Let variantFieldText be joinVals(vFields).
            Return "{vVarName}({variantFieldText})".
        When VClosure (clParams, clBody, clEnv):
            Return "<closure>".
        When VDuration (shownDuration):
            Return "{shownDuration}".
        When VDate (shownDate):
            Return "{shownDate}".
        When VMoment (shownMoment):
            Return "{shownMoment}".
        When VSpan (shownSpan):
            Return "{shownSpan}".
        When VTime (shownTime):
            Return "{shownTime}".
        When VChar (shownChar):
            Return "{shownChar}".
        When VCrdt (crdtKind, crdtState):
            If coreIsCounter(v):
                Return "{coreCounterValue(v)}".
            If crdtKind equals "SharedSequence":
                Let crdtSeqText be joinVals(coreRgaValues(crdtState)).
                Return "[{crdtSeqText}]".
            Return "<crdt:{crdtKind}>".
        When VError (msg):
            Return "Error: {msg}".
        When VNothing:
            Return "nothing".

## To joinTexts (parts: Seq of Text) -> Text:
    Let mutable joined be "".
    Let mutable first be true.
    Repeat for part in parts:
        If first:
            Set joined to part.
            Set first to false.
        Otherwise:
            Set joined to "{joined}, {part}".
    Return joined.

## To joinVals (vals: Seq of CVal) -> Text:
    Let valParts be a new Seq of Text.
    Repeat for val in vals:
        Push valToText(val) to valParts.
    Return joinTexts(valParts).

## To variantText (vm: Map of Text to CVal) -> Text:
    Let tagVal be item "__tag" of vm.
    Let tagText be valToText(tagVal).
    Let fieldVals be a new Seq of CVal.
    If vm contains "__fnames__":
        Inspect item "__fnames__" of vm:
            When VSeq (fnameVals):
                Repeat for fnameVal in fnameVals:
                    Let fname be valToText(fnameVal).
                    If vm contains fname:
                        Push item fname of vm to fieldVals.
            Otherwise:
                Let skip be true.
    If length of fieldVals equals 0:
        Return tagText.
    Let fieldText be joinVals(fieldVals).
    Return "{tagText}({fieldText})".

## To coreTypeName (v: CVal) -> Text:
    Inspect v:
        When VInt (tnInt):
            Return "Int".
        When VFloat (tnFloat):
            Return "Float".
        When VBool (tnBool):
            Return "Bool".
        When VText (tnText):
            Return "Text".
        When VSeq (tnSeq):
            Return "List".
        When VMap (tnMap):
            Return "Map".
        When VSet (tnSet):
            Return "Set".
        When VOption (tnOptInner, tnOptPresent):
            Return "Option".
        When VTuple (tnTuple):
            Return "Tuple".
        When VStruct (tnStructName, tnStructFields):
            Return tnStructName.
        When VVariant (tnVariantType, tnVariantName, tnVariantFields):
            Return tnVariantType.
        When VClosure (tnParams, tnBody, tnEnv):
            Return "Function".
        When VDuration (tnDuration):
            Return "Duration".
        When VDate (tnDate):
            Return "Date".
        When VMoment (tnMoment):
            Return "Moment".
        When VSpan (tnSpan):
            Return "Span".
        When VTime (tnTime):
            Return "Time".
        When VChar (tnChar):
            Return "Char".
        When VCrdt (tnCrdtKind, tnCrdtState):
            Return tnCrdtKind.
        When VError (tnErr):
            Return "Error".
        When VNothing:
            Return "Nothing".

## To coreIndexRefusal (indexed: CVal) and (index: CVal) -> CVal:
    Let indexedName be coreTypeName(indexed).
    Let indexName be coreTypeName(index).
    Return a new VError with msg "Cannot index {indexedName} with {indexName}".

## To coreFieldRefusal (fieldless: CVal) -> CVal:
    Let fieldlessName be coreTypeName(fieldless).
    Return a new VError with msg "Cannot access field on {fieldlessName}".

## To coreFieldOf (holder: CVal) and (field: Text) -> CVal:
    Inspect holder:
        When VStruct (fhTypeName, fhFields):
            Return item field of fhFields.
        When VMap (fhEntries):
            Return item field of fhEntries.
        Otherwise:
            Return coreFieldRefusal(holder).

## To coreWithField (holder: CVal) and (field: Text) and (fieldValue: CVal) -> CVal:
    Inspect holder:
        When VStruct (whTypeName, whFields):
            Let mutable whNewFields be copy of whFields.
            Set item field of whNewFields to fieldValue.
            Return a new VStruct with typeName whTypeName and fields whNewFields.
        When VMap (whEntries):
            Let mutable whNewEntries be copy of whEntries.
            Set item field of whNewEntries to fieldValue.
            Return a new VMap with entries whNewEntries.
        Otherwise:
            Return coreFieldRefusal(holder).

## To coreSetOpRefusal (opWord: Text) and (setLeft: CVal) and (setRight: CVal) -> CVal:
    Let setLeftName be coreTypeName(setLeft).
    Let setRightName be coreTypeName(setRight).
    Return a new VError with msg "Cannot {opWord} {setLeftName} and {setRightName}".

## To coreFails (v: CVal) -> Bool:
    Inspect v:
        When VError (failedMsg):
            Return true.
        Otherwise:
            Return false.

## To coreFailureText (v: CVal) -> Text:
    Inspect v:
        When VError (failureMsg):
            Return failureMsg.
        Otherwise:
            Return "".

# The operators: generated by optimize::core_operators from semantics::operator_overloads.
## To applyBinOp (op: Text) and (lv: CVal) and (rv: CVal) -> CVal:
    If coreFails(lv):
        Return lv.
    If coreFails(rv):
        Return rv.
    Let opLength be length of op.
    If opLength equals 1:
        If op equals "%":
            Return coreOpModulo(lv, rv).
        If op equals "&":
            Return coreOpBitAnd(lv, rv).
        If op equals "*":
            Return coreOpMultiply(lv, rv).
        If op equals "+":
            Return coreOpAdd(lv, rv).
        If op equals "-":
            Return coreOpSubtract(lv, rv).
        If op equals "/":
            Return coreOpDivide(lv, rv).
        If op equals "<":
            Return coreOpLt(lv, rv).
        If op equals ">":
            Return coreOpGt(lv, rv).
        If op equals "^":
            Return coreOpBitXor(lv, rv).
        If op equals "|":
            Return coreOpBitOr(lv, rv).
    If opLength equals 2:
        If op equals "!=":
            Return coreOpNotEq(lv, rv).
        If op equals "&&":
            Return coreOpAnd(lv, rv).
        If op equals "**":
            Return coreOpPow(lv, rv).
        If op equals "//":
            Return coreOpFloorDivide(lv, rv).
        If op equals "<<":
            Return coreOpShl(lv, rv).
        If op equals "<=":
            Return coreOpLtEq(lv, rv).
        If op equals "==":
            Return coreOpEq(lv, rv).
        If op equals ">=":
            Return coreOpGtEq(lv, rv).
        If op equals ">>":
            Return coreOpShr(lv, rv).
        If op equals "||":
            Return coreOpOr(lv, rv).
    If opLength equals 11:
        If op equals "followed by":
            Return coreOpSeqConcat(lv, rv).
    If opLength equals 13:
        If op equals "combined with":
            Return coreOpConcat(lv, rv).
    If opLength equals 16:
        If op equals "is approximately":
            Return coreOpApproxEq(lv, rv).
    Return coreOpRefusal(op, lv, rv).

## To coreOpModulo (lv: CVal) and (rv: CVal) -> CVal:
    Inspect lv:
        When VInt (leftInt):
            Inspect rv:
                When VInt (rightInt):
                    If rightInt equals 0:
                        Fail with "Modulo by zero".
                    Return a new VInt with value (leftInt % rightInt).
                Otherwise:
                    Return coreOpFamily("%", lv, rv).
        Otherwise:
            Return coreOpFamily("%", lv, rv).

## To coreOpBitAnd (lv: CVal) and (rv: CVal) -> CVal:
    Inspect lv:
        When VInt (leftInt):
            Inspect rv:
                When VInt (rightInt):
                    Return a new VInt with value (leftInt & rightInt).
                Otherwise:
                    Return coreOpFamily("&", lv, rv).
        When VBool (leftBool):
            Inspect rv:
                When VBool (rightBool):
                    Return a new VBool with value (leftBool & rightBool).
                Otherwise:
                    Return coreOpFamily("&", lv, rv).
        Otherwise:
            Return coreOpFamily("&", lv, rv).

## To coreOpMultiply (lv: CVal) and (rv: CVal) -> CVal:
    Inspect lv:
        When VInt (leftInt):
            Inspect rv:
                When VInt (rightInt):
                    Return a new VInt with value (leftInt * rightInt).
                When VFloat (rightReal):
                    Return a new VFloat with value (leftInt * rightReal).
                When VSeq (rightSeq):
                    Return a new VSeq with items (leftInt * rightSeq).
                Otherwise:
                    Return coreOpFamily("*", lv, rv).
        When VFloat (leftReal):
            Inspect rv:
                When VFloat (rightReal):
                    Return a new VFloat with value (leftReal * rightReal).
                When VInt (rightInt):
                    Return a new VFloat with value (leftReal * rightInt).
                Otherwise:
                    Return coreOpFamily("*", lv, rv).
        When VSeq (leftSeq):
            Inspect rv:
                When VInt (rightInt):
                    Return a new VSeq with items (leftSeq * rightInt).
                Otherwise:
                    Return coreOpFamily("*", lv, rv).
        Otherwise:
            Return coreOpFamily("*", lv, rv).

## To coreOpPow (lv: CVal) and (rv: CVal) -> CVal:
    Inspect lv:
        When VInt (leftInt):
            Inspect rv:
                When VInt (rightInt):
                    If rightInt is less than 0:
                        Fail with "negative exponent on an integer (an Int can't hold a fraction — use a Float base)".
                    Return a new VInt with value (leftInt ** rightInt).
                When VFloat (rightReal):
                    Return a new VFloat with value (leftInt ** rightReal).
                Otherwise:
                    Return coreOpFamily("**", lv, rv).
        When VFloat (leftReal):
            Inspect rv:
                When VFloat (rightReal):
                    Return a new VFloat with value (leftReal ** rightReal).
                When VInt (rightInt):
                    Return a new VFloat with value (leftReal ** rightInt).
                Otherwise:
                    Return coreOpFamily("**", lv, rv).
        Otherwise:
            Return coreOpFamily("**", lv, rv).

## To coreOpAdd (lv: CVal) and (rv: CVal) -> CVal:
    Inspect lv:
        When VInt (leftInt):
            Inspect rv:
                When VInt (rightInt):
                    Return a new VInt with value (leftInt + rightInt).
                When VFloat (rightReal):
                    Return a new VFloat with value (leftInt + rightReal).
                When VText (rightText):
                    Let leftShown be valToText(lv).
                    Return a new VText with value (leftShown + rightText).
                Otherwise:
                    Return coreOpFamily("+", lv, rv).
        When VFloat (leftReal):
            Inspect rv:
                When VFloat (rightReal):
                    Return a new VFloat with value (leftReal + rightReal).
                When VInt (rightInt):
                    Return a new VFloat with value (leftReal + rightInt).
                When VText (rightText):
                    Let leftShown be valToText(lv).
                    Return a new VText with value (leftShown + rightText).
                Otherwise:
                    Return coreOpFamily("+", lv, rv).
        When VText (leftText):
            Inspect rv:
                When VText (rightText):
                    Return a new VText with value (leftText + rightText).
                Otherwise:
                    Let rightShown be valToText(rv).
                    Return a new VText with value (leftText + rightShown).
        When VSeq (leftSeq):
            Inspect rv:
                When VText (rightText):
                    Let leftShown be valToText(lv).
                    Return a new VText with value (leftShown + rightText).
                When VSeq (rightSeq):
                    Return a new VSeq with items (leftSeq + rightSeq).
                Otherwise:
                    Return coreOpFamily("+", lv, rv).
        When VDuration (leftDuration):
            Inspect rv:
                When VText (rightText):
                    Let leftShown be valToText(lv).
                    Return a new VText with value (leftShown + rightText).
                When VDuration (rightDuration):
                    Return a new VDuration with value (leftDuration + rightDuration).
                When VMoment (rightMoment):
                    Return a new VMoment with value (leftDuration + rightMoment).
                Otherwise:
                    Return coreOpFamily("+", lv, rv).
        When VDate (leftDate):
            Inspect rv:
                When VText (rightText):
                    Let leftShown be valToText(lv).
                    Return a new VText with value (leftShown + rightText).
                When VSpan (rightSpan):
                    Return a new VDate with value (leftDate + rightSpan).
                Otherwise:
                    Return coreOpFamily("+", lv, rv).
        When VMoment (leftMoment):
            Inspect rv:
                When VText (rightText):
                    Let leftShown be valToText(lv).
                    Return a new VText with value (leftShown + rightText).
                When VSpan (rightSpan):
                    Return a new VMoment with value (leftMoment + rightSpan).
                When VDuration (rightDuration):
                    Return a new VMoment with value (leftMoment + rightDuration).
                Otherwise:
                    Return coreOpFamily("+", lv, rv).
        When VSpan (leftSpan):
            Inspect rv:
                When VText (rightText):
                    Let leftShown be valToText(lv).
                    Return a new VText with value (leftShown + rightText).
                When VMoment (rightMoment):
                    Return a new VMoment with value (leftSpan + rightMoment).
                Otherwise:
                    Return coreOpFamily("+", lv, rv).
        Otherwise:
            Inspect rv:
                When VText (rightText):
                    Let leftShown be valToText(lv).
                    Return a new VText with value (leftShown + rightText).
                Otherwise:
                    Return coreOpFamily("+", lv, rv).

## To coreOpSubtract (lv: CVal) and (rv: CVal) -> CVal:
    Inspect lv:
        When VInt (leftInt):
            Inspect rv:
                When VInt (rightInt):
                    Return a new VInt with value (leftInt - rightInt).
                When VFloat (rightReal):
                    Return a new VFloat with value (leftInt - rightReal).
                Otherwise:
                    Return coreOpFamily("-", lv, rv).
        When VFloat (leftReal):
            Inspect rv:
                When VFloat (rightReal):
                    Return a new VFloat with value (leftReal - rightReal).
                When VInt (rightInt):
                    Return a new VFloat with value (leftReal - rightInt).
                Otherwise:
                    Return coreOpFamily("-", lv, rv).
        When VDuration (leftDuration):
            Inspect rv:
                When VDuration (rightDuration):
                    Return a new VDuration with value (leftDuration - rightDuration).
                Otherwise:
                    Return coreOpFamily("-", lv, rv).
        When VDate (leftDate):
            Inspect rv:
                When VSpan (rightSpan):
                    Return a new VDate with value (leftDate - rightSpan).
                Otherwise:
                    Return coreOpFamily("-", lv, rv).
        When VMoment (leftMoment):
            Inspect rv:
                When VSpan (rightSpan):
                    Return a new VMoment with value (leftMoment - rightSpan).
                When VDuration (rightDuration):
                    Return a new VMoment with value (leftMoment - rightDuration).
                Otherwise:
                    Return coreOpFamily("-", lv, rv).
        Otherwise:
            Return coreOpFamily("-", lv, rv).

## To coreOpDivide (lv: CVal) and (rv: CVal) -> CVal:
    Inspect lv:
        When VInt (leftInt):
            Inspect rv:
                When VInt (rightInt):
                    If rightInt equals 0:
                        Fail with "Division by zero".
                    Return a new VInt with value (leftInt / rightInt).
                When VFloat (rightReal):
                    If rightReal equals 0.0:
                        Fail with "Division by zero".
                    Return a new VFloat with value (leftInt / rightReal).
                Otherwise:
                    Return coreOpFamily("/", lv, rv).
        When VFloat (leftReal):
            Inspect rv:
                When VFloat (rightReal):
                    If rightReal equals 0.0:
                        Fail with "Division by zero".
                    Return a new VFloat with value (leftReal / rightReal).
                When VInt (rightInt):
                    If rightInt equals 0:
                        Fail with "Division by zero".
                    Return a new VFloat with value (leftReal / rightInt).
                Otherwise:
                    Return coreOpFamily("/", lv, rv).
        Otherwise:
            Return coreOpFamily("/", lv, rv).

## To coreOpFloorDivide (lv: CVal) and (rv: CVal) -> CVal:
    Inspect lv:
        When VInt (leftInt):
            Inspect rv:
                When VInt (rightInt):
                    If rightInt equals 0:
                        Fail with "Division by zero".
                    Return a new VInt with value (leftInt // rightInt).
                When VFloat (rightReal):
                    If rightReal equals 0.0:
                        Fail with "Division by zero".
                    Return a new VFloat with value (leftInt // rightReal).
                Otherwise:
                    Return coreOpFamily("//", lv, rv).
        When VFloat (leftReal):
            Inspect rv:
                When VFloat (rightReal):
                    If rightReal equals 0.0:
                        Fail with "Division by zero".
                    Return a new VFloat with value (leftReal // rightReal).
                When VInt (rightInt):
                    If rightInt equals 0:
                        Fail with "Division by zero".
                    Return a new VFloat with value (leftReal // rightInt).
                Otherwise:
                    Return coreOpFamily("//", lv, rv).
        Otherwise:
            Return coreOpFamily("//", lv, rv).

## To coreOpLt (lv: CVal) and (rv: CVal) -> CVal:
    Inspect lv:
        When VInt (leftInt):
            Inspect rv:
                When VInt (rightInt):
                    Return a new VBool with value (leftInt is less than rightInt).
                When VFloat (rightReal):
                    Return a new VBool with value (leftInt is less than rightReal).
                Otherwise:
                    Return coreOpFamily("<", lv, rv).
        When VFloat (leftReal):
            Inspect rv:
                When VFloat (rightReal):
                    Return a new VBool with value (leftReal is less than rightReal).
                When VInt (rightInt):
                    Return a new VBool with value (leftReal is less than rightInt).
                Otherwise:
                    Return coreOpFamily("<", lv, rv).
        When VDuration (leftDuration):
            Inspect rv:
                When VDuration (rightDuration):
                    Return a new VBool with value (leftDuration is less than rightDuration).
                Otherwise:
                    Return coreOpFamily("<", lv, rv).
        When VDate (leftDate):
            Inspect rv:
                When VDate (rightDate):
                    Return a new VBool with value (leftDate is less than rightDate).
                Otherwise:
                    Return coreOpFamily("<", lv, rv).
        When VMoment (leftMoment):
            Inspect rv:
                When VMoment (rightMoment):
                    Return a new VBool with value (leftMoment is less than rightMoment).
                When VTime (rightTime):
                    Return a new VBool with value (leftMoment is less than rightTime).
                Otherwise:
                    Return coreOpFamily("<", lv, rv).
        When VTime (leftTime):
            Inspect rv:
                When VTime (rightTime):
                    Return a new VBool with value (leftTime is less than rightTime).
                When VMoment (rightMoment):
                    Return a new VBool with value (leftTime is less than rightMoment).
                Otherwise:
                    Return coreOpFamily("<", lv, rv).
        Otherwise:
            Return coreOpFamily("<", lv, rv).

## To coreOpShl (lv: CVal) and (rv: CVal) -> CVal:
    Inspect lv:
        When VInt (leftInt):
            Inspect rv:
                When VInt (rightInt):
                    Return a new VInt with value (leftInt shifted left by rightInt).
                Otherwise:
                    Return coreOpFamily("<<", lv, rv).
        Otherwise:
            Return coreOpFamily("<<", lv, rv).

## To coreOpLtEq (lv: CVal) and (rv: CVal) -> CVal:
    Inspect lv:
        When VInt (leftInt):
            Inspect rv:
                When VInt (rightInt):
                    Return a new VBool with value (leftInt is at most rightInt).
                When VFloat (rightReal):
                    Return a new VBool with value (leftInt is at most rightReal).
                Otherwise:
                    Return coreOpFamily("<=", lv, rv).
        When VFloat (leftReal):
            Inspect rv:
                When VFloat (rightReal):
                    Return a new VBool with value (leftReal is at most rightReal).
                When VInt (rightInt):
                    Return a new VBool with value (leftReal is at most rightInt).
                Otherwise:
                    Return coreOpFamily("<=", lv, rv).
        When VDuration (leftDuration):
            Inspect rv:
                When VDuration (rightDuration):
                    Return a new VBool with value (leftDuration is at most rightDuration).
                Otherwise:
                    Return coreOpFamily("<=", lv, rv).
        When VDate (leftDate):
            Inspect rv:
                When VDate (rightDate):
                    Return a new VBool with value (leftDate is at most rightDate).
                Otherwise:
                    Return coreOpFamily("<=", lv, rv).
        When VMoment (leftMoment):
            Inspect rv:
                When VMoment (rightMoment):
                    Return a new VBool with value (leftMoment is at most rightMoment).
                When VTime (rightTime):
                    Return a new VBool with value (leftMoment is at most rightTime).
                Otherwise:
                    Return coreOpFamily("<=", lv, rv).
        When VTime (leftTime):
            Inspect rv:
                When VTime (rightTime):
                    Return a new VBool with value (leftTime is at most rightTime).
                When VMoment (rightMoment):
                    Return a new VBool with value (leftTime is at most rightMoment).
                Otherwise:
                    Return coreOpFamily("<=", lv, rv).
        Otherwise:
            Return coreOpFamily("<=", lv, rv).

## To coreOpGt (lv: CVal) and (rv: CVal) -> CVal:
    Inspect lv:
        When VInt (leftInt):
            Inspect rv:
                When VInt (rightInt):
                    Return a new VBool with value (leftInt is greater than rightInt).
                When VFloat (rightReal):
                    Return a new VBool with value (leftInt is greater than rightReal).
                Otherwise:
                    Return coreOpFamily(">", lv, rv).
        When VFloat (leftReal):
            Inspect rv:
                When VFloat (rightReal):
                    Return a new VBool with value (leftReal is greater than rightReal).
                When VInt (rightInt):
                    Return a new VBool with value (leftReal is greater than rightInt).
                Otherwise:
                    Return coreOpFamily(">", lv, rv).
        When VDuration (leftDuration):
            Inspect rv:
                When VDuration (rightDuration):
                    Return a new VBool with value (leftDuration is greater than rightDuration).
                Otherwise:
                    Return coreOpFamily(">", lv, rv).
        When VDate (leftDate):
            Inspect rv:
                When VDate (rightDate):
                    Return a new VBool with value (leftDate is greater than rightDate).
                Otherwise:
                    Return coreOpFamily(">", lv, rv).
        When VMoment (leftMoment):
            Inspect rv:
                When VMoment (rightMoment):
                    Return a new VBool with value (leftMoment is greater than rightMoment).
                When VTime (rightTime):
                    Return a new VBool with value (leftMoment is greater than rightTime).
                Otherwise:
                    Return coreOpFamily(">", lv, rv).
        When VTime (leftTime):
            Inspect rv:
                When VTime (rightTime):
                    Return a new VBool with value (leftTime is greater than rightTime).
                When VMoment (rightMoment):
                    Return a new VBool with value (leftTime is greater than rightMoment).
                Otherwise:
                    Return coreOpFamily(">", lv, rv).
        Otherwise:
            Return coreOpFamily(">", lv, rv).

## To coreOpGtEq (lv: CVal) and (rv: CVal) -> CVal:
    Inspect lv:
        When VInt (leftInt):
            Inspect rv:
                When VInt (rightInt):
                    Return a new VBool with value (leftInt is at least rightInt).
                When VFloat (rightReal):
                    Return a new VBool with value (leftInt is at least rightReal).
                Otherwise:
                    Return coreOpFamily(">=", lv, rv).
        When VFloat (leftReal):
            Inspect rv:
                When VFloat (rightReal):
                    Return a new VBool with value (leftReal is at least rightReal).
                When VInt (rightInt):
                    Return a new VBool with value (leftReal is at least rightInt).
                Otherwise:
                    Return coreOpFamily(">=", lv, rv).
        When VDuration (leftDuration):
            Inspect rv:
                When VDuration (rightDuration):
                    Return a new VBool with value (leftDuration is at least rightDuration).
                Otherwise:
                    Return coreOpFamily(">=", lv, rv).
        When VDate (leftDate):
            Inspect rv:
                When VDate (rightDate):
                    Return a new VBool with value (leftDate is at least rightDate).
                Otherwise:
                    Return coreOpFamily(">=", lv, rv).
        When VMoment (leftMoment):
            Inspect rv:
                When VMoment (rightMoment):
                    Return a new VBool with value (leftMoment is at least rightMoment).
                When VTime (rightTime):
                    Return a new VBool with value (leftMoment is at least rightTime).
                Otherwise:
                    Return coreOpFamily(">=", lv, rv).
        When VTime (leftTime):
            Inspect rv:
                When VTime (rightTime):
                    Return a new VBool with value (leftTime is at least rightTime).
                When VMoment (rightMoment):
                    Return a new VBool with value (leftTime is at least rightMoment).
                Otherwise:
                    Return coreOpFamily(">=", lv, rv).
        Otherwise:
            Return coreOpFamily(">=", lv, rv).

## To coreOpShr (lv: CVal) and (rv: CVal) -> CVal:
    Inspect lv:
        When VInt (leftInt):
            Inspect rv:
                When VInt (rightInt):
                    Return a new VInt with value (leftInt shifted right by rightInt).
                Otherwise:
                    Return coreOpFamily(">>", lv, rv).
        Otherwise:
            Return coreOpFamily(">>", lv, rv).

## To coreOpBitXor (lv: CVal) and (rv: CVal) -> CVal:
    Inspect lv:
        When VInt (leftInt):
            Inspect rv:
                When VInt (rightInt):
                    Return a new VInt with value (leftInt xor rightInt).
                Otherwise:
                    Return coreOpFamily("^", lv, rv).
        When VBool (leftBool):
            Inspect rv:
                When VBool (rightBool):
                    Return a new VBool with value (leftBool xor rightBool).
                Otherwise:
                    Return coreOpFamily("^", lv, rv).
        Otherwise:
            Return coreOpFamily("^", lv, rv).

## To coreOpConcat (lv: CVal) and (rv: CVal) -> CVal:
    Let leftShown be valToText(lv).
    Let rightShown be valToText(rv).
    Return a new VText with value (leftShown combined with rightShown).

## To coreOpSeqConcat (lv: CVal) and (rv: CVal) -> CVal:
    Inspect lv:
        When VSeq (leftSeq):
            Inspect rv:
                When VSeq (rightSeq):
                    Return a new VSeq with items (leftSeq followed by rightSeq).
                Otherwise:
                    Return coreOpFamily("followed by", lv, rv).
        Otherwise:
            Return coreOpFamily("followed by", lv, rv).

## To coreOpApproxEq (lv: CVal) and (rv: CVal) -> CVal:
    Inspect lv:
        When VInt (leftInt):
            Inspect rv:
                When VInt (rightInt):
                    Return a new VBool with value (leftInt is approximately rightInt).
                When VFloat (rightReal):
                    Return a new VBool with value (leftInt is approximately rightReal).
                Otherwise:
                    Return coreOpFamily("is approximately", lv, rv).
        When VFloat (leftReal):
            Inspect rv:
                When VFloat (rightReal):
                    Return a new VBool with value (leftReal is approximately rightReal).
                When VInt (rightInt):
                    Return a new VBool with value (leftReal is approximately rightInt).
                Otherwise:
                    Return coreOpFamily("is approximately", lv, rv).
        Otherwise:
            Return coreOpFamily("is approximately", lv, rv).

## To coreOpBitOr (lv: CVal) and (rv: CVal) -> CVal:
    Inspect lv:
        When VInt (leftInt):
            Inspect rv:
                When VInt (rightInt):
                    Return a new VInt with value (leftInt | rightInt).
                Otherwise:
                    Return coreOpFamily("|", lv, rv).
        When VBool (leftBool):
            Inspect rv:
                When VBool (rightBool):
                    Return a new VBool with value (leftBool | rightBool).
                Otherwise:
                    Return coreOpFamily("|", lv, rv).
        Otherwise:
            Return coreOpFamily("|", lv, rv).

## To coreOpRefusal (op: Text) and (lv: CVal) and (rv: CVal) -> CVal:
    Let refusedLeft be coreTypeName(lv).
    Let refusedRight be coreTypeName(rv).
    If op equals "%":
        Return a new VError with msg "Cannot compute modulo of {refusedLeft} and {refusedRight}".
    If op equals "&":
        Return a new VError with msg "`&` requires integer, boolean, or Set operands".
    If op equals "*":
        Return a new VError with msg "Cannot multiply {refusedLeft} and {refusedRight}".
    If op equals "**":
        If refusedLeft equals "Float":
            Return a new VError with msg "cannot raise to a {refusedRight} power".
        If refusedRight equals "Float":
            Return a new VError with msg "cannot raise {refusedLeft} to a power".
        Return a new VError with msg "cannot raise {refusedLeft} to the {refusedRight} power".
    If op equals "+":
        Return a new VError with msg "Cannot add {refusedLeft} and {refusedRight}".
    If op equals "-":
        Return a new VError with msg "Cannot subtract {refusedRight} from {refusedLeft}".
    If op equals "/":
        Return a new VError with msg "Cannot divide {refusedLeft} by {refusedRight}".
    If op equals "//":
        Return a new VError with msg "Cannot floor-divide {refusedLeft} by {refusedRight}".
    If op equals "<":
        Return a new VError with msg "Cannot compare {refusedLeft} and {refusedRight}".
    If op equals "<<":
        Return a new VError with msg "Left shift requires integer operands".
    If op equals "<=":
        Return a new VError with msg "Cannot compare {refusedLeft} and {refusedRight}".
    If op equals ">":
        Return a new VError with msg "Cannot compare {refusedLeft} and {refusedRight}".
    If op equals ">=":
        Return a new VError with msg "Cannot compare {refusedLeft} and {refusedRight}".
    If op equals ">>":
        Return a new VError with msg "Right shift requires integer operands".
    If op equals "^":
        Return a new VError with msg "Bitwise XOR requires integer, boolean, or Set operands".
    If op equals "followed by":
        Return a new VError with msg "`followed by` requires two sequences (merge two sequences into one)".
    If op equals "is approximately":
        Return a new VError with msg "`is approximately` compares numbers, got {refusedLeft} and {refusedRight}".
    If op equals "|":
        Return a new VError with msg "`|` requires integer, boolean, or Set operands".
    If op equals "exact /":
        Return a new VError with msg "the self-interpreter applies no `/`: it awaits an exact Rational".
    Return a new VError with msg "the self-interpreter applies no `{op}`".
# The operators end.

## To coreTruthy (truthValue: CVal) -> Bool:
    Inspect truthValue:
        When VBool (truthBool):
            Return truthBool.
        When VInt (truthInt):
            Return truthInt is not 0.
        When VFloat (truthReal):
            Return truthReal is not 0.0.
        When VText (truthText):
            Return (length of truthText) is not 0.
        When VSeq (truthItems):
            Return (length of truthItems) is not 0.
        When VSet (truthMembers):
            Return (length of truthMembers) is not 0.
        When VMap (truthEntries):
            Return (length of truthEntries) is not 0.
        When VNothing:
            Return false.
        Otherwise:
            Return true.

## To coreOpAnd (lv: CVal) and (rv: CVal) -> CVal:
    Let andLeft be coreTruthy(lv).
    Let andRight be coreTruthy(rv).
    Return a new VBool with value (andLeft and andRight).

## To coreOpOr (lv: CVal) and (rv: CVal) -> CVal:
    Let orLeft be coreTruthy(lv).
    Let orRight be coreTruthy(rv).
    Return a new VBool with value (orLeft or orRight).

## To coreEquals (lv0: CVal) and (rv0: CVal) -> Bool:
    Let lv be coreCounterAsInt(lv0).
    Let rv be coreCounterAsInt(rv0).
    Inspect lv:
        When VInt (eqLeftInt):
            Inspect rv:
                When VInt (eqRightInt):
                    Return eqLeftInt equals eqRightInt.
                When VFloat (eqRightReal):
                    Return eqLeftInt equals eqRightReal.
                Otherwise:
                    Return false.
        When VFloat (eqLeftReal):
            Inspect rv:
                When VFloat (eqRightReal):
                    Return eqLeftReal equals eqRightReal.
                When VInt (eqRightInt):
                    Return eqLeftReal equals eqRightInt.
                Otherwise:
                    Return false.
        When VBool (eqLeftBool):
            Inspect rv:
                When VBool (eqRightBool):
                    Return eqLeftBool equals eqRightBool.
                Otherwise:
                    Return false.
        When VText (eqLeftText):
            Inspect rv:
                When VText (eqRightText):
                    Return eqLeftText equals eqRightText.
                Otherwise:
                    Return false.
        When VNothing:
            Inspect rv:
                When VNothing:
                    Return true.
                When VOption (eqNoneInner, eqNonePresent):
                    Return not eqNonePresent.
                Otherwise:
                    Return false.
        When VOption (eqLeftInner, eqLeftPresent):
            Inspect rv:
                When VOption (eqRightInner, eqRightPresent):
                    If eqLeftPresent and eqRightPresent:
                        Return coreEquals(eqLeftInner, eqRightInner).
                    Return eqLeftPresent equals eqRightPresent.
                When VNothing:
                    Return not eqLeftPresent.
                Otherwise:
                    Return false.
        When VSeq (eqLeftItems):
            Inspect rv:
                When VSeq (eqRightItems):
                    Return coreItemsEqual(eqLeftItems, eqRightItems).
                Otherwise:
                    Return false.
        When VTuple (eqLeftTuple):
            Inspect rv:
                When VTuple (eqRightTuple):
                    Return coreItemsEqual(eqLeftTuple, eqRightTuple).
                Otherwise:
                    Return false.
        When VSet (eqLeftSet):
            Inspect rv:
                When VSet (eqRightSet):
                    If length of eqLeftSet is not length of eqRightSet:
                        Return false.
                    Repeat for eqSetItem in eqLeftSet:
                        If not coreSetHolds(eqRightSet, eqSetItem):
                            Return false.
                    Return true.
                Otherwise:
                    Return false.
        When VMap (eqLeftEntries):
            Inspect rv:
                When VMap (eqRightEntries):
                    Return coreEntriesEqual(eqLeftEntries, eqRightEntries).
                Otherwise:
                    Return false.
        When VStruct (eqLeftName, eqLeftFields):
            Inspect rv:
                When VStruct (eqRightName, eqRightFields):
                    If eqLeftName is not eqRightName:
                        Return false.
                    Return coreEntriesEqual(eqLeftFields, eqRightFields).
                Otherwise:
                    Return false.
        When VVariant (eqLeftType, eqLeftVariant, eqLeftValues):
            Inspect rv:
                When VVariant (eqRightType, eqRightVariant, eqRightValues):
                    If eqLeftType is not eqRightType:
                        Return false.
                    If eqLeftVariant is not eqRightVariant:
                        Return false.
                    Return coreItemsEqual(eqLeftValues, eqRightValues).
                Otherwise:
                    Return false.
        When VDuration (eqLeftDuration):
            Inspect rv:
                When VDuration (eqRightDuration):
                    Return eqLeftDuration equals eqRightDuration.
                Otherwise:
                    Return false.
        When VDate (eqLeftDate):
            Inspect rv:
                When VDate (eqRightDate):
                    Return eqLeftDate equals eqRightDate.
                Otherwise:
                    Return false.
        When VMoment (eqLeftMoment):
            Inspect rv:
                When VMoment (eqRightMoment):
                    Return eqLeftMoment equals eqRightMoment.
                Otherwise:
                    Return false.
        When VSpan (eqLeftSpan):
            Inspect rv:
                When VSpan (eqRightSpan):
                    Return eqLeftSpan equals eqRightSpan.
                Otherwise:
                    Return false.
        When VTime (eqLeftTime):
            Inspect rv:
                When VTime (eqRightTime):
                    Return eqLeftTime equals eqRightTime.
                Otherwise:
                    Return false.
        When VChar (eqLeftChar):
            Inspect rv:
                When VChar (eqRightChar):
                    Return eqLeftChar equals eqRightChar.
                Otherwise:
                    Return false.
        Otherwise:
            Let eqLeftType be coreTypeName(lv).
            Let eqRightType be coreTypeName(rv).
            If eqLeftType is not eqRightType:
                Return false.
            Return valEquals(lv, rv).

## To coreItemsEqual (eqLeftList: Seq of CVal) and (eqRightList: Seq of CVal) -> Bool:
    If length of eqLeftList is not length of eqRightList:
        Return false.
    Let mutable eqAt be 1.
    Repeat for eqLeftItem in eqLeftList:
        If not coreEquals(eqLeftItem, item eqAt of eqRightList):
            Return false.
        Set eqAt to eqAt + 1.
    Return true.

## To coreEntriesEqual (eqLeftMap: Map of Text to CVal) and (eqRightMap: Map of Text to CVal) -> Bool:
    If length of eqLeftMap is not length of eqRightMap:
        Return false.
    Repeat for (eqKey, eqLeftValue) in eqLeftMap:
        If not (eqRightMap contains eqKey):
            Return false.
        If not coreEquals(eqLeftValue, item eqKey of eqRightMap):
            Return false.
    Return true.

## To coreMapKey (mapKeyValue: CVal) -> Text:
    Inspect mapKeyValue:
        When VInt (mkInt):
            Return "n{mkInt}".
        When VFloat (mkReal):
            Return "n{mkReal}".
        When VText (mkText):
            Return "t{mkText}".
        When VBool (mkBool):
            If mkBool:
                Return "btrue".
            Return "bfalse".
        When VNothing:
            Return "z".
        When VOption (mkInner, mkPresent):
            If mkPresent:
                Let mkInnerKey be coreMapKey(mkInner).
                Return "s{mkInnerKey}".
            Return "z".
        When VTuple (mkTuple):
            Return coreItemsKey("u", mkTuple).
        When VSeq (mkSeq):
            Return coreItemsKey("l", mkSeq).
        When VStruct (mkStructName, mkStructFields):
            Let mkStructLength be length of mkStructName.
            Return coreEntriesKey("r{mkStructLength}:{mkStructName}", mkStructFields).
        When VVariant (mkVariantType, mkVariantName, mkVariantValues):
            Let mkVariantTypeLength be length of mkVariantType.
            Let mkVariantNameLength be length of mkVariantName.
            Return coreItemsKey("v{mkVariantTypeLength}:{mkVariantType}{mkVariantNameLength}:{mkVariantName}", mkVariantValues).
        When VMap (mkEntries):
            Return coreEntriesKey("m", mkEntries).
        When VDuration (mkDuration):
            Let mkDurationStamp be format_timestamp(1970-01-01 at 12:00am + mkDuration).
            Return "d{mkDurationStamp}".
        When VDate (mkDate):
            Return "a{mkDate}".
        When VMoment (mkMoment):
            Let mkMomentStamp be format_timestamp(mkMoment).
            Return "w{mkMomentStamp}".
        When VSpan (mkSpan):
            Return "g{mkSpan}".
        When VTime (mkTime):
            Return "h{mkTime}".
        When VChar (mkChar):
            Return "c{mkChar}".
        Otherwise:
            Let mkType be coreTypeName(mapKeyValue).
            Let mkTypeLength be length of mkType.
            Let mkShown be valToText(mapKeyValue).
            Return "o{mkTypeLength}:{mkType}{mkShown}".

## To coreItemsKey (ikTag: Text) and (ikItems: Seq of CVal) -> Text:
    Let ikCount be length of ikItems.
    Let mutable ikOut be "{ikTag}{ikCount}[".
    Repeat for ikItem in ikItems:
        Let ikPart be coreMapKey(ikItem).
        Let ikPartLength be length of ikPart.
        Set ikOut to "{ikOut}{ikPartLength}:{ikPart}".
    Return "{ikOut}]".

## To coreEntriesKey (ekTag: Text) and (ekEntries: Map of Text to CVal) -> Text:
    Let ekCount be length of ekEntries.
    Let mutable ekOut be "{ekTag}{ekCount}[".
    Repeat for (ekName, ekValue) in ekEntries:
        Let ekPart be coreMapKey(ekValue).
        Let ekNameLength be length of ekName.
        Let ekPartLength be length of ekPart.
        Set ekOut to "{ekOut}{ekNameLength}:{ekName}{ekPartLength}:{ekPart}".
    Return "{ekOut}]".

## To coreMapPair (pairKey: CVal) and (pairValue: CVal) -> CVal:
    Let pairItems be a new Seq of CVal.
    Push pairKey to pairItems.
    Push pairValue to pairItems.
    Return a new VTuple with items pairItems.

## To coreMapPairKey (pkPair: CVal) -> CVal:
    Inspect pkPair:
        When VTuple (pkItems):
            Return item 1 of pkItems.
        Otherwise:
            Return pkPair.

## To coreMapPairValue (pvPair: CVal) -> CVal:
    Inspect pvPair:
        When VTuple (pvItems):
            Return item 2 of pvItems.
        Otherwise:
            Return pvPair.

## To coreMapSet (msEntries: Map of Text to CVal) and (msKey: CVal) and (msValue: CVal) -> Map of Text to CVal:
    Let msText be coreMapKey(msKey).
    Let mutable msOut be copy of msEntries.
    Let mutable msHeldKey be msKey.
    If msOut contains msText:
        Set msHeldKey to coreMapPairKey(item msText of msOut).
    Set item msText of msOut to coreMapPair(msHeldKey, msValue).
    Return msOut.

## To coreOpEq (lv: CVal) and (rv: CVal) -> CVal:
    Return a new VBool with value coreEquals(lv, rv).

## To coreOpNotEq (lv: CVal) and (rv: CVal) -> CVal:
    Let neLeft be coreCounterAsInt(lv).
    Let neRight be coreCounterAsInt(rv).
    Inspect neLeft:
        When VInt (neLeftInt):
            Inspect neRight:
                When VInt (neRightInt):
                    Return a new VBool with value (neLeftInt is not neRightInt).
                When VFloat (neRightReal):
                    Return a new VBool with value (neLeftInt is not neRightReal).
                Otherwise:
                    Let neIntApart be true.
        When VFloat (neLeftReal):
            Inspect neRight:
                When VFloat (neRightReal):
                    Return a new VBool with value (neLeftReal is not neRightReal).
                When VInt (neRightInt):
                    Return a new VBool with value (neLeftReal is not neRightInt).
                Otherwise:
                    Let neRealApart be true.
        When VBool (neLeftBool):
            Inspect neRight:
                When VBool (neRightBool):
                    Return a new VBool with value (neLeftBool is not neRightBool).
                Otherwise:
                    Let neBoolApart be true.
        When VText (neLeftText):
            Inspect neRight:
                When VText (neRightText):
                    Return a new VBool with value (neLeftText is not neRightText).
                Otherwise:
                    Let neTextApart be true.
        Otherwise:
            Let neOtherKind be true.
    Return a new VBool with value (not coreEquals(lv, rv)).

## To coreSetHolds (holdItems: Seq of CVal) and (held: CVal) -> Bool:
    Repeat for holdItem in holdItems:
        If coreEquals(holdItem, held):
            Return true.
    Return false.

## To coreSetOp (setOp: Text) and (setLeft: Seq of CVal) and (setRight: Seq of CVal) -> Seq of CVal:
    Let mutable setOut be a new Seq of CVal.
    If setOp equals "|":
        Repeat for unionLeftItem in setLeft:
            Push unionLeftItem to setOut.
        Repeat for unionRightItem in setRight:
            If not coreSetHolds(setOut, unionRightItem):
                Push unionRightItem to setOut.
        Return setOut.
    If setOp equals "&":
        Repeat for meetItem in setLeft:
            If coreSetHolds(setRight, meetItem):
                Push meetItem to setOut.
        Return setOut.
    Repeat for leftOnly in setLeft:
        If not coreSetHolds(setRight, leftOnly):
            Push leftOnly to setOut.
    If setOp equals "^":
        Repeat for rightOnly in setRight:
            If not coreSetHolds(setLeft, rightOnly):
                Push rightOnly to setOut.
    Return setOut.

## To coreOpFamily (op: Text) and (lv: CVal) and (rv: CVal) -> CVal:
    Let familyLeftCounts be coreIsCounter(lv).
    Let familyRightCounts be coreIsCounter(rv).
    If familyLeftCounts or familyRightCounts:
        If op equals "<" or op equals ">" or op equals "<=" or op equals ">=":
            Return applyBinOp(op, coreCounterAsInt(lv), coreCounterAsInt(rv)).
    Inspect lv:
        When VSet (familySetLeft):
            Inspect rv:
                When VSet (familySetRight):
                    If op equals "|" or op equals "&" or op equals "^" or op equals "-":
                        Return a new VSet with items coreSetOp(op, familySetLeft, familySetRight).
                    Return coreOpRefusal(op, lv, rv).
                Otherwise:
                    Return coreOpRefusal(op, lv, rv).
        Otherwise:
            Return coreOpRefusal(op, lv, rv).

## To coreIsCounter (counterCandidate: CVal) -> Bool:
    Inspect counterCandidate:
        When VCrdt (isCounterKind, isCounterState):
            Return (isCounterKind equals "ConvergentCount") or (isCounterKind equals "Tally").
        Otherwise:
            Return false.

## To coreSlotTotal (slots: Map of Text to CVal) -> Int:
    Let mutable slotTotal be 0.
    Repeat for (slotReplica, slotCount) in slots:
        Inspect slotCount:
            When VInt (slotN):
                Set slotTotal to slotTotal + slotN.
            Otherwise:
                Let slotSkip be true.
    Return slotTotal.

## To coreSlotsOf (slotState: Map of Text to CVal) and (slotKey: Text) -> Map of Text to CVal:
    If slotState contains slotKey:
        Let heldSlotsVal be item slotKey of slotState.
        Inspect heldSlotsVal:
            When VMap (heldSlots):
                Return heldSlots.
            Otherwise:
                Return a new Map of Text to CVal.
    Return a new Map of Text to CVal.

## To coreCounterValue (counter: CVal) -> Int:
    Inspect counter:
        When VCrdt (cvKind, cvState):
            If cvKind equals "Tally":
                Return coreSlotTotal(coreSlotsOf(cvState, "inc")) - coreSlotTotal(coreSlotsOf(cvState, "dec")).
            Return coreSlotTotal(coreSlotsOf(cvState, "slots")).
        Otherwise:
            Return 0.

## To coreCounterAsInt (asIntCandidate: CVal) -> CVal:
    If coreIsCounter(asIntCandidate):
        Return a new VInt with value coreCounterValue(asIntCandidate).
    Return asIntCandidate.

## To coreSlotBumped (bumpSlots: Map of Text to CVal) and (bumpReplica: Text) and (bumpBy: Int) -> Map of Text to CVal:
    Let mutable bumped be copy of bumpSlots.
    Let mutable bumpHeld be 0.
    If bumped contains bumpReplica:
        Let bumpOldVal be item bumpReplica of bumped.
        Inspect bumpOldVal:
            When VInt (bumpOld):
                Set bumpHeld to bumpOld.
            Otherwise:
                Let bumpSkip be true.
    Set item bumpReplica of bumped to a new VInt with value (bumpHeld + bumpBy).
    Return bumped.

## To coreSlotsJoined (joinLeft: Map of Text to CVal) and (joinRight: Map of Text to CVal) -> Map of Text to CVal:
    Let mutable joinedSlots be copy of joinLeft.
    Repeat for (joinReplica, joinCount) in joinRight:
        Let mutable joinNext be joinCount.
        If joinedSlots contains joinReplica:
            Let joinHeld be item joinReplica of joinedSlots.
            Inspect joinHeld:
                When VInt (joinHeldN):
                    Inspect joinCount:
                        When VInt (joinCountN):
                            If joinHeldN is greater than joinCountN:
                                Set joinNext to joinHeld.
                        Otherwise:
                            Let joinSkip be true.
                Otherwise:
                    Let joinSkip2 be true.
        Set item joinReplica of joinedSlots to joinNext.
    Return joinedSlots.

## To coreCounterBumped (bumpCounter: CVal) and (bumpAmount: Int) -> CVal:
    Inspect bumpCounter:
        When VCrdt (bcKind, bcState):
            Let bcReplica be valToText(item "replica" of bcState).
            Let mutable bcNext be copy of bcState.
            If bcKind equals "ConvergentCount":
                If bumpAmount is less than 0:
                    Return a new VError with msg "a ConvergentCount is grow-only — use a Tally to decrement".
                Set item "slots" of bcNext to a new VMap with entries coreSlotBumped(coreSlotsOf(bcState, "slots"), bcReplica, bumpAmount).
                Return a new VCrdt with kind bcKind and state bcNext.
            If bcKind equals "Tally":
                If bumpAmount is at least 0:
                    Set item "inc" of bcNext to a new VMap with entries coreSlotBumped(coreSlotsOf(bcState, "inc"), bcReplica, bumpAmount).
                Otherwise:
                    Set item "dec" of bcNext to a new VMap with entries coreSlotBumped(coreSlotsOf(bcState, "dec"), bcReplica, 0 - bumpAmount).
                Return a new VCrdt with kind bcKind and state bcNext.
            Return a new VError with msg "cannot increment a {bcKind}".
        Otherwise:
            Let bcTypeName be coreTypeName(bumpCounter).
            Return a new VError with msg "cannot increment a {bcTypeName}".

## To coreCounterJoined (joinCurrent: CVal) and (joinIncoming: CVal) -> CVal:
    Inspect joinCurrent:
        When VCrdt (cjKind, cjState):
            Inspect joinIncoming:
                When VCrdt (cjInKind, cjInState):
                    If cjKind is not cjInKind:
                        Return joinCurrent.
                    Let mutable cjNext be copy of cjState.
                    If cjKind equals "Tally":
                        Set item "inc" of cjNext to a new VMap with entries coreSlotsJoined(coreSlotsOf(cjState, "inc"), coreSlotsOf(cjInState, "inc")).
                        Set item "dec" of cjNext to a new VMap with entries coreSlotsJoined(coreSlotsOf(cjState, "dec"), coreSlotsOf(cjInState, "dec")).
                    Otherwise:
                        Set item "slots" of cjNext to a new VMap with entries coreSlotsJoined(coreSlotsOf(cjState, "slots"), coreSlotsOf(cjInState, "slots")).
                    Return a new VCrdt with kind cjKind and state cjNext.
                Otherwise:
                    Return joinCurrent.
        Otherwise:
            Return joinIncoming.

## To coreMergeField (mergeCurrent: CVal) and (mergeIncoming: CVal) and (mergeJoins: Bool) -> CVal:
    Inspect mergeCurrent:
        When VInt (mfCurInt):
            Inspect mergeIncoming:
                When VInt (mfInInt):
                    If mergeJoins:
                        If mfCurInt is greater than mfInInt:
                            Return mergeCurrent.
                        Return mergeIncoming.
                    Return a new VInt with value (mfCurInt + mfInInt).
                Otherwise:
                    Return mergeIncoming.
        When VSet (mfCurSet):
            Inspect mergeIncoming:
                When VSet (mfInSet):
                    Return a new VSet with items coreSetOp("|", mfCurSet, mfInSet).
                Otherwise:
                    Return mergeIncoming.
        When VMap (mfCurMap):
            Inspect mergeIncoming:
                When VMap (mfInMap):
                    Let mutable mfMerged be copy of mfCurMap.
                    Repeat for (mfKey, mfInVal) in mfInMap:
                        If mfMerged contains mfKey:
                            Set item mfKey of mfMerged to coreMergeField(item mfKey of mfMerged, mfInVal, false).
                        Otherwise:
                            Set item mfKey of mfMerged to mfInVal.
                    Return a new VMap with entries mfMerged.
                Otherwise:
                    Return mergeIncoming.
        When VCrdt (mfCurKind, mfCurState):
            If coreIsCounter(mergeCurrent):
                Return coreCounterJoined(mergeCurrent, mergeIncoming).
            Inspect mergeIncoming:
                When VCrdt (mfInKind, mfInState):
                    If mfCurKind equals "SharedSequence" and mfInKind equals "SharedSequence":
                        Return coreRgaMerged(mergeCurrent, mergeIncoming).
                    Return mergeCurrent.
                Otherwise:
                    Return mergeIncoming.
        Otherwise:
            Return mergeIncoming.

## To coreReplicaNext (nextEnv: Map of Text to CVal) -> Int:
    If nextEnv contains "replicas()":
        Let nextHeld be item "replicas()" of nextEnv.
        Inspect nextHeld:
            When VInt (nextId):
                Return nextId.
            Otherwise:
                Return 1.
    Return 1.

## To coreReplicaOf (replicaKind: Text) and (replicaId: Int) -> CVal:
    Let mutable replicaState be a new Map of Text to CVal.
    Set item "replica" of replicaState to a new VInt with value replicaId.
    Return a new VCrdt with kind replicaKind and state replicaState.

## To coreTakeReplicas (calleeEnv: Map of Text to CVal) and (callerEnv: mutable Map of Text to CVal):
    If calleeEnv contains "replicas()":
        Set item "replicas()" of callerEnv to item "replicas()" of calleeEnv.

## To coreLastField (fieldPath: Text) -> Text:
    Let mutable lastField be "".
    Repeat for fieldCh in fieldPath:
        If fieldCh equals " ":
            Set lastField to "".
        Otherwise:
            Set lastField to "{lastField}{fieldCh}".
    Return lastField.

## To coreCounterStep (stepTarget: Text) and (stepBy: Int) and (stepEnv: Map of Text to CVal) -> CVal:
    If not (stepEnv contains stepTarget):
        Return a new VError with msg "Undefined variable: {stepTarget}".
    Let stepCurrent be item stepTarget of stepEnv.
    Inspect stepCurrent:
        When VInt (stepHeld):
            Return a new VInt with value (stepHeld + stepBy).
        When VNothing:
            Return a new VInt with value stepBy.
        When VCrdt (stepKind, stepState):
            Return coreCounterBumped(stepCurrent, stepBy).
        Otherwise:
            Let stepField be coreLastField(stepTarget).
            Return a new VError with msg "Field '{stepField}' is not a counter".

## To coreMergeInto (miTarget: Text) and (miOther: CExpr) and (miJoins: Bool) and (miEnv0: Map of Text to CVal) and (miFuncs: Map of Text to CFunc) -> CoreOut:
    Let mutable miEnv be copy of miEnv0.
    Let miSource be coreEval(miOther, miEnv, miFuncs).
    If coreFails(miSource):
        Fail with coreFailureText(miSource).
    Let mutable miSourceFields be a new Map of Text to CVal.
    Inspect miSource:
        When VStruct (miSourceType, miSourceHeld):
            Set miSourceFields to miSourceHeld.
        Otherwise:
            Return a new CoreNext with env miEnv.
    If miTarget contains "'s ":
        If miJoins:
            Fail with "Converge target must be an identifier".
        Fail with "Merge target must be an identifier".
    If not (miEnv contains miTarget):
        Fail with "Undefined variable: {miTarget}".
    Let miCurrent be item miTarget of miEnv.
    Inspect miCurrent:
        When VStruct (miTargetType, miTargetHeld):
            Let mutable miFields be copy of miTargetHeld.
            Repeat for (miField, miIncoming) in miSourceFields:
                Let mutable miHeld be a new VInt with value 0.
                If miFields contains miField:
                    Set miHeld to item miField of miFields.
                Set item miField of miFields to coreMergeField(miHeld, miIncoming, miJoins).
            Set item miTarget of miEnv to a new VStruct with typeName miTargetType and fields miFields.
            Return a new CoreNext with env miEnv.
        Otherwise:
            Return a new CoreNext with env miEnv.

## To coreCharCount (countedText: Text) -> Int:
    Let mutable counted be 0.
    Repeat for countedCh in countedText:
        Set counted to counted + 1.
    Return counted.

## To coreSpaces (spaceCount: Int) -> Text:
    Let mutable spaced be "".
    Let mutable spaceAt be 0.
    While spaceAt is less than spaceCount:
        Set spaced to "{spaced} ".
        Set spaceAt to spaceAt + 1.
    Return spaced.

## To corePadded (padText: Text) and (padWidth: Int) and (padSide: Text) -> CVal:
    Let padGap be padWidth - coreCharCount(padText).
    If padGap is at most 0:
        Return a new VText with value padText.
    If padSide equals "<":
        Return a new VText with value "{padText}{coreSpaces(padGap)}".
    If padSide equals "^":
        Let padLeft be padGap / 2.
        Return a new VText with value "{coreSpaces(padLeft)}{padText}{coreSpaces(padGap - padLeft)}".
    Return a new VText with value "{coreSpaces(padGap)}{padText}".

## To coreFormatted (fmtValue: CVal) and (fmtForm: Text) and (fmtSize: Int) -> CVal:
    If fmtForm equals "$":
        Inspect fmtValue:
            When VInt (fmtDollarInt):
                Let fmtCentsInt be coreFormatPrecision(fmtValue, 2).
                If coreFails(fmtCentsInt):
                    Return fmtCentsInt.
                Let fmtCentsIntText be valToText(fmtCentsInt).
                Return a new VText with value "${fmtCentsIntText}".
            When VFloat (fmtDollarReal):
                Let fmtCentsReal be coreFormatPrecision(fmtValue, 2).
                If coreFails(fmtCentsReal):
                    Return fmtCentsReal.
                Let fmtCentsRealText be valToText(fmtCentsReal).
                Return a new VText with value "${fmtCentsRealText}".
            Otherwise:
                Let fmtDollarShown be valToText(fmtValue).
                Return a new VText with value "${fmtDollarShown}".
    If fmtForm equals ".":
        Return coreFormatPrecision(fmtValue, fmtSize).
    Return corePadded(valToText(fmtValue), fmtSize, fmtForm).

## To corePolicyField (pfHolder: CVal) and (pfName: Text) -> CVal:
    Inspect pfHolder:
        When VStruct (pfType, pfFields):
            If pfFields contains pfName:
                Return item pfName of pfFields.
            Return a new VError with msg "absent".
        Otherwise:
            Return a new VError with msg "absent".

## To corePolicyHolds (phCondition: CPolicy) and (phSubject: CVal) and (phObject: CVal) -> CVal:
    Inspect phCondition:
        When PFieldEquals (phField, phExpected, phLiteral, phAsInt, phIsInt, phAsBool, phIsBool):
            Let phHeld be corePolicyField(phSubject, phField).
            Inspect phHeld:
                When VText (phText):
                    Return a new VBool with value (phText equals phExpected).
                When VInt (phInt):
                    If phLiteral or not phIsInt:
                        Return a new VBool with value false.
                    Return a new VBool with value (phInt equals phAsInt).
                When VBool (phBool):
                    If phLiteral or not phIsBool:
                        Return a new VBool with value false.
                    Return a new VBool with value (phBool equals phAsBool).
                Otherwise:
                    Return a new VBool with value false.
        When PFieldBool (pbField, pbValue):
            Let pbHeld be corePolicyField(phSubject, pbField).
            Inspect pbHeld:
                When VBool (pbBool):
                    Return a new VBool with value (pbBool equals pbValue).
                Otherwise:
                    Return a new VBool with value false.
        When PFieldsEqual (pqSubjectField, pqObjectField):
            Let pqLeft be corePolicyField(phSubject, pqSubjectField).
            Let pqRight be corePolicyField(phObject, pqObjectField).
            Let pqLeftAbsent be coreFails(pqLeft).
            Let pqRightAbsent be coreFails(pqRight).
            If pqLeftAbsent or pqRightAbsent:
                Return a new VBool with value false.
            Return a new VBool with value coreEquals(pqLeft, pqRight).
        When PAnd (paLeft, paRight):
            Let paFirst be corePolicyHolds(paLeft, phSubject, phObject).
            If coreFails(paFirst):
                Return paFirst.
            If not coreTruthy(paFirst):
                Return paFirst.
            Return corePolicyHolds(paRight, phSubject, phObject).
        When POr (poLeft, poRight):
            Let poFirst be corePolicyHolds(poLeft, phSubject, phObject).
            If coreFails(poFirst):
                Return poFirst.
            If coreTruthy(poFirst):
                Return poFirst.
            Return corePolicyHolds(poRight, phSubject, phObject).
        When PFalse:
            Return a new VBool with value false.
        When PRecursive (prName):
            Return a new VError with msg "the self-interpreter checks no `{prName}`: its condition names itself, so the language's check never ends".

## To corePolicyCheck (pcSubject: CVal) and (pcObject: CVal) and (pcCapability: Bool) and (pcRule: Text) and (pcAlts: Seq of CPolicyAlt) and (pcSource: Text) -> Text:
    Let mutable pcTypeName be "".
    Inspect pcSubject:
        When VStruct (pcStructType, pcStructFields):
            Set pcTypeName to pcStructType.
        Otherwise:
            Let pcGot be coreTypeName(pcSubject).
            Return "Check subject must be a struct, got {pcGot}".
    Repeat for pcAlt in pcAlts:
        Inspect pcAlt:
            When CPolicyCase (pcCaseType, pcCondition):
                If pcCaseType equals pcTypeName:
                    Let pcHolds be corePolicyHolds(pcCondition, pcSubject, pcObject).
                    Inspect pcHolds:
                        When VError (pcHoldsMsg):
                            Return pcHoldsMsg.
                        Otherwise:
                            If coreTruthy(pcHolds):
                                Return "".
                            Return "Security Check Failed: {pcSource}".
    If pcCapability:
        Return "No capability '{pcRule}' defined for type '{pcTypeName}'".
    Return "No predicate '{pcRule}' defined for type '{pcTypeName}'".

## To coreRgaNodes (rgaState: Map of Text to CVal) -> Seq of CVal:
    If rgaState contains "nodes":
        Let rgaHeld be item "nodes" of rgaState.
        Inspect rgaHeld:
            When VSeq (rgaNodeItems):
                Return rgaNodeItems.
            Otherwise:
                Return a new Seq of CVal.
    Return a new Seq of CVal.

## To coreRgaStamp (stampState: Map of Text to CVal) -> Int:
    If stampState contains "timestamp":
        Let stampHeld be item "timestamp" of stampState.
        Inspect stampHeld:
            When VInt (stampNow):
                Return stampNow.
            Otherwise:
                Return 0.
    Return 0.

## To coreRgaField (rgaNode: CVal) and (rgaAt: Int) -> CVal:
    Inspect rgaNode:
        When VTuple (rgaParts):
            Return item rgaAt of rgaParts.
        Otherwise:
            Return a new VNothing.

## To coreRgaInt (rgaNodeI: CVal) and (rgaAtI: Int) -> Int:
    Let rgaHeldI be coreRgaField(rgaNodeI, rgaAtI).
    Inspect rgaHeldI:
        When VInt (rgaIntValue):
            Return rgaIntValue.
        Otherwise:
            Return 0.

## To coreRgaFlag (rgaNodeB: CVal) and (rgaAtB: Int) -> Bool:
    Let rgaHeldB be coreRgaField(rgaNodeB, rgaAtB).
    Inspect rgaHeldB:
        When VBool (rgaFlagValue):
            Return rgaFlagValue.
        Otherwise:
            Return false.

## To coreRgaNode (nTs: Int) and (nReplica: Int) and (nValue: CVal) and (nDeleted: Bool) and (nHasParent: Bool) and (nParentTs: Int) and (nParentReplica: Int) -> CVal:
    Let nParts be a new Seq of CVal.
    Push a new VInt with value nTs to nParts.
    Push a new VInt with value nReplica to nParts.
    Push nValue to nParts.
    Push a new VBool with value nDeleted to nParts.
    Push a new VBool with value nHasParent to nParts.
    Push a new VInt with value nParentTs to nParts.
    Push a new VInt with value nParentReplica to nParts.
    Return a new VTuple with items nParts.

## To coreRgaAbove (aTs: Int) and (aReplica: Int) and (bTs: Int) and (bReplica: Int) -> Bool:
    If aTs is greater than bTs:
        Return true.
    If aTs equals bTs:
        Return aReplica is greater than bReplica.
    Return false.

## To coreRgaChildren (allNodes: Seq of CVal) and (underRoot: Bool) and (underTs: Int) and (underReplica: Int) -> Seq of CVal:
    Let mutable kids be a new Seq of CVal.
    Repeat for kidNode in allNodes:
        Let kidHasParent be coreRgaFlag(kidNode, 5).
        Let mutable kidUnder be false.
        If underRoot:
            Set kidUnder to not kidHasParent.
        Otherwise:
            If kidHasParent:
                Let kidParentTs be coreRgaInt(kidNode, 6).
                Let kidParentReplica be coreRgaInt(kidNode, 7).
                Set kidUnder to (kidParentTs equals underTs) and (kidParentReplica equals underReplica).
        If kidUnder:
            Let mutable kidsSorted be a new Seq of CVal.
            Let mutable kidPlaced be false.
            Let kidTs be coreRgaInt(kidNode, 1).
            Let kidReplica be coreRgaInt(kidNode, 2).
            Repeat for kidHeld in kids:
                If not kidPlaced:
                    Let kidHeldTs be coreRgaInt(kidHeld, 1).
                    Let kidHeldReplica be coreRgaInt(kidHeld, 2).
                    Let kidGoesFirst be coreRgaAbove(kidTs, kidReplica, kidHeldTs, kidHeldReplica).
                    If kidGoesFirst:
                        Push kidNode to kidsSorted.
                        Set kidPlaced to true.
                Push kidHeld to kidsSorted.
            If not kidPlaced:
                Push kidNode to kidsSorted.
            Set kids to kidsSorted.
    Return kids.

## To coreRgaOrdered (orderNodes: Seq of CVal) -> Seq of CVal:
    Let mutable ordered be a new Seq of CVal.
    Let mutable pending be a new Seq of CVal.
    Let heads be coreRgaChildren(orderNodes, true, 0, 0).
    Let mutable headAt be length of heads.
    While headAt is at least 1:
        Push item headAt of heads to pending.
        Set headAt to headAt - 1.
    While length of pending is greater than 0:
        Let pendingCount be length of pending.
        Let visiting be item pendingCount of pending.
        Let mutable pendingRest be a new Seq of CVal.
        Let mutable pendingAt be 1.
        While pendingAt is less than pendingCount:
            Push item pendingAt of pending to pendingRest.
            Set pendingAt to pendingAt + 1.
        Set pending to pendingRest.
        Push visiting to ordered.
        Let visitingTs be coreRgaInt(visiting, 1).
        Let visitingReplica be coreRgaInt(visiting, 2).
        Let visitingKids be coreRgaChildren(orderNodes, false, visitingTs, visitingReplica).
        Let mutable kidAt be length of visitingKids.
        While kidAt is at least 1:
            Push item kidAt of visitingKids to pending.
            Set kidAt to kidAt - 1.
    Return ordered.

## To coreRgaValues (valuesState: Map of Text to CVal) -> Seq of CVal:
    Let mutable shownValues be a new Seq of CVal.
    Repeat for shownNode in coreRgaOrdered(coreRgaNodes(valuesState)):
        If not coreRgaFlag(shownNode, 4):
            Push coreRgaField(shownNode, 3) to shownValues.
    Return shownValues.

## To coreRgaAppended (appendTo: CVal) and (appendValue: CVal) -> CVal:
    Inspect appendTo:
        When VCrdt (appendKind, appendState):
            If appendKind is not "SharedSequence":
                Return a new VError with msg "cannot append to a {appendKind}".
            Let mutable appendScalar be false.
            Inspect appendValue:
                When VInt (appendInt):
                    Set appendScalar to true.
                When VText (appendText):
                    Set appendScalar to true.
                When VBool (appendBool):
                    Set appendScalar to true.
                Otherwise:
                    Let appendSkip be true.
            If not appendScalar:
                Let appendType be coreTypeName(appendValue).
                Return a new VError with msg "a shared collection holds Int, Text, or Bool elements, not {appendType}".
            Let appendStamp be coreRgaStamp(appendState) + 1.
            Let appendNodes be coreRgaNodes(appendState).
            Let mutable appendHasParent be false.
            Let mutable appendParentTs be 0.
            Let mutable appendParentReplica be 0.
            Repeat for appendSeen in coreRgaOrdered(appendNodes):
                If not coreRgaFlag(appendSeen, 4):
                    Set appendHasParent to true.
                    Set appendParentTs to coreRgaInt(appendSeen, 1).
                    Set appendParentReplica to coreRgaInt(appendSeen, 2).
            Let mutable appendNext be copy of appendNodes.
            Push coreRgaNode(appendStamp, coreReplicaOfState(appendState), appendValue, false, appendHasParent, appendParentTs, appendParentReplica) to appendNext.
            Let mutable appendStateNext be copy of appendState.
            Set item "nodes" of appendStateNext to a new VSeq with items appendNext.
            Set item "timestamp" of appendStateNext to a new VInt with value appendStamp.
            Return a new VCrdt with kind appendKind and state appendStateNext.
        Otherwise:
            Let appendToType be coreTypeName(appendTo).
            Return a new VError with msg "Cannot append to {appendToType}".

## To coreReplicaOfState (rsState: Map of Text to CVal) -> Int:
    If rsState contains "replica":
        Let rsHeld be item "replica" of rsState.
        Inspect rsHeld:
            When VInt (rsId):
                Return rsId.
            Otherwise:
                Return 0.
    Return 0.

## To coreRgaMerged (mergedInto: CVal) and (mergedFrom: CVal) -> CVal:
    Inspect mergedInto:
        When VCrdt (miKind, miState):
            Inspect mergedFrom:
                When VCrdt (mfKind, mfState):
                    Let mutable mergedNodes be copy of coreRgaNodes(miState).
                    Repeat for fromNode in coreRgaNodes(mfState):
                        Let fromTs be coreRgaInt(fromNode, 1).
                        Let fromReplica be coreRgaInt(fromNode, 2).
                        Let fromDeleted be coreRgaFlag(fromNode, 4).
                        Let mutable mergedFound be false.
                        Let mutable mergedNext be a new Seq of CVal.
                        Repeat for intoNode in mergedNodes:
                            Let intoTs be coreRgaInt(intoNode, 1).
                            Let intoReplica be coreRgaInt(intoNode, 2).
                            If (intoTs equals fromTs) and (intoReplica equals fromReplica):
                                Set mergedFound to true.
                                If fromDeleted:
                                    Push coreRgaNode(intoTs, intoReplica, coreRgaField(intoNode, 3), true, coreRgaFlag(intoNode, 5), coreRgaInt(intoNode, 6), coreRgaInt(intoNode, 7)) to mergedNext.
                                Otherwise:
                                    Push intoNode to mergedNext.
                            Otherwise:
                                Push intoNode to mergedNext.
                        If not mergedFound:
                            Push fromNode to mergedNext.
                        Set mergedNodes to mergedNext.
                    Let mutable mergedStamp be coreRgaStamp(miState).
                    Let fromStamp be coreRgaStamp(mfState).
                    If fromStamp is greater than mergedStamp:
                        Set mergedStamp to fromStamp.
                    Let mutable mergedState be copy of miState.
                    Set item "nodes" of mergedState to a new VSeq with items mergedNodes.
                    Set item "timestamp" of mergedState to a new VInt with value mergedStamp.
                    Return a new VCrdt with kind miKind and state mergedState.
                Otherwise:
                    Return mergedInto.
        Otherwise:
            Return mergedFrom.

## To valEquals (a: CVal) and (b: CVal) -> Bool:
    Let ta be valToText(a).
    Let tb be valToText(b).
    Return ta equals tb.

## To coreEval (expr: CExpr) and (env: mutable Map of Text to CVal) and (funcs: Map of Text to CFunc) -> CVal:
    Inspect expr:
        When CInt (n):
            Return a new VInt with value n.
        When CFloat (f):
            Return a new VFloat with value f.
        When CBool (b):
            Return a new VBool with value b.
        When CText (s):
            Return a new VText with value s.
        When CVar (name):
            If env contains name:
                Return item name of env.
            Return a new VError with msg "Undefined variable: {name}".
        When CBinOp (op, left, right):
            Let lv be coreEval(left, env, funcs).
            If coreFails(lv):
                Return lv.
            If op equals "&&":
                If not coreTruthy(lv):
                    Return a new VBool with value false.
            If op equals "||":
                If coreTruthy(lv):
                    Return a new VBool with value true.
            Let rv be coreEval(right, env, funcs).
            If coreFails(rv):
                Return rv.
            Return applyBinOp(op, lv, rv).
        When CNot (inner):
            Let v be coreEval(inner, env, funcs).
            Inspect v:
                When VBool (b):
                    Return a new VBool with value (not b).
                When VError (notMsg):
                    Return v.
                Otherwise:
                    Return a new VBool with value (not coreTruthy(v)).
        When CCall (name, argExprs):
            Let argVals be a new Seq of CVal.
            Repeat for a in argExprs:
                Let argVal be coreEval(a, env, funcs).
                If coreFails(argVal):
                    Return argVal.
                Push argVal to argVals.
            Let callInFuncs be (funcs contains name).
            If callInFuncs:
                Let func be item name of funcs.
                Inspect func:
                    When CFuncDef (fname, params, fnParamTypes, fnReturnType, body):
                        Let callEnv be coreFrame(env).
                        Let mutable idx be 1.
                        Repeat for p in params:
                            Set item p of callEnv to item idx of argVals.
                            coreMarkBound(callEnv, p).
                            Set idx to idx + 1.
                        Let callBodyOut be coreCallBody(body, callEnv, funcs, params).
                        coreTakeReplicas(coreOutEnv(callBodyOut), env).
                        coreWriteBack(params, fnParamTypes, argExprs, coreOutEnv(callBodyOut), env).
                        Return coreOutResult(callBodyOut).
                    Otherwise:
                        Return a new VNothing.
            Otherwise:
                If name equals "args":
                    If env contains "args()":
                        Return item "args()" of env.
                If coreBuiltinKnown(name):
                    Return coreBuiltin(name, argVals).
                Let callInEnv be (env contains name).
                If callInEnv:
                    Let envVal be item name of env.
                    Inspect envVal:
                        When VClosure (ceParams, ceBody, ceCapturedEnv):
                            Let mutable ceCallEnv be coreClosureFrame(ceCapturedEnv, env).
                            Let mutable ceCopyIdx be 1.
                            While ceCopyIdx is at most (length of ceParams):
                                If ceCopyIdx is at most (length of argVals):
                                    Set item (item ceCopyIdx of ceParams) of ceCallEnv to item ceCopyIdx of argVals.
                                    coreMarkBound(ceCallEnv, item ceCopyIdx of ceParams).
                                Set ceCopyIdx to ceCopyIdx + 1.
                            Let ceBodyOut be coreCallBody(ceBody, ceCallEnv, funcs, ceParams).
                            coreTakeReplicas(coreOutEnv(ceBodyOut), env).
                            Return coreOutResult(ceBodyOut).
                        Otherwise:
                            Return a new VError with msg "Unknown function: {name}".
                Otherwise:
                    Return coreBuiltin(name, argVals).
        When CIndex (collExpr, idxExpr):
            Let cv be coreEval(collExpr, env, funcs).
            If coreFails(cv):
                Return cv.
            Let iv be coreEval(idxExpr, env, funcs).
            If coreFails(iv):
                Return iv.
            Inspect cv:
                When VSeq (items):
                    Inspect iv:
                        When VInt (i):
                            If (i equals 0) or (i is greater than (length of items)) or (i is less than (0 - (length of items))):
                                Fail with "Index {i} out of bounds".
                            Return item i of items.
                        Otherwise:
                            Return coreIndexRefusal(cv, iv).
                When VTuple (tupItems):
                    Inspect iv:
                        When VInt (i):
                            If (i equals 0) or (i is greater than (length of tupItems)) or (i is less than (0 - (length of tupItems))):
                                Fail with "Index {i} out of bounds".
                            Return item i of tupItems.
                        Otherwise:
                            Return coreIndexRefusal(cv, iv).
                When VMap (mapData):
                    Let mapKey be coreMapKey(iv).
                    If mapData contains mapKey:
                        Return coreMapPairValue(item mapKey of mapData).
                    Let mapKeyShown be valToText(iv).
                    Return a new VError with msg "Key '{mapKeyShown}' not found in map".
                When VText (idxText):
                    Inspect iv:
                        When VInt (ti):
                            If (ti equals 0) or (ti is greater than (length of idxText)) or (ti is less than (0 - (length of idxText))):
                                Fail with "Index {ti} out of bounds".
                            Return a new VText with value (item ti of idxText).
                        Otherwise:
                            Return coreIndexRefusal(cv, iv).
                Otherwise:
                    Return coreIndexRefusal(cv, iv).
        When CLen (collExpr):
            Let cv be coreEval(collExpr, env, funcs).
            Return coreLengthOf(cv).
        When CMapGet (mapExpr, keyExpr):
            Let mv be coreEval(mapExpr, env, funcs).
            If coreFails(mv):
                Return mv.
            Let kv be coreEval(keyExpr, env, funcs).
            If coreFails(kv):
                Return kv.
            Inspect mv:
                When VMap (mapData):
                    Let getKey be coreMapKey(kv).
                    If mapData contains getKey:
                        Return coreMapPairValue(item getKey of mapData).
                    Let getKeyShown be valToText(kv).
                    Return a new VError with msg "Key '{getKeyShown}' not found in map".
                When VStruct (mgTypeName, mgFields):
                    Inspect kv:
                        When VText (mgKey):
                            Return item mgKey of mgFields.
                        Otherwise:
                            Return coreFieldRefusal(mv).
                Otherwise:
                    Return coreFieldRefusal(mv).
        When CNewSeq (coreSeqElem1):
            Return a new VSeq with items a new Seq of CVal.
        When CNewVariant (nvTag, nvNames, nvVals):
            Let nvMap be a new Map of Text to CVal.
            Set item "__tag" of nvMap to a new VText with value nvTag.
            Let nvFnSeq be a new Seq of CVal.
            Let mutable nvi be 1.
            While nvi is at most (length of nvNames):
                Let nvn be item nvi of nvNames.
                Let nvv be coreEval(item nvi of nvVals, env, funcs).
                If coreFails(nvv):
                    Return nvv.
                Set item nvn of nvMap to nvv.
                Let nvn2 be item nvi of nvNames.
                Push a new VText with value nvn2 to nvFnSeq.
                Set nvi to nvi + 1.
            Set item "__fnames__" of nvMap to a new VSeq with items nvFnSeq.
            Return a new VMap with entries nvMap.
        When CList (listItems):
            Let result be a new Seq of CVal.
            Repeat for listItem in listItems:
                Let listVal be coreEval(listItem, env, funcs).
                If coreFails(listVal):
                    Return listVal.
                Push listVal to result.
            Return a new VSeq with items result.
        When CRange (rangeStart, rangeEnd):
            Let sv be coreEval(rangeStart, env, funcs).
            If coreFails(sv):
                Return sv.
            Let ev be coreEval(rangeEnd, env, funcs).
            If coreFails(ev):
                Return ev.
            Let result be a new Seq of CVal.
            Inspect sv:
                When VInt (s):
                    Inspect ev:
                        When VInt (e):
                            Let mutable ri be s.
                            While ri is at most e:
                                Push a new VInt with value ri to result.
                                Set ri to ri + 1.
                        Otherwise:
                            Let skip be true.
                Otherwise:
                    Let skip be true.
            Return a new VSeq with items result.
        When CSlice (sliceColl, sliceStart, sliceEnd):
            Let cv be coreEval(sliceColl, env, funcs).
            If coreFails(cv):
                Return cv.
            Let siv be coreEval(sliceStart, env, funcs).
            If coreFails(siv):
                Return siv.
            Let eiv be coreEval(sliceEnd, env, funcs).
            If coreFails(eiv):
                Return eiv.
            Inspect cv:
                When VSeq (srcItems):
                    Inspect siv:
                        When VInt (si):
                            Inspect eiv:
                                When VInt (ei):
                                    Let sliceResult be a new Seq of CVal.
                                    If si is at least 0 and ei is at least 0:
                                        Let mutable sliceFrom be si - 1.
                                        If sliceFrom is less than 0:
                                            Set sliceFrom to 0.
                                        If sliceFrom is less than ei and ei is at most (length of srcItems):
                                            Let mutable sIdx be sliceFrom + 1.
                                            While sIdx is at most ei:
                                                Push item sIdx of srcItems to sliceResult.
                                                Set sIdx to sIdx + 1.
                                    Return a new VSeq with items sliceResult.
                                Otherwise:
                                    Return a new VError with msg "Slice requires List and Int indices".
                        Otherwise:
                            Return a new VError with msg "Slice requires List and Int indices".
                Otherwise:
                    Return a new VError with msg "Slice requires List and Int indices".
        When CCopy (copyTarget):
            Let cv be coreEval(copyTarget, env, funcs).
            If coreFails(cv):
                Return cv.
            Inspect cv:
                When VSeq (srcItems):
                    Let copiedItems be a new Seq of CVal.
                    Repeat for ci in srcItems:
                        Push ci to copiedItems.
                    Return a new VSeq with items copiedItems.
                When VMap (mapData):
                    Let copiedMap be copy of mapData.
                    Return a new VMap with entries copiedMap.
                When VSet (copiedSetItems):
                    Let copiedSet be copy of copiedSetItems.
                    Return a new VSet with items copiedSet.
                When VStruct (stn, stf):
                    Let copiedFields be copy of stf.
                    Return a new VStruct with typeName stn and fields copiedFields.
                Otherwise:
                    Return cv.
        When CNewSet (coreSetElem1):
            Return a new VSet with items a new Seq of CVal.
        When CContains (containsColl, containsElem):
            Let ccv be coreEval(containsColl, env, funcs).
            If coreFails(ccv):
                Return ccv.
            Let cev be coreEval(containsElem, env, funcs).
            If coreFails(cev):
                Return cev.
            Inspect ccv:
                When VSet (setItems):
                    Return a new VBool with value coreSetHolds(setItems, cev).
                When VSeq (seqItems):
                    Return a new VBool with value coreSetHolds(seqItems, cev).
                When VText (haystack):
                    Inspect cev:
                        When VText (needle):
                            If haystack contains needle:
                                Return a new VBool with value true.
                            Otherwise:
                                Return a new VBool with value false.
                        Otherwise:
                            Return a new VBool with value false.
                When VMap (keyMap):
                    Return a new VBool with value (keyMap contains coreMapKey(cev)).
                Otherwise:
                    Return a new VBool with value false.
        When CUnion (unionLeft, unionRight):
            Let ulv be coreEval(unionLeft, env, funcs).
            If coreFails(ulv):
                Return ulv.
            Let urv be coreEval(unionRight, env, funcs).
            If coreFails(urv):
                Return urv.
            Inspect ulv:
                When VSet (leftItems):
                    Inspect urv:
                        When VSet (rightItems):
                            Let unionResult be a new Seq of CVal.
                            Let unionTexts be a new Seq of Text.
                            Let mutable uliIdx be 1.
                            While uliIdx is at most (length of leftItems):
                                Push item uliIdx of leftItems to unionResult.
                                Push valToText(item uliIdx of leftItems) to unionTexts.
                                Set uliIdx to uliIdx + 1.
                            Let mutable uriIdx be 1.
                            While uriIdx is at most (length of rightItems):
                                Let uriTxt be valToText(item uriIdx of rightItems).
                                Let mutable uriFound be false.
                                Repeat for ut in unionTexts:
                                    If ut equals uriTxt:
                                        Set uriFound to true.
                                If not uriFound:
                                    Push item uriIdx of rightItems to unionResult.
                                    Push uriTxt to unionTexts.
                                Set uriIdx to uriIdx + 1.
                            Return a new VSet with items unionResult.
                        Otherwise:
                            Return coreSetOpRefusal("union", ulv, urv).
                Otherwise:
                    Return coreSetOpRefusal("union", ulv, urv).
        When CIntersection (interLeft, interRight):
            Let ilv be coreEval(interLeft, env, funcs).
            If coreFails(ilv):
                Return ilv.
            Let irv be coreEval(interRight, env, funcs).
            If coreFails(irv):
                Return irv.
            Inspect ilv:
                When VSet (leftItems):
                    Inspect irv:
                        When VSet (rightItems):
                            Let interResult be a new Seq of CVal.
                            Let rightTexts be a new Seq of Text.
                            Repeat for iri in rightItems:
                                Push valToText(iri) to rightTexts.
                            Let mutable iliIdx be 1.
                            While iliIdx is at most (length of leftItems):
                                Let iliTxt be valToText(item iliIdx of leftItems).
                                Let mutable iliFound be false.
                                Repeat for irt in rightTexts:
                                    If irt equals iliTxt:
                                        Set iliFound to true.
                                If iliFound:
                                    Push item iliIdx of leftItems to interResult.
                                Set iliIdx to iliIdx + 1.
                            Return a new VSet with items interResult.
                        Otherwise:
                            Return coreSetOpRefusal("intersect", ilv, irv).
                Otherwise:
                    Return coreSetOpRefusal("intersect", ilv, irv).
        When COptionSome (optInner):
            Let optVal be coreEval(optInner, env, funcs).
            If coreFails(optVal):
                Return optVal.
            Return a new VOption with inner optVal and present true.
        When COptionNone:
            Return a new VOption with inner (a new VNothing) and present false.
        When CNothing:
            Return a new VNothing.
        When CDeclaredDefault (declaredTypeName):
            Let declaredStart be coreDeclaredDefault(declaredTypeName).
            Inspect declaredStart:
                When VCrdt (declaredKind, declaredState):
                    Let declaredId be coreReplicaNext(env).
                    Set item "replicas()" of env to a new VInt with value (declaredId + 1).
                    Return coreReplicaOf(declaredKind, declaredId).
                Otherwise:
                    Return declaredStart.
        When CSpelled (spelledCode, spelledAwaits):
            Return a new VError with msg "the self-interpreter evaluates no {spelledCode}: it awaits {spelledAwaits}".
        When CTuple (tupleItems):
            Let tupleResult be a new Seq of CVal.
            Repeat for ti in tupleItems:
                Let tupleVal be coreEval(ti, env, funcs).
                If coreFails(tupleVal):
                    Return tupleVal.
                Push tupleVal to tupleResult.
            Return a new VTuple with items tupleResult.
        When CNew (newTypeName, newFieldNames, newFields):
            If coreIsMapType(newTypeName):
                Return a new VMap with entries a new Map of Text to CVal.
            Let newFieldMap be a new Map of Text to CVal.
            Let mutable nfIdx be 1.
            Repeat for nfn in newFieldNames:
                If nfIdx is at most (length of newFields):
                    Let newFieldVal be coreEval(item nfIdx of newFields, env, funcs).
                    If coreFails(newFieldVal):
                        Return newFieldVal.
                    Set item nfn of newFieldMap to newFieldVal.
                Set nfIdx to nfIdx + 1.
            Return a new VStruct with typeName newTypeName and fields newFieldMap.
        When CFieldAccess (faTarget, faField):
            Let faVal be coreEval(faTarget, env, funcs).
            If coreFails(faVal):
                Return faVal.
            Inspect faVal:
                When VStruct (faTypeName, faFields):
                    Return item faField of faFields.
                When VMap (faMapData):
                    Return item faField of faMapData.
                Otherwise:
                    Return coreFieldRefusal(faVal).
        When CClosure (clParams, clBody, clCaptured):
            Let clEnv be a new Map of Text to CVal.
            Let mutable clCapIdx be 1.
            While clCapIdx is at most (length of clCaptured):
                Let clCapName be item clCapIdx of clCaptured.
                If env contains clCapName:
                    Let clCapVal be item clCapName of env.
                    Let clCapName2 be item clCapIdx of clCaptured.
                    Set item clCapName2 of clEnv to clCapVal.
                    coreMarkBound(env, clCapName2).
                    coreMarkBound(clEnv, clCapName2).
                Set clCapIdx to clCapIdx + 1.
            Return a new VClosure with params clParams and body clBody and capturedEnv clEnv.
        When CCallExpr (ceTarget, ceArgs):
            Let ceVal be coreEval(ceTarget, env, funcs).
            If coreFails(ceVal):
                Return ceVal.
            Inspect ceVal:
                When VClosure (ceParams, ceBody, ceCapturedEnv):
                    Let mutable ceCallEnv be coreClosureFrame(ceCapturedEnv, env).
                    Let mutable ceCopyIdx be 1.
                    While ceCopyIdx is at most (length of ceParams):
                        If ceCopyIdx is at most (length of ceArgs):
                            Let ceArgVal be coreEval(item ceCopyIdx of ceArgs, env, funcs).
                            If coreFails(ceArgVal):
                                Return ceArgVal.
                            Set item (item ceCopyIdx of ceParams) of ceCallEnv to ceArgVal.
                            coreMarkBound(ceCallEnv, item ceCopyIdx of ceParams).
                        Set ceCopyIdx to ceCopyIdx + 1.
                    Let ceOut be coreCallBody(ceBody, ceCallEnv, funcs, ceParams).
                    coreTakeReplicas(coreOutEnv(ceOut), env).
                    Let ceResult be coreOutResult(ceOut).
                    Return ceResult.
                Otherwise:
                    Let ceTypeName be coreTypeName(ceVal).
                    Return a new VError with msg "Cannot call value of type {ceTypeName}".
        When CInterpolatedString (isParts):
            Let mutable isResult be "".
            Repeat for isPart in isParts:
                Inspect isPart:
                    When CLiteralPart (litVal):
                        Set isResult to "{isResult}{litVal}".
                    When CExprPart (epExpr):
                        Let epVal be coreEval(epExpr, env, funcs).
                        If coreFails(epVal):
                            Return epVal.
                        Let epText be valToText(epVal).
                        Set isResult to "{isResult}{epText}".
                    When CFormattedPart (fpExpr, fpSpec, fpForm, fpSize):
                        Let fpVal be coreEval(fpExpr, env, funcs).
                        If coreFails(fpVal):
                            Return fpVal.
                        Let fpShown be coreFormatted(fpVal, fpForm, fpSize).
                        If coreFails(fpShown):
                            Return fpShown.
                        Let fpText be valToText(fpShown).
                        Set isResult to "{isResult}{fpText}".
            Return a new VText with value isResult.
        When CDuration (heldDuration):
            Return a new VDuration with value heldDuration.
        When CDate (heldDate):
            Return a new VDate with value heldDate.
        When CMoment (heldMoment):
            Return a new VMoment with value heldMoment.
        When CSpan (heldSpan):
            Return a new VSpan with value heldSpan.
        When CTime (heldTime):
            Return a new VTime with value heldTime.
        When CChar (heldChar):
            Return a new VChar with value heldChar.
        When CTimeNow:
            Return a new VMoment with value now.
        When CDateToday:
            Return a new VDate with value today.
        When CEscExpr (escCode):
            Return a new VError with msg "`Escape to Rust:` holds raw Rust code, which only the Rust backends compile. Use `largo build` or `largo run` to compile and run this program.".
        When CManifestOf (zn):
            Return a new VNothing.
        When CChunkAt (idx, zn):
            Return a new VNothing.

## A CoreOut is one of:
    A CoreNext with env Map of Text to CVal.
    A CoreReturn with result CVal and env Map of Text to CVal.
    A CoreBreak with env Map of Text to CVal.
    A CoreFail with msg Text.

## To coreOutResult (o: CoreOut) -> CVal:
    Inspect o:
        When CoreReturn (corR, coeR):
            Return corR.
        When CoreFail (cofMsg):
            Return a new VError with msg cofMsg.
        Otherwise:
            Return a new VNothing.

## To coreOutEnv (o: CoreOut) -> Map of Text to CVal:
    Inspect o:
        When CoreNext (cnE):
            Return cnE.
        When CoreReturn (crR, crE):
            Return crE.
        When CoreBreak (cbE):
            Return cbE.
        When CoreFail (cfMsg):
            Return a new Map of Text to CVal.

## To coreWithEnv (weOut: CoreOut) and (weEnv: Map of Text to CVal) -> CoreOut:
    Inspect weOut:
        When CoreReturn (weVal, weOld):
            Return a new CoreReturn with result weVal and env weEnv.
        When CoreBreak (weBreakOld):
            Return a new CoreBreak with env weEnv.
        Otherwise:
            Return weOut.

## To coreOutExits (o: CoreOut) -> Bool:
    Inspect o:
        When CoreNext (cxE):
            Return false.
        Otherwise:
            Return true.

## To coreWriteBack (params: Seq of Text) and (paramTypes: Seq of Text) and (argExprs: Seq of CExpr) and (calleeEnv: Map of Text to CVal) and (env: mutable Map of Text to CVal):
    Let mutable wbIdx be 1.
    Repeat for wbP in params:
        If wbIdx is at most (length of paramTypes):
            Let wbType be item wbIdx of paramTypes.
            If wbType contains "mutable":
                If wbIdx is at most (length of argExprs):
                    Let wbArg be item wbIdx of argExprs.
                    Inspect wbArg:
                        When CVar (wbName):
                            If calleeEnv contains wbP:
                                Set item wbName of env to item wbP of calleeEnv.
                                coreMarkBound(env, wbName).
                        Otherwise:
                            Let skip be true.
        Set wbIdx to wbIdx + 1.

## To coreIterItems (v: CVal) -> Seq of CVal:
    Inspect v:
        When VSeq (iterSeq):
            Return iterSeq.
        When VSet (iterSet):
            Return iterSet.
        When VMap (iterMap):
            Let pairs be a new Seq of CVal.
            Repeat for (iterKey, iterPair) in iterMap:
                Push iterPair to pairs.
            Return pairs.
        When VText (iterText):
            Let chars be a new Seq of CVal.
            Repeat for iterCh in iterText:
                Push a new VText with value iterCh to chars.
            Return chars.
        When VCrdt (iterKind, iterState):
            If iterKind equals "SharedSequence":
                Return coreRgaValues(iterState).
            Return a new Seq of CVal.
        Otherwise:
            Return a new Seq of CVal.

## To coreIterRefusal (iterated: CVal) -> Text:
    Inspect iterated:
        When VSeq (irSeq):
            Return "".
        When VSet (irSet):
            Return "".
        When VMap (irMap):
            Return "".
        When VText (irText):
            Return "".
        When VCrdt (irKind, irState):
            If irKind equals "SharedSequence":
                Return "".
            Return "Cannot iterate over {irKind}".
        When VError (irError):
            Return "".
        Otherwise:
            Let irType be coreTypeName(iterated).
            Return "Cannot iterate over {irType}".

## To coreFrame (callerEnv: Map of Text to CVal) -> Map of Text to CVal:
    Let frame be a new Map of Text to CVal.
    If callerEnv contains "args()":
        Set item "args()" of frame to item "args()" of callerEnv.
    If callerEnv contains "replicas()":
        Set item "replicas()" of frame to item "replicas()" of callerEnv.
    Return frame.

## To coreClosureFrame (capturedEnv: Map of Text to CVal) and (callerEnv: Map of Text to CVal) -> Map of Text to CVal:
    Let mutable closureFrame be copy of capturedEnv.
    If callerEnv contains "args()":
        Set item "args()" of closureFrame to item "args()" of callerEnv.
    If callerEnv contains "replicas()":
        Set item "replicas()" of closureFrame to item "replicas()" of callerEnv.
    Return closureFrame.

## To coreDefinedFormat (callArgs: Seq of CVal) -> CVal:
    If (length of callArgs) equals 0:
        Return a new VText with value "".
    Return a new VText with value valToText(item 1 of callArgs).

## To coreDefinedMapOf (callArgs: Seq of CVal) -> CVal:
    Let mutable built be a new Map of Text to CVal.
    Let mutable bi be 1.
    While bi is less than (length of callArgs):
        Set built to coreMapSet(built, item bi of callArgs, item (bi + 1) of callArgs).
        Set bi to bi + 2.
    Return a new VMap with entries built.

## To coreDefinedSetOf (callArgs: Seq of CVal) -> CVal:
    Let mutable setBuilt be a new Seq of CVal.
    Repeat for sa in callArgs:
        If not coreSetHolds(setBuilt, sa):
            Push sa to setBuilt.
    Return a new VSet with items setBuilt.

## To coreDefinedPow (callArgs: Seq of CVal) -> CVal:
    Let powBase be item 1 of callArgs.
    Let powExponent be item 2 of callArgs.
    Inspect powBase:
        When VInt (baseInt):
            Inspect powExponent:
                When VInt (exponentInt):
                    If exponentInt is at least 0:
                        Return a new VInt with value floor(pow(baseInt, exponentInt)).
                    Return a new VFloat with value pow((baseInt + 0.0), exponentInt).
                When VFloat (exponentReal):
                    Return a new VFloat with value pow((baseInt + 0.0), exponentReal).
                Otherwise:
                    Return a new VError with msg "pow() requires numbers".
        When VFloat (baseReal):
            Inspect powExponent:
                When VInt (realExponentInt):
                    Return a new VFloat with value pow(baseReal, realExponentInt).
                When VFloat (realExponentReal):
                    Return a new VFloat with value pow(baseReal, realExponentReal).
                Otherwise:
                    Return a new VError with msg "pow() requires numbers".
        Otherwise:
            Return a new VError with msg "pow() requires numbers".

## To coreDefinedRepeatSeq (callArgs: Seq of CVal) -> CVal:
    Let repeated be item 1 of callArgs.
    Let repeatCountVal be item 2 of callArgs.
    Inspect repeatCountVal:
        When VInt (repeatCount):
            Let repeatedItems be a new Seq of CVal.
            Let mutable repeatIdx be 1.
            While repeatIdx is at most repeatCount:
                Push repeated to repeatedItems.
                Set repeatIdx to repeatIdx + 1.
            Return a new VSeq with items repeatedItems.
        Otherwise:
            Let countType be coreTypeName(repeatCountVal).
            Return a new VError with msg "repeatSeq count must be an Int, got {countType}".

## To coreDefinedCopy (callArgs: Seq of CVal) -> CVal:
    Return item 1 of callArgs.

## To coreDefinedLength (callArgs: Seq of CVal) -> CVal:
    Return coreLengthOf(item 1 of callArgs).

## To coreLengthOf (lengthOf: CVal) -> CVal:
    Inspect lengthOf:
        When VSeq (lenItems):
            Return a new VInt with value (length of lenItems).
        When VSet (lenSetItems):
            Return a new VInt with value (length of lenSetItems).
        When VTuple (lenTupItems):
            Return a new VInt with value (length of lenTupItems).
        When VText (lenText):
            Return a new VInt with value (length of lenText).
        When VMap (lenMap):
