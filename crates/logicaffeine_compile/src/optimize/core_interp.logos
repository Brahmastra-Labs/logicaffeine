## To coreBuiltinTextBytes (args: Seq of CVal) -> CVal:
    Let arg1 be item 1 of args.
    Inspect arg1:
        When VText (text1):
            Let answered be text_bytes(text1).
            Let mutable answeredItems be a new Seq of CVal.
            Repeat for answeredByte in answered:
                Push a new VInt with value answeredByte to answeredItems.
            Return a new VSeq with items answeredItems.
        Otherwise:
            Let got1 be coreTypeName(arg1).
            Return a new VError with msg "text_bytes() requires text, got {got1}".

## To coreBuiltinTextFromBytes (args: Seq of CVal) -> CVal:
    Let arg1 be item 1 of args.
    Inspect arg1:
        When VSeq (seq1):
            Let mutable bytes1 be a new Seq of Int.
            Let mutable byteAt1 be 0.
            Repeat for byte1 in seq1:
                Set byteAt1 to byteAt1 + 1.
                Inspect byte1:
                    When VInt (byteInt1):
                        Push byteInt1 to bytes1.
                    Otherwise:
                        Return a new VError with msg "expected a Seq of Int (bytes); element {byteAt1} is not an Int".
            Return a new VText with value text_from_bytes(bytes1).
        Otherwise:
            Let got1 be coreTypeName(arg1).
            Return a new VError with msg "expected a Seq of Int (bytes), got {got1}".

## To coreBuiltinTimeNow (args: Seq of CVal) -> CVal:
    Return a new VInt with value now().

