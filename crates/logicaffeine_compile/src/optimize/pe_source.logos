                        Inspect peElem:
                            When CText (cmKey):
                                Return a new CBool with value (cnFieldNames contains cmKey).
                            Otherwise:
                                Let skipMapKey be true.
                    If length of cnFields equals 0:
                        Return a new CBool with value false.
                When CNewSeq (peSeqElem12):
                    Return a new CBool with value false.
                When CNewSet (peSetElem11):
                    Return a new CBool with value false.
                When CList (litems):
                    If length of litems equals 0:
                        Return a new CBool with value false.
                    If isLiteral(peElem) and allLiteral(litems):
                        Let clKey be exprToKeyPart(peElem).
                        Repeat for clItem in litems:
                            Let clItemKey be exprToKeyPart(clItem).
                            If clItemKey equals clKey:
                                Return a new CBool with value true.
                        Return a new CBool with value false.
                When CText (ctHay):
                    Inspect peElem:
                        When CText (ctNeedle):
                            Return a new CBool with value (ctHay contains ctNeedle).
                        Otherwise:
                            Let skipTextC be true.
                Otherwise:
                    Let skipContains be true.
            Return a new CContains with coll peColl and elem peElem.
        When CUnion (unionLeft, unionRight):
            Let peLeft be peExpr(unionLeft, state).
            Let peRight be peExpr(unionRight, state).
            Return a new CUnion with left peLeft and right peRight.
        When CIntersection (interLeft, interRight):
            Let peLeft be peExpr(interLeft, state).
            Let peRight be peExpr(interRight, state).
            Return a new CIntersection with left peLeft and right peRight.
        When COptionSome (optInner):
            Let peInner be peExpr(optInner, state).
            Return a new COptionSome with inner peInner.
        When COptionNone:
            Return a new COptionNone.
        When CNothing:
            Return a new CNothing.
        When CDeclaredDefault (pdDefaultType):
            Return e.
        When CSpelled (pdSpelledCode, pdSpelledAwaits):
            Return e.
        When CTuple (tupleItems):
            Let peItems be a new Seq of CExpr.
            Repeat for ti in tupleItems:
                Push peExpr(ti, state) to peItems.
            Return a new CTuple with items peItems.
        When CNew (newTypeName, newFieldNames, newFieldExprs):
            Let peNewFields be a new Seq of CExpr.
            Repeat for nfe in newFieldExprs:
                Push peExpr(nfe, state) to peNewFields.
            Return a new CNew with typeName newTypeName and fieldNames newFieldNames and fields peNewFields.
        When CFieldAccess (faTarget, faField):
            Let peFaTarget be peExpr(faTarget, state).
            Inspect peFaTarget:
                When CNewVariant (nvTag, nvNames, nvVals):
                    Let mutable fidx be 1.
                    Repeat for fname in nvNames:
                        If fname equals faField:
                            Return item fidx of nvVals.
                        Set fidx to fidx + 1.
                When CNew (nType, nNames, nVals):
                    Let mutable fidx be 1.
                    Repeat for fname in nNames:
                        If fname equals faField:
                            Let faHeld be item fidx of nVals.
                            Inspect faHeld:
                                When CDeclaredDefault (faDefaultType):
                                    Let faKept be true.
                                Otherwise:
                                    Return faHeld.
                        Set fidx to fidx + 1.
                Otherwise:
                    Let skip be true.
            Return a new CFieldAccess with target peFaTarget and field faField.
        When CClosure (clParams, clBody, clCaptured):
            Let peClBody be peBlock(clBody, state).
            Return a new CClosure with params clParams and body peClBody and captured clCaptured.
        When CCallExpr (ceTarget, ceArgs):
            Let peCeTarget be peExpr(ceTarget, state).
            Let peCeArgs be a new Seq of CExpr.
            Repeat for ceArg in ceArgs:
                Push peExpr(ceArg, state) to peCeArgs.
            If depth is greater than 0:
                Inspect peCeTarget:
                    When CClosure (ceParams, ceBody, ceCaptured):
                        Let ceApplied be peApplyClosure(ceParams, ceBody, peCeArgs, state).
                        If not isNoUnfold(ceApplied):
                            Return ceApplied.
                    Otherwise:
                        Let ceSkip be true.
            Return a new CCallExpr with target peCeTarget and args peCeArgs.
        When CInterpolatedString (isParts):
            Let peIsParts be a new Seq of CStringPart.
            Let mutable isAllStatic be true.
            Let mutable isText be "".
            Repeat for isPart in isParts:
                Inspect isPart:
                    When CLiteralPart (litVal):
                        Set isText to "{isText}{litVal}".
                        Push a new CLiteralPart with value litVal to peIsParts.
                    When CExprPart (epExpr):
                        Let peEpExpr be peExpr(epExpr, state).
                        Let epShown be peKnownShown(peEpExpr).
                        Inspect epShown:
                            When CText (isShown):
                                Set isText to "{isText}{isShown}".
                                Push a new CLiteralPart with value isShown to peIsParts.
                            Otherwise:
                                Set isAllStatic to false.
                                If peHoleTextPrintable(decompileExpr(peEpExpr)):
                                    Push a new CExprPart with expr peEpExpr to peIsParts.
                                Otherwise:
                                    peShownParts(peEpExpr, peIsParts).
                    When CFormattedPart (fpExpr, fpSpec, fpForm, fpSize):
                        Let peFpExpr be peExpr(fpExpr, state).
                        Let fpKnown be peFormattedKnown(peFpExpr, fpForm, fpSize).
                        Inspect fpKnown:
                            When CText (fpShown):
                                Set isText to "{isText}{fpShown}".
                                Push a new CLiteralPart with value fpShown to peIsParts.
                            Otherwise:
                                Set isAllStatic to false.
                                Push a new CFormattedPart with expr peFpExpr and spec fpSpec and form fpForm and size fpSize to peIsParts.
            If isAllStatic:
                Return a new CText with value isText.
            Return a new CInterpolatedString with parts peIsParts.
        When CDuration (peHeldDuration):
            Return e.
        When CDate (peHeldDate):
            Return e.
        When CMoment (peHeldMoment):
            Return e.
        When CSpan (peHeldSpan):
            Return e.
        When CTime (peHeldTime):
            Return e.
        When CChar (peHeldChar):
            Return e.
        When CTimeNow:
            Return a new CTimeNow.
        When CDateToday:
            Return a new CDateToday.
        When CEscExpr (escCode):
            Return a new CEscExpr with code escCode.
        When CManifestOf (zn):
            Let peZone be peExpr(zn, state).
            Return a new CManifestOf with zn peZone.
        When CChunkAt (idx, zn):
            Let peIdx be peExpr(idx, state).
            Let peZone be peExpr(zn, state).
            Return a new CChunkAt with idx peIdx and zn peZone.

## To collectSetVars (stmts: Seq of CStmt) and (funcs: Map of Text to CFunc) -> Seq of Text:
    Let csvNone be a new Seq of Text.
    Return peScopedSetVars(stmts, funcs, csvNone).

## To peScopedSetVars (stmts: Seq of CStmt) and (funcs: Map of Text to CFunc) and (svOuter: Seq of Text) -> Seq of Text:
    Let mutable svDeclared be copy of svOuter.
    Let mutable result be a new Seq of Text.
    Repeat for s in stmts:
        Let mutable svWrites be a new Seq of Text.
        stmtMutVars(s, funcs, svWrites).
        Let mutable svBinds be a new Seq of Text.
        Inspect s:
            When CLet (svLetName, svLetExpr):
                Push svLetName to svBinds.
            When CSet (setName, setExpr):
                Push setName to svWrites.
            When CPush (wPushE, wPushT):
                Push wPushT to svWrites.
            When CSetIdx (wIdxT, wIdxI, wIdxV):
                Push wIdxT to svWrites.
            When CMapSet (wMapT, wMapK, wMapV):
                Push wMapT to svWrites.
            When CPop (wPopT):
                Push wPopT to svWrites.
            When CPopInto (wPiT, wPiI):
                Push wPiT to svWrites.
                Push wPiI to svWrites.
            When CAdd (wAddE, wAddT):
                Push wAddT to svWrites.
            When CRemove (wRemE, wRemT):
                Push wRemT to svWrites.
            When CSetField (wFldT, wFldF, wFldV):
                Push wFldT to svWrites.
            When CAppendToSeq (wAppT, wAppV):
                Push wAppT to svWrites.
            When CIncrease (wIncT, wIncA):
                Push wIncT to svWrites.
            When CDecrease (wDecT, wDecA):
                Push wDecT to svWrites.
            When CMerge (wMrgT, wMrgO):
                Push wMrgT to svWrites.
            When CJoin (wJnT, wJnO):
                Push wJnT to svWrites.
            When CResolve (wResT):
                Push wResT to svWrites.
            When CResolveTo (wRtT, wRtV):
                Push wRtT to svWrites.
            When CForceDynamic (wFdN):
                Push wFdN to svWrites.
            When CAtPath (wAtT, wAtP, wAtB):
                Push wAtT to svWrites.
            When CReadConsole (wRcT):
                Push wRcT to svWrites.
            When CReadFile (wRfP, wRfT):
                Push wRfT to svWrites.
            When CReceivePipe (wRpC, wRpT):
                Push wRpT to svWrites.
            When CTryReceivePipe (wTrpC, wTrpT):
                Push wTrpT to svWrites.
            When CMount (wMntT, wMntP):
                Push wMntT to svWrites.
            When CSync (wSynT, wSynC):
                Push wSynT to svWrites.
            When CAwaitMessage (wAwT):
                Push wAwT to svWrites.
            When CConnectTo (wConA, wConT):
                Push wConT to svWrites.
            When CSpawn (wSpTy, wSpT):
                Push wSpT to svWrites.
            When CIf (ifCond, ifThen, ifElse):
                Let thenVars be peScopedSetVars(ifThen, funcs, svDeclared).
                Repeat for tv in thenVars:
                    Push tv to svWrites.
                Let elseVars be peScopedSetVars(ifElse, funcs, svDeclared).
                Repeat for ev in elseVars:
                    Push ev to svWrites.
            When CWhile (wCond, wBody):
                Let wVars be peScopedSetVars(wBody, funcs, svDeclared).
                Repeat for wv in wVars:
                    Push wv to svWrites.
            When CRepeat (rVar, rColl, rBody):
                Let mutable rScope be copy of svDeclared.
                Push rVar to rScope.
                Let rVars be peScopedSetVars(rBody, funcs, rScope).
                Repeat for rv in rVars:
                    Push rv to svWrites.
            When CRepeatRange (rrVar, rrStart, rrEnd, rrBody):
                Let mutable rrScope be copy of svDeclared.
                Push rrVar to rrScope.
                Let rrVars be peScopedSetVars(rrBody, funcs, rrScope).
                Repeat for rrv in rrVars:
                    Push rrv to svWrites.
            When CInspect (inspTarget, inspArms):
                Repeat for cinsArm in inspArms:
                    Inspect cinsArm:
                        When CWhen (cwName, cwBindings, cwBody):
                            Let mutable cwScope be copy of svDeclared.
                            Repeat for cwB in cwBindings:
                                Push cwB to cwScope.
                            Let cwVars be peScopedSetVars(cwBody, funcs, cwScope).
                            Repeat for cwv in cwVars:
                                Push cwv to svWrites.
                        When COtherwise (coBody):
                            Let coVars be peScopedSetVars(coBody, funcs, svDeclared).
                            Repeat for cov in coVars:
                                Push cov to svWrites.
            When CSelect (selBranches):
                Repeat for cselBr in selBranches:
                    Inspect cselBr:
                        When CSelectRecv (csrChan, csrVar, csrBody):
                            Let mutable csrScope be copy of svDeclared.
                            Push csrVar to csrScope.
                            Let csrVars be peScopedSetVars(csrBody, funcs, csrScope).
                            Repeat for csrv in csrVars:
                                Push csrv to svWrites.
                        When CSelectTimeout (cstDur, cstBody):
                            Let cstVars be peScopedSetVars(cstBody, funcs, svDeclared).
                            Repeat for cstv in cstVars:
                                Push cstv to svWrites.
                        Otherwise:
                            Let skipCselBr be true.
            When CZone (zoneName, zoneKind, zoneBody):
                Let zVars be peScopedSetVars(zoneBody, funcs, svDeclared).
                Repeat for zv in zVars:
                    Push zv to svWrites.
            When CConcurrent (concBranches):
                Repeat for concBranch in concBranches:
                    Let concVars be peScopedSetVars(concBranch, funcs, svDeclared).
                    Repeat for ccv in concVars:
                        Push ccv to svWrites.
            When CParallel (parBranches):
                Repeat for parBranch in parBranches:
                    Let parVars be peScopedSetVars(parBranch, funcs, svDeclared).
                    Repeat for pcv in parVars:
                        Push pcv to svWrites.
            When CLaunchTask (ltBody, ltHandle):
                Let ltVars be peScopedSetVars(ltBody, funcs, svDeclared).
                Repeat for ltv in ltVars:
                    Push ltv to svWrites.
            Otherwise:
                Let skip be true.
        Repeat for svW in svWrites:
            If not svDeclared contains svW:
                Push svW to result.
        Repeat for svB in svBinds:
            Push svB to svDeclared.
    Return result.

## To isDeadTarget (targetName: Text) and (env: Map of Text to CVal) -> Bool:
    Let tk be "{targetName}".
    If env contains tk:
        Let tv be item tk of env.
        Let tvn be isVNothing(tv).
        If tvn:
            Return false.
        Return true.
    Return false.

## To isPureForDce (e: CExpr) -> Bool:
    If peIsBox(e) or peIsSum(e):
        Return true.
    Inspect e:
        When CInt (pdI):
            Return true.
        When CFloat (pdF):
            Return true.
        When CBool (pdB):
            Return true.
        When CText (pdT):
            Return true.
        When CDuration (pdAtomDuration):
            Return true.
        When CDate (pdAtomDate):
            Return true.
        When CMoment (pdAtomMoment):
            Return true.
        When CSpan (pdAtomSpan):
            Return true.
        When CTime (pdAtomTime):
            Return true.
        When CChar (pdAtomChar):
            Return true.
        When CVar (pdV):
            Return true.
        When CNewSeq (peSeqElem13):
            Return true.
        When CNewSet (peSetElem12):
            Return true.
        When COptionNone:
            Return true.
        When CNothing:
            Return true.
        When CDeclaredDefault (dceDefaultType):
            Return true.
        When CSpelled (dceSpelledCode, dceSpelledAwaits):
            Return true.
        When COptionSome (pdO):
            Return isPureForDce(pdO).
        When CCopy (pdC):
            Return isPureForDce(pdC).
        When CList (pdItems):
            Return allPureForDce(pdItems).
        When CTuple (pdTup):
            Return allPureForDce(pdTup).
        When CNewVariant (pdTag, pdNames, pdVals):
            Return allPureForDce(pdVals).
        When CNew (pdTy, pdFn, pdFv):
            Return allPureForDce(pdFv).
        When CLen (pdLen):
            Return isPureForDce(pdLen).
        When CNot (pdNot):
            Return isPureForDce(pdNot).
        When CBinOp (pdOp, pdL, pdR):
            If peNoFailOp(pdOp) and isPureForDce(pdL):
                Return isPureForDce(pdR).
            Return false.
        Otherwise:
            Return false.

## To peNoFailOp (nfOp: Text) -> Bool:
    If nfOp equals "==" or nfOp equals "!=" or nfOp equals "<" or nfOp equals "<=":
        Return true.
    If nfOp equals ">" or nfOp equals ">=" or nfOp equals "&&" or nfOp equals "||":
        Return true.
    Return false.

## To allPureForDce (es: Seq of CExpr) -> Bool:
    Repeat for apE in es:
        If not isPureForDce(apE):
            Return false.
    Return true.

## To dceBlock (stmts: Seq of CStmt) -> Seq of CStmt:
    Let dcDeclared be a new Seq of Text.
    Let dcMaps be a new Seq of Text.
    Repeat for dcS in stmts:
        Inspect dcS:
            When CLet (dcDn, dcDe):
                Let dcDk be "{dcDn}".
                If not dcDeclared contains dcDk:
                    Push dcDk to dcDeclared.
                Inspect dcDe:
                    When CNew (dcTy, dcFn, dcFv):
                        If peIsMapType(dcTy):
                            Let dcMk be "{dcDn}".
                            Push dcMk to dcMaps.
                    Otherwise:
                        Let dcSkipM be true.
            Otherwise:
                Let dcSkipD be true.
    Let dcEmpty be a new Map of Text to Text.
    Let dcSafeIdx be a new Seq of Int.
    Let mutable dcLens be a new Map of Text to Int.
    Let mutable dcF be 1.
    Repeat for dcFs in stmts:
        Let mutable dcFHandled be false.
        Inspect dcFs:
            When CLet (dfN, dfE):
                Inspect dfE:
                    When CList (dfItems):
                        Let dfNk be "{dfN}".
                        Set item dfNk of dcLens to (length of dfItems).
                        Set dcFHandled to true.
                    When CNewSeq (peSeqElem14):
                        Let dfNk2 be "{dfN}".
                        Set item dfNk2 of dcLens to 0.
                        Set dcFHandled to true.
                    Otherwise:
                        Let dfSkipE be true.
            When CPush (dfPe, dfPt):
                If dcLens contains dfPt:
                    Let dfPtLen be item dfPt of dcLens.
                    Let dfPtK be "{dfPt}".
                    Set item dfPtK of dcLens to dfPtLen + 1.
                    Set dcFHandled to true.
            When CSetIdx (dfT, dfI, dfV):
                If dcLens contains dfT:
                    Inspect dfI:
                        When CInt (dfPos):
                            If dfPos is at least 1 and dfPos is at most (item dfT of dcLens):
                                Push dcF to dcSafeIdx.
                                Set dcFHandled to true.
                        Otherwise:
                            Let dfSkipI be true.
            Otherwise:
                Let dfSkipS be true.
        If not dcFHandled:
            Let dfOne be a new Seq of CStmt.
            Push dcFs to dfOne.
            Let dfRefs be a new Seq of Text.
            Let dfWrites be a new Seq of Text.
            Let dfJunk be renameStmts(dfOne, dcEmpty, dfRefs, dfWrites).
            If dfRefs contains "__pe_unsupported":
                Set dcLens to a new Map of Text to Int.
            Otherwise:
                Repeat for dfX in dfRefs:
                    If dcLens contains dfX:
                        Remove dfX from dcLens.
                Repeat for dfW in dfWrites:
                    If dcLens contains dfW:
                        Remove dfW from dcLens.
                Inspect dcFs:
                    When CLet (dfLn, dfLe):
                        If dcLens contains dfLn:
                            Remove dfLn from dcLens.
                    Otherwise:
                        Let dfSkipL be true.
        Set dcF to dcF + 1.
    Let mutable dcLive be a new Seq of Text.
    Let mutable dcAllLive be false.
    Let dcRev be a new Seq of CStmt.
    Let mutable dcI be length of stmts.
    While dcI is at least 1:
        Let dcSt be item dcI of stmts.
        Let mutable dcDrop be false.
        If not dcAllLive:
            Inspect dcSt:
                When CLet (dlN, dlE):
                    If dcDeclared contains dlN:
                        If not dcLive contains dlN:
                            If isPureForDce(dlE):
                                Set dcDrop to true.
                When CSet (dsN, dsE):
                    If dcDeclared contains dsN:
                        If not dcLive contains dsN:
                            If isPureForDce(dsE):
                                Set dcDrop to true.
                When CPush (dpE, dpT):
                    If dcDeclared contains dpT:
                        If not dcLive contains dpT:
                            If isPureForDce(dpE):
                                Set dcDrop to true.
                When CMapSet (dmT, dmK, dmV):
                    If dcDeclared contains dmT:
                        If not dcLive contains dmT:
                            If isPureForDce(dmK) and isPureForDce(dmV):
                                Set dcDrop to true.
                When CRemove (drE, drT):
                    If dcDeclared contains drT:
                        If not dcLive contains drT:
                            If isPureForDce(drE):
                                Set dcDrop to true.
                When CAdd (daE, daT):
                    If dcDeclared contains daT:
                        If not dcLive contains daT:
                            If isPureForDce(daE):
                                Set dcDrop to true.
                When CSetIdx (dxT, dxK, dxV):
                    If dcMaps contains dxT or dcSafeIdx contains dcI:
                        If dcDeclared contains dxT:
                            If not dcLive contains dxT:
                                If isPureForDce(dxK) and isPureForDce(dxV):
                                    Set dcDrop to true.
                Otherwise:
                    Let dcSkipK be true.
        If not dcDrop:
            Push dcSt to dcRev.
            Let dcOne be a new Seq of CStmt.
            Push dcSt to dcOne.
            Let dcRefs be a new Seq of Text.
            Let dcWrites be a new Seq of Text.
            Let dcJunk be renameStmts(dcOne, dcEmpty, dcRefs, dcWrites).
            If dcRefs contains "__pe_unsupported":
                Set dcAllLive to true.
            Inspect dcSt:
                When CLet (klN, klE):
                    Let dcKilled be a new Seq of Text.
                    Repeat for dcL in dcLive:
                        If dcL equals klN:
                            Let dcSkipL be true.
                        Otherwise:
                            Push dcL to dcKilled.
                    Set dcLive to dcKilled.
                Otherwise:
                    Let dcSkipKill be true.
            Repeat for dcR in dcRefs:
                If not dcLive contains dcR:
                    Push dcR to dcLive.
            Repeat for dcW in dcWrites:
                If not dcLive contains dcW:
                    Push dcW to dcLive.
        Set dcI to dcI - 1.
    Let dcOut be a new Seq of CStmt.
    Let mutable dcJ be length of dcRev.
    While dcJ is at least 1:
        Push (item dcJ of dcRev) to dcOut.
        Set dcJ to dcJ - 1.
    Return peCoalesceUpdates(peSinkLets(peDeepDce(dcOut))).

## To peWritesOnly (woS: CStmt) and (woDead: Seq of Text) -> Bool:
    Inspect woS:
        When CLet (woN, woE):
            If woDead contains woN:
                Return isPureForDce(woE).
            Return false.
        When CSet (woN2, woE2):
            If woDead contains woN2:
                Return isPureForDce(woE2).
            Return false.
        When CSetIdx (woT, woI, woV):
            If woDead contains woT:
                If isPureForDce(woI):
                    Return isPureForDce(woV).
            Return false.
        When CMapSet (woT2, woK, woV2):
            If woDead contains woT2:
                If isPureForDce(woK):
                    Return isPureForDce(woV2).
            Return false.
        When CPush (woPe, woPt):
            If woDead contains woPt:
                Return isPureForDce(woPe).
            Return false.
        When CAdd (woAe, woAt):
            If woDead contains woAt:
                Return isPureForDce(woAe).
            Return false.
        When CRemove (woRe, woRt):
            If woDead contains woRt:
                Return isPureForDce(woRe).
            Return false.
        When CSetField (woFt, woFf, woFv):
            If woDead contains woFt:
                Return isPureForDce(woFv).
            Return false.
        Otherwise:
            Return false.

## To peExprWritesAny (ewE: CExpr) and (ewDead: Seq of Text) -> Bool:
    Let ewMap be a new Map of Text to Text.
    Let mutable ewRefs be a new Seq of Text.
    Let mutable ewWrites be a new Seq of Text.
    Let ewWalked be renameExpr(ewE, ewMap, ewRefs, ewWrites).
    Repeat for ewW in ewWrites:
        If ewDead contains ewW:
            Return true.
    Return false.

## To peStrandedWrites (swStmts: Seq of CStmt) and (swDead: Seq of Text) and (swOut: mutable Seq of Text):
    Repeat for swS in swStmts:
        If not peWritesOnly(swS, swDead):
            Let mutable swOpen be true.
            Inspect swS:
                When CIf (swIc, swIt, swIe):
                    If not peExprWritesAny(swIc, swDead):
                        peStrandedWrites(swIt, swDead, swOut).
                        peStrandedWrites(swIe, swDead, swOut).
                        Set swOpen to false.
                When CWhile (swWc, swWb):
                    If not peExprWritesAny(swWc, swDead):
                        peStrandedWrites(swWb, swDead, swOut).
                        Set swOpen to false.
                When CRepeat (swRv, swRc, swRb):
                    If not peExprWritesAny(swRc, swDead):
                        peStrandedWrites(swRb, swDead, swOut).
                        Set swOpen to false.
                When CRepeatRange (swGv, swGs, swGe, swGb):
                    If not peExprWritesAny(swGs, swDead):
                        If not peExprWritesAny(swGe, swDead):
                            peStrandedWrites(swGb, swDead, swOut).
                            Set swOpen to false.
                When CInspect (swNt, swNa):
                    If not peExprWritesAny(swNt, swDead):
                        Repeat for swArm in swNa:
                            Inspect swArm:
                                When CWhen (swWn, swWbs, swWbody):
                                    peStrandedWrites(swWbody, swDead, swOut).
                                When COtherwise (swOb):
                                    peStrandedWrites(swOb, swDead, swOut).
                        Set swOpen to false.
                When CZone (swZn, swZk, swZb):
                    peStrandedWrites(swZb, swDead, swOut).
                    Set swOpen to false.
                Otherwise:
                    Let swSkip be true.
            If swOpen:
                Let swOne be a new Seq of CStmt.
                Push swS to swOne.
                Let swMap be a new Map of Text to Text.
                Let mutable swRefs be a new Seq of Text.
                Let mutable swWrites be a new Seq of Text.
                Let swWalked be renameStmts(swOne, swMap, swRefs, swWrites).
                Inspect swS:
                    When CLet (swLn, swLe):
                        Let swLk be "{swLn}".
                        Push swLk to swWrites.
                    Otherwise:
                        Let swSkip2 be true.
                Repeat for swW in swWrites:
                    If swDead contains swW:
                        If not swOut contains swW:
                            Let swWk be "{swW}".
                            Push swWk to swOut.

## To peDropDeadWrites (dwStmts: Seq of CStmt) and (dwDead: Seq of Text) -> Seq of CStmt:
    Let mutable dwOut be a new Seq of CStmt.
    Repeat for dwS in dwStmts:
        If not peWritesOnly(dwS, dwDead):
            Inspect dwS:
                When CIf (dwIc, dwIt, dwIe):
                    Push (a new CIf with cond dwIc and thenBlock peDropDeadWrites(dwIt, dwDead) and elseBlock peDropDeadWrites(dwIe, dwDead)) to dwOut.
                When CWhile (dwWc, dwWb):
                    Push (a new CWhile with cond dwWc and body peDropDeadWrites(dwWb, dwDead)) to dwOut.
                When CRepeat (dwRv, dwRc, dwRb):
                    Push (a new CRepeat with var dwRv and coll dwRc and body peDropDeadWrites(dwRb, dwDead)) to dwOut.
                When CRepeatRange (dwGv, dwGs, dwGe, dwGb):
                    Push (a new CRepeatRange with var dwGv and start dwGs and end dwGe and body peDropDeadWrites(dwGb, dwDead)) to dwOut.
                When CInspect (dwNt, dwNa):
                    Let mutable dwArms be a new Seq of CMatchArm.
                    Repeat for dwArm in dwNa:
                        Inspect dwArm:
                            When CWhen (dwWn, dwWbs, dwWbody):
                                Push (a new CWhen with variantName dwWn and bindings dwWbs and body peDropDeadWrites(dwWbody, dwDead)) to dwArms.
                            When COtherwise (dwOb):
                                Push (a new COtherwise with body peDropDeadWrites(dwOb, dwDead)) to dwArms.
                    Push (a new CInspect with target dwNt and arms dwArms) to dwOut.
                When CZone (dwZn, dwZk, dwZb):
                    Push (a new CZone with name dwZn and kind dwZk and body peDropDeadWrites(dwZb, dwDead)) to dwOut.
                Otherwise:
                    Push dwS to dwOut.
    Return dwOut.

## To peCountRefs (crName: Text) and (crStmts: Seq of CStmt) -> Int:
    Let crMap be a new Map of Text to Text.
    Let mutable crRefs be a new Seq of Text.
    Let mutable crWrites be a new Seq of Text.
    Let crWalked be renameStmts(crStmts, crMap, crRefs, crWrites).
    Let mutable crN be 0.
    Repeat for crR in crRefs:
        If crR equals crName:
            Set crN to crN + 1.
    If crRefs contains "__pe_unsupported":
        Return 1000000.
    Return crN.

## To peStmtWrites (swS: CStmt) -> Seq of Text:
    Let swOne be a new Seq of CStmt.
    Push swS to swOne.
    Let swMap be a new Map of Text to Text.
    Let mutable swRefs be a new Seq of Text.
    Let mutable swWrites be a new Seq of Text.
    Let swWalked be renameStmts(swOne, swMap, swRefs, swWrites).
    Inspect swS:
        When CLet (swLn, swLe):
            Let swLk be "{swLn}".
            Push swLk to swWrites.
        Otherwise:
            Let swSkip be true.
    If swRefs contains "__pe_unsupported":
        Push "*" to swWrites.
    Return swWrites.

## To peLeadsWith (lwE: CExpr) and (lwName: Text) -> Bool:
    Return peLeadsWithExpr(lwE, a new CVar with name lwName).

## To peLeadsWithExpr (lwE: CExpr) and (lwX: CExpr) -> Bool:
    If peSameExpr(lwE, lwX):
        Return true.
    Inspect lwE:
        When CBinOp (lwOp, lwL, lwR):
            If peLeadsWithExpr(lwL, lwX):
                Return true.
            If lwOp equals "&&" or lwOp equals "||":
                Return false.
            If isPureForDce(lwL):
                Return peLeadsWithExpr(lwR, lwX).
            Return false.
        When CNot (lwI):
            Return peLeadsWithExpr(lwI, lwX).
        When CLen (lwT):
            Return peLeadsWithExpr(lwT, lwX).
        When CCopy (lwCt):
            Return peLeadsWithExpr(lwCt, lwX).
        When CInterpolatedString (lwParts):
            Repeat for lwPart in lwParts:
                Let mutable lwPartExpr be a new CNothing.
                Let mutable lwHasExpr be false.
                Inspect lwPart:
                    When CExprPart (lwPe):
                        Set lwPartExpr to lwPe.
                        Set lwHasExpr to true.
                    When CFormattedPart (lwFe, lwFs, lwFf, lwFz):
                        Set lwPartExpr to lwFe.
                        Set lwHasExpr to true.
                    Otherwise:
                        Let lwLiteral be true.
                If lwHasExpr:
                    If peLeadsWithExpr(lwPartExpr, lwX):
                        Return true.
                    If not isPureForDce(lwPartExpr):
                        Return false.
            Return false.
        When CIndex (lwC, lwI2):
            Let mutable lwPair be a new Seq of CExpr.
            Push lwC to lwPair.
            Push lwI2 to lwPair.
            Return peLeadsWithin(lwPair, lwX).
        When CCall (lwF, lwArgs):
            Return peLeadsWithin(lwArgs, lwX).
        When CRange (lwRs, lwRe):
            Let mutable lwBounds be a new Seq of CExpr.
            Push lwRs to lwBounds.
            Push lwRe to lwBounds.
            Return peLeadsWithin(lwBounds, lwX).
        When CList (lwItems):
            Return peLeadsWithin(lwItems, lwX).
        When CTuple (lwTup):
            Return peLeadsWithin(lwTup, lwX).
        When CNewVariant (lwTag, lwNames, lwVals):
            Return peLeadsWithin(lwVals, lwX).
        When CNew (lwTy, lwFn, lwFv):
            Return peLeadsWithin(lwFv, lwX).
        Otherwise:
            Return false.

## To peLeadsWithin (lsEs: Seq of CExpr) and (lsX: CExpr) -> Bool:
    Repeat for lsE in lsEs:
        If peLeadsWithExpr(lsE, lsX):
            Return true.
        If not isPureForDce(lsE):
            Return false.
    Return false.

## To peHasHead (hhS: CStmt) -> Bool:
    Inspect hhS:
        When CLet (hhLn, hhLe):
            Return true.
        When CSet (hhSn, hhSe):
            Return true.
        When CReturn (hhR):
            Return true.
        When CShow (hhW):
            Return true.
        When CIf (hhC, hhT, hhE):
            Return true.
        When CPush (hhPe, hhPt):
            Return true.
        When CRepeat (hhRv, hhRc, hhRb):
            Return true.
        When CCallS (hhCn, hhCa):
            Return true.
        When CSetIdx (hhXt, hhXi, hhXv):
            Return true.
        When CFail (hhFr):
            Return true.
        Otherwise:
            Return false.

## To peHeadOf (hoS: CStmt) -> CExpr:
    Inspect hoS:
        When CLet (hoLn, hoLe):
            Return hoLe.
        When CSet (hoSn, hoSe):
            Return hoSe.
        When CReturn (hoR):
            Return hoR.
        When CShow (hoW):
            Return hoW.
        When CIf (hoC, hoT, hoE):
            Return hoC.
        When CPush (hoPe, hoPt):
            Return hoPe.
        When CRepeat (hoRv, hoRc, hoRb):
            Return hoRc.
        When CCallS (hoCn, hoCa):
            Return a new CCall with name hoCn and args hoCa.
        When CFail (hoFr):
            Return hoFr.
        When CSetIdx (hoXt, hoXi, hoXv):
            Let mutable hoStored be a new Seq of CExpr.
            Push hoXi to hoStored.
            Push hoXv to hoStored.
            Return a new CList with items hoStored.
        Otherwise:
            Return a new CNothing.

## To peWithHead (whS: CStmt) and (whE: CExpr) -> CStmt:
    Inspect whS:
        When CLet (whLn, whLe):
            Return a new CLet with name whLn and expr whE.
        When CSet (whSn, whSe):
            Return a new CSet with name whSn and expr whE.
        When CReturn (whR):
            Return a new CReturn with expr whE.
        When CShow (whW):
            Return a new CShow with expr whE.
        When CIf (whC, whT, whF):
            Return a new CIf with cond whE and thenBlock whT and elseBlock whF.
        When CPush (whPe, whPt):
            Return a new CPush with expr whE and target whPt.
        When CRepeat (whRv, whRc, whRb):
            Return a new CRepeat with var whRv and coll whE and body whRb.
        When CCallS (whCn, whCa):
            Inspect whE:
                When CCall (whEn, whEa):
                    Return a new CCallS with name whEn and args whEa.
                Otherwise:
                    Return whS.
        When CFail (whFr):
            Return a new CFail with reason whE.
        When CSetIdx (whXt, whXi, whXv):
            Inspect whE:
                When CList (whStored):
                    If length of whStored equals 2:
                        Return a new CSetIdx with target whXt and idx (item 1 of whStored) and val (item 2 of whStored).
                    Return whS.
                Otherwise:
                    Return whS.
        Otherwise:
            Return whS.

## To peFreshValue (fvE: CExpr) -> Bool:
    Inspect fvE:
        When CCopy (fvT):
            Return true.
        When CCall (fvN, fvA):
            Return true.
        When CList (fvItems):
            Return true.
        When CNewSeq (fvElem):
            Return true.
        Otherwise:
            Return false.

## To peForwardLets (fwStmts: Seq of CStmt) -> Seq of CStmt:
    Let mutable fwCur be fwStmts.
    Let mutable fwI be length of fwCur.
    While fwI is at least 1:
        Let fwS be item fwI of fwCur.
        Inspect fwS:
            When CLet (fwName, fwExpr):
                If fwI is less than length of fwCur:
                    Let fwTail be peTailOf(fwCur, fwI + 1).
                    If peCountRefs(fwName, fwTail) equals 1:
                        Let fwPure be isPureForDce(fwExpr).
                        Let fwReads be peExprRefs(fwExpr).
                        Let fwN be length of fwCur.
                        Let mutable fwJ be fwI + 1.
                        Let mutable fwFound be 0.
                        Let mutable fwBlocked be false.
                        While fwJ is at most fwN and fwFound equals 0 and not fwBlocked:
                            Let fwT be item fwJ of fwCur.
                            Let fwOne be a new Seq of CStmt.
                            Push fwT to fwOne.
                            Let fwW be peStmtWrites(fwT).
                            If fwW contains fwName or fwW contains "*":
                                Set fwBlocked to true.
                            Otherwise:
                                If peCountRefs(fwName, fwOne) is greater than 0:
                                    Set fwFound to fwJ.
                                Otherwise:
                                    If not fwPure and not peInertStmt(fwT):
                                        Set fwBlocked to true.
                                    Repeat for fwWn in fwW:
                                        If fwReads contains fwWn:
                                            Set fwBlocked to true.
                            Set fwJ to fwJ + 1.
                        If fwFound is greater than 0 and not fwBlocked:
                            Let fwUse be item fwFound of fwCur.
                            If peHasHead(fwUse):
                                Let fwHead be peHeadOf(fwUse).
                                Let mutable fwInHead be 0.
                                Repeat for fwR in peExprRefs(fwHead):
                                    If fwR equals fwName:
                                        Set fwInHead to fwInHead + 1.
                                Let mutable fwOk be fwInHead equals 1.
                                If fwOk and not fwPure:
                                    Set fwOk to peLeadsWith(fwHead, fwName).
                                Let fwSubst be substExpr(fwHead, fwName, fwExpr).
                                Inspect fwUse:
                                    When CRepeat (fwRv, fwRc, fwRb):
                                        Inspect fwRc:
                                            When CRange (fwRs, fwRe):
                                                Let fwBound be true.
                                            Otherwise:
                                                If not peFreshValue(fwExpr):
                                                    Set fwOk to false.
                                    Otherwise:
                                        Let fwSkipR be true.
                                If fwOk and (peExprRefs(fwSubst) contains fwName):
                                    Set fwOk to false.
                                If fwOk and not peHolesPrintable(fwSubst):
                                    Set fwOk to false.
                                If fwOk:
                                    Let fwNew be peWithHead(fwUse, fwSubst).
                                    Let mutable fwNext be a new Seq of CStmt.
                                    Let mutable fwK be 1.
                                    Repeat for fwX in fwCur:
                                        If fwK equals fwFound:
                                            Push fwNew to fwNext.
                                        Otherwise:
                                            If not (fwK equals fwI):
                                                Push fwX to fwNext.
                                        Set fwK to fwK + 1.
                                    Set fwCur to fwNext.
            Otherwise:
                Let fwSkip be true.
        Set fwI to fwI - 1.
    Return fwCur.

## To peHoleTextPrintable (htText: Text) -> Bool:
    If htText contains chr(34) or htText contains "{{" or htText contains "}}":
        Return false.
    Let mutable htAfter be "".
    Let mutable htAtColon be false.
    Repeat for htCh in htText:
        Let htC be "{htCh}".
        If htAtColon:
            Set htAfter to htC.
            Set htAtColon to false.
        If htC equals ":":
            Set htAtColon to true.
            Set htAfter to "".
    If htAfter equals "":
        Return true.
    Return not (".<>^$0123456789" contains htAfter).

## To peHolesPrintableAll (haExprs: Seq of CExpr) -> Bool:
    Repeat for haE in haExprs:
        If not peHolesPrintable(haE):
            Return false.
    Return true.

## To peHolesPrintable (hpE: CExpr) -> Bool:
    Inspect hpE:
        When CInterpolatedString (hpParts):
            Repeat for hpPart in hpParts:
                Inspect hpPart:
                    When CExprPart (hpX):
                        Inspect hpX:
                            When CInterpolatedString (hpNested):
                                Let hpFlattened be true.
                            Otherwise:
                                If not peHoleTextPrintable(decompileExpr(hpX)):
                                    Return false.
                        If not peHolesPrintable(hpX):
                            Return false.
                    When CFormattedPart (hpFx, hpFspec, hpFform, hpFsize):
                        Let hpFtext be decompileExpr(hpFx).
                        If hpFtext contains chr(34) or hpFtext contains "{{" or hpFtext contains "}}":
                            Return false.
                        If not peHolesPrintable(hpFx):
                            Return false.
                    Otherwise:
                        Let hpSkipL be true.
            Return true.
        When CBinOp (hpOp, hpL, hpR):
            Return peHolesPrintable(hpL) and peHolesPrintable(hpR).
        When CNot (hpI):
            Return peHolesPrintable(hpI).
        When CCall (hpCn, hpCa):
            Return peHolesPrintableAll(hpCa).
        When CCallExpr (hpCt, hpCea):
            Return peHolesPrintable(hpCt) and peHolesPrintableAll(hpCea).
        When CIndex (hpIc, hpIx):
            Return peHolesPrintable(hpIc) and peHolesPrintable(hpIx).
        When CLen (hpLt):
            Return peHolesPrintable(hpLt).
        When CMapGet (hpMt, hpMk):
            Return peHolesPrintable(hpMt) and peHolesPrintable(hpMk).
        When CNewVariant (hpVt, hpVn, hpVv):
            Return peHolesPrintableAll(hpVv).
        When CNew (hpNt, hpNn, hpNf):
            Return peHolesPrintableAll(hpNf).
        When CList (hpLi):
            Return peHolesPrintableAll(hpLi).
        When CTuple (hpTi):
            Return peHolesPrintableAll(hpTi).
        When CRange (hpRs, hpRe):
            Return peHolesPrintable(hpRs) and peHolesPrintable(hpRe).
        When CSlice (hpSc, hpSs, hpSe):
            Return peHolesPrintable(hpSc) and peHolesPrintable(hpSs) and peHolesPrintable(hpSe).
        When CCopy (hpCp):
            Return peHolesPrintable(hpCp).
        When CContains (hpKc, hpKe):
            Return peHolesPrintable(hpKc) and peHolesPrintable(hpKe).
        When CUnion (hpUl, hpUr):
            Return peHolesPrintable(hpUl) and peHolesPrintable(hpUr).
        When CIntersection (hpXl, hpXr):
            Return peHolesPrintable(hpXl) and peHolesPrintable(hpXr).
        When COptionSome (hpOs):
            Return peHolesPrintable(hpOs).
        When CFieldAccess (hpFt, hpFf):
            Return peHolesPrintable(hpFt).
        When CManifestOf (hpMz):
            Return peHolesPrintable(hpMz).
        When CChunkAt (hpCi, hpCz):
            Return peHolesPrintable(hpCi) and peHolesPrintable(hpCz).
        When CClosure (hpClp, hpClb, hpClc):
            Return false.
        Otherwise:
            Return true.

## To peDropSubsumedStores (ssStmts: Seq of CStmt) -> Seq of CStmt:
    Let mutable ssOut be a new Seq of CStmt.
    Let mutable ssDeclared be a new Seq of Text.
    Let ssN be length of ssStmts.
    Let mutable ssI be 1.
    Repeat for ssS in ssStmts:
        Let mutable ssDrop be false.
        Let mutable ssName be "".
        Let mutable ssExpr be a new CNothing.
        Let mutable ssStore be false.
        Inspect ssS:
            When CLet (ssLn, ssLe):
                Set ssName to ssLn.
                Set ssExpr to ssLe.
                Set ssStore to true.
            When CSet (ssSn, ssSe):
                If ssDeclared contains ssSn:
                    Set ssName to ssSn.
                    Set ssExpr to ssSe.
                    Set ssStore to true.
            Otherwise:
                Let ssSkip be true.
        If ssStore and ssI is less than ssN and peSimpleExpr(ssExpr) and not isPureForDce(ssExpr):
            If peCountRefs(ssName, peTailOf(ssStmts, ssI + 1)) equals 0:
                Let ssNext be item (ssI + 1) of ssStmts.
                If peHasHead(ssNext):
                    Set ssDrop to peLeadsWithExpr(peHeadOf(ssNext), ssExpr).
        If not ssDrop:
            Push ssS to ssOut.
        Inspect ssS:
            When CLet (ssDn, ssDe):
                Push ssDn to ssDeclared.
            Otherwise:
                Let ssSkipD be true.
        Set ssI to ssI + 1.
    Return ssOut.

## To peIsBreakOnly (boStmts: Seq of CStmt) -> Bool:
    If not (length of boStmts equals 1):
        Return false.
    Let boOnly be item 1 of boStmts.
    Inspect boOnly:
        When CBreak:
            Return true.
        Otherwise:
            Return false.

## To peNegate (ngE: CExpr) -> CExpr:
    Inspect ngE:
        When CNot (ngInner):
            Return ngInner.
        Otherwise:
            Return a new CNot with inner ngE.

## To peNormalizeWhile (nwCond: CExpr) and (nwBody: Seq of CStmt) -> CStmt:
    Inspect nwCond:
        When CBool (nwB):
            If nwB and length of nwBody is greater than 1:
                Let nwFirst be item 1 of nwBody.
                Inspect nwFirst:
                    When CIf (nwC, nwT, nwE):
                        If peIsBreakOnly(nwT) and length of nwE equals 0:
                            Return a new CWhile with cond peNegate(nwC) and body peTailOf(nwBody, 2).
                        If peIsBreakOnly(nwE) and length of nwT equals 0:
                            Return a new CWhile with cond nwC and body peTailOf(nwBody, 2).
                    Otherwise:
                        Let nwSkipS be true.
        Otherwise:
            Let nwSkip be true.
    Return a new CWhile with cond nwCond and body nwBody.

## To peIsArgsCall (acE: CExpr) -> Bool:
    Inspect acE:
        When CCall (acName, acArgs):
            Return (acName equals "args") and (length of acArgs equals 0).
        Otherwise:
            Return false.

## To peIsSeqSource (ssE: CExpr) and (ssPrefix: Seq of CStmt) and (ssOuter: Seq of Text) -> Bool:
    Let ssNoKinds be a new Map of Text to Text.
    Return peIsSeqSourceKinds(ssE, ssPrefix, ssOuter, ssNoKinds).

## To peIsSeqSourceKinds (ssE: CExpr) and (ssPrefix: Seq of CStmt) and (ssOuter: Seq of Text) and (ssKinds: Map of Text to Text) -> Bool:
    If peIsArgsCall(ssE):
        Return true.
    Inspect ssE:
        When CRange (ssRs, ssRe):
            Return false.
        Otherwise:
            Let ssNotRange be true.
    If peStartsWith(peKindOf(ssE, ssKinds), "List of "):
        Return true.
    Inspect ssE:
        When CList (ssItems):
            Return true.
        When CNewSeq (ssElem):
            Return true.
        When CCopy (ssInner):
            Return peIsSeqSourceKinds(ssInner, ssPrefix, ssOuter, ssKinds).
        When CVar (ssV):
            Let mutable ssI be length of ssPrefix.
            While ssI is at least 1:
                Let ssS be item ssI of ssPrefix.
                Inspect ssS:
                    When CLet (ssLn, ssLe):
                        If ssLn equals ssV:
                            Return peIsSeqSourceKinds(ssLe, peSlice(ssPrefix, 1, ssI - 1), ssOuter, ssKinds).
                    Otherwise:
                        Let ssSkip be true.
                Set ssI to ssI - 1.
            Return ssOuter contains ssV.
        Otherwise:
            Return false.

## To peCopyLoops (clStmts: Seq of CStmt) and (clOuter: Seq of Text) -> Seq of CStmt:
    Let clNoKinds be a new Map of Text to Text.
    Return peCopyLoopsKinds(clStmts, clOuter, clNoKinds).

## To peCopiedItem (ciE: CExpr) and (ciVar: Text) -> Bool:
    Inspect ciE:
        When CVar (ciV):
            Return ciV equals ciVar.
        When CCopy (ciC):
            Inspect ciC:
                When CVar (ciCv):
                    Return ciCv equals ciVar.
                Otherwise:
                    Return false.
        Otherwise:
            Return false.

## To peCopyLoopsKinds (clStmts: Seq of CStmt) and (clOuter: Seq of Text) and (clKinds: Map of Text to Text) -> Seq of CStmt:
    Let mutable clOut be a new Seq of CStmt.
    Let clN be length of clStmts.
    Let mutable clI be 1.
    While clI is at most clN:
        Let clS be item clI of clStmts.
        Let mutable clDone be false.
        If clI is less than clN:
            Inspect clS:
                When CLet (clB, clInit):
                    Inspect clInit:
                        When CNewSeq (clElem):
                            Let clNext be item (clI + 1) of clStmts.
                            Inspect clNext:
                                When CRepeat (clX, clColl, clBody):
                                    If length of clBody equals 1 and peIsSeqSourceKinds(clColl, clOut, clOuter, clKinds):
                                        Let clOnly be item 1 of clBody.
                                        Inspect clOnly:
                                            When CPush (clPe, clPt):
                                                If clPt equals clB:
                                                    If peCopiedItem(clPe, clX) and not (peExprRefs(clColl) contains clB):
                                                        Let clBk be "{clB}".
                                                        Push (a new CLet with name clBk and expr (a new CCopy with target clColl)) to clOut.
                                                        Set clDone to true.
                                            Otherwise:
                                                Let clSkipP be true.
                                Otherwise:
                                    Let clSkipR be true.
                        Otherwise:
                            Let clSkipI be true.
                Otherwise:
                    Let clSkipL be true.
        If clDone:
            Set clI to clI + 2.
        Otherwise:
            Push clS to clOut.
            Set clI to clI + 1.
    Return clOut.

## To peFreshCopies (fcE: CExpr) -> CExpr:
    Inspect fcE:
        When CCopy (fcT):
            If peIsArgsCall(fcT):
                Return fcT.
            Return a new CCopy with target peFreshCopies(fcT).
        When CBinOp (fcOp, fcLl, fcRr):
            Return a new CBinOp with op fcOp and left peFreshCopies(fcLl) and right peFreshCopies(fcRr).
        When CNot (fcI):
            Return a new CNot with inner peFreshCopies(fcI).
        When CCall (fcN, fcArgs):
            Return a new CCall with name fcN and args peFreshCopiesAll(fcArgs).
        When CCallExpr (fcTg, fcCa):
            Return a new CCallExpr with target peFreshCopies(fcTg) and args peFreshCopiesAll(fcCa).
        When CIndex (fcC, fcX):
            Return a new CIndex with coll peFreshCopies(fcC) and idx peFreshCopies(fcX).
        When CMapGet (fcMt, fcMk):
            Return a new CMapGet with target peFreshCopies(fcMt) and key peFreshCopies(fcMk).
        When CLen (fcL):
            Return a new CLen with target peFreshCopies(fcL).
        When CContains (fcCc, fcCe):
            Return a new CContains with coll peFreshCopies(fcCc) and elem peFreshCopies(fcCe).
        When CList (fcItems):
            Return a new CList with items peFreshCopiesAll(fcItems).
        When CTuple (fcTitems):
            Return a new CTuple with items peFreshCopiesAll(fcTitems).
        When CNewVariant (fcVt, fcVn, fcVv):
            Return a new CNewVariant with tag fcVt and fnames fcVn and fvals peFreshCopiesAll(fcVv).
        When CNew (fcNt, fcNn, fcNf):
            Return a new CNew with typeName fcNt and fieldNames fcNn and fields peFreshCopiesAll(fcNf).
        When CRange (fcRs, fcRe):
            Return a new CRange with start peFreshCopies(fcRs) and end peFreshCopies(fcRe).
        When CSlice (fcSc, fcSs, fcSe):
            Return a new CSlice with coll peFreshCopies(fcSc) and startIdx peFreshCopies(fcSs) and endIdx peFreshCopies(fcSe).
        When CUnion (fcUl, fcUr):
            Return a new CUnion with left peFreshCopies(fcUl) and right peFreshCopies(fcUr).
        When CIntersection (fcIl, fcIr):
            Return a new CIntersection with left peFreshCopies(fcIl) and right peFreshCopies(fcIr).
        When COptionSome (fcOs):
            Return a new COptionSome with inner peFreshCopies(fcOs).
        When CFieldAccess (fcFa, fcFf):
            Return a new CFieldAccess with target peFreshCopies(fcFa) and field fcFf.
        When CInterpolatedString (fcParts):
            Let mutable fcNewParts be a new Seq of CStringPart.
            Repeat for fcPart in fcParts:
                Inspect fcPart:
                    When CExprPart (fcPe):
                        Push (a new CExprPart with expr peFreshCopies(fcPe)) to fcNewParts.
                    When CFormattedPart (fcFe, fcFs, fcFf2, fcFz):
                        Push (a new CFormattedPart with expr peFreshCopies(fcFe) and spec fcFs and form fcFf2 and size fcFz) to fcNewParts.
                    Otherwise:
                        Push fcPart to fcNewParts.
            Return a new CInterpolatedString with parts fcNewParts.
        Otherwise:
            Return fcE.

## To peFreshCopiesAll (fcEs: Seq of CExpr) -> Seq of CExpr:
    Let mutable fcOut be a new Seq of CExpr.
    Repeat for fcX in fcEs:
        Push peFreshCopies(fcX) to fcOut.
    Return fcOut.

## To peFreshCopiesIn (fsStmts: Seq of CStmt) -> Seq of CStmt:
    Let mutable fsOut be a new Seq of CStmt.
    Repeat for fsS in fsStmts:
        If peHasHead(fsS):
            Push peWithHead(fsS, peFreshCopies(peHeadOf(fsS))) to fsOut.
        Otherwise:
            Push fsS to fsOut.
    Return fsOut.

## To peInertStmt (inS: CStmt) -> Bool:
    Inspect inS:
        When CLet (inLn, inLe):
            Return isPureForDce(inLe).
        When CSet (inSn, inSe):
            Return isPureForDce(inSe).
        Otherwise:
            Return false.

## To peStmtReads (srS: CStmt) and (srName: Text) -> Bool:
    Let srOne be a new Seq of CStmt.
    Push srS to srOne.
    Return peCountRefs(srName, srOne) is greater than 0.

## To peWritesName (wnS: CStmt) and (wnName: Text) -> Bool:
    Let wnW be peStmtWrites(wnS).
    Return (wnW contains wnName) or (wnW contains "*").

## To peNoReadAfterWrite (raStmts: Seq of CStmt) and (raCopy: Text) and (raOrig: Text) and (raWrote: Bool) and (raOk: mutable Seq of Bool) -> Bool:
    Let mutable raW be raWrote.
    Repeat for raS in raStmts:
        If peWritesName(raS, raOrig):
            Push false to raOk.
        Inspect raS:
            When CIf (raC, raT, raE):
                If raW and (peExprRefs(raC) contains raOrig):
                    Push false to raOk.
                Let raTw be peNoReadAfterWrite(raT, raCopy, raOrig, raW, raOk).
                Let raEw be peNoReadAfterWrite(raE, raCopy, raOrig, raW, raOk).
                Set raW to raTw or raEw.
            When CLet (raLn, raLe):
                If raW and (peExprRefs(raLe) contains raOrig):
                    Push false to raOk.
            When CSet (raSn, raSe):
                If raW and (peExprRefs(raSe) contains raOrig):
                    Push false to raOk.
                If raSn equals raCopy:
                    Set raW to true.
            Otherwise:
                If peStmtReads(raS, raOrig) and (raW or peWritesName(raS, raCopy)):
                    Push false to raOk.
                If peWritesName(raS, raCopy):
                    Set raW to true.
    Return raW.

## To peFirstFallible (ffE: CExpr) and (ffFound: mutable Seq of CExpr) -> Bool:
    Inspect ffE:
        When CBinOp (ffOp, ffL, ffR):
            If peFirstFallible(ffL, ffFound):
                Return true.
            If ffOp equals "&&" or ffOp equals "||":
                If isPureForDce(ffR):
                    Return false.
                Push ffE to ffFound.
                Return true.
            If peFirstFallible(ffR, ffFound):
                Return true.
            If peNoFailOp(ffOp):
                Return false.
            Push ffE to ffFound.
            Return true.
        When CNot (ffI):
            Return peFirstFallible(ffI, ffFound).
        When CLen (ffLen):
            Return peFirstFallible(ffLen, ffFound).
        When CIndex (ffColl, ffAt):
            If peFirstFallible(ffColl, ffFound):
                Return true.
            If peFirstFallible(ffAt, ffFound):
                Return true.
            Push ffE to ffFound.
            Return true.
        When CCall (ffFn, ffArgs):
            If peIsArgsCall(ffE):
                Return false.
            If peFirstFallibleOf(ffArgs, ffFound):
                Return true.
            Push ffE to ffFound.
            Return true.
        When CVar (ffV):
            Return false.
        When CInt (ffN):
            Return false.
        When CFloat (ffX):
            Return false.
        When CBool (ffB):
            Return false.
        When CText (ffT):
            Return false.
        When CNewSeq (ffElem):
            Return false.
        When CList (ffItems):
            Return peFirstFallibleOf(ffItems, ffFound).
        When CTuple (ffTup):
            Return peFirstFallibleOf(ffTup, ffFound).
        When CRange (ffRs, ffRe):
            If peFirstFallible(ffRs, ffFound):
                Return true.
            Return peFirstFallible(ffRe, ffFound).
        When CNewVariant (ffTag, ffNs, ffVs):
            Return peFirstFallibleOf(ffVs, ffFound).
        When CNew (ffTy, ffFns, ffFvs):
            Return peFirstFallibleOf(ffFvs, ffFound).
        When CInterpolatedString (ffParts):
            Repeat for ffPart in ffParts:
                Inspect ffPart:
                    When CExprPart (ffPx):
                        If peFirstFallible(ffPx, ffFound):
                            Return true.
                    When CFormattedPart (ffFx, ffFs, ffFf, ffFz):
                        Push ffE to ffFound.
                        Return true.
                    Otherwise:
                        Let ffSkipL be true.
            Return false.
        Otherwise:
            Push ffE to ffFound.
            Return true.

## To peFirstFallibleOf (foEs: Seq of CExpr) and (foFound: mutable Seq of CExpr) -> Bool:
    Repeat for foE in foEs:
        If peFirstFallible(foE, foFound):
            Return true.
    Return false.

## To peStmtFirstFallible (sfS: CStmt) and (sfFound: mutable Seq of CExpr) -> Bool:
    Inspect sfS:
        When CSetIdx (sfT, sfAt, sfV):
            If peFirstFallible(sfAt, sfFound):
                Return true.
            If peFirstFallible(sfV, sfFound):
                Return true.
            Let sfTk be "{sfT}".
            Let mutable sfStored be a new Seq of CExpr.
            Push (a new CVar with name sfTk) to sfStored.
            Push sfAt to sfStored.
            Push (a new CCall with name "__pe_store" and args sfStored) to sfFound.
            Return true.
        Otherwise:
            If not peHasHead(sfS):
                Return false.
            Return peFirstFallible(peHeadOf(sfS), sfFound).

## To peTextAfter (taText: Text) and (taSkip: Int) -> Text:
    Let mutable taAt be 1.
    Let mutable taOut be "".
    Repeat for taCh in taText:
        If taAt is greater than taSkip:
            Set taOut to "{taOut}{taCh}".
        Set taAt to taAt + 1.
    Return taOut.

## To peKindElement (keKind: Text) -> Text:
    If peStartsWith(keKind, "List of "):
        Return peTextAfter(keKind, 8).
    If keKind equals "Text":
        Return "Text".
    If keKind equals "":
        Return "".
    Return "?".

## To peKindJoin (kjA: Text) and (kjB: Text) -> Text:
    If kjA equals "":
        Return kjB.
    If kjB equals "":
        Return kjA.
    If kjA equals kjB:
        Return kjA.
    If peStartsWith(kjA, "List of ") and peStartsWith(kjB, "List of "):
        Let kjItems be peKindJoin(peTextAfter(kjA, 8), peTextAfter(kjB, 8)).
        Return "List of {kjItems}".
    Return "?".

## To peKindArith (kaA: Text) and (kaB: Text) -> Text:
    If kaA equals "?" or kaB equals "?":
        Return "?".
    If kaA equals "" or kaB equals "":
        Return "".
    If kaA equals "Int" and kaB equals "Int":
        Return "Int".
    Let kaNumbers be (kaA equals "Int" or kaA equals "Real") and (kaB equals "Int" or kaB equals "Real").
    If kaNumbers:
        Return "Real".
    Return "?".

## To peKindIntOnly (kiA: Text) and (kiB: Text) -> Text:
    If kiA equals "?" or kiB equals "?":
        Return "?".
    If kiA equals "" or kiB equals "":
        Return "".
    If kiA equals "Int" and kiB equals "Int":
        Return "Int".
    Return "?".

## To peKindOfType (ktType: Text) -> Text:
    If ktType equals "Int" or ktType equals "mutable Int":
        Return "Int".
    If ktType equals "Real" or ktType equals "Float" or ktType equals "mutable Real" or ktType equals "mutable Float":
        Return "Real".
    If ktType equals "Text" or ktType equals "mutable Text":
        Return "Text".
    If peStartsWith(ktType, "Seq of "):
        Let ktItems be peKindOfType(peTextAfter(ktType, 7)).
        Return "List of {ktItems}".
    If peStartsWith(ktType, "mutable Seq of "):
        Let ktOwnItems be peKindOfType(peTextAfter(ktType, 15)).
        Return "List of {ktOwnItems}".
    Return "?".

## To peKindOf (koE: CExpr) and (koKinds: Map of Text to Text) -> Text:
    Inspect koE:
        When CInt (koI):
            Return "Int".
        When CFloat (koF):
            Return "Real".
        When CText (koT):
            Return "Text".
        When CInterpolatedString (koParts):
            Return "Text".
        When CNewSeq (koElem):
            Let koElemKind be peKindOfType(koElem).
            Return "List of {koElemKind}".
        When CList (koItems):
            Let mutable koJoined be "".
            Repeat for koItem in koItems:
                Set koJoined to peKindJoin(koJoined, peKindOf(koItem, koKinds)).
            Return "List of {koJoined}".
        When CIndex (koColl, koAt):
            Return peKindElement(peKindOf(koColl, koKinds)).
        When CTuple (koTup):
            Return "Tuple".
        When CRange (koStart, koEnd):
            Return "List of Int".
        When CLen (koLen):
            Return "Int".
        When CCopy (koCopied):
            Return peKindOf(koCopied, koKinds).
        When CVar (koV):
            Let koK be "{koV}".
            If koKinds contains koK:
                Return item koK of koKinds.
            Return "?".
        When CCall (koFn, koArgs):
            If peIsArgsCall(koE):
                Return "List of Text".
            If koFn equals "parseInt" and length of koArgs equals 1:
                Return "Int".
            Return "?".
        When CBool (koTruth):
            Return "Bool".
        When CNot (koNegated):
            If peKindOf(koNegated, koKinds) equals "Bool":
                Return "Bool".
            Return "?".
        When CBinOp (koOp, koL, koR):
            Let koA be peKindOf(koL, koKinds).
            Let koB be peKindOf(koR, koKinds).
            If koOp equals "+" or koOp equals "-" or koOp equals "*" or koOp equals "/" or koOp equals "//":
                Return peKindArith(koA, koB).
            If koOp equals "%" or koOp equals "**":
                Return peKindIntOnly(koA, koB).
            If koOp equals "==" or koOp equals "!=" or koOp equals "<" or koOp equals ">" or koOp equals "<=" or koOp equals ">=":
                Return "Bool".
            If koOp equals "&&" or koOp equals "||":
                If koA equals "Bool" and koB equals "Bool":
                    Return "Bool".
                Return "?".
            Return "?".
        Otherwise:
            Return "?".

## To peKindLeaf (klS: CStmt) and (klKeep: Text) and (klOpaque: mutable Seq of Text) -> Bool:
    Let klW be peStmtWrites(klS).
    If klW contains "*":
        Return false.
    Repeat for klN in klW:
        If not (klN equals klKeep):
            Let klNk be "{klN}".
            Push klNk to klOpaque.
    Return true.

## To peKindHeader (khE: CExpr) and (khOpaque: mutable Seq of Text) -> Bool:
    Return peKindLeaf(a new CLet with name "__pe_kind_probe" and expr khE, "__pe_kind_probe", khOpaque).

## To peKindWrite (kwName: Text) and (kwExpr: CExpr) and (kwNames: mutable Seq of Text) and (kwExprs: mutable Seq of CExpr):
    Let kwNk be "{kwName}".
    Push kwNk to kwNames.
    Push kwExpr to kwExprs.

## To peKindNote (knStmts: Seq of CStmt) and (knNames: mutable Seq of Text) and (knExprs: mutable Seq of CExpr) and (knOpaque: mutable Seq of Text) -> Bool:
    Repeat for knS in knStmts:
        Let mutable knOk be true.
        Inspect knS:
            When CLet (knLn, knLe):
                Set knOk to peKindLeaf(knS, knLn, knOpaque).
                peKindWrite(knLn, knLe, knNames, knExprs).
            When CSet (knSn, knSe):
                Set knOk to peKindLeaf(knS, knSn, knOpaque).
                peKindWrite(knSn, knSe, knNames, knExprs).
            When CPush (knPe, knPt):
                Set knOk to peKindLeaf(knS, knPt, knOpaque).
                Let mutable knPushed be a new Seq of CExpr.
                Push knPe to knPushed.
                peKindWrite(knPt, a new CList with items knPushed, knNames, knExprs).
            When CSetIdx (knXt, knXi, knXv):
                Set knOk to peKindLeaf(knS, knXt, knOpaque).
                Let mutable knStored be a new Seq of CExpr.
                Push knXv to knStored.
                peKindWrite(knXt, a new CList with items knStored, knNames, knExprs).
            When CPop (knPopT):
                Set knOk to peKindLeaf(knS, knPopT, knOpaque).
            When CIf (knC, knT, knE):
                Set knOk to peKindHeader(knC, knOpaque) and peKindNote(knT, knNames, knExprs, knOpaque) and peKindNote(knE, knNames, knExprs, knOpaque).
            When CWhile (knWc, knWb):
                Set knOk to peKindHeader(knWc, knOpaque) and peKindNote(knWb, knNames, knExprs, knOpaque).
            When CRepeat (knRv, knRc, knRb):
                peKindWrite(knRv, a new CIndex with coll knRc and idx (a new CInt with value 1), knNames, knExprs).
                Set knOk to peKindHeader(knRc, knOpaque) and peKindNote(knRb, knNames, knExprs, knOpaque).
            When CRepeatRange (knQv, knQs, knQe, knQb):
                peKindWrite(knQv, a new CInt with value 0, knNames, knExprs).
                Set knOk to peKindHeader(knQs, knOpaque) and peKindHeader(knQe, knOpaque) and peKindNote(knQb, knNames, knExprs, knOpaque).
            When CInspect (knNt, knArms):
                Set knOk to peKindHeader(knNt, knOpaque).
                Repeat for knA in knArms:
                    Inspect knA:
                        When CWhen (knWn, knWbs, knWbody):
                            Repeat for knBound in knWbs:
                                Let knBk be "{knBound}".
                                Push knBk to knOpaque.
                            If not peKindNote(knWbody, knNames, knExprs, knOpaque):
                                Set knOk to false.
                        When COtherwise (knObody):
                            If not peKindNote(knObody, knNames, knExprs, knOpaque):
                                Set knOk to false.
            Otherwise:
                Set knOk to peKindLeaf(knS, "", knOpaque).
        If not knOk:
            Return false.
    Return true.

## To peKinds (kdStmts: Seq of CStmt) and (kdParams: Seq of Text) and (kdTypes: Seq of Text) and (kdMutating: Seq of Text) -> Map of Text to Text:
    Let mutable kdOut be a new Map of Text to Text.
    If peCallsAnyOf(kdStmts, kdMutating):
        Return kdOut.
    Let mutable kdNames be a new Seq of Text.
    Let mutable kdExprs be a new Seq of CExpr.
    Let mutable kdOpaque be a new Seq of Text.
    If not peKindNote(kdStmts, kdNames, kdExprs, kdOpaque):
        Return a new Map of Text to Text.
    Let mutable kdI be 1.
    Repeat for kdP in kdParams:
        If kdI is at most length of kdTypes:
            Let kdPk be "{kdP}".
            Set item kdPk of kdOut to peKindOfType(item kdI of kdTypes).
        Set kdI to kdI + 1.
    Repeat for kdN in kdNames:
        Let kdNk be "{kdN}".
        If not kdOut contains kdNk:
            Set item kdNk of kdOut to "".
    Repeat for kdO in kdOpaque:
        Let kdOk be "{kdO}".
        Set item kdOk of kdOut to "?".
    Let mutable kdChanged be true.
    While kdChanged:
        Set kdChanged to false.
        Let mutable kdJ be 1.
        Repeat for kdW in kdNames:
            Let kdWk be "{kdW}".
            Let kdOld be item kdWk of kdOut.
            Let kdNew be peKindJoin(kdOld, peKindOf(item kdJ of kdExprs, kdOut)).
            If not (kdNew equals kdOld):
                Set item kdWk of kdOut to kdNew.
                Set kdChanged to true.
            Set kdJ to kdJ + 1.
    Return kdOut.

## To peOrTerms (otE: CExpr) and (otOut: mutable Seq of CExpr):
    Inspect otE:
        When CBinOp (otOp, otL, otR):
            If otOp equals "||":
                peOrTerms(otL, otOut).
                peOrTerms(otR, otOut).
                Return.
        Otherwise:
            Let otAtom be true.
    Push otE to otOut.

## To peIsZero (izE: CExpr) -> Bool:
    Inspect izE:
        When CInt (izN):
            Return izN equals 0.
        Otherwise:
            Return false.

## To peLiteralLength (llColl: CExpr) -> Int:
    Inspect llColl:
        When CList (llItems):
            Return length of llItems.
        When CText (llText):
            Return length of llText.
        Otherwise:
            Return -1.

## To peIsLengthOf (ilE: CExpr) and (ilColl: CExpr) -> Bool:
    Inspect ilE:
        When CLen (ilLc):
            Return peSameExpr(ilLc, ilColl).
        When CInt (ilN):
            Let ilKnown be peLiteralLength(ilColl).
            Return ilKnown is at least 0 and ilN equals ilKnown.
        Otherwise:
            Return false.

## To peIsMinusLengthOf (imE: CExpr) and (imColl: CExpr) -> Bool:
    Inspect imE:
        When CBinOp (imOp, imL, imR):
            Return (imOp equals "-") and peIsZero(imL) and peIsLengthOf(imR, imColl).
        When CInt (imN):
            Let imKnown be peLiteralLength(imColl).
            Return imKnown is at least 0 and imN equals 0 - imKnown.
        Otherwise:
            Return false.

## To peIndexAtom (iaE: CExpr) and (iaAt: CExpr) and (iaColl: CExpr) -> Bool:
    Inspect iaE:
        When CBool (iaB):
            Return not iaB.
        When CBinOp (iaOp, iaL, iaR):
            If not peSameExpr(iaL, iaAt):
                Return false.
            If iaOp equals "==":
                Return peIsZero(iaR).
            If iaOp equals ">":
                Return peIsLengthOf(iaR, iaColl).
            If iaOp equals "<":
                Return peIsMinusLengthOf(iaR, iaColl).
            Return false.
        Otherwise:
            Return false.

## To peIsLiteralPart (lpPart: CStringPart) and (lpText: Text) -> Bool:
    Inspect lpPart:
        When CLiteralPart (lpV):
            Return lpV equals lpText.
        Otherwise:
            Return false.

## To peIsExprPart (epPart: CStringPart) and (epAt: CExpr) -> Bool:
    Inspect epPart:
        When CExprPart (epX):
            Return peSameExpr(epX, epAt).
        Otherwise:
            Return false.

## To peIndexReport (irReason: CExpr) and (irAt: CExpr) -> Bool:
    Inspect irReason:
        When CText (irMsg):
            Inspect irAt:
                When CInt (irK):
                    Return irMsg equals "Index {irK} out of bounds".
                Otherwise:
                    Return false.
        When CInterpolatedString (irParts):
            If not (length of irParts equals 3):
                Return false.
            Return peIsLiteralPart(item 1 of irParts, "Index ") and peIsExprPart(item 2 of irParts, irAt) and peIsLiteralPart(item 3 of irParts, " out of bounds").
        Otherwise:
            Return false.

## To peIndexGuard (igCond: CExpr) and (igReason: CExpr) and (igColl: CExpr) and (igAt: CExpr) and (igKinds: Map of Text to Text) -> Bool:
    If not (peKindOf(igAt, igKinds) equals "Int"):
        Return false.
    If not peIndexReport(igReason, igAt):
        Return false.
    Let mutable igTerms be a new Seq of CExpr.
    peOrTerms(igCond, igTerms).
    Let mutable igTests be 0.
    Repeat for igT in igTerms:
        If not peIndexAtom(igT, igAt, igColl):
            Return false.
        Inspect igT:
            When CBool (igB):
                Let igNoTest be true.
            Otherwise:
                Set igTests to igTests + 1.
    Return igTests is greater than 0.

## To peGuardOfStep (goCond: CExpr) and (goReason: CExpr) and (goStep: CExpr) and (goKinds: Map of Text to Text) -> Bool:
    Inspect goStep:
        When CIndex (goColl, goAt):
            Let goRead be peKindOf(goColl, goKinds).
            If peStartsWith(goRead, "List of ") or goRead equals "Text" or goRead equals "Tuple":
                Return peIndexGuard(goCond, goReason, goColl, goAt, goKinds).
            Return false.
        When CCall (goFn, goArgs):
            If goFn equals "__pe_store" and length of goArgs equals 2:
                If peStartsWith(peKindOf(item 1 of goArgs, goKinds), "List of "):
                    Return peIndexGuard(goCond, goReason, item 1 of goArgs, item 2 of goArgs, goKinds).
            Return false.
        When CBinOp (goOp, goL, goR):
            Inspect goReason:
                When CText (goMsg):
                    Let goExpected be peGuardCondition(goOp, peKindOf(goL, goKinds), peKindOf(goR, goKinds), goMsg, goL, goR).
                    If isNoUnfold(goExpected):
                        Return false.
                    Return peSameExpr(goCond, goExpected).
                Otherwise:
                    Return false.
        Otherwise:
            Return false.

## To peGuardSubsumed (gsGuard: CStmt) and (gsNext: CStmt) and (gsKinds: Map of Text to Text) -> Bool:
    Inspect gsGuard:
        When CIf (gsC, gsT, gsE):
            If not (length of gsT equals 1 and length of gsE equals 0):
                Return false.
            Inspect item 1 of gsT:
                When CFail (gsReason):
                    Let mutable gsFound be a new Seq of CExpr.
                    If not peStmtFirstFallible(gsNext, gsFound):
                        Return false.
                    Return peGuardOfStep(gsC, gsReason, item 1 of gsFound, gsKinds).
                Otherwise:
                    Return false.
        Otherwise:
            Return false.

## To peEndsInFail (efStmts: Seq of CStmt) -> Bool:
    Let efN be length of efStmts.
    If efN equals 0:
        Return false.
    Inspect item efN of efStmts:
        When CFail (efReason):
            Return true.
        Otherwise:
            Return false.

## To peTextParts (tpE: CExpr) and (tpOut: mutable Seq of CStringPart) -> Bool:
    Inspect tpE:
        When CInterpolatedString (tpParts):
            Repeat for tpP in tpParts:
                Push tpP to tpOut.
            Return true.
        When CText (tpT):
            Push (a new CLiteralPart with value tpT) to tpOut.
            Return true.
        Otherwise:
            Return false.

## To peAppendedTo (apE: CExpr) and (apName: Text) and (apRest: mutable Seq of CStringPart) -> Bool:
    Inspect apE:
        When CInterpolatedString (apParts):
            If length of apParts is less than 2:
                Return false.
            Inspect item 1 of apParts:
                When CExprPart (apFirst):
                    Inspect apFirst:
                        When CVar (apV):
                            If not (apV equals apName):
                                Return false.
                        Otherwise:
                            Return false.
                Otherwise:
                    Return false.
            Let mutable apI be 1.
            Repeat for apP in apParts:
                If apI is greater than 1:
                    Push apP to apRest.
                Set apI to apI + 1.
            Let apTail be a new CInterpolatedString with parts apRest.
            Return not (peExprRefs(apTail) contains apName).
        Otherwise:
            Return false.

## To peWrittenText (wtS: CStmt) and (wtName: Text) and (wtOut: mutable Seq of CStringPart) -> Bool:
    Inspect wtS:
        When CLet (wtLn, wtLe):
            If wtLn equals wtName:
                Return peTextParts(wtLe, wtOut).
            Return false.
        When CSet (wtSn, wtSe):
            If wtSn equals wtName:
                Return peTextParts(wtSe, wtOut).
            Return false.
        Otherwise:
            Return false.

## To peWithText (wxS: CStmt) and (wxParts: Seq of CStringPart) -> CStmt:
    Let wxText be a new CInterpolatedString with parts wxParts.
    Inspect wxS:
        When CLet (wxLn, wxLe):
            Return a new CLet with name wxLn and expr wxText.
        When CSet (wxSn, wxSe):
            Return a new CSet with name wxSn and expr wxText.
        Otherwise:
            Return wxS.

## To peMergeAppends (maStmts: Seq of CStmt) -> Seq of CStmt:
    Let mutable maOut be a new Seq of CStmt.
    Repeat for maS in maStmts:
        Let mutable maMerged be false.
        Let maN be length of maOut.
        If maN is greater than 0:
            Inspect maS:
                When CSet (maName, maE):
                    Let mutable maRest be a new Seq of CStringPart.
                    If peAppendedTo(maE, maName, maRest):
                        Let maPrev be item maN of maOut.
                        Let mutable maParts be a new Seq of CStringPart.
                        If peWrittenText(maPrev, maName, maParts):
                            Repeat for maR in maRest:
                                Push maR to maParts.
                            Set item maN of maOut to peWithText(maPrev, maParts).
                            Set maMerged to true.
                Otherwise:
                    Let maOther be true.
        If not maMerged:
            Push maS to maOut.
    Return maOut.

## To peTruthOf (toE: CExpr) and (toKinds: Map of Text to Text) -> CExpr:
    Inspect toE:
        When CNot (toOnce):
            Inspect toOnce:
                When CNot (toTwice):
                    If peKindOf(toTwice, toKinds) equals "Bool":
                        Return peTruthOf(toTwice, toKinds).
                Otherwise:
                    Let toSingle be true.
        Otherwise:
            Let toPlain be true.
    Return toE.

## To peRestTest (rtCond: CExpr) and (rtOp: Text) and (rtLeft: CExpr) -> CExpr:
    Inspect rtCond:
        When CBinOp (rtCop, rtCl, rtCr):
            If rtCop equals rtOp and peSameExpr(rtCl, rtLeft):
                Return rtCr.
        Otherwise:
            Let rtWhole be true.
    Return rtCond.

## To peSameBlock (sbA: Seq of CStmt) and (sbB: Seq of CStmt) -> Bool:
    Return decompileBlock(sbA, 0) equals decompileBlock(sbB, 0).

## To peFusedTest (ftLeft: CExpr) and (ftOp: Text) and (ftInner: Seq of CStmt) and (ftShown: Seq of CStmt) and (ftOut: mutable Seq of CStmt) -> Bool:
    Let ftN be length of ftInner.
    If ftN is less than 1 or ftN is greater than 2:
        Return false.
    Let mutable ftQ be "".
    Let mutable ftE be a new CNothing.
    If ftN equals 2:
        Inspect item 1 of ftInner:
            When CLet (ftQl, ftEl):
                Set ftQ to ftQl.
                Set ftE to ftEl.
            Otherwise:
                Return false.
    Inspect item ftN of ftInner:
        When CIf (ftC, ftT, ftF):
            If length of ftF is greater than 0 or not peSameBlock(ftT, ftShown):
                Return false.
            Let ftRest be peRestTest(ftC, ftOp, ftLeft).
            Let mutable ftRight be ftRest.
            If ftN equals 2:
                Let ftOne be a new Seq of CStmt.
                Push (a new CReturn with expr ftRest) to ftOne.
                If not (peCountRefs(ftQ, ftOne) equals 1) or not peLeadsWith(ftRest, ftQ):
                    Return false.
                If peExprRefs(ftLeft) contains ftQ:
                    Return false.
                Set ftRight to substExpr(ftRest, ftQ, ftE).
            Let ftJoined be a new CBinOp with op ftOp and left ftLeft and right ftRight.
            Let ftNoElse be a new Seq of CStmt.
            Push (a new CIf with cond ftJoined and thenBlock ftShown and elseBlock ftNoElse) to ftOut.
            Return true.
        Otherwise:
            Return false.

## To peFuseShortCircuits (fsStmts: Seq of CStmt) and (fsKinds: Map of Text to Text) -> Seq of CStmt:
    Let mutable fsOut be a new Seq of CStmt.
    Let fsN be length of fsStmts.
    Let mutable fsAt be 1.
    While fsAt is at most fsN:
        Let fsS be item fsAt of fsStmts.
        Let mutable fsFused be false.
        Let mutable fsTaken be 1.
        Inspect fsS:
            When CIf (fsC, fsT, fsE):
                Let mutable fsCond be fsC.
                Let mutable fsThen be fsT.
                Let mutable fsElse be fsE.
                If length of fsT equals 0 and length of fsE is greater than 0:
                    Inspect fsC:
                        When CNot (fsNegated):
                            If peKindOf(fsNegated, fsKinds) equals "Bool":
                                Set fsCond to fsNegated.
                                Set fsThen to fsE.
                                Set fsElse to a new Seq of CStmt.
                        Otherwise:
                            Let fsPositive be true.
                Let fsA be peTruthOf(fsCond, fsKinds).
                If isPureForDce(fsA) and peKindOf(fsA, fsKinds) equals "Bool":
                    If length of fsElse equals 0:
                        If length of fsThen equals 1 or length of fsThen equals 2:
                            Inspect item (length of fsThen) of fsThen:
                                When CIf (fsIc, fsIt, fsIf):
                                    Set fsFused to peFusedTest(fsA, "&&", fsThen, fsIt, fsOut).
                                Otherwise:
                                    Let fsNotAnd be true.
                        If not fsFused and length of fsThen is greater than 0 and peExits(fsThen):
                            Let mutable fsWidth be 1.
                            While fsWidth is at most 2 and not fsFused:
                                If fsAt + fsWidth is at most fsN:
                                    Let mutable fsScoped be true.
                                    If fsWidth equals 2:
                                        Inspect item (fsAt + 1) of fsStmts:
                                            When CLet (fsQn, fsQe):
                                                If peCountRefs(fsQn, peTailOf(fsStmts, fsAt + 3)) is greater than 0:
                                                    Set fsScoped to false.
                                            Otherwise:
                                                Set fsScoped to false.
                                    If fsScoped and fsAt + fsWidth is less than fsN:
                                        If peGuardSubsumed(item (fsAt + fsWidth) of fsStmts, item (fsAt + fsWidth + 1) of fsStmts, fsKinds):
                                            Set fsScoped to false.
                                    If fsScoped:
                                        Let fsRest be peSlice(fsStmts, fsAt + 1, fsAt + fsWidth).
                                        Set fsFused to peFusedTest(fsA, "||", fsRest, fsThen, fsOut).
                                        If fsFused:
                                            Set fsTaken to fsWidth + 1.
                                Set fsWidth to fsWidth + 1.
                    Otherwise:
                        If length of fsThen is greater than 0:
                            Set fsFused to peFusedTest(fsA, "||", fsElse, fsThen, fsOut).
            Otherwise:
                Let fsOther be true.
        If not fsFused:
            Push fsS to fsOut.
        Set fsAt to fsAt + fsTaken.
    Return fsOut.

## To peCoalesceAliases (caStmts: Seq of CStmt) -> Seq of CStmt:
    Let mutable caCur be caStmts.
    Let mutable caChanged be true.
    While caChanged:
        Set caChanged to false.
        Let mutable caI be 1.
        Let caN be length of caCur.
        While caI is at most caN and not caChanged:
            Inspect item caI of caCur:
                When CLet (caL, caInit):
                    Inspect caInit:
                        When CVar (caX):
                            If not (caX equals caL):
                                Let caRest be peTailOf(caCur, caI + 1).
                                Let mutable caOk be a new Seq of Bool.
                                Let caWrote be peNoReadAfterWrite(caRest, caL, caX, false, caOk).
                                If length of caOk equals 0:
                                    Let mutable caMap be a new Map of Text to Text.
                                    Let caXk be "{caX}".
                                    Set item caL of caMap to caXk.
                                    Let mutable caJr be a new Seq of Text.
                                    Let mutable caJw be a new Seq of Text.
                                    Let caRenamed be renameStmts(caRest, caMap, caJr, caJw).
                                    If not (caJr contains "__pe_unsupported"):
                                        Let mutable caNext be peSlice(caCur, 1, caI - 1).
                                        Repeat for caR in caRenamed:
                                            Push caR to caNext.
                                        Set caCur to caNext.
                                        Set caChanged to true.
                        Otherwise:
                            Let caOther be true.
                Otherwise:
                    Let caNotLet be true.
            Set caI to caI + 1.
    Return caCur.

## To peKnownValue (kvE: CExpr) -> Bool:
    If isLiteral(kvE):
        Return true.
    Inspect kvE:
        When CVar (kvV):
            Return true.
        Otherwise:
            Return false.

## To peCopyFactsForget (cfFacts: mutable Map of Text to CExpr) and (cfWritten: Seq of Text):
    Let mutable cfGone be a new Seq of Text.
    Repeat for (cfK, cfV) in cfFacts:
        Let mutable cfDrop be (cfWritten contains cfK) or (cfWritten contains "*").
        Inspect cfV:
            When CVar (cfW):
                If cfWritten contains cfW:
                    Set cfDrop to true.
            Otherwise:
                Let cfConst be true.
        If cfDrop:
            Let cfKk be "{cfK}".
            Push cfKk to cfGone.
    Repeat for cfG in cfGone:
        Remove cfG from cfFacts.

## To peDropKnownCopies (dkStmts: Seq of CStmt) and (dkFacts0: Map of Text to CExpr) -> Seq of CStmt:
    Let mutable dkFacts be copy of dkFacts0.
    Let mutable dkOut be a new Seq of CStmt.
    Repeat for dkS in dkStmts:
        Let mutable dkKeep be true.
        Inspect dkS:
            When CSet (dkName, dkE):
                Let dkNk be "{dkName}".
                If peKnownValue(dkE) and dkFacts contains dkNk:
                    If peSameExpr(item dkNk of dkFacts, dkE):
                        Set dkKeep to false.
            Otherwise:
                Let dkNotSet be true.
        If dkKeep:
            Let mutable dkEmit be dkS.
            Inspect dkS:
                When CIf (dkC, dkT, dkF):
                    Set dkEmit to a new CIf with cond dkC and thenBlock peDropKnownCopies(dkT, dkFacts) and elseBlock peDropKnownCopies(dkF, dkFacts).
                Otherwise:
                    Let dkPlain be true.
            Push dkEmit to dkOut.
            peCopyFactsForget(dkFacts, peStmtWrites(dkS)).
            Inspect dkS:
                When CLet (dkLn, dkLe):
                    If peKnownValue(dkLe) and not peSameExpr(dkLe, a new CVar with name dkLn):
                        Let dkLk be "{dkLn}".
                        Set item dkLk of dkFacts to dkLe.
                When CSet (dkSn, dkSe):
                    If peKnownValue(dkSe) and not peSameExpr(dkSe, a new CVar with name dkSn):
                        Let dkSk be "{dkSn}".
                        Set item dkSk of dkFacts to dkSe.
                Otherwise:
                    Let dkNoFact be true.
    Return dkOut.

## To peCutAfterExit (ceStmts: Seq of CStmt) -> Seq of CStmt:
    Let mutable ceOut be a new Seq of CStmt.
    Repeat for ceS in ceStmts:
        Push ceS to ceOut.
        Let mutable ceOne be a new Seq of CStmt.
        Push ceS to ceOne.
        If peExits(ceOne):
            Return ceOut.
    Return ceOut.

## To peFlattenGuards (fgStmts: Seq of CStmt) -> Seq of CStmt:
    Let fgN be length of fgStmts.
    If fgN equals 0:
        Return fgStmts.
    Let fgLast be item fgN of fgStmts.
    Inspect fgLast:
        When CIf (fgC, fgT, fgE):
            If length of fgE is greater than 0 and peEndsInFail(fgT):
                Let mutable fgOut be peSlice(fgStmts, 1, fgN - 1).
                Let fgNoElse be a new Seq of CStmt.
                Push (a new CIf with cond fgC and thenBlock fgT and elseBlock fgNoElse) to fgOut.
                Repeat for fgX in peFlattenGuards(fgE):
                    Push fgX to fgOut.
                Return fgOut.
        Otherwise:
            Let fgKeep be true.
    Return fgStmts.

## To peDropSubsumedGuards (dgStmts: Seq of CStmt) and (dgKinds: Map of Text to Text) -> Seq of CStmt:
    Let mutable dgOut be a new Seq of CStmt.
    Let dgN be length of dgStmts.
    Let mutable dgI be 1.
    Repeat for dgS in dgStmts:
        Let mutable dgDrop be false.
        If dgI is less than dgN:
            Set dgDrop to peGuardSubsumed(dgS, item (dgI + 1) of dgStmts, dgKinds).
        If not dgDrop:
            Push dgS to dgOut.
        Set dgI to dgI + 1.
    Return dgOut.

## To peFoldAliases (faStmts: Seq of CStmt) -> Seq of CStmt:
    Let faN be length of faStmts.
    Let mutable faI be 1.
    Repeat for faS in faStmts:
        Inspect faS:
            When CLet (faL, faInit):
                Inspect faInit:
                    When CVar (faX):
                        If not (faX equals faL):
                            Let faRest be peTailOf(faStmts, faI + 1).
                            Let faNames be [faX].
                            If peAlwaysReturns(faRest) and not peStmtsMention(faRest, faNames):
                                Let mutable faMap be a new Map of Text to Text.
                                Let faXk be "{faX}".
                                Set item faL of faMap to faXk.
                                Let mutable faJr be a new Seq of Text.
                                Let mutable faJw be a new Seq of Text.
                                Let faRenamed be renameStmts(faRest, faMap, faJr, faJw).
                                If not (faJr contains "__pe_unsupported"):
                                    Let mutable faOut be peSlice(faStmts, 1, faI - 1).
                                    Repeat for faR in peFoldAliases(faRenamed):
                                        Push faR to faOut.
                                    Return faOut.
                    Otherwise:
                        Let faSkipI be true.
            Otherwise:
                Let faSkip be true.
        Set faI to faI + 1.
    Return faStmts.

## To peCoalesceCopies (ccStmts: Seq of CStmt) -> Seq of CStmt:
    Let mutable ccCur be ccStmts.
    Let mutable ccChanged be true.
    While ccChanged:
        Set ccChanged to false.
        Let ccN be length of ccCur.
        Let mutable ccI be 1.
        While ccI is at most ccN and not ccChanged:
            Let ccS be item ccI of ccCur.
            Inspect ccS:
                When CLet (ccL, ccInit):
                    Inspect ccInit:
                        When CVar (ccX):
                            If not (ccX equals ccL):
                                Let mutable ccK be ccI + 1.
                                Let mutable ccAt be 0.
                                While ccK is at most ccN and ccAt equals 0:
                                    Let ccT be item ccK of ccCur.
                                    Inspect ccT:
                                        When CSet (ccMt, ccMe):
                                            Inspect ccMe:
                                                When CVar (ccMv):
                                                    If ccMt equals ccX and ccMv equals ccL:
                                                        Set ccAt to ccK.
                                                Otherwise:
                                                    Let ccSkipMe be true.
                                        Otherwise:
                                            Let ccSkipT be true.
                                    Set ccK to ccK + 1.
                                If ccAt is greater than 0:
                                    Let ccBetween be peSlice(ccCur, ccI + 1, ccAt - 1).
                                    Let ccAfter be peTailOf(ccCur, ccAt + 1).
                                    Let mutable ccOk be a new Seq of Bool.
                                    Let ccWrote be peNoReadAfterWrite(ccBetween, ccL, ccX, false, ccOk).
                                    If length of ccOk equals 0 and peCountRefs(ccL, ccAfter) equals 0:
                                        Let mutable ccMap be a new Map of Text to Text.
                                        Let ccXk be "{ccX}".
                                        Set item ccL of ccMap to ccXk.
                                        Let mutable ccJr be a new Seq of Text.
                                        Let mutable ccJw be a new Seq of Text.
                                        Let ccRenamed be renameStmts(ccBetween, ccMap, ccJr, ccJw).
                                        If not (ccJr contains "__pe_unsupported"):
                                            Let mutable ccNext be a new Seq of CStmt.
                                            Repeat for ccP in peSlice(ccCur, 1, ccI - 1):
                                                Push ccP to ccNext.
                                            Repeat for ccB in ccRenamed:
                                                Push ccB to ccNext.
                                            Repeat for ccA in ccAfter:
                                                Push ccA to ccNext.
                                            Set ccCur to ccNext.
                                            Set ccChanged to true.
                        Otherwise:
                            Let ccSkipI be true.
                Otherwise:
                    Let ccSkip be true.
            Set ccI to ccI + 1.
    Return ccCur.

## To peInlineIds (iiE: CExpr) and (iiIds: Seq of Text) -> CExpr:
    Inspect iiE:
        When CCall (iiF, iiArgs):
            If iiIds contains iiF and length of iiArgs equals 1:
                If iiIds contains "{iiF} copies":
                    Let iiCopied be peInlineIds(item 1 of iiArgs, iiIds).
                    Inspect iiCopied:
                        When CCopy (iiAlready):
                            Return iiCopied.
                        Otherwise:
                            Return a new CCopy with target iiCopied.
                Return peInlineIds(item 1 of iiArgs, iiIds).
            Return a new CCall with name iiF and args peInlineIdsAll(iiArgs, iiIds).
        When CBinOp (iiOp, iiL, iiR):
            Return a new CBinOp with op iiOp and left peInlineIds(iiL, iiIds) and right peInlineIds(iiR, iiIds).
        When CNot (iiN):
            Return a new CNot with inner peInlineIds(iiN, iiIds).
        When CIndex (iiC, iiX):
            Return a new CIndex with coll peInlineIds(iiC, iiIds) and idx peInlineIds(iiX, iiIds).
        When CLen (iiT):
            Return a new CLen with target peInlineIds(iiT, iiIds).
        When CCopy (iiCt):
            Return a new CCopy with target peInlineIds(iiCt, iiIds).
        When CList (iiItems):
            Return a new CList with items peInlineIdsAll(iiItems, iiIds).
        When CTuple (iiTup):
            Return a new CTuple with items peInlineIdsAll(iiTup, iiIds).
        When CNewVariant (iiTag, iiNames, iiVals):
            Return a new CNewVariant with tag iiTag and fnames iiNames and fvals peInlineIdsAll(iiVals, iiIds).
        When CNew (iiTy, iiFn, iiFv):
            Return a new CNew with typeName iiTy and fieldNames iiFn and fields peInlineIdsAll(iiFv, iiIds).
        When CFieldAccess (iiFt, iiFf):
            Return a new CFieldAccess with target peInlineIds(iiFt, iiIds) and field iiFf.
        When CInterpolatedString (iiParts):
            Let mutable iiNewParts be a new Seq of CStringPart.
            Repeat for iiPart in iiParts:
                Inspect iiPart:
                    When CExprPart (iiPe0):
                        Let iiPe be peInlineIds(iiPe0, iiIds).
                        Inspect iiPe:
                            When CInterpolatedString (iiInner):
                                Repeat for iiInnerPart in iiInner:
                                    Push iiInnerPart to iiNewParts.
                            Otherwise:
                                Push (a new CExprPart with expr iiPe) to iiNewParts.
                    When CFormattedPart (iiFe, iiFs, iiFfm, iiFz):
                        Push (a new CFormattedPart with expr peInlineIds(iiFe, iiIds) and spec iiFs and form iiFfm and size iiFz) to iiNewParts.
                    Otherwise:
                        Push iiPart to iiNewParts.
            Return a new CInterpolatedString with parts iiNewParts.
        Otherwise:
            Return iiE.

## To peInlineIdsAll (iaEs: Seq of CExpr) and (iaIds: Seq of Text) -> Seq of CExpr:
    Let mutable iaOut be a new Seq of CExpr.
    Repeat for iaE in iaEs:
        Push peInlineIds(iaE, iaIds) to iaOut.
    Return iaOut.

## To peRewriteExpr (reE: CExpr) and (reMode: Text) and (reName: Text) and (reRepl: CExpr) and (reIds: Seq of Text) -> CExpr:
    If reMode equals "subst":
        Return substExpr(reE, reName, reRepl).
    Return peInlineIds(reE, reIds).

## To peRewriteAll (raEs: Seq of CExpr) and (raMode: Text) and (raName: Text) and (raRepl: CExpr) and (raIds: Seq of Text) -> Seq of CExpr:
    Let mutable raOut be a new Seq of CExpr.
    Repeat for raE in raEs:
        Push peRewriteExpr(raE, raMode, raName, raRepl, raIds) to raOut.
    Return raOut.

## To peRewriteStmts (rwStmts: Seq of CStmt) and (rwMode: Text) and (rwName: Text) and (rwRepl: CExpr) and (rwIds: Seq of Text) and (rwOk: mutable Seq of Bool) -> Seq of CStmt:
    Let mutable rwOut be a new Seq of CStmt.
    Repeat for rwS in rwStmts:
        Inspect rwS:
            When CLet (rwLn, rwLe):
                Push (a new CLet with name rwLn and expr peRewriteExpr(rwLe, rwMode, rwName, rwRepl, rwIds)) to rwOut.
            When CSet (rwSn, rwSe):
                Push (a new CSet with name rwSn and expr peRewriteExpr(rwSe, rwMode, rwName, rwRepl, rwIds)) to rwOut.
            When CShow (rwW):
                Push (a new CShow with expr peRewriteExpr(rwW, rwMode, rwName, rwRepl, rwIds)) to rwOut.
            When CReturn (rwR):
                Push (a new CReturn with expr peRewriteExpr(rwR, rwMode, rwName, rwRepl, rwIds)) to rwOut.
            When CFail (rwF):
                Push (a new CFail with reason peRewriteExpr(rwF, rwMode, rwName, rwRepl, rwIds)) to rwOut.
            When CPush (rwPe, rwPt):
                Push (a new CPush with expr peRewriteExpr(rwPe, rwMode, rwName, rwRepl, rwIds) and target rwPt) to rwOut.
            When CSetIdx (rwXt, rwXi, rwXv):
                Push (a new CSetIdx with target rwXt and idx peRewriteExpr(rwXi, rwMode, rwName, rwRepl, rwIds) and val peRewriteExpr(rwXv, rwMode, rwName, rwRepl, rwIds)) to rwOut.
            When CMapSet (rwMt, rwMk, rwMv):
                Push (a new CMapSet with target rwMt and key peRewriteExpr(rwMk, rwMode, rwName, rwRepl, rwIds) and val peRewriteExpr(rwMv, rwMode, rwName, rwRepl, rwIds)) to rwOut.
            When CCallS (rwCn, rwCa):
                Push (a new CCallS with name rwCn and args peRewriteAll(rwCa, rwMode, rwName, rwRepl, rwIds)) to rwOut.
            When CIf (rwC, rwT, rwE):
                Push (a new CIf with cond peRewriteExpr(rwC, rwMode, rwName, rwRepl, rwIds) and thenBlock peRewriteStmts(rwT, rwMode, rwName, rwRepl, rwIds, rwOk) and elseBlock peRewriteStmts(rwE, rwMode, rwName, rwRepl, rwIds, rwOk)) to rwOut.
            When CWhile (rwWc, rwWb):
                Push (a new CWhile with cond peRewriteExpr(rwWc, rwMode, rwName, rwRepl, rwIds) and body peRewriteStmts(rwWb, rwMode, rwName, rwRepl, rwIds, rwOk)) to rwOut.
            When CRepeat (rwRv, rwRc, rwRb):
                Push (a new CRepeat with var rwRv and coll peRewriteExpr(rwRc, rwMode, rwName, rwRepl, rwIds) and body peRewriteStmts(rwRb, rwMode, rwName, rwRepl, rwIds, rwOk)) to rwOut.
            When CRepeatRange (rwQv, rwQs, rwQe, rwQb):
                Push (a new CRepeatRange with var rwQv and start peRewriteExpr(rwQs, rwMode, rwName, rwRepl, rwIds) and end peRewriteExpr(rwQe, rwMode, rwName, rwRepl, rwIds) and body peRewriteStmts(rwQb, rwMode, rwName, rwRepl, rwIds, rwOk)) to rwOut.
            When CBreak:
                Push rwS to rwOut.
            Otherwise:
                If rwMode equals "subst":
                    Let rwOne be a new Seq of CStmt.
                    Push rwS to rwOne.
                    If peCountRefs(rwName, rwOne) is greater than 0:
                        Push false to rwOk.
                Push rwS to rwOut.
    Return rwOut.

## To peSubstStmts (ssStmts: Seq of CStmt) and (ssName: Text) and (ssRepl: CExpr) and (ssOk: mutable Seq of Bool) -> Seq of CStmt:
    Let ssNoIds be a new Seq of Text.
    Return peRewriteStmts(ssStmts, "subst", ssName, ssRepl, ssNoIds, ssOk).

## To peIdentityFuncs (ifFuncs: Map of Text to CFunc) and (ifNames: Seq of Text) -> Seq of Text:
    Let mutable ifOut be a new Seq of Text.
    Repeat for ifN in ifNames:
        Let ifK be "{ifN}".
        If ifFuncs contains ifK and not ifOut contains ifK:
            Let ifDef be item ifK of ifFuncs.
            Inspect ifDef:
                When CFuncDef (ifFn, ifPs, ifPt, ifRt, ifBody):
                    If length of ifPs equals 1 and length of ifBody equals 1:
                        Let ifOnly be item 1 of ifBody.
                        Inspect ifOnly:
                            When CReturn (ifR):
                                Inspect ifR:
                                    When CVar (ifRv):
                                        If ifRv equals (item 1 of ifPs):
                                            Let ifK2 be "{ifN}".
                                            Push ifK2 to ifOut.
                                    When CCopy (ifRc):
                                        Inspect ifRc:
                                            When CVar (ifRcv):
                                                If ifRcv equals (item 1 of ifPs):
                                                    Let ifK3 be "{ifN}".
                                                    Push ifK3 to ifOut.
                                                    Push "{ifN} copies" to ifOut.
                                            Otherwise:
                                                Let ifSkipC be true.
                                    Otherwise:
                                        Let ifSkipR be true.
                            Otherwise:
                                Let ifSkipB be true.
                Otherwise:
                    Let ifSkipD be true.
    Return ifOut.

## To peRematerializeArgs (raStmts: Seq of CStmt) -> Seq of CStmt:
    Let raN be length of raStmts.
    Let mutable raI be 1.
    Repeat for raS in raStmts:
        Inspect raS:
            When CLet (raB, raE0):
                Let raE be peFreshCopies(raE0).
                If peIsArgsCall(raE):
                    Let raTail be peTailOf(raStmts, raI + 1).
                    Let mutable raWritten be false.
                    Repeat for raT in raTail:
                        If peWritesName(raT, raB):
                            Set raWritten to true.
                    If not raWritten:
                        Let mutable raOk be a new Seq of Bool.
                        Let raNew be peSubstStmts(raTail, raB, raE, raOk).
                        Let mutable raClean be length of raOk equals 0.
                        Repeat for raNs in raNew:
                            Let raOne be a new Seq of CStmt.
                            Push raNs to raOne.
                            If peCountRefs(raB, raOne) is greater than 0:
                                Set raClean to false.
                        If raClean:
                            Return peJoinStmts(peSlice(raStmts, 1, raI - 1), raNew).
            Otherwise:
                Let raSkip be true.
        Set raI to raI + 1.
    Return raStmts.

## To peDropSelfMoves (dmStmts: Seq of CStmt) -> Seq of CStmt:
    Let mutable dmOut be a new Seq of CStmt.
    Repeat for dmS in dmStmts:
        Let mutable dmSelf be false.
        Inspect dmS:
            When CSet (dmT, dmE):
                Inspect dmE:
                    When CVar (dmV):
                        Set dmSelf to dmV equals dmT.
                    Otherwise:
                        Let dmSkipE be true.
            Otherwise:
                Let dmSkip be true.
        If not dmSelf:
            Push dmS to dmOut.
    Return dmOut.

## To peShownValue (svE: CExpr) -> CExpr:
    Inspect svE:
        When CCopy (svC):
            Return peShownValue(svC).
        When CList (svItems):
            Let mutable svOut be a new Seq of CExpr.
            Repeat for svX in svItems:
                Push peShownValue(svX) to svOut.
            Return a new CList with items svOut.
        When CTuple (svTup):
            Let mutable svTout be a new Seq of CExpr.
            Repeat for svT in svTup:
                Push peShownValue(svT) to svTout.
            Return a new CTuple with items svTout.
        When CInterpolatedString (svParts):
            Let mutable svNewParts be a new Seq of CStringPart.
            Repeat for svPart in svParts:
                Inspect svPart:
                    When CExprPart (svPe):
                        Push (a new CExprPart with expr peShownValue(svPe)) to svNewParts.
                    Otherwise:
                        Push svPart to svNewParts.
            Return a new CInterpolatedString with parts svNewParts.
        Otherwise:
            Return svE.

## To peShowDirect (sdStmts: Seq of CStmt) -> Seq of CStmt:
    Let mutable sdOut be a new Seq of CStmt.
    Repeat for sdS in sdStmts:
        Let mutable sdNew be sdS.
        Inspect sdS:
            When CShow (sdE):
                Inspect sdE:
                    When CCopy (sdDirect):
                        Set sdNew to a new CShow with expr sdDirect.
                    When CInterpolatedString (sdParts):
                        If length of sdParts equals 1:
                            Let sdOnly be item 1 of sdParts.
                            Inspect sdOnly:
                                When CExprPart (sdX):
                                    Set sdNew to a new CShow with expr sdX.
                                    Inspect sdX:
                                        When CCopy (sdXc):
                                            Set sdNew to a new CShow with expr sdXc.
                                        Otherwise:
                                            Let sdSkipC be true.
                                Otherwise:
                                    Let sdSkipP be true.
                    Otherwise:
                        Let sdSkipE be true.
            Otherwise:
                Let sdSkip be true.
        Inspect sdNew:
            When CShow (sdShown):
                Set sdNew to a new CShow with expr peShownValue(sdShown).
            Otherwise:
                Let sdNotShow be true.
        Push sdNew to sdOut.
    Return sdOut.

## To peMergeDeadInits (miStmts: Seq of CStmt) -> Seq of CStmt:
    Let mutable miOut be a new Seq of CStmt.
    Let miN be length of miStmts.
    Let mutable miI be 1.
    While miI is at most miN:
        Let miS be item miI of miStmts.
        Let mutable miDone be false.
        If miI is less than miN:
            Inspect miS:
                When CLet (miX, miInit):
                    If isPureForDce(miInit):
                        Let miNext be item (miI + 1) of miStmts.
                        Inspect miNext:
                            When CSet (miT, miE):
                                If miT equals miX and not (peExprRefs(miE) contains miX):
                                    Let miXk be "{miX}".
                                    Push (a new CLet with name miXk and expr miE) to miOut.
                                    Set miDone to true.
                            Otherwise:
                                Let miSkipN be true.
                Otherwise:
                    Let miSkipS be true.
        If miDone:
            Set miI to miI + 2.
        Otherwise:
            Push miS to miOut.
            Set miI to miI + 1.
    Return miOut.

## To peSelfWrite (swS: CStmt) and (swCopy: Text) and (swOrig: Text) -> CStmt:
    Inspect swS:
        When CSet (swT, swE):
            If swT equals swCopy:
                Return a new CSet with name swT and expr substExpr(swE, swOrig, a new CVar with name swCopy).
        Otherwise:
            Let swSkip be true.
    Return swS.

## To peSelfWriteFirst (sfBlock: Seq of CStmt) and (sfCopy: Text) and (sfOrig: Text) -> Seq of CStmt:
    If length of sfBlock equals 0:
        Return sfBlock.
    Let mutable sfOut be a new Seq of CStmt.
    Let mutable sfI be 1.
    Repeat for sfS in sfBlock:
        If sfI equals 1:
            Push peSelfWrite(sfS, sfCopy, sfOrig) to sfOut.
        Otherwise:
            Push sfS to sfOut.
        Set sfI to sfI + 1.
    Return sfOut.

## To peLocalizeCopyReads (lcStmts: Seq of CStmt) -> Seq of CStmt:
    Let mutable lcOut be a new Seq of CStmt.
    Let lcN be length of lcStmts.
    Let mutable lcI be 1.
    Repeat for lcS in lcStmts:
        Let mutable lcNext be lcS.
        If lcI is greater than 1:
            Let lcPrev be item (lcI - 1) of lcStmts.
            Inspect lcPrev:
                When CLet (lcL, lcInit):
                    Inspect lcInit:
                        When CVar (lcX):
                            If not (lcX equals lcL):
                                Inspect lcS:
                                    When CIf (lcC, lcT, lcE):
                                        If not (peExprRefs(lcC) contains lcL):
                                            Set lcNext to a new CIf with cond lcC and thenBlock peSelfWriteFirst(lcT, lcL, lcX) and elseBlock peSelfWriteFirst(lcE, lcL, lcX).
                                    When CSet (lcSt, lcSe):
                                        Set lcNext to peSelfWrite(lcS, lcL, lcX).
                                    Otherwise:
                                        Let lcSkipS be true.
                        Otherwise:
                            Let lcSkipI be true.
                Otherwise:
                    Let lcSkipP be true.
        Push lcNext to lcOut.
        Set lcI to lcI + 1.
    Return lcOut.

## To peShownEmpty (seE: CExpr) and (seX: Text) -> CExpr:
    Inspect seE:
        When CVar (seV):
            If seV equals seX:
                Return a new CText with value "[]".
            Return seE.
        When CCopy (seC):
            Inspect seC:
                When CVar (seCv):
                    If seCv equals seX:
                        Return a new CText with value "[]".
                Otherwise:
                    Let seSkipC be true.
            Return seE.
        When CInterpolatedString (seParts):
            Let mutable seOut be a new Seq of CStringPart.
            Repeat for sePart in seParts:
                Inspect sePart:
                    When CExprPart (sePe):
                        Let seShown be peShownEmpty(sePe, seX).
                        Inspect seShown:
                            When CText (seText):
                                Push (a new CLiteralPart with value seText) to seOut.
                            Otherwise:
                                Push (a new CExprPart with expr sePe) to seOut.
                    Otherwise:
                        Push sePart to seOut.
            Return a new CInterpolatedString with parts seOut.
        Otherwise:
            Return seE.

## To peShownEmptyStmts (ssStmts: Seq of CStmt) and (ssX: Text) -> Seq of CStmt:
    Let mutable ssOut be a new Seq of CStmt.
    Repeat for ssS in ssStmts:
        Inspect ssS:
            When CShow (ssW):
                Push (a new CShow with expr peShownEmpty(ssW, ssX)) to ssOut.
            When CReturn (ssR):
                Push (a new CReturn with expr peShownEmpty(ssR, ssX)) to ssOut.
            When CLet (ssLn, ssLe):
                Push (a new CLet with name ssLn and expr peShownEmpty(ssLe, ssX)) to ssOut.
            When CSet (ssSn, ssSe):
                Push (a new CSet with name ssSn and expr peShownEmpty(ssSe, ssX)) to ssOut.
            Otherwise:
                Push ssS to ssOut.
    Return ssOut.

## To peDropFirstReads (frStmts: Seq of CStmt) and (frX: Text) -> Seq of CStmt:
    Let mutable frOut be a new Seq of CStmt.
    Let mutable frI be 1.
    Repeat for frS in frStmts:
        Let mutable frDead be false.
        Inspect frS:
            When CLet (frN, frE):
                Inspect frE:
                    When CIndex (frC, frIdx):
                        Inspect frC:
                            When CVar (frCv):
                                Inspect frIdx:
                                    When CInt (frOne):
                                        If frCv equals frX and frOne equals 1:
                                            Set frDead to peCountRefs(frN, peTailOf(frStmts, frI + 1)) equals 0.
                                    Otherwise:
                                        Let frSkipI be true.
                            Otherwise:
                                Let frSkipC be true.
                    Otherwise:
                        Let frSkipE be true.
            Otherwise:
                Let frSkip be true.
        If not frDead:
            Push frS to frOut.
        Set frI to frI + 1.
    Return frOut.

## To peEmptyListIfs (elStmts: Seq of CStmt) and (elSeqs: Seq of Text) -> Seq of CStmt:
    Let mutable elOut be a new Seq of CStmt.
    Let mutable elI be 1.
    Repeat for elS in elStmts:
        Let mutable elFolded be false.
        Inspect elS:
            When CIf (elC, elT, elE):
                Inspect elC:
                    When CBinOp (elOp, elL, elR):
                        If elOp equals "==":
                            Inspect elL:
                                When CLen (elLt):
                                    Inspect elLt:
                                        When CVar (elX):
                                            Inspect elR:
                                                When CInt (elZero):
                                                    If elZero equals 0 and elSeqs contains elX:
                                                        Let elE2 be peDropFirstReads(elE, elX).
                                                        Let mutable elShownE be peShownEmptyStmts(elE2, elX).
                                                        If elI is greater than 1:
                                                            Let elPrev be item (elI - 1) of elStmts.
                                                            Inspect elPrev:
                                                                When CLet (elCopyName, elCopyOf):
                                                                    Inspect elCopyOf:
                                                                        When CCopy (elCopyT):
                                                                            Inspect elCopyT:
                                                                                When CVar (elCopyV):
                                                                                    If elCopyV equals elX:
                                                                                        Set elShownE to peShownEmptyStmts(elShownE, elCopyName).
                                                                                Otherwise:
                                                                                    Let elSkipCv be true.
                                                                        Otherwise:
                                                                            Let elSkipCc be true.
                                                                Otherwise:
                                                                    Let elSkipP be true.
                                                        If decompileBlock(elT, 0) equals decompileBlock(elShownE, 0):
                                                            Repeat for elKeep in elE2:
                                                                Push elKeep to elOut.
                                                            Set elFolded to true.
                                                Otherwise:
                                                    Let elSkipR be true.
                                        Otherwise:
                                            Let elSkipX be true.
                                Otherwise:
                                    Let elSkipL be true.
                    Otherwise:
                        Let elSkipC be true.
            Otherwise:
                Let elSkip be true.
        If not elFolded:
            Push elS to elOut.
        Set elI to elI + 1.
    Return elOut.

## To peTupleArity (taType: Text) -> Int:
    If not peStartsWith(taType, "("):
        Return 0.
    Let mutable taDepth be 0.
    Let mutable taCount be 1.
    Repeat for taCh in taType:
        Let taC be "{taCh}".
        If taC equals "(":
            Set taDepth to taDepth + 1.
        If taC equals ")":
            Set taDepth to taDepth - 1.
        If taC equals "," and taDepth equals 1:
            Set taCount to taCount + 1.
    Return taCount.

## To peTupleArities (tfFuncs: Map of Text to CFunc) and (tfNames: Seq of Text) -> Map of Text to Int:
    Let mutable tfOut be a new Map of Text to Int.
    Repeat for tfN in tfNames:
        Let tfK be "{tfN}".
        If tfFuncs contains tfK:
            Inspect item tfK of tfFuncs:
                When CFuncDef (tfFn, tfPs, tfPt, tfRt, tfBody):
                    Let tfA be peTupleArity(tfRt).
                    If tfA is greater than 1:
                        Let tfK2 be "{tfN}".
                        Set item tfK2 of tfOut to tfA.
                Otherwise:
                    Let tfSkip be true.
    Return tfOut.

## To peTupleEta (teStmts: Seq of CStmt) and (teArities: Map of Text to Int) -> Seq of CStmt:
    Let mutable teCalls be a new Map of Text to Int.
    Let mutable teParts be a new Map of Text to Text.
    Let mutable teAt be a new Map of Text to Int.
    Let mutable teOut be a new Seq of CStmt.
    Let mutable teI be 1.
    Repeat for teS in teStmts:
        Let mutable teNew be teS.
        Inspect teS:
            When CLet (teL, teE):
                Inspect teE:
                    When CCall (teFn, teArgs):
                        Let teFk be "{teFn}".
                        If teArities contains teFk:
                            Let teLk be "{teL}".
                            Set item teLk of teCalls to item teFk of teArities.
                    When CIndex (teColl, teIdx):
                        Inspect teColl:
                            When CVar (teCv):
                                Inspect teIdx:
                                    When CInt (teIv):
                                        Let teCk be "{teCv}".
                                        If teCalls contains teCk:
                                            Let teLk2 be "{teL}".
                                            Set item teLk2 of teParts to "{teCv}#{teIv}".
                                    Otherwise:
                                        Let teSkipX be true.
                            Otherwise:
                                Let teSkipC be true.
                    Otherwise:
                        Let teSkipE be true.
            When CReturn (teR):
                Inspect teR:
                    When CTuple (teItems):
                        Let mutable teWhole be "".
                        Let mutable teOk be length of teItems is greater than 1.
                        Let mutable teJ be 1.
                        Repeat for teItem in teItems:
                            Let mutable teRef be "".
                            Inspect teItem:
                                When CVar (teV):
                                    Let teVk be "{teV}".
                                    If teParts contains teVk:
                                        Set teRef to item teVk of teParts.
                                When CIndex (teIc, teIi):
                                    Inspect teIc:
                                        When CVar (teIcv):
                                            Inspect teIi:
                                                When CInt (teIiv):
                                                    Set teRef to "{teIcv}#{teIiv}".
                                                Otherwise:
                                                    Let teSkipIi be true.
                                        Otherwise:
                                            Let teSkipIc be true.
                                Otherwise:
                                    Let teSkipItem be true.
                            Let mutable teBase be "".
                            Let mutable teSeen be false.
                            Repeat for teRc in teRef:
                                Let teRcs be "{teRc}".
                                If teRcs equals "#":
                                    Set teSeen to true.
                                Otherwise:
                                    If not teSeen:
                                        Set teBase to "{teBase}{teRcs}".
                            If teRef equals "" or not (teRef equals "{teBase}#{teJ}"):
                                Set teOk to false.
                            If teJ equals 1:
                                Set teWhole to teBase.
                            Otherwise:
                                If not (teWhole equals teBase):
                                    Set teOk to false.
                            Set teJ to teJ + 1.
                        If teOk and teCalls contains teWhole:
                            If (item teWhole of teCalls) equals (length of teItems):
                                Let teWk be "{teWhole}".
                                Set teNew to a new CReturn with expr (a new CVar with name teWk).
                    Otherwise:
                        Let teSkipR be true.
            When CIf (teC, teT, teF):
                Set teNew to a new CIf with cond teC and thenBlock peTupleEta(teT, teArities) and elseBlock peTupleEta(teF, teArities).
            When CWhile (teWc, teWb):
                Set teNew to a new CWhile with cond teWc and body peTupleEta(teWb, teArities).
            When CRepeat (teRv, teRc, teRb):
                Set teNew to a new CRepeat with var teRv and coll teRc and body peTupleEta(teRb, teArities).
            When CRepeatRange (teQv, teQs, teQe, teQb):
                Set teNew to a new CRepeatRange with var teQv and start teQs and end teQe and body peTupleEta(teQb, teArities).
            When CInspect (teNt, teArms):
                Let mutable teNewArms be a new Seq of CMatchArm.
                Repeat for teArm in teArms:
                    Push peWithArmBody(teArm, peTupleEta(peArmBody(teArm), teArities)) to teNewArms.
                Set teNew to a new CInspect with target teNt and arms teNewArms.
            Otherwise:
                Let teSkip be true.
        Push teNew to teOut.
        Set teI to teI + 1.
    Return peDropDeadParts(teOut, teParts).

## To peDropDeadParts (dpStmts: Seq of CStmt) and (dpParts: Map of Text to Text) -> Seq of CStmt:
    Let mutable dpOut be a new Seq of CStmt.
    Let mutable dpI be 1.
    Repeat for dpS in dpStmts:
        Let mutable dpKeep be true.
        Inspect dpS:
            When CLet (dpL, dpE):
                Let dpLk be "{dpL}".
                If dpParts contains dpLk:
                    If peCountRefs(dpLk, peTailOf(dpStmts, dpI + 1)) equals 0:
                        Set dpKeep to false.
            Otherwise:
                Let dpSkip be true.
        If dpKeep:
            Push dpS to dpOut.
        Set dpI to dpI + 1.
    Return dpOut.

## To peFinishBlock (fbStmts: Seq of CStmt) and (fbMutating: Seq of Text) -> Seq of CStmt:
    Let fbNone be a new Seq of Text.
    Let fbKinds be peKinds(fbStmts, fbNone, fbNone, fbMutating).
    Return peDropUnread(peFinishFixed(fbStmts, fbNone, fbMutating, fbKinds), fbNone, fbKinds).

## To peKindPure (kpE: CExpr) and (kpKinds: Map of Text to Text) -> Bool:
    If isPureForDce(kpE):
        Return true.
    Inspect kpE:
        When CBinOp (kpOp, kpL, kpR):
            If not (peKindPure(kpL, kpKinds) and peKindPure(kpR, kpKinds)):
                Return false.
            If peNoFailOp(kpOp):
                Return true.
            Let kpLk be peKindOf(kpL, kpKinds).
            Let kpRk be peKindOf(kpR, kpKinds).
            If kpOp equals "+" or kpOp equals "-" or kpOp equals "*":
                If (kpLk equals "Int" or kpLk equals "Real") and (kpRk equals "Int" or kpRk equals "Real"):
                    Return true.
            If kpOp equals "+" and kpLk equals "Text" and kpRk equals "Text":
                Return true.
            Return false.
        When CNot (kpI):
            Return peKindPure(kpI, kpKinds) and peKindOf(kpI, kpKinds) equals "Bool".
        When CInterpolatedString (kpParts):
            Repeat for kpPart in kpParts:
                Inspect kpPart:
                    When CExprPart (kpX):
                        If not peKindPure(kpX, kpKinds):
                            Return false.
                    When CLiteralPart (kpLit):
                        Let kpLitOk be true.
                    Otherwise:
                        Return false.
            Return true.
        Otherwise:
            Return false.

## To peOtherWrites (owStmts: Seq of CStmt) and (owOut: mutable Seq of Text):
    Repeat for owS in owStmts:
        Inspect owS:
            When CLet (owLn, owLe):
                Let owSkipL be true.
            When CSet (owSn, owSe):
                Let owSkipS be true.
            When CIf (owC, owT, owE):
                peOtherWrites(owT, owOut).
                peOtherWrites(owE, owOut).
            When CWhile (owWc, owWb):
                peOtherWrites(owWb, owOut).
            When CRepeat (owRv, owRc, owRb):
                Push owRv to owOut.
                peOtherWrites(owRb, owOut).
            When CRepeatRange (owQv, owQs, owQe, owQb):
                Push owQv to owOut.
                peOtherWrites(owQb, owOut).
            When CInspect (owNt, owArms):
                Repeat for owArm in owArms:
                    Repeat for owBound in peArmBindings(owArm):
                        Push owBound to owOut.
                    peOtherWrites(peArmBody(owArm), owOut).
            Otherwise:
                Repeat for owW in peStmtWrites(owS):
                    Push owW to owOut.

## To peImpureStores (isStmts: Seq of CStmt) and (isKinds: Map of Text to Text) and (isOut: mutable Seq of Text):
    Repeat for isS in isStmts:
        Inspect isS:
            When CLet (isLn, isLe):
                If not peKindPure(isLe, isKinds):
                    Push isLn to isOut.
            When CSet (isSn, isSe):
                If not peKindPure(isSe, isKinds):
                    Push isSn to isOut.
            When CIf (isC, isT, isE):
                peImpureStores(isT, isKinds, isOut).
                peImpureStores(isE, isKinds, isOut).
            When CWhile (isWc, isWb):
                peImpureStores(isWb, isKinds, isOut).
            When CRepeat (isRv, isRc, isRb):
                peImpureStores(isRb, isKinds, isOut).
            When CRepeatRange (isQv, isQs, isQe, isQb):
                peImpureStores(isQb, isKinds, isOut).
            When CInspect (isNt, isArms):
                Repeat for isArm in isArms:
                    peImpureStores(peArmBody(isArm), isKinds, isOut).
            Otherwise:
                Let isSkip be true.

## To peDropStores (dsStmts: Seq of CStmt) and (dsDead: Seq of Text) and (dsKinds: Map of Text to Text) -> Seq of CStmt:
    Let mutable dsOut be a new Seq of CStmt.
    Repeat for dsS in dsStmts:
        Let mutable dsKeep be true.
        Let mutable dsNew be dsS.
        Inspect dsS:
            When CLet (dsLn, dsLe):
                If dsDead contains dsLn and not dsDead contains "{dsLn} stays declared" and peKindPure(dsLe, dsKinds):
                    Set dsKeep to false.
            When CSet (dsSn, dsSe):
                If dsDead contains dsSn and peKindPure(dsSe, dsKinds):
                    Set dsKeep to false.
            When CIf (dsC, dsT, dsE):
                Let dsT2 be peDropStores(dsT, dsDead, dsKinds).
                Let dsE2 be peDropStores(dsE, dsDead, dsKinds).
                If length of dsT2 equals 0 and length of dsE2 equals 0:
                    If peKindPure(dsC, dsKinds):
                        Set dsKeep to false.
                Otherwise:
                    Set dsNew to a new CIf with cond dsC and thenBlock dsT2 and elseBlock dsE2.
            When CWhile (dsWc, dsWb):
                Let dsWb2 be peDropStores(dsWb, dsDead, dsKinds).
                If length of dsWb2 is greater than 0:
                    Set dsNew to a new CWhile with cond dsWc and body dsWb2.
            When CRepeat (dsRv, dsRc, dsRb):
                Let dsRb2 be peDropStores(dsRb, dsDead, dsKinds).
                If length of dsRb2 is greater than 0:
                    Set dsNew to a new CRepeat with var dsRv and coll dsRc and body dsRb2.
                Otherwise:
                    If peKindPure(dsRc, dsKinds):
                        Set dsKeep to false.
            When CRepeatRange (dsQv, dsQs, dsQe, dsQb):
                Let dsQb2 be peDropStores(dsQb, dsDead, dsKinds).
                If length of dsQb2 is greater than 0:
                    Set dsNew to a new CRepeatRange with var dsQv and start dsQs and end dsQe and body dsQb2.
                Otherwise:
                    If peKindPure(dsQs, dsKinds) and peKindPure(dsQe, dsKinds):
                        Set dsKeep to false.
            When CInspect (dsNt, dsArms):
                Let mutable dsNewArms be a new Seq of CMatchArm.
                Let mutable dsArmsOk be true.
                Repeat for dsArm in dsArms:
                    Let dsBody2 be peDropStores(peArmBody(dsArm), dsDead, dsKinds).
                    If length of dsBody2 equals 0:
                        Set dsArmsOk to false.
                    Push peWithArmBody(dsArm, dsBody2) to dsNewArms.
                If dsArmsOk:
                    Set dsNew to a new CInspect with target dsNt and arms dsNewArms.
            Otherwise:
                Let dsSkip be true.
        If dsKeep:
            Push dsNew to dsOut.
    Return dsOut.

## To peDropUnread (duStmts: Seq of CStmt) and (duParams: Seq of Text) and (duKinds: Map of Text to Text) -> Seq of CStmt:
    Let mutable duCur be duStmts.
    Let mutable duRound be 0.
    While duRound is less than 8:
        Set duRound to duRound + 1.
        Let duEmpty be a new Map of Text to Text.
        Let mutable duRefs be a new Seq of Text.
        Let mutable duWrites be a new Seq of Text.
        Let duScan be renameStmts(duCur, duEmpty, duRefs, duWrites).
        If duRefs contains "__pe_unsupported":
            Return duCur.
        Let mutable duOther be a new Seq of Text.
        peOtherWrites(duCur, duOther).
        If duOther contains "*":
            Return duCur.
        Let mutable duLocals be a new Seq of Text.
        collectBinders(duCur, duLocals).
        Let mutable duDead be a new Seq of Text.
        Repeat for duL in duLocals:
            If not duRefs contains duL and not duOther contains duL and not duParams contains duL:
                Let duLk be "{duL}".
                Push duLk to duDead.
        If length of duDead equals 0:
            Return duCur.
        Let mutable duImpure be a new Seq of Text.
        peImpureStores(duCur, duKinds, duImpure).
        Repeat for duI in duImpure:
            If duDead contains duI:
                Push "{duI} stays declared" to duDead.
        Let duNext be peDropStores(duCur, duDead, duKinds).
        If decompileBlock(duNext, 0) equals decompileBlock(duCur, 0):
            Return duCur.
        Set duCur to duNext.
    Return duCur.

## To peFinishFixed (ffStmts: Seq of CStmt) and (ffOuter: Seq of Text) and (ffMutating: Seq of Text) and (ffKinds: Map of Text to Text) -> Seq of CStmt:
    Let mutable ffCur be peFinishIn(ffStmts, ffOuter, ffMutating, ffKinds).
    Let mutable ffRound be 1.
    While ffRound is less than 4:
        Let ffNext be peFinishIn(ffCur, ffOuter, ffMutating, ffKinds).
        If decompileBlock(ffNext, 0) equals decompileBlock(ffCur, 0):
            Return ffNext.
        Set ffCur to ffNext.
        Set ffRound to ffRound + 1.
    Return ffCur.

## To peCallsAnyOf (caStmts: Seq of CStmt) and (caNames: Seq of Text) -> Bool:
    If length of caNames equals 0:
        Return false.
    Repeat for caCalled in collectCallNames(caStmts):
        If caNames contains caCalled:
            Return true.
    Return false.

## To peMutatingFuncs (mfFuncs: Map of Text to CFunc) and (mfNames: Seq of Text) -> Seq of Text:
    Let mutable mfOut be a new Seq of Text.
    Repeat for mfN in mfNames:
        Let mfK be "{mfN}".
        If mfFuncs contains mfK and not mfOut contains mfK:
            Let mfDef be item mfK of mfFuncs.
            Inspect mfDef:
                When CFuncDef (mfFn, mfPs, mfPt, mfRt, mfBody):
                    Let mutable mfMutable be false.
                    Repeat for mfT in mfPt:
                        If mfT contains "mutable":
                            Set mfMutable to true.
                    If mfMutable:
                        Let mfK2 be "{mfN}".
                        Push mfK2 to mfOut.
                Otherwise:
                    Let mfSkip be true.
    Return mfOut.

## To peHoldExpr (heE: CExpr) and (heKinds: Map of Text to Text) and (heOut: mutable Seq of CStmt):
    Inspect heE:
        When CRange (heRs, heRe):
            peHoldExpr(heRs, heKinds, heOut).
            peHoldExpr(heRe, heKinds, heOut).
            Return.
        Otherwise:
            Let heWhole be true.
    If not peKindPure(heE, heKinds):
        Push (a new CLet with name "pkv__held" and expr heE) to heOut.

## To peHoldHeaders (hhStmts: Seq of CStmt) and (hhKinds: Map of Text to Text) -> Seq of CStmt:
    Let mutable hhOut be a new Seq of CStmt.
    Repeat for hhS in hhStmts:
        Inspect hhS:
            When CIf (hhC, hhT, hhE):
                Let hhT2 be peHoldHeaders(hhT, hhKinds).
                Let hhE2 be peHoldHeaders(hhE, hhKinds).
                If length of hhT2 equals 0 and length of hhE2 equals 0:
                    peHoldExpr(hhC, hhKinds, hhOut).
                Otherwise:
                    Let mutable hhCond be peTruthOf(hhC, hhKinds).
                    Let mutable hhThen be hhT2.
                    Let mutable hhElse be hhE2.
                    If length of hhT2 equals 0:
                        Inspect hhCond:
                            When CNot (hhNegated):
                                If peKindOf(hhNegated, hhKinds) equals "Bool":
                                    Set hhCond to peTruthOf(hhNegated, hhKinds).
                                    Set hhThen to hhE2.
                                    Set hhElse to a new Seq of CStmt.
                            Otherwise:
                                Let hhPositive be true.
                    Push (a new CIf with cond hhCond and thenBlock hhThen and elseBlock hhElse) to hhOut.
            When CWhile (hhWc, hhWb):
                Push (a new CWhile with cond peTruthOf(hhWc, hhKinds) and body peHoldHeaders(hhWb, hhKinds)) to hhOut.
            When CRepeat (hhRv, hhRc, hhRb):
                Let hhRb2 be peHoldHeaders(hhRb, hhKinds).
                If length of hhRb2 equals 0:
                    peHoldExpr(hhRc, hhKinds, hhOut).
                Otherwise:
                    Push (a new CRepeat with var hhRv and coll hhRc and body hhRb2) to hhOut.
            When CRepeatRange (hhQv, hhQs, hhQe, hhQb):
                Let hhQb2 be peHoldHeaders(hhQb, hhKinds).
                If length of hhQb2 equals 0:
                    peHoldExpr(hhQs, hhKinds, hhOut).
                    peHoldExpr(hhQe, hhKinds, hhOut).
                Otherwise:
                    Push (a new CRepeatRange with var hhQv and start hhQs and end hhQe and body hhQb2) to hhOut.
            When CInspect (hhNt, hhArms):
                Let mutable hhNewArms be a new Seq of CMatchArm.
                Repeat for hhArm in hhArms:
                    Push peWithArmBody(hhArm, peHoldHeaders(peArmBody(hhArm), hhKinds)) to hhNewArms.
                Push (a new CInspect with target hhNt and arms hhNewArms) to hhOut.
            Otherwise:
                Push hhS to hhOut.
    Return hhOut.

## To peFinishIn (fbStmts: Seq of CStmt) and (fbOuter: Seq of Text) and (fbMutating: Seq of Text) and (fbKinds: Map of Text to Text) -> Seq of CStmt:
    Let mutable fbOut be a new Seq of CStmt.
    Let mutable fbSeqs be copy of fbOuter.
    Repeat for fbS in peFlattenGuards(peCutAfterExit(fbStmts)):
        Inspect fbS:
            When CIf (fbC, fbT, fbE):
                Push (a new CIf with cond fbC and thenBlock peFinishIn(fbT, fbSeqs, fbMutating, fbKinds) and elseBlock peFinishIn(fbE, fbSeqs, fbMutating, fbKinds)) to fbOut.
            When CWhile (fbWc, fbWb):
                Push peNormalizeWhile(fbWc, peFinishIn(fbWb, fbSeqs, fbMutating, fbKinds)) to fbOut.
            When CRepeat (fbRv, fbRc, fbRb):
                Let fbRbDone be peFinishIn(fbRb, fbSeqs, fbMutating, fbKinds).
                If length of fbRbDone is greater than 0 or not peKindPure(fbRc, fbKinds):
                    Push (a new CRepeat with var fbRv and coll fbRc and body fbRbDone) to fbOut.
            When CRepeatRange (fbQv, fbQs, fbQe, fbQb):
                Let fbQbDone be peFinishIn(fbQb, fbSeqs, fbMutating, fbKinds).
                If length of fbQbDone is greater than 0 or not (peKindPure(fbQs, fbKinds) and peKindPure(fbQe, fbKinds)):
                    Push (a new CRepeatRange with var fbQv and start fbQs and end fbQe and body fbQbDone) to fbOut.
            When CInspect (fbNt, fbArms):
                Let mutable fbNewArms be a new Seq of CMatchArm.
                Repeat for fbA in fbArms:
                    Inspect fbA:
                        When CWhen (fbWn, fbWbs, fbWbody):
                            Push (a new CWhen with variantName fbWn and bindings fbWbs and body peFinishIn(fbWbody, fbSeqs, fbMutating, fbKinds)) to fbNewArms.
                        When COtherwise (fbObody):
                            Push (a new COtherwise with body peFinishIn(fbObody, fbSeqs, fbMutating, fbKinds)) to fbNewArms.
                Push (a new CInspect with target fbNt and arms fbNewArms) to fbOut.
            When CLet (fbLn, fbLe):
                If peIsSeqSource(fbLe, fbOut, fbSeqs):
                    Let fbLk be "{fbLn}".
                    Push fbLk to fbSeqs.
                Push fbS to fbOut.
            Otherwise:
                Push fbS to fbOut.
    If peCallsAnyOf(fbOut, fbMutating):
        Return peHoldHeaders(dceBlock(peShowDirect(peFreshCopiesIn(peDropSelfMoves(peDropSubsumedStores(peMergeDeadInits(peCopyLoopsKinds(fbOut, fbOuter, fbKinds))))))), fbKinds).
    Let fbLocal be peLocalizeCopyReads(peCoalesceAliases(peCoalesceCopies(peMergeDeadInits(peEmptyListIfs(peCopyLoopsKinds(fbOut, fbOuter, fbKinds), fbSeqs))))).
    Let fbForwarded be peForwardLets(peFuseShortCircuits(peFoldAliases(peForwardLets(peMergeAppends(peDropSubsumedGuards(fbLocal, fbKinds)))), fbKinds)).
    Let fbNoFacts be a new Map of Text to CExpr.
    Return peHoldHeaders(dceBlock(peShowDirect(peFreshCopiesIn(peRematerializeArgs(peDropKnownCopies(peDropSelfMoves(peDropSubsumedStores(peDropSubsumedGuards(fbForwarded, fbKinds))), fbNoFacts))))), fbKinds).

## To peEmitProgram (epMain: Seq of CStmt) and (epState: PEState) -> Text:
    Let nl be chr(10).
    Let mutable output be "".
    Let specFuncs be peFuncs(epState).
    Let mutable allNames be collectCallNames(epMain).
    Let mutable emitted be a new Map of Text to Bool.
    Let mutable changed be true.
    While changed:
        Set changed to false.
        Let mutable toAdd be a new Seq of Text.
        Repeat for fnKey in allNames:
            Let fkStr be "{fnKey}".
            If not emitted contains fkStr:
                Set item fkStr of emitted to true.
                Let fkStr2 be "{fnKey}".
                If specFuncs contains fkStr2:
                    Let fdef be item fkStr2 of specFuncs.
                    Inspect fdef:
                        When CFuncDef (fn0, ps0, pt0, rt0, body0):
                            Let children be collectCallNames(body0).
                            Repeat for child in children:
                                Let childStr be "{child}".
                                If not emitted contains childStr:
                                    Push child to toAdd.
                                    Set changed to true.
                        Otherwise:
                            Let skipF be true.
        Repeat for ta in toAdd:
            Push ta to allNames.
    Let epIds be peIdentityFuncs(specFuncs, allNames).
    Let epArities be peTupleArities(specFuncs, allNames).
    Let epMutating be peMutatingFuncs(specFuncs, allNames).
    Let mutable epOk be a new Seq of Bool.
    Let epNoRepl be a new CNothing.
    Let epMainInl be peRewriteStmts(epMain, "inline", "", epNoRepl, epIds, epOk).
    Let mutable epLive be collectCallNames(epMainInl).
    Let mutable epLiveDone be false.
    While not epLiveDone:
        Set epLiveDone to true.
        Repeat for epLn in epLive:
            Let epLk be "{epLn}".
            If specFuncs contains epLk and not epIds contains epLk:
                Let epLdef be item epLk of specFuncs.
                Inspect epLdef:
                    When CFuncDef (epLf, epLps, epLpt, epLrt, epLbody):
                        Repeat for epLc in collectCallNames(peRewriteStmts(epLbody, "inline", "", epNoRepl, epIds, epOk)):
                            If not epLive contains epLc:
                                Let epLck be "{epLc}".
                                Push epLck to epLive.
                                Set epLiveDone to false.
                    Otherwise:
                        Let epSkipL be true.
    Let mutable printed be a new Map of Text to Bool.
    Repeat for fnKey2 in allNames:
        Let fkStr3 be "{fnKey2}".
        If specFuncs contains fkStr3 and not printed contains fkStr3 and epLive contains fkStr3:
            Let fkStr4 be "{fnKey2}".
            Set item fkStr4 of printed to true.
            Let fdef2 be item fkStr3 of specFuncs.
            Inspect fdef2:
                When CFuncDef (fn1, ps1, pt1, rt1, body1):
                    Let mutable epSeqParams be a new Seq of Text.
                    Let mutable epPi be 1.
                    Repeat for epP in ps1:
                        If epPi is at most length of pt1:
                            If peStartsWith(item epPi of pt1, "Seq of "):
                                Let epPk be "{epP}".
                                Push epPk to epSeqParams.
                        Set epPi to epPi + 1.
                    Let epBody be peTupleEta(peRewriteStmts(body1, "inline", "", epNoRepl, epIds, epOk), epArities).
                    Let epKinds be peKinds(epBody, ps1, pt1, epMutating).
                    Let finished be a new CFuncDef with name fn1 and params ps1 and paramTypes pt1 and returnType rt1 and body peDropUnread(peFinishFixed(epBody, epSeqParams, epMutating, epKinds), ps1, epKinds).
                    Let funcSrc be decompileFunc(finished).
                    If the length of funcSrc is greater than 0:
                        Set output to "{output}{funcSrc}{nl}".
                Otherwise:
                    Let skipG be true.
    Let mainSrc be decompileBlock(peFinishBlock(epMainInl, epMutating), 0).
    Let mutable epSections be "".
    If output contains "PeSumS" or mainSrc contains "PeSumS":
        Set epSections to "{peSumSections(epState)}{nl}".
    Return "{epSections}{output}## Main{nl}{mainSrc}".

## To peSinkLets (skStmts: Seq of CStmt) -> Seq of CStmt:
    Let mutable skCur be skStmts.
    Let mutable skChanged be true.
    While skChanged:
        Set skChanged to false.
        Let skN be length of skCur.
        Let mutable skI be 1.
        Let mutable skDone be false.
        While skI is at most skN and not skDone:
            Let skS be item skI of skCur.
            Inspect skS:
                When CLet (skName, skExpr):
                    If peStartsWith(skName, "pkv__") and isPureForDce(skExpr):
                        Let skTail be peTailOf(skCur, skI + 1).
                        If peCountRefs(skName, skTail) equals 1:
                            Let skReads be peExprRefs(skExpr).
                            Let mutable skJ be skI + 1.
                            Let mutable skBlocked be false.
                            Let mutable skFound be 0.
                            While skJ is at most skN and skFound equals 0 and not skBlocked:
                                Let skT be item skJ of skCur.
                                Let mutable skIsMove be false.
                                Inspect skT:
                                    When CSet (skMt, skMe):
                                        Inspect skMe:
                                            When CVar (skMv):
                                                If skMv equals skName:
                                                    Set skIsMove to true.
                                            Otherwise:
                                                Let skSkipM be true.
                                    Otherwise:
                                        Let skSkipT be true.
                                If skIsMove:
                                    Set skFound to skJ.
                                Otherwise:
                                    Let skOne be a new Seq of CStmt.
                                    Push skT to skOne.
                                    If peCountRefs(skName, skOne) is greater than 0:
                                        Set skBlocked to true.
                                    Otherwise:
                                        Let skW be peStmtWrites(skT).
                                        Repeat for skWn in skW:
                                            If skWn equals "*" or skWn equals skName or skReads contains skWn:
                                                Set skBlocked to true.
                                Set skJ to skJ + 1.
                            If skFound is greater than 0 and not skBlocked:
                                Let mutable skNext be a new Seq of CStmt.
                                Let mutable skK be 1.
                                Repeat for skX in skCur:
                                    If skK equals skFound:
                                        Inspect skX:
                                            When CSet (skFt, skFe):
                                                Push (a new CSet with name skFt and expr skExpr) to skNext.
                                            Otherwise:
                                                Push skX to skNext.
                                    Otherwise:
                                        If not (skK equals skI):
                                            Push skX to skNext.
                                    Set skK to skK + 1.
                                Set skCur to skNext.
                                Set skChanged to true.
                                Set skDone to true.
                Otherwise:
                    Let skSkip be true.
            Set skI to skI + 1.
    Return skCur.

## To peLeafRefCount (lrName: Text) and (lrState: PEState) -> Int:
    Let mutable lrN be 0.
    Repeat for (lrK, lrV) in (peStaticEnv(lrState)):
        If not peStartsWith(lrK, "__pe_"):
            Let lrRefs be peExprRefs(lrV).
            Repeat for lrR in lrRefs:
                If lrR equals lrName:
                    Set lrN to lrN + 1.
    Return lrN.

## To peOnlyMovesOf (omStmts: Seq of CStmt) and (omTarget: Text) and (omFrom: Text) -> Bool:
    Repeat for omS in omStmts:
        Let mutable omIsMove be false.
        Inspect omS:
            When CSet (omT, omE):
                If omT equals omTarget:
                    Inspect omE:
                        When CVar (omV):
                            If omV equals omFrom:
                                Set omIsMove to true.
                        Otherwise:
                            Let omSkipE be true.
            Otherwise:
                Let omSkip be true.
        If not omIsMove:
            Inspect omS:
                When CIf (omC, omT2, omE2):
                    Let omCs be peExprRefs(omC).
                    If omCs contains omTarget:
                        Return false.
                    If not peOnlyMovesOf(omT2, omTarget, omFrom):
                        Return false.
                    If not peOnlyMovesOf(omE2, omTarget, omFrom):
                        Return false.
                Otherwise:
                    Let omOne be a new Seq of CStmt.
                    Push omS to omOne.
                    If peCountRefs(omTarget, omOne) is greater than 0:
                        Return false.
                    Let omW be peStmtWrites(omS).
                    If omW contains omTarget or omW contains "*":
                        Return false.
    Return true.

## To peDropMoves (dmStmts: Seq of CStmt) and (dmTarget: Text) and (dmFrom: Text) -> Seq of CStmt:
    Let mutable dmOut be a new Seq of CStmt.
    Let mutable dmMap be a new Map of Text to Text.
    Let dmTk be "{dmTarget}".
    Set item dmFrom of dmMap to dmTk.
    Repeat for dmS in dmStmts:
        Let mutable dmIsMove be false.
        Inspect dmS:
            When CSet (dmT, dmE):
                If dmT equals dmTarget:
                    Inspect dmE:
                        When CVar (dmV):
                            If dmV equals dmFrom:
                                Set dmIsMove to true.
                        Otherwise:
                            Let dmSkipE be true.
            Otherwise:
                Let dmSkip be true.
        If not dmIsMove:
            Inspect dmS:
                When CIf (dmC, dmT2, dmE2):
                    Let dmJr be a new Seq of Text.
                    Let dmJw be a new Seq of Text.
                    Push (a new CIf with cond (renameExpr(dmC, dmMap, dmJr, dmJw)) and thenBlock peDropMoves(dmT2, dmTarget, dmFrom) and elseBlock peDropMoves(dmE2, dmTarget, dmFrom)) to dmOut.
                Otherwise:
                    Let dmOne be a new Seq of CStmt.
                    Push dmS to dmOne.
                    Let dmJr2 be a new Seq of Text.
                    Let dmJw2 be a new Seq of Text.
                    Let dmRen be renameStmts(dmOne, dmMap, dmJr2, dmJw2).
                    Repeat for dmR in dmRen:
                        Push dmR to dmOut.
    Return dmOut.

## To peCoalesceUpdates (cuStmts: Seq of CStmt) -> Seq of CStmt:
    Let mutable cuCur be cuStmts.
    Let mutable cuChanged be true.
    While cuChanged:
        Set cuChanged to false.
        Let cuN be length of cuCur.
        Let mutable cuI be 1.
        While cuI is at most cuN and not cuChanged:
            Let cuS be item cuI of cuCur.
            Inspect cuS:
                When CLet (cuX, cuE):
                    If peStartsWith(cuX, "pkv__"):
                        Let mutable cuJ be cuI + 1.
                        Let mutable cuTarget be "".
                        Let mutable cuAt be 0.
                        While cuJ is at most cuN and cuAt equals 0:
                            Let cuT be item cuJ of cuCur.
                            Inspect cuT:
                                When CSet (cuL, cuLe):
                                    Inspect cuLe:
                                        When CVar (cuLv):
                                            If cuLv equals cuX and peStartsWith(cuL, "pkv__"):
                                                Set cuTarget to "{cuL}".
                                                Set cuAt to cuJ.
                                        Otherwise:
                                            Let cuSkipLe be true.
                                Otherwise:
                                    Let cuSkipT be true.
                            Set cuJ to cuJ + 1.
                        If cuAt is greater than 0:
                            Let cuBetween be peSlice(cuCur, cuI + 1, cuAt - 1).
                            Let cuAfter be peTailOf(cuCur, cuAt + 1).
                            If peOnlyMovesOf(cuBetween, cuTarget, cuX) and peCountRefs(cuX, cuAfter) equals 0:
                                Let mutable cuNext be a new Seq of CStmt.
                                Repeat for cuP in peSlice(cuCur, 1, cuI - 1):
                                    Push cuP to cuNext.
                                Let cuTk be "{cuTarget}".
                                Push (a new CSet with name cuTk and expr cuE) to cuNext.
                                Repeat for cuB in peDropMoves(cuBetween, cuTarget, cuX):
                                    Push cuB to cuNext.
                                Repeat for cuA in cuAfter:
                                    Push cuA to cuNext.
                                Set cuCur to cuNext.
                                Set cuChanged to true.
                Otherwise:
                    Let cuSkip be true.
            Set cuI to cuI + 1.
    Return cuCur.

## To peSlice (slStmts: Seq of CStmt) and (slFrom: Int) and (slTo: Int) -> Seq of CStmt:
    Let mutable slOut be a new Seq of CStmt.
    Let mutable slI be 1.
    Repeat for slS in slStmts:
        If slI is at least slFrom and slI is at most slTo:
            Push slS to slOut.
        Set slI to slI + 1.
    Return slOut.

## To peDeepDce (ddStmts: Seq of CStmt) -> Seq of CStmt:
    Let mutable ddCur be ddStmts.
    Let mutable ddChanged be true.
    While ddChanged:
        Set ddChanged to false.
        Let mutable ddDeclared be a new Seq of Text.
        Repeat for ddS in ddCur:
            Inspect ddS:
                When CLet (ddLn, ddLe):
                    If not ddDeclared contains ddLn:
                        Let ddLk be "{ddLn}".
                        Push ddLk to ddDeclared.
                Otherwise:
                    Let ddSkip be true.
        If length of ddDeclared is greater than 0:
            Let ddMap be a new Map of Text to Text.
            Let mutable ddRefs be a new Seq of Text.
            Let mutable ddWrites be a new Seq of Text.
            Let ddWalked be renameStmts(ddCur, ddMap, ddRefs, ddWrites).
            If ddRefs contains "__pe_unsupported":
                Return ddCur.
            Let mutable ddDead be a new Seq of Text.
            Repeat for ddD in ddDeclared:
                If not ddRefs contains ddD:
                    Let ddDk be "{ddD}".
                    Push ddDk to ddDead.
            If length of ddDead is greater than 0:
                Let mutable ddStranded be a new Seq of Text.
                peStrandedWrites(ddCur, ddDead, ddStranded).
                Let mutable ddDrop be a new Seq of Text.
                Repeat for ddX in ddDead:
                    If not ddStranded contains ddX:
                        Let ddXk be "{ddX}".
                        Push ddXk to ddDrop.
                If length of ddDrop is greater than 0:
                    Set ddCur to peDropDeadWrites(ddCur, ddDrop).
                    Set ddChanged to true.
    Return ddCur.

## To peBlock (stmts: Seq of CStmt) and (state: mutable PEState) -> Seq of CStmt:
    Return dceBlock(specializeStmts(stmts, state)).

## To peExpandPlaces (epStmts: Seq of CStmt) -> Seq of CStmt:
    Let mutable epOut be a new Seq of CStmt.
    Repeat for epS in epStmts:
        Inspect epS:
            When CAtPath (epRoot, epPath, epBody):
                Push (a new CForceDynamic with name epRoot) to epOut.
                Repeat for epWrite in epBody:
                    Push epWrite to epOut.
            When CCheckPolicy (epcSubject, epcObject, epcCapability, epcRule, epcAlts, epcSource):
                Push (a new CForceDynamic with name epcSubject) to epOut.
                If epcObject is not "":
                    Push (a new CForceDynamic with name epcObject) to epOut.
                Push epS to epOut.
            Otherwise:
                Push epS to epOut.
    Return epOut.

## To peSameNames (snA: Seq of Text) and (snB: Seq of Text) -> Bool:
    If not ((length of snA) equals (length of snB)):
        Return false.
    Let mutable snI be 1.
    Repeat for snX in snA:
        Let snY be item snI of snB.
        If not (snX equals snY):
            Return false.
        Set snI to snI + 1.
    Return true.

## To peSameExprs (seA: Seq of CExpr) and (seB: Seq of CExpr) -> Bool:
    If not ((length of seA) equals (length of seB)):
        Return false.
    Let mutable seI be 1.
    Repeat for seX in seA:
        Let seY be item seI of seB.
        If not peSameExpr(seX, seY):
            Return false.
        Set seI to seI + 1.
    Return true.

## To peSimpleExpr (smE: CExpr) -> Bool:
    If isLiteral(smE):
        Return true.
    Inspect smE:
        When CVar (smV):
            Return true.
        When CBinOp (smOp, smL, smR):
            If peSimpleExpr(smL):
                Return peSimpleExpr(smR).
            Return false.
        When CNot (smI):
            Return peSimpleExpr(smI).
        When COptionNone:
            Return true.
        When CNothing:
            Return true.
        Otherwise:
            Return false.

## To peSameExpr (sxA: CExpr) and (sxB: CExpr) -> Bool:
    Inspect sxA:
        When CNew (sxAt, sxAn, sxAv):
            Inspect sxB:
                When CNew (sxBt, sxBn, sxBv):
                    If not (sxAt equals sxBt):
                        Return false.
                    If not peSameNames(sxAn, sxBn):
                        Return false.
                    Return peSameExprs(sxAv, sxBv).
                Otherwise:
                    Return false.
        When CNewVariant (sxAg, sxAgn, sxAgv):
            Inspect sxB:
                When CNewVariant (sxBg, sxBgn, sxBgv):
                    If not (sxAg equals sxBg):
                        Return false.
                    If not peSameNames(sxAgn, sxBgn):
                        Return false.
                    Return peSameExprs(sxAgv, sxBgv).
                Otherwise:
                    Return false.
        When CTuple (sxAi):
            Inspect sxB:
                When CTuple (sxBi):
                    Return peSameExprs(sxAi, sxBi).
                Otherwise:
                    Return false.
        When CList (sxAl):
            Inspect sxB:
                When CList (sxBl):
                    Return peSameExprs(sxAl, sxBl).
                Otherwise:
                    Return false.
        When COptionSome (sxAo):
            Inspect sxB:
                When COptionSome (sxBo):
                    Return peSameExpr(sxAo, sxBo).
                Otherwise:
                    Return false.
        When CNewSeq (sxAq):
            Inspect sxB:
                When CNewSeq (sxBq):
                    Return sxAq equals sxBq.
                Otherwise:
                    Return false.
        When CNewSet (sxAs):
            Inspect sxB:
                When CNewSet (sxBs):
                    Return sxAs equals sxBs.
                Otherwise:
                    Return false.
        When CCall (sxAc, sxAca):
            Inspect sxB:
                When CCall (sxBc, sxBca):
                    If not (sxAc equals sxBc):
                        Return false.
                    Return peSameExprs(sxAca, sxBca).
                Otherwise:
                    Return false.
        Otherwise:
            Let sxSkip be true.
    If not peSimpleExpr(sxA):
        Return false.
    If not peSimpleExpr(sxB):
        Return false.
    Return exprToKeyPart(sxA) equals exprToKeyPart(sxB).

## To peLoopCandidate (lcE: CExpr) -> Bool:
    If peShapeable(lcE):
        Return true.
    Return isPeValueForCopyProp(lcE).

## To peShapeable (shE: CExpr) -> Bool:
    Inspect shE:
        When CNew (shT, shN, shV):
            Return true.
        When CNewVariant (shG, shGn, shGv):
            Return true.
        When CTuple (shI):
            Return true.
        When COptionSome (shO):
            Return true.
        When CList (shL):
            Return true.
        When CNewSeq (shQ):
            Return true.
        Otherwise:
            Return peIsBox(shE).

## To peGeneralizeArgs (gzPrev: Seq of CExpr) and (gzNext: Seq of CExpr) and (gzState: mutable PEState) -> Seq of CExpr:
    If not hoistActive((peSpecResults(gzState))):
        Return gzNext.
    Let mutable gzLeaves be a new Seq of Text.
    Let gzGen be peGenShapes(gzPrev, gzNext, gzLeaves, gzState).
    If length of gzLeaves equals 0:
        Return gzNext.
    Let mutable gzVals be a new Map of Text to CExpr.
    If not peMatchLeavesAll(gzGen, gzNext, gzLeaves, gzVals, gzState):
        Return gzNext.
    Let mutable gzLets be a new Seq of CStmt.
    Repeat for gzL in gzLeaves:
        Let gzLk be "{gzL}".
        If not (gzVals contains gzLk):
            Return gzNext.
        Let gzLk2 be "{gzL}".
        Push (a new CLet with name gzLk2 and expr (item gzLk of gzVals)) to gzLets.
    hoistAppendSt(gzState, gzLets).
    Return gzGen.

## To peGenShapes (gaA: Seq of CExpr) and (gaB: Seq of CExpr) and (gaLeaves: mutable Seq of Text) and (gaSt: mutable PEState) -> Seq of CExpr:
    Let gaOut be a new Seq of CExpr.
    Let mutable gaI be 1.
    Repeat for gaX in gaA:
        Let gaY be item gaI of gaB.
        Push peGenShape(gaX, gaY, gaLeaves, gaSt) to gaOut.
        Set gaI to gaI + 1.
    Return gaOut.

## To peEveryItemDiffers (edA: Seq of CExpr) and (edB: Seq of CExpr) -> Bool:
    Let mutable edI be 1.
    Repeat for edX in edA:
        If peSameExpr(edX, item edI of edB):
            Return false.
        Set edI to edI + 1.
    Return true.

## To peIsSum (smE: CExpr) -> Bool:
    Inspect smE:
        When CCall (smN, smA):
            If peStartsWith(smN, "peSum__"):
                Return length of smA equals 1.
            Return false.
        Otherwise:
            Return false.

## To peSumDef (sdE: CExpr) and (sdSt: PEState) -> CExpr:
    Inspect sdE:
        When CCall (sdN, sdA):
            Let sdK be "__pe_sumdef__{sdN}".
            If (peSpecResults(sdSt)) contains sdK:
                Return item sdK of (peSpecResults(sdSt)).
        Otherwise:
            Let sdSkip be true.
    Return a new CNothing.

## To peSumPart (spDef: CExpr) and (spAt: Int) -> Seq of CExpr:
    Inspect spDef:
        When CNewVariant (spT, spNs, spVs):
            Inspect item spAt of spVs:
                When CList (spItems):
                    Return spItems.
                Otherwise:
                    Let spSkip be true.
        Otherwise:
            Let spSkip2 be true.
    Return a new Seq of CExpr.

## To peSumIds (siDef: CExpr) -> Seq of Text:
    Return peTextsOf(a new CList with items peSumPart(siDef, 5)).

## To peSumShapeId (ssShape: CExpr) and (ssHoles: mutable Seq of Text) and (ssKinds: mutable Seq of Text) and (ssSt: mutable PEState) -> Text:
    Let mutable ssNames be a new Seq of Text.
    Let mutable ssTypes be a new Seq of Text.
    If peFreeNonLeaf(ssShape):
        Return "".
    If not peCollectTypedLeaves(ssShape, "", ssNames, ssTypes, ssSt):
        Return "".
    If length of ssNames is greater than 12:
        Return "".
    Let mutable ssCanon be a new Map of Text to Text.
    Let mutable ssJ be 1.
    Repeat for ssL in ssNames:
        Let ssLk be "{ssL}".
        Set item ssLk of ssCanon to "pkv__shh{ssJ}".
        Set ssJ to ssJ + 1.
    Let ssCr be a new Seq of Text.
    Let ssCw be a new Seq of Text.
    Let ssKey be "__pe_sumshape__{exprToKeyPart(renameExpr(ssShape, ssCanon, ssCr, ssCw))}".
    Let mutable ssId be "".
    If (peSpecResults(ssSt)) contains ssKey:
        Set ssId to peTextOf(item ssKey of (peSpecResults(ssSt))).
    Otherwise:
        Let ssFresh be freshNameSt(ssSt, "peSumShape").
        Set ssId to peTextAfter(ssFresh, 12).
        Let ssIdK be "{ssId}".
        peStSrBind(ssSt, ssKey, a new CText with value ssIdK).
    Let mutable ssRen be a new Map of Text to Text.
    Let mutable ssK be 1.
    Repeat for ssL2 in ssNames:
        Let ssL2k be "{ssL2}".
        Let ssHole be "pkv__sh{ssId}h{ssK}".
        Set item ssL2k of ssRen to ssHole.
        Push ssHole to ssHoles.
        Push (item ssK of ssTypes) to ssKinds.
        Set ssK to ssK + 1.
    Let ssRr be a new Seq of Text.
    Let ssRw be a new Seq of Text.
    Let ssStored be renameExpr(ssShape, ssRen, ssRr, ssRw).
    Let ssListK be "__pe_sumshapes".
    Let mutable ssAll be a new Seq of CExpr.
    Let mutable ssHave be false.
    If (peSpecResults(ssSt)) contains ssListK:
        Inspect item ssListK of (peSpecResults(ssSt)):
            When CList (ssPrev):
                Set ssAll to copy of ssPrev.
                Repeat for ssP in ssPrev:
                    Inspect ssP:
                        When CNewVariant (ssPt, ssPns, ssPvs):
                            If peTextOf(item 4 of ssPvs) equals ssId:
                                Set ssHave to true.
                        Otherwise:
                            Let ssPskip be true.
            Otherwise:
                Let ssAskip be true.
    If not ssHave:
        Let mutable ssEntryNs be a new Seq of Text.
        Push "shape" to ssEntryNs.
        Push "holes" to ssEntryNs.
        Push "kinds" to ssEntryNs.
        Push "id" to ssEntryNs.
        Let mutable ssEntryVs be a new Seq of CExpr.
        Push ssStored to ssEntryVs.
        Push (peTextList(ssHoles)) to ssEntryVs.
        Push (peTextList(ssKinds)) to ssEntryVs.
        Let ssIdK2 be "{ssId}".
        Push (a new CText with value ssIdK2) to ssEntryVs.
        Push (a new CNewVariant with tag "PeSumShape" and fnames ssEntryNs and fvals ssEntryVs) to ssAll.
        peStSrBind(ssSt, ssListK, a new CList with items ssAll).
    Return ssId.

## To peFreeNonLeaf (fnE: CExpr) -> Bool:
    Inspect fnE:
        When CVar (fnV):
            Return not peStartsWith(fnV, "pkv__").
        When CNew (fnT, fnNs, fnVs):
            Repeat for fnX in fnVs:
                If peFreeNonLeaf(fnX):
                    Return true.
            Return false.
        When CNewVariant (fnG, fnGs, fnGv):
            Repeat for fnY in fnGv:
                If peFreeNonLeaf(fnY):
                    Return true.
            Return false.
        When CList (fnL):
            Repeat for fnZ in fnL:
                If peFreeNonLeaf(fnZ):
                    Return true.
            Return false.
        When CTuple (fnTu):
            Repeat for fnW in fnTu:
                If peFreeNonLeaf(fnW):
                    Return true.
            Return false.
        When COptionSome (fnO):
            Return peFreeNonLeaf(fnO).
        When CCall (fnC, fnCa):
            Repeat for fnQ in fnCa:
                If peFreeNonLeaf(fnQ):
                    Return true.
            Return false.
        Otherwise:
            Return false.

## To peSumFits (sfAlt: CExpr) and (sfHoles: Seq of Text) and (sfV: CExpr) and (sfOut: mutable Map of Text to CExpr) and (sfSt: PEState) -> Bool:
    Let mutable sfScratch be a new Map of Text to CExpr.
    If not peMatchLeaves(sfAlt, sfV, sfHoles, sfScratch, sfSt):
        Return false.
    Repeat for sfH in sfHoles:
        If not sfScratch contains sfH:
            Return false.
    Set sfOut to sfScratch.
    Return true.

## To peSumBuild (sbDef: CExpr) and (sbV: CExpr) and (sbSt: PEState) -> CExpr:
    Let sbAlts be peSumPart(sbDef, 1).
    Let sbHoleLists be peSumPart(sbDef, 2).
    Let sbIds be peSumIds(sbDef).
    Let mutable sbI be 1.
    Repeat for sbAlt in sbAlts:
        Let sbHoles be peTextsOf(item sbI of sbHoleLists).
        Let mutable sbBound be a new Map of Text to CExpr.
        If peSumFits(sbAlt, sbHoles, sbV, sbBound, sbSt):
            Let mutable sbFields be a new Seq of Text.
            Let mutable sbVals be a new Seq of CExpr.
            Let mutable sbJ be 1.
            Repeat for sbH in sbHoles:
                Push "h{sbJ}" to sbFields.
                Push (item sbH of sbBound) to sbVals.
                Set sbJ to sbJ + 1.
            Let sbId be item sbI of sbIds.
            Return a new CNewVariant with tag "PeSumS{sbId}" and fnames sbFields and fvals sbVals.
        Set sbI to sbI + 1.
    Return a new CVar with name "__pe_no_unfold".

## To peSumViewOf (svE: CExpr) and (svSt: mutable PEState) and (svIds: mutable Seq of Text) -> Bool:
    If peIsSum(svE):
        Let svDef be peSumDef(svE, svSt).
        Inspect svDef:
            When CNothing:
                Return false.
            Otherwise:
                Let svHas be true.
        Repeat for svId in peSumIds(svDef):
            If not svIds contains svId:
                Let svIdK be "{svId}".
                Push svIdK to svIds.
        Return true.
    Inspect svE:
        When CNew (svNt, svNns, svNvs):
            Let svOk be true.
        When CNewVariant (svVt, svVns, svVvs):
            Let svOk2 be true.
        Otherwise:
            Return false.
    Let mutable svH be a new Seq of Text.
    Let mutable svK be a new Seq of Text.
    Let svNew be peSumShapeId(svE, svH, svK, svSt).
    If svNew equals "":
        Return false.
    If not svIds contains svNew:
        Let svNewK be "{svNew}".
        Push svNewK to svIds.
    Return true.

## To peSumShapeEntry (seId: Text) and (seSt: PEState) -> CExpr:
    If (peSpecResults(seSt)) contains "__pe_sumshapes":
        Inspect item "__pe_sumshapes" of (peSpecResults(seSt)):
            When CList (seAll):
                Repeat for seE in seAll:
                    Inspect seE:
                        When CNewVariant (seT, seNs, seVs):
                            If peTextOf(item 4 of seVs) equals seId:
                                Return seE.
                        Otherwise:
                            Let seSkip be true.
            Otherwise:
                Let seSkip2 be true.
    Return a new CNothing.

## To peGenSum (gnA: CExpr) and (gnB: CExpr) and (gnLeaves: mutable Seq of Text) and (gnSt: mutable PEState) -> CExpr:
    Let gnNo be a new CVar with name "__pe_no_unfold".
    Let mutable gnIds be a new Seq of Text.
    If not peSumViewOf(gnA, gnSt, gnIds):
        Return gnNo.
    If not peSumViewOf(gnB, gnSt, gnIds):
        Return gnNo.
    If length of gnIds is less than 2 or length of gnIds is greater than 6:
        Return gnNo.
    Let mutable gnSides be a new Seq of CExpr.
    Push gnA to gnSides.
    Push gnB to gnSides.
    Repeat for gnSide in gnSides:
        If peIsSum(gnSide) and gnLeaves contains peBoxBase(gnSide):
            If length of peSumIds(peSumDef(gnSide, gnSt)) equals length of gnIds:
                Return gnSide.
    Let mutable gnViewKey be "__pe_sumview__".
    Repeat for gnVid in gnIds:
        Set gnViewKey to "{gnViewKey}_{gnVid}".
    Let mutable gnName be "".
    If (peSpecResults(gnSt)) contains gnViewKey:
        Set gnName to peTextOf(item gnViewKey of (peSpecResults(gnSt))).
    Otherwise:
        Set gnName to freshNameSt(gnSt, "peSum").
        Let gnNameK be "{gnName}".
        peStSrBind(gnSt, gnViewKey, a new CText with value gnNameK).
        Let mutable gnAlts be a new Seq of CExpr.
        Let mutable gnHoles be a new Seq of CExpr.
        Let mutable gnKinds be a new Seq of CExpr.
        Let mutable gnIdTexts be a new Seq of CExpr.
        Repeat for gnId in gnIds:
            Inspect peSumShapeEntry(gnId, gnSt):
                When CNewVariant (gnEt, gnEns, gnEvs):
                    Push (item 1 of gnEvs) to gnAlts.
                    Push (item 2 of gnEvs) to gnHoles.
                    Push (item 3 of gnEvs) to gnKinds.
                    Let gnIdK be "{gnId}".
                    Push (a new CText with value gnIdK) to gnIdTexts.
                Otherwise:
                    Return gnNo.
        Let gnNum be peTextAfter(gnName, 7).
        Let mutable gnRet be "".
        Inspect item 1 of gnAlts:
            When CNew (gnRt, gnRns, gnRvs):
                Set gnRet to "{gnRt}".
            When CNewVariant (gnRg, gnRgs, gnRgv):
                Set gnRet to peEnumOf(gnSt, gnRg).
            Otherwise:
                Let gnRetSkip be true.
        If gnRet equals "":
            Return gnNo.
        Let mutable gnDefNs be a new Seq of Text.
        Push "alts" to gnDefNs.
        Push "holes" to gnDefNs.
        Push "kinds" to gnDefNs.
        Push "num" to gnDefNs.
        Push "ids" to gnDefNs.
        Let mutable gnDefVs be a new Seq of CExpr.
        Push (a new CList with items gnAlts) to gnDefVs.
        Push (a new CList with items gnHoles) to gnDefVs.
        Push (a new CList with items gnKinds) to gnDefVs.
        Push (a new CText with value gnNum) to gnDefVs.
        Push (a new CList with items gnIdTexts) to gnDefVs.
        Let gnDefK be "__pe_sumdef__{gnName}".
        peStSrBind(gnSt, gnDefK, a new CNewVariant with tag "PeSumDef" and fnames gnDefNs and fvals gnDefVs).
        Let mutable gnFnArms be a new Seq of CMatchArm.
        Let mutable gnFi be 1.
        Repeat for gnFa in gnAlts:
            Let gnFh be peTextsOf(item gnFi of gnHoles).
            Let gnFid be item gnFi of gnIds.
            Let mutable gnFret be a new Seq of CStmt.
            Push (a new CReturn with expr gnFa) to gnFret.
            Push (a new CWhen with variantName "PeSumS{gnFid}" and bindings gnFh and body gnFret) to gnFnArms.
            Set gnFi to gnFi + 1.
        Let mutable gnFnBody be a new Seq of CStmt.
        Push (a new CInspect with target (a new CVar with name "pbS") and arms gnFnArms) to gnFnBody.
        Let mutable gnFnPs be a new Seq of Text.
        Push "pbS" to gnFnPs.
        Let mutable gnFnTs be a new Seq of Text.
        Push "PeSum" to gnFnTs.
        Let gnFnName be "{gnName}".
        peStFuncBind(gnSt, gnFnName, a new CFuncDef with name gnFnName and params gnFnPs and paramTypes gnFnTs and returnType gnRet and body gnFnBody).
        peMarkSpecialized(gnName, gnSt).
    Let gnLeaf be freshNameSt(gnSt, "pkv").
    Let gnLeafK be "{gnLeaf}".
    Push gnLeafK to gnLeaves.
    Let mutable gnArgs be a new Seq of CExpr.
    Push (a new CVar with name gnLeaf) to gnArgs.
    Return a new CCall with name gnName and args gnArgs.

## To peSumSections (ssSt: PEState) -> Text:
    Let ssNl be chr(10).
    Let mutable ssOut be "## A PeSum is one of:{ssNl}".
    If (peSpecResults(ssSt)) contains "__pe_sumshapes":
        Inspect item "__pe_sumshapes" of (peSpecResults(ssSt)):
            When CList (ssAll):
                Repeat for ssE in ssAll:
                    Inspect ssE:
                        When CNewVariant (ssT, ssNs, ssVs):
                            Let ssId be peTextOf(item 4 of ssVs).
                            Let ssKinds be peTextsOf(item 3 of ssVs).
                            Let mutable ssLine be "    A PeSumS{ssId}".
                            Let mutable ssJ be 1.
                            Repeat for ssK in ssKinds:
                                If ssJ equals 1:
                                    Set ssLine to "{ssLine} with h{ssJ} {ssK}".
                                Otherwise:
                                    Set ssLine to "{ssLine} and h{ssJ} {ssK}".
                                Set ssJ to ssJ + 1.
                            Set ssOut to "{ssOut}{ssLine}.{ssNl}".
                        Otherwise:
                            Let ssSkip be true.
            Otherwise:
                Let ssSkip2 be true.
    Return ssOut.

## To peReplaceSum (rsE: CExpr) and (rsBox: CExpr) and (rsWith: CExpr) -> CExpr:
    If peSameExpr(rsE, rsBox):
        Return rsWith.
    Inspect rsE:
        When CNew (rsT, rsNs, rsVs):
            Let mutable rsNv be a new Seq of CExpr.
            Repeat for rsX in rsVs:
                Push peReplaceSum(rsX, rsBox, rsWith) to rsNv.
            Return a new CNew with typeName rsT and fieldNames rsNs and fields rsNv.
        When CNewVariant (rsG, rsGs, rsGv):
            Let mutable rsNg be a new Seq of CExpr.
            Repeat for rsY in rsGv:
                Push peReplaceSum(rsY, rsBox, rsWith) to rsNg.
            Return a new CNewVariant with tag rsG and fnames rsGs and fvals rsNg.
        When CList (rsL):
            Let mutable rsNl be a new Seq of CExpr.
            Repeat for rsZ in rsL:
                Push peReplaceSum(rsZ, rsBox, rsWith) to rsNl.
            Return a new CList with items rsNl.
        When CTuple (rsTu):
            Let mutable rsNt be a new Seq of CExpr.
            Repeat for rsW in rsTu:
                Push peReplaceSum(rsW, rsBox, rsWith) to rsNt.
            Return a new CTuple with items rsNt.
        When COptionSome (rsO):
            Return a new COptionSome with inner peReplaceSum(rsO, rsBox, rsWith).
        Otherwise:
            Return rsE.

## To peInspectsName (inStmts: Seq of CStmt) and (inName: Text) -> Bool:
    Repeat for inS in inStmts:
        Inspect inS:
            When CInspect (inT, inArms):
                Inspect inT:
                    When CVar (inV):
                        If inV equals inName:
                            Return true.
                    Otherwise:
                        Let inSkipT be true.
                Repeat for inArm in inArms:
                    If peInspectsName(peArmBody(inArm), inName):
                        Return true.
            When CIf (inC, inTh, inEl):
                If peInspectsName(inTh, inName) or peInspectsName(inEl, inName):
                    Return true.
            When CWhile (inWc, inWb):
                If peInspectsName(inWb, inName):
                    Return true.
            When CRepeat (inRv, inRc, inRb):
                If peInspectsName(inRb, inName):
                    Return true.
            When CRepeatRange (inQv, inQs, inQe, inQb):
                If peInspectsName(inQb, inName):
                    Return true.
            Otherwise:
                Let inSkip be true.
    Return false.

## To peSumOfName (soE: CExpr) and (soSt: PEState) -> CExpr:
    Inspect soE:
        When CVar (soV):
            Let soK be "{soV}".
            If (peStaticEnv(soSt)) contains soK:
                Let soVal be item soK of (peStaticEnv(soSt)).
                If peIsSum(soVal):
                    Return soVal.
        Otherwise:
            Let soSkip be true.
    Return a new CVar with name "__pe_no_unfold".

## To peSumRead (srE: CExpr) and (srSt: PEState) -> CExpr:
    Let srNo be a new CVar with name "__pe_no_unfold".
    Inspect srE:
        When CIndex (srC, srI):
            Let srA be peSumOfName(srC, srSt).
            If not isNoUnfold(srA):
                Return srA.
            Let srA2 be peSumRead(srC, srSt).
            If not isNoUnfold(srA2):
                Return srA2.
            Return peSumRead(srI, srSt).
        When CContains (srCc, srCe):
            Let srB be peSumOfName(srCc, srSt).
            If not isNoUnfold(srB):
                Return srB.
            Let srB2 be peSumRead(srCc, srSt).
            If not isNoUnfold(srB2):
                Return srB2.
            Return peSumRead(srCe, srSt).
        When CLen (srL):
            Let srD be peSumOfName(srL, srSt).
            If not isNoUnfold(srD):
                Return srD.
            Return peSumRead(srL, srSt).
        When CMapGet (srMt, srMk):
            Let srE2 be peSumOfName(srMt, srSt).
            If not isNoUnfold(srE2):
                Return srE2.
            Return peSumRead(srMk, srSt).
        When CBinOp (srOp, srLl, srRr):
            Let srF be peSumRead(srLl, srSt).
            If not isNoUnfold(srF):
                Return srF.
            Return peSumRead(srRr, srSt).
        When CNot (srN):
            Return peSumRead(srN, srSt).
        When CCall (srFn, srArgs):
            Repeat for srX in srArgs:
                Let srG be peSumRead(srX, srSt).
                If not isNoUnfold(srG):
                    Return srG.
            Return srNo.
        When CInterpolatedString (srParts):
            Repeat for srPart in srParts:
                Inspect srPart:
                    When CExprPart (srPe):
                        Let srH be peSumRead(srPe, srSt).
                        If not isNoUnfold(srH):
                            Return srH.
                    Otherwise:
                        Let srPskip be true.
            Return srNo.
        Otherwise:
            Return srNo.

## To peHeldSum (hsV: CExpr) -> CExpr:
    If peIsSum(hsV):
        Return hsV.
    Inspect hsV:
        When CNewVariant (hsG, hsGs, hsGv):
            Repeat for hsX in hsGv:
                If peIsSum(hsX):
                    Return hsX.
        When CNew (hsT, hsNs, hsVs):
            Repeat for hsY in hsVs:
                If peIsSum(hsY):
                    Return hsY.
        Otherwise:
            Let hsSkip be true.
    Return a new CVar with name "__pe_no_unfold".

## To peSumShape (ssBox: CExpr) and (ssIdx: Int) and (ssBinds: Seq of Text) and (ssSt: PEState) -> CExpr:
    Let ssDef be peSumDef(ssBox, ssSt).
    Let ssAlt be item ssIdx of peSumPart(ssDef, 1).
    Let ssHoles be peTextsOf(item ssIdx of peSumPart(ssDef, 2)).
    Let mutable ssRen be a new Map of Text to Text.
    Let mutable ssJ be 1.
    Repeat for ssH in ssHoles:
        Let ssHk be "{ssH}".
        Let ssBk be item ssJ of ssBinds.
        Set item ssHk of ssRen to "{ssBk}".
        Set ssJ to ssJ + 1.
    Let ssJr be a new Seq of Text.
    Let ssJw be a new Seq of Text.
    Return renameExpr(ssAlt, ssRen, ssJr, ssJw).

## To peApplySumRefine (arSt: mutable PEState) and (arArgs: Seq of CExpr):
    Let arBox be item 1 of arArgs.
    Let mutable arIdx be 1.
    Inspect item 2 of arArgs:
        When CInt (arI):
            Set arIdx to arI.
        Otherwise:
            Let arSkipI be true.
    Let mutable arBinds be a new Seq of Text.
    Inspect item 3 of arArgs:
        When CList (arBl):
            Set arBinds to peLeafNames(arBl).
        Otherwise:
            Let arSkipB be true.
    Let arWith be peSumShape(arBox, arIdx, arBinds, arSt).
    Let arSe be peSeShallow(peStaticEnv(arSt)).
    Repeat for (arK, arV) in arSe:
        Let arNew be peReplaceSum(arV, arBox, arWith).
        If not peSameExpr(arNew, arV):
            Let arKk be "{arK}".
            peBindShape(arSt, arKk, arNew).

## To peSumSplit (spBox: CExpr) and (spHead: CStmt) and (spRest: Seq of CStmt) and (spSt: mutable PEState) -> Seq of CStmt:
    Let spDef be peSumDef(spBox, spSt).
    Let spIds be peSumIds(spDef).
    Let spHoleLists be peSumPart(spDef, 2).
    Let spLeafK be "__pe_sumsplit__{peBoxBase(spBox)}".
    Inspect spBox:
        When CCall (spBn, spBa):
            Let spBnK be "{spBn}".
            peStSrBind(spSt, spLeafK, a new CText with value spBnK).
        Otherwise:
            Let spSkipB be true.
    Let mutable spArms be a new Seq of CMatchArm.
    Let mutable spI be 1.
    Repeat for spHl in spHoleLists:
        Let spHoles be peTextsOf(spHl).
        Let mutable spBinds be a new Seq of Text.
        Let mutable spBindVars be a new Seq of CExpr.
        Repeat for spH in spHoles:
            Let spB be freshNameSt(spSt, "pkv").
            Let spBk be "{spB}".
            Push spBk to spBinds.
            Push (a new CVar with name spB) to spBindVars.
        Let mutable spRefArgs be a new Seq of CExpr.
        Push spBox to spRefArgs.
        Push (a new CInt with value spI) to spRefArgs.
        Push (a new CList with items spBindVars) to spRefArgs.
        Let mutable spBody be a new Seq of CStmt.
        Push (a new CCallS with name "__pe_refine__" and args spRefArgs) to spBody.
        Let spShape be peSumShape(spBox, spI, spBinds, spSt).
        Inspect spHead:
            When CLet (spHn, spHe):
                Let spHnk be "{spHn}".
                Push (a new CLet with name spHnk and expr peReplaceSum(spHe, spBox, spShape)) to spBody.
            When CInspect (spIt, spIa):
                Push (a new CInspect with target peReplaceSum(spIt, spBox, spShape) and arms spIa) to spBody.
            Otherwise:
                Push spHead to spBody.
        Repeat for spR in spRest:
            Push spR to spBody.
        Let spId be item spI of spIds.
        Push (a new CWhen with variantName "PeSumS{spId}" and bindings spBinds and body spBody) to spArms.
        Set spI to spI + 1.
    Let mutable spNone be a new Seq of CStmt.
    Push (a new CFail with reason (a new CText with value "the specializer's sum holds no other shape here")) to spNone.
    Push (a new COtherwise with body spNone) to spArms.
    Let mutable spOut be a new Seq of CStmt.
    Push (a new CInspect with target (a new CVar with name peBoxBase(spBox)) and arms spArms) to spOut.
    Return spOut.

## To peGenShape (gsA: CExpr) and (gsB: CExpr) and (gsLeaves: mutable Seq of Text) and (gsSt: mutable PEState) -> CExpr:
    Inspect gsA:
        When CVar (gsAv):
            If gsLeaves contains gsAv:
                Return gsA.
        Otherwise:
            Let gsSkip be true.
    If peSameExpr(gsA, gsB):
        Return gsA.
    Inspect gsA:
        When CNew (gsAt, gsAn, gsAvals):
            Inspect gsB:
                When CNew (gsBt, gsBn, gsBvals):
                    If (gsAt equals gsBt) and peSameNames(gsAn, gsBn):
                        Let gsNames be copy of gsAn.
                        Let gsTy be "{gsAt}".
                        Return a new CNew with typeName gsTy and fieldNames gsNames and fields peGenShapes(gsAvals, gsBvals, gsLeaves, gsSt).
                Otherwise:
                    Let gsSkip2 be true.
        When CNewVariant (gsAg, gsAgn, gsAgv):
            Inspect gsB:
                When CNewVariant (gsBg, gsBgn, gsBgv):
                    If (gsAg equals gsBg) and peSameNames(gsAgn, gsBgn):
                        Let gsGNames be copy of gsAgn.
                        Let gsTag be "{gsAg}".
                        Return a new CNewVariant with tag gsTag and fnames gsGNames and fvals peGenShapes(gsAgv, gsBgv, gsLeaves, gsSt).
                Otherwise:
                    Let gsSkip3 be true.
        When CTuple (gsAi):
            Inspect gsB:
                When CTuple (gsBi):
                    If (length of gsAi) equals (length of gsBi):
                        Return a new CTuple with items peGenShapes(gsAi, gsBi, gsLeaves, gsSt).
                Otherwise:
                    Let gsSkip4 be true.
        When COptionSome (gsAo):
            Inspect gsB:
                When COptionSome (gsBo):
                    Return a new COptionSome with inner peGenShape(gsAo, gsBo, gsLeaves, gsSt).
                Otherwise:
                    Let gsSkip5 be true.
        When CList (gsAl):
            Inspect gsB:
                When CList (gsBl):
                    If (length of gsAl) equals (length of gsBl):
                        If length of gsAl is at least 2 and peEveryItemDiffers(gsAl, gsBl):
                            Let gsWhole be peGenList(gsA, gsB, gsLeaves, gsSt).
                            If not isNoUnfold(gsWhole):
                                Return gsWhole.
                        Return a new CList with items peGenShapes(gsAl, gsBl, gsLeaves, gsSt).
                Otherwise:
                    Let gsSkip7 be true.
        Otherwise:
            Let gsSkip6 be true.
    If peIsBox(gsA):
        Let gsBoxBase be peBoxBase(gsA).
        If gsLeaves contains gsBoxBase:
            Let mutable gsBoxProbe be a new Map of Text to CExpr.
            If peMatchList(gsA, gsB, gsLeaves, gsBoxProbe, gsSt):
                Return gsA.
    If peListLike(gsA) and peListLike(gsB):
        Let gsList be peGenList(gsA, gsB, gsLeaves, gsSt).
        If not isNoUnfold(gsList):
            Return gsList.
    If peIsSum(gsA):
        If gsLeaves contains peBoxBase(gsA):
            Let gsSumDef be peSumDef(gsA, gsSt).
            Let gsSumBuilt be peSumBuild(gsSumDef, gsB, gsSt).
            If not isNoUnfold(gsSumBuilt):
                Return gsA.
    Let gsSum be peGenSum(gsA, gsB, gsLeaves, gsSt).
    If not isNoUnfold(gsSum):
        Return gsSum.
    Let gsLeaf be freshNameSt(gsSt, "pkv").
    Let gsLeafK be "{gsLeaf}".
    Push gsLeafK to gsLeaves.
    Return a new CVar with name gsLeaf.

## To peMatchLeavesAll (maP: Seq of CExpr) and (maV: Seq of CExpr) and (maLeaves: Seq of Text) and (maOut: mutable Map of Text to CExpr) and (maState: PEState) -> Bool:
    If not ((length of maP) equals (length of maV)):
        Return false.
    Let mutable maI be 1.
    Repeat for maX in maP:
        Let maY be item maI of maV.
        If not peMatchLeaves(maX, maY, maLeaves, maOut, maState):
            Return false.
        Set maI to maI + 1.
    Return true.

## To peMatchLeaves (mlP: CExpr) and (mlV: CExpr) and (mlLeaves: Seq of Text) and (mlOut: mutable Map of Text to CExpr) and (mlState: PEState) -> Bool:
    If peIsBox(mlP):
        Return peMatchList(mlP, mlV, mlLeaves, mlOut, mlState).
    If peIsSum(mlP):
        Let mlSumBase be peBoxBase(mlP).
        If not mlLeaves contains mlSumBase:
            Return peSameExpr(mlP, mlV).
        If peIsSum(mlV):
            Inspect mlP:
                When CCall (mlPn, mlPa):
                    Inspect mlV:
                        When CCall (mlVn, mlVa):
                            Let mlPids be peSumIds(peSumDef(mlP, mlState)).
                            Repeat for mlVid in peSumIds(peSumDef(mlV, mlState)):
                                If not mlPids contains mlVid:
                                    Return false.
                            Let mlSbK be "{mlSumBase}".
                            Set item mlSbK of mlOut to item 1 of mlVa.
                            Return true.
                        Otherwise:
                            Return false.
                Otherwise:
                    Return false.
        Let mlSumBuilt be peSumBuild(peSumDef(mlP, mlState), mlV, mlState).
        If isNoUnfold(mlSumBuilt):
            Return false.
        Let mlSbK2 be "{mlSumBase}".
        Set item mlSbK2 of mlOut to mlSumBuilt.
        Return true.
    Inspect mlP:
        When CVar (mlPv):
            If mlLeaves contains mlPv:
                Let mlK be "{mlPv}".
                Set item mlK of mlOut to mlV.
                Return true.
        When CNew (mlPt, mlPn, mlPf):
            Inspect mlV:
                When CNew (mlVt, mlVn, mlVf):
                    If (mlPt equals mlVt) and peSameNames(mlPn, mlVn):
                        Return peMatchLeavesAll(mlPf, mlVf, mlLeaves, mlOut, mlState).
                    Return false.
                Otherwise:
                    Return false.
        When CNewVariant (mlPg, mlPgn, mlPgv):
            Inspect mlV:
                When CNewVariant (mlVg, mlVgn, mlVgv):
                    If (mlPg equals mlVg) and peSameNames(mlPgn, mlVgn):
                        Return peMatchLeavesAll(mlPgv, mlVgv, mlLeaves, mlOut, mlState).
                    Return false.
                Otherwise:
                    Return false.
        When CTuple (mlPi):
            Inspect mlV:
                When CTuple (mlVi):
                    Return peMatchLeavesAll(mlPi, mlVi, mlLeaves, mlOut, mlState).
                Otherwise:
                    Return false.
        When COptionSome (mlPo):
            Inspect mlV:
                When COptionSome (mlVo):
                    Return peMatchLeaves(mlPo, mlVo, mlLeaves, mlOut, mlState).
                Otherwise:
                    Return false.
        When CList (mlPl):
            Inspect mlV:
                When CList (mlVl):
                    Return peMatchLeavesAll(mlPl, mlVl, mlLeaves, mlOut, mlState).
                Otherwise:
                    Return false.
        Otherwise:
            Let mlSkip be true.
    Return peSameExpr(mlP, mlV).

## To peExprRefs (erE: CExpr) -> Seq of Text:
    Let erMap be a new Map of Text to Text.
    Let mutable erRefs be a new Seq of Text.
    Let mutable erWrites be a new Seq of Text.
    Let erWalked be renameExpr(erE, erMap, erRefs, erWrites).
    Return erRefs.

## To peLeafMoves (lmLeaves: Seq of Text) and (lmVals: Map of Text to CExpr) and (lmSt: mutable PEState) -> Seq of CStmt:
    Let mutable lmPending be a new Seq of Text.
    Let mutable lmExprs be a new Map of Text to CExpr.
    Repeat for lmL in lmLeaves:
        Let lmK be "{lmL}".
        If lmVals contains lmK:
            Let lmK2 be "{lmL}".
            Let lmV be item lmK2 of lmVals.
            Let mutable lmSelf be false.
            Inspect lmV:
                When CVar (lmVn):
                    If lmVn equals lmL:
                        Set lmSelf to true.
                Otherwise:
                    Let lmSkip be true.
            If not lmSelf:
                Let lmK3 be "{lmL}".
                Push lmK3 to lmPending.
                Let lmK4 be "{lmL}".
                Set item lmK4 of lmExprs to lmV.
    Let mutable lmOut be a new Seq of CStmt.
    While length of lmPending is greater than 0:
        Let mutable lmPicked be "".
        Repeat for lmP in lmPending:
            If lmPicked equals "":
                Let mutable lmReadLater be false.
                Repeat for lmQ in lmPending:
                    If not (lmQ equals lmP):
                        Let lmQk be "{lmQ}".
                        Let lmQe be item lmQk of lmExprs.
                        Let lmQr be peExprRefs(lmQe).
                        If lmQr contains lmP:
                            Set lmReadLater to true.
                If not lmReadLater:
                    Set lmPicked to "{lmP}".
        If lmPicked equals "":
            Let lmCycle be item 1 of lmPending.
            Let lmCycleK be "{lmCycle}".
            Let lmTemp be freshNameSt(lmSt, "pkv").
            Let lmTempK be "{lmTemp}".
            Push (a new CLet with name lmTempK and expr (a new CVar with name lmCycleK)) to lmOut.
            Let mutable lmRen be a new Map of Text to Text.
            Let lmCycleK2 be "{lmCycle}".
            Let lmTempK2 be "{lmTemp}".
            Set item lmCycleK2 of lmRen to lmTempK2.
            Let mutable lmRenamed be a new Map of Text to CExpr.
            Repeat for lmR in lmPending:
                Let lmRk be "{lmR}".
                Let lmRe be item lmRk of lmExprs.
                Let mutable lmRefs be a new Seq of Text.
                Let mutable lmWrites be a new Seq of Text.
                Let lmRk2 be "{lmR}".
                Set item lmRk2 of lmRenamed to renameExpr(lmRe, lmRen, lmRefs, lmWrites).
            Set lmExprs to lmRenamed.
        Otherwise:
            Let lmPk be "{lmPicked}".
            Let lmPe be item lmPk of lmExprs.
            Let lmPk2 be "{lmPicked}".
            Push (a new CSet with name lmPk2 and expr lmPe) to lmOut.
            Let mutable lmRest be a new Seq of Text.
            Repeat for lmS in lmPending:
                If not (lmS equals lmPicked):
                    Let lmSk be "{lmS}".
                    Push lmSk to lmRest.
            Set lmPending to lmRest.
    Return lmOut.

## To peAnyExit (axStmts: Seq of CStmt) -> Bool:
    Repeat for axS in axStmts:
        Inspect axS:
            When CBreak:
                Return true.
            When CReturn (axR):
                Return true.
            When CIf (axC, axT, axE):
                If peAnyExit(axT):
                    Return true.
                If peAnyExit(axE):
                    Return true.
            When CWhile (axWc, axWb):
                If peAnyExit(axWb):
                    Return true.
            When CInspect (axNt, axNa):
                Repeat for axArm in axNa:
                    Inspect axArm:
                        When CWhen (axWn, axWbs, axWbody):
                            If peAnyExit(axWbody):
                                Return true.
                        When COtherwise (axOb):
                            If peAnyExit(axOb):
                                Return true.
            Otherwise:
                If breaksBelow(axS):
                    Return true.
    Return false.

## To peDrySt (dsSt: PEState) -> PEState:
    Let dsEnv be peEnvShallow((peEnv(dsSt))).
    Let dsSe be peSeShallow((peStaticEnv(dsSt))).
    Let dsDepth be peDepth(dsSt).
    Return a new PEStateR with env dsEnv and funcs (peFuncs(dsSt)) and depth dsDepth and staticEnv dsSe and specResults (peSpecResults(dsSt)) and onStack (peOnStack(dsSt)).

## To peBindShape (bsSt: mutable PEState) and (bsName: Text) and (bsShape: CExpr):
    Let bsK be "{bsName}".
    peStSeBind(bsSt, bsK, bsShape).
    If isStaticValue(bsShape):
        Let bsK2 be "{bsName}".
        peStEnvBind(bsSt, bsK2, exprToVal(bsShape)).

## To peAdoptState (adSt: mutable PEState) and (adChild: PEState):
    peStSetEnv(adSt, peEnv(adChild)).
    peStSetStaticEnv(adSt, peStaticEnv(adChild)).
    peStSetOnStack(adSt, peOnStack(adChild)).

## To peMakeDynamic (mdSt: mutable PEState) and (mdNames: Seq of Text):
    Repeat for mdN in mdNames:
        Let mdK be "{mdN}".
        If (peStaticEnv(mdSt)) contains mdK:
            Let mdK2 be "{mdN}".
            peStSeDrop(mdSt, mdK2).
            Let mdK3 be "{mdN}".
            peStEnvDynamic(mdSt, mdK3).

## To peFrame (pfState: PEState) -> Text:
    If (peSpecResults(pfState)) contains "__pe_frame":
        Return peTextOf(item "__pe_frame" of (peSpecResults(pfState))).
    Return "".

## To peSetFrame (sfState: mutable PEState) and (sfFrame: Text):
    Let sfK be "{sfFrame}".
    peStSrBind(sfState, "__pe_frame", a new CText with value sfK).

## To peIsLoopStmt (ilS: CStmt) -> Bool:
    Inspect ilS:
        When CWhile (ilWc, ilWb):
            Return true.
        When CRepeat (ilRv, ilRc, ilRb):
            Return true.
        When CRepeatRange (ilQv, ilQs, ilQe, ilQb):
            Return true.
        Otherwise:
            Return false.

## To peRecordBreak (rbState: mutable PEState) and (rbFrame: Text) and (rbId: Text):
    Let rbCandsKey be "__pe_frame_cands__{rbFrame}".
    Let rbCands be peTextsOf(item rbCandsKey of (peSpecResults(rbState))).
    Let mutable rbVals be a new Seq of CExpr.
    Repeat for rbC in rbCands:
        Let rbCk be "{rbC}".
        If (peStaticEnv(rbState)) contains rbCk:
            Let rbCk2 be "{rbC}".
            Push (item rbCk2 of (peStaticEnv(rbState))) to rbVals.
        Otherwise:
            Push (a new CNothing) to rbVals.
    Let rbNames be copy of rbCands.
    Let rbKey be "__pe_brk__{rbId}".
    peStSrBind(rbState, rbKey, a new CNewVariant with tag "__pe_brkvals" and fnames rbNames and fvals rbVals).
    Let rbListKey be "__pe_brk_list__{rbFrame}".
    Let mutable rbList be a new Seq of CExpr.
    If (peSpecResults(rbState)) contains rbListKey:
        Let rbHeld be item rbListKey of (peSpecResults(rbState)).
        Inspect rbHeld:
            When CList (rbItems):
                Repeat for rbI in rbItems:
                    Push rbI to rbList.
            Otherwise:
                Let rbSkip be true.
    Let rbIdK be "{rbId}".
    Push (a new CText with value rbIdK) to rbList.
    Let rbListKey2 be "__pe_brk_list__{rbFrame}".
    peStSrBind(rbState, rbListKey2, a new CList with items rbList).

## To peUnmarkedBreaks (umStmts: Seq of CStmt) -> Bool:
    Let mutable umPrevMarked be false.
    Repeat for umS in umStmts:
        Inspect umS:
            When CBreak:
                If not umPrevMarked:
                    Return true.
            When CIf (umC, umT, umE):
                If peUnmarkedBreaks(umT):
                    Return true.
                If peUnmarkedBreaks(umE):
                    Return true.
            When CInspect (umNt, umNa):
                Repeat for umArm in umNa:
                    Inspect umArm:
                        When CWhen (umWn, umWbs, umWbody):
                            If peUnmarkedBreaks(umWbody):
                                Return true.
                        When COtherwise (umOb):
                            If peUnmarkedBreaks(umOb):
                                Return true.
            When CZone (umZn, umZk, umZb):
                If peUnmarkedBreaks(umZb):
                    Return true.
            Otherwise:
                Let umSkip be true.
        Set umPrevMarked to false.
        Inspect umS:
            When CCallS (umCn, umCa):
                Set umPrevMarked to peStartsWith(umCn, "pkvbrk__").
            Otherwise:
                Let umSkip2 be true.
    Return false.

## To peFillBreaks (fbStmts: Seq of CStmt) and (fbMoves: Map of Text to CExpr) -> Seq of CStmt:
    Let mutable fbOut be a new Seq of CStmt.
    Repeat for fbS in fbStmts:
        Inspect fbS:
            When CCallS (fbCn, fbCa):
                If fbMoves contains fbCn:
                    Let fbHeld be item fbCn of fbMoves.
                    Inspect fbHeld:
                        When CClosure (fbP, fbB, fbC):
                            Repeat for fbM in fbB:
                                Push fbM to fbOut.
                        Otherwise:
                            Let fbSkip be true.
                Otherwise:
                    Push fbS to fbOut.
            When CIf (fbIc, fbIt, fbIe):
                Push (a new CIf with cond fbIc and thenBlock peFillBreaks(fbIt, fbMoves) and elseBlock peFillBreaks(fbIe, fbMoves)) to fbOut.
            When CInspect (fbNt, fbNa):
                Let mutable fbArms be a new Seq of CMatchArm.
                Repeat for fbArm in fbNa:
                    Inspect fbArm:
                        When CWhen (fbWn, fbWbs, fbWbody):
                            Push (a new CWhen with variantName fbWn and bindings fbWbs and body peFillBreaks(fbWbody, fbMoves)) to fbArms.
                        When COtherwise (fbOb):
                            Push (a new COtherwise with body peFillBreaks(fbOb, fbMoves)) to fbArms.
                Push (a new CInspect with target fbNt and arms fbArms) to fbOut.
            When CZone (fbZn, fbZk, fbZb):
                Push (a new CZone with name fbZn and kind fbZk and body peFillBreaks(fbZb, fbMoves)) to fbOut.
            Otherwise:
                Push fbS to fbOut.
    Return fbOut.

## To peLoopShapes (lsHead: CStmt) and (lsResVar: Text) and (lsBody: Seq of CStmt) and (lsCands: Seq of Text) and (lsDyn: Seq of Text) and (lsShapes: mutable Map of Text to CExpr) and (lsLeaves: mutable Seq of Text) and (lsSt: mutable PEState) -> CStmt:
    Let mutable lsRound be 0.
    While lsRound is less than 8:
        Set lsRound to lsRound + 1.
        Let mutable lsDry be peDrySt(lsSt).
        peMakeDynamic(lsDry, lsDyn).
        Repeat for lsC in lsCands:
            Let lsCk be "{lsC}".
            Let lsCv be item lsCk of lsShapes.
            peBindShape(lsDry, lsC, lsCv).
        Let lsFrame be freshNameSt(lsDry, "pkvframe").
        Let mutable lsCandTexts be a new Seq of CExpr.
        Repeat for lsCt in lsCands:
            Let lsCtk be "{lsCt}".
            Push (a new CText with value lsCtk) to lsCandTexts.
        Let lsFrameCands be "__pe_frame_cands__{lsFrame}".
        peStSrBind(lsDry, lsFrameCands, a new CList with items lsCandTexts).
        peSetFrame(lsDry, lsFrame).
        Let mutable lsCondDry be a new CBool with value true.
        Inspect lsHead:
            When CWhile (lsWc, lsWb):
                Let lsSusp be hoistSuspendSt(lsDry).
                Set lsCondDry to peExpr(lsWc, lsDry).
                hoistRestoreSt(lsDry, lsSusp).
            When CRepeat (lsRv, lsRc, lsRb):
                peBindLoopVar(lsDry, lsRv, lsRc, lsResVar).
            When CRepeatRange (lsQv, lsQs, lsQe, lsQb):
                Let lsQk be "{lsQv}".
                If (peStaticEnv(lsDry)) contains lsQk:
                    Let lsQk2 be "{lsQv}".
                    peStSeDrop(lsDry, lsQk2).
                Let lsQk3 be "{lsQv}".
                peStEnvDynamic(lsDry, lsQk3).
            Otherwise:
                Let lsHeadSkip be true.
        Let lsBodyDry be specializeStmts(lsBody, lsDry).
        peSetFrame(lsDry, "").
        peAbsorb(lsSt, lsDry).
        If peUnmarkedBreaks(lsBodyDry):
            Return a new CBreak.
        Let lsBreakListKey be "__pe_brk_list__{lsFrame}".
        Let mutable lsBreakIds be a new Seq of Text.
        If (peSpecResults(lsDry)) contains lsBreakListKey:
            Set lsBreakIds to peTextsOf(item lsBreakListKey of (peSpecResults(lsDry))).
        Let mutable lsStable be true.
        Let mutable lsEnds be a new Map of Text to CExpr.
        Let mutable lsBreakMoves be a new Map of Text to CExpr.
        Repeat for lsBid in lsBreakIds:
            Let lsBk be "__pe_brk__{lsBid}".
            Let lsBvals be item lsBk of (peSpecResults(lsDry)).
            Let mutable lsBat be a new Map of Text to CExpr.
            Inspect lsBvals:
                When CNewVariant (lsBtag, lsBnames, lsBvs):
                    Let mutable lsBi be 1.
                    Repeat for lsBn in lsBnames:
                        Let lsBv be item lsBi of lsBvs.
                        Let lsBnk be "{lsBn}".
                        Let lsBshape be item lsBnk of lsShapes.
                        Inspect lsBv:
                            When CNothing:
                                Return a new CBreak.
                            Otherwise:
                                Let lsBvSkip be true.
                        If not peMatchLeaves(lsBshape, lsBv, lsLeaves, lsBat, lsSt):
                            Let lsBgen be peGenShape(lsBshape, lsBv, lsLeaves, lsSt).
                            Let lsBnk2 be "{lsBn}".
                            Set item lsBnk2 of lsShapes to lsBgen.
                            Set lsStable to false.
                        Set lsBi to lsBi + 1.
                Otherwise:
                    Let lsBskip be true.
            Let lsBmoves be peLeafMoves(lsLeaves, lsBat, lsSt).
            Let lsBnoP be a new Seq of Text.
            Let lsBnoC be a new Seq of Text.
            Let lsBidK be "{lsBid}".
            Set item lsBidK of lsBreakMoves to a new CClosure with params lsBnoP and body lsBmoves and captured lsBnoC.
        Repeat for lsC2 in lsCands:
            Let lsK be "{lsC2}".
            If not ((peStaticEnv(lsDry)) contains lsK):
                Return a new CBreak.
            Let lsK2 be "{lsC2}".
            Let lsEnd be item lsK2 of (peStaticEnv(lsDry)).
            Let lsK3 be "{lsC2}".
            Let lsShape be item lsK3 of lsShapes.
            If not peMatchLeaves(lsShape, lsEnd, lsLeaves, lsEnds, lsSt):
                Let lsGen be peGenShape(lsShape, lsEnd, lsLeaves, lsSt).
                Let lsK4 be "{lsC2}".
                Set item lsK4 of lsShapes to lsGen.
                Set lsStable to false.
        If lsStable:
            Let mutable lsInits be a new Map of Text to CExpr.
            Repeat for lsC4 in lsCands:
                Let lsK6 be "{lsC4}".
                If not ((peStaticEnv(lsSt)) contains lsK6):
                    Return a new CBreak.
                Let lsK7 be "{lsC4}".
                If not peMatchLeaves(item lsK7 of lsShapes, item lsK7 of (peStaticEnv(lsSt)), lsLeaves, lsInits, lsSt):
                    Return a new CBreak.
            Repeat for lsBound in lsLeaves:
                If not lsInits contains lsBound:
                    Return a new CBreak.
            Let lsMoves be peLeafMoves(lsLeaves, lsEnds, lsSt).
            Let mutable lsFull be a new Seq of CStmt.
            Let lsFilled be peFillBreaks(lsBodyDry, lsBreakMoves).
            Repeat for lsB in lsFilled:
                Push lsB to lsFull.
            Repeat for lsMv in lsMoves:
                Push lsMv to lsFull.
            peAbsorbAll(lsSt, lsDry).
            peSetFrame(lsSt, "").
            Repeat for lsC3 in lsCands:
                Let lsK5 be "{lsC3}".
                Let lsFinal be item lsK5 of lsShapes.
                peBindShape(lsSt, lsC3, lsFinal).
            peMakeDynamic(lsSt, lsDyn).
            Let lsBodyOut be dceBlock(lsFull).
            Inspect lsHead:
                When CWhile (lsWc2, lsWb2):
                    Return a new CWhile with cond lsCondDry and body lsBodyOut.
                When CRepeat (lsRv2, lsRc2, lsRb2):
                    Return a new CRepeat with var lsResVar and coll (peLoopColl(lsRc2)) and body lsBodyOut.
                When CRepeatRange (lsQv2, lsQs2, lsQe2, lsQb2):
                    Return a new CRepeatRange with var lsQv2 and start lsQs2 and end lsQe2 and body lsBodyOut.
                Otherwise:
                    Return a new CBreak.
    Return a new CBreak.

## To peLoopColl (lcColl: CExpr) -> CExpr:
    If peIsBox(lcColl):
        Let lcBase be peBoxBase(lcColl).
        Return a new CVar with name lcBase.
    Return lcColl.

## To peBindLoopVar (bvSt: mutable PEState) and (bvVar: Text) and (bvColl: CExpr) and (bvResVar: Text):
    Let bvK be "{bvVar}".
    If (peStaticEnv(bvSt)) contains bvK:
        Let bvK2 be "{bvVar}".
        peStSeDrop(bvSt, bvK2).
    If peIsBox(bvColl):
        Let bvElem be peBoxElement(bvColl, a new CVar with name bvResVar, bvSt).
        peBindShape(bvSt, bvVar, bvElem).
    Otherwise:
        Let bvLeaf be "{bvResVar}".
        peBindShape(bvSt, bvVar, a new CVar with name bvLeaf).

## To peBranchTail (btMods: Seq of Text) and (btSkip: Seq of Text) and (btSt: PEState) and (btOut: mutable Seq of CStmt):
    Repeat for btM in btMods:
        If not btSkip contains btM:
            Let btK be "{btM}".
            If (peStaticEnv(btSt)) contains btK and not isResidualVar((peEnv(btSt)), btM):
                Let btK2 be "{btM}".
                Let btV be item btK2 of (peStaticEnv(btSt)).
                Let btK3 be "{btM}".
                Push (a new CSet with name btK3 and expr btV) to btOut.

## To peBlockWrites (bwStmts: Seq of CStmt) -> Seq of Text:
    Let mutable bwOut be a new Seq of Text.
    Repeat for bwS in bwStmts:
        Repeat for bwW in peStmtWrites(bwS):
            If not bwOut contains bwW:
                Let bwK be "{bwW}".
                Push bwK to bwOut.
    Return bwOut.

## To peChangedLeaves (clShapes: Map of Text to CExpr) and (clCands: Seq of Text) and (clAt: PEState) and (clLeaves: Seq of Text) and (clInits: Map of Text to CExpr) and (clWritten: Seq of Text) -> Map of Text to CExpr:
    Let mutable clVals be a new Map of Text to CExpr.
    Repeat for clC in clCands:
        Let clK be "{clC}".
        Let clShape be item clK of clShapes.
        Let clK2 be "{clC}".
        Let clEnd be item clK2 of (peStaticEnv(clAt)).
        Let clMatched be peMatchLeaves(clShape, clEnd, clLeaves, clVals, clAt).
    Let mutable clOut be a new Map of Text to CExpr.
    Repeat for clL in clLeaves:
        Let clLk be "{clL}".
        If clVals contains clLk:
            Let clLk2 be "{clL}".
            Let clV be item clLk2 of clVals.
            Let mutable clSame be false.
            Let clLk3 be "{clL}".
            If clInits contains clLk3:
                Let clLk4 be "{clL}".
                Set clSame to peSameExpr(clV, item clLk4 of clInits).
                Inspect clV:
                    When CVar (clVn):
                        If clWritten contains clVn or clWritten contains "*":
                            Set clSame to false.
                    Otherwise:
                        Let clSkipW be true.
            If not clSame:
                Let clLk5 be "{clL}".
                Set item clLk5 of clOut to clV.
    Return clOut.

## To peIfShapes (isCond: CExpr) and (isThen: Seq of CStmt) and (isElse: Seq of CStmt) and (isThenMods: Seq of Text) and (isElseMods: Seq of Text) and (isCands: Seq of Text) and (isDyn: Seq of Text) and (isSt: mutable PEState) and (isOut: mutable Seq of CStmt) -> Bool:
    Let mutable isEntry be a new Map of Text to CExpr.
    Repeat for isC in isCands:
        Let isCk be "{isC}".
        Let isCk2 be "{isC}".
        Set item isCk of isEntry to item isCk2 of (peStaticEnv(isSt)).
    Let mutable isT be peDrySt(isSt).
    peMakeDynamic(isT, isDyn).
    Let isPos be applyPosFactsSt(isCond, isT).
    Let mutable isThenRes be specializeStmts(isThen, isT).
    peBranchTail(isThenMods, isCands, isT, isThenRes).
    Let isClrT be clearGuardFactsSt(isCond, isT).
    peAbsorb(isSt, isT).
    Let mutable isF be peDrySt(isSt).
    peMakeDynamic(isF, isDyn).
    Let isNeg be applyNegFactsSt(isCond, isF).
    Let mutable isElseRes be specializeStmts(isElse, isF).
    peBranchTail(isElseMods, isCands, isF, isElseRes).
    Let isClrF be clearGuardFactsSt(isCond, isF).
    peAbsorb(isSt, isF).
    Let isTx be peExits(isThenRes).
    Let isEx be peExits(isElseRes).
    If isTx or isEx:
        Let isNone be a new Seq of CStmt.
        If isTx and isEx:
            Push (a new CIf with cond isCond and thenBlock dceBlock(isThenRes) and elseBlock dceBlock(isElseRes)) to isOut.
            peAdoptState(isSt, isF).
        Otherwise:
            If isTx:
                Push (a new CIf with cond isCond and thenBlock dceBlock(isThenRes) and elseBlock isNone) to isOut.
                Repeat for isFs in isElseRes:
                    Push isFs to isOut.
                peAdoptState(isSt, isF).
            Otherwise:
                Push (a new CIf with cond isCond and thenBlock isNone and elseBlock dceBlock(isElseRes)) to isOut.
                Repeat for isTs in isThenRes:
                    Push isTs to isOut.
                peAdoptState(isSt, isT).
        peMakeDynamic(isSt, isDyn).
        Return true.
    Let mutable isLeaves be a new Seq of Text.
    Let mutable isShapes be a new Map of Text to CExpr.
    Repeat for isC2 in isCands:
        Let isK be "{isC2}".
        If not ((peStaticEnv(isT)) contains isK):
            Return false.
        If isResidualVar((peEnv(isT)), isC2) and isStaticValue(item isK of isEntry):
            Return false.
        Let isK2 be "{isC2}".
        If not ((peStaticEnv(isF)) contains isK2):
            Return false.
        If isResidualVar((peEnv(isF)), isC2) and isStaticValue(item isK2 of isEntry):
            Return false.
        Let isK3 be "{isC2}".
        Let isE be item isK3 of isEntry.
        Let isK4 be "{isC2}".
        Let isTv be item isK4 of (peStaticEnv(isT)).
        Let isK5 be "{isC2}".
        Let isFv be item isK5 of (peStaticEnv(isF)).
        Let isG1 be peGenShape(isE, isTv, isLeaves, isSt).
        Let isG be peGenShape(isG1, isFv, isLeaves, isSt).
        Let isK6 be "{isC2}".
        Set item isK6 of isShapes to isG.
    Let mutable isInits be a new Map of Text to CExpr.
    Repeat for isC3 in isCands:
        Let isK7 be "{isC3}".
        Let isK8 be "{isC3}".
        If not peMatchLeaves(item isK7 of isShapes, item isK8 of isEntry, isLeaves, isInits, isSt):
            Return false.
        Let mutable isAtThen be a new Map of Text to CExpr.
        If not peMatchLeaves(item isK7 of isShapes, item isK8 of (peStaticEnv(isT)), isLeaves, isAtThen, isT):
            Return false.
        Let mutable isAtElse be a new Map of Text to CExpr.
        If not peMatchLeaves(item isK7 of isShapes, item isK8 of (peStaticEnv(isF)), isLeaves, isAtElse, isF):
            Return false.
    Repeat for isBound in isLeaves:
        If not isInits contains isBound:
            Return false.
    Let mutable isReuse be a new Map of Text to Text.
    Let mutable isReused be a new Seq of Text.
    Repeat for isRl in isLeaves:
        Let isRlk be "{isRl}".
        If isInits contains isRlk:
            Let isRlk2 be "{isRl}".
            Let isRinit be item isRlk2 of isInits.
            Inspect isRinit:
                When CVar (isOld):
                    If peStartsWith(isOld, "pkv__") and not isReused contains isOld:
                        If peLeafRefCount(isOld, isSt) equals 1:
                            Let isRlk3 be "{isRl}".
                            Let isOldK be "{isOld}".
                            Set item isRlk3 of isReuse to isOldK.
                            Let isOldK2 be "{isOld}".
                            Push isOldK2 to isReused.
                Otherwise:
                    Let isRskip be true.
    If length of isReused is greater than 0:
        Let mutable isRenamed be a new Map of Text to CExpr.
        Repeat for isC5 in isCands:
            Let isK10 be "{isC5}".
            Let isRjr be a new Seq of Text.
            Let isRjw be a new Seq of Text.
            Let isK11 be "{isC5}".
            Set item isK10 of isRenamed to renameExpr(item isK11 of isShapes, isReuse, isRjr, isRjw).
        Set isShapes to isRenamed.
        Let mutable isNewLeaves be a new Seq of Text.
        Let mutable isNewInits be a new Map of Text to CExpr.
        Repeat for isNl in isLeaves:
            Let isNlk be "{isNl}".
            If isReuse contains isNlk:
                Let isNlk2 be "{isNl}".
                Let isOldName be item isNlk2 of isReuse.
                Push isOldName to isNewLeaves.
                Let isOldName2 be "{isOldName}".
                Set item isOldName2 of isNewInits to a new CVar with name isOldName.
            Otherwise:
                Let isNlk3 be "{isNl}".
                Push isNlk3 to isNewLeaves.
                If isInits contains isNlk:
                    Let isNlk4 be "{isNl}".
                    Let isNlk5 be "{isNl}".
                    Set item isNlk4 of isNewInits to item isNlk5 of isInits.
        Set isLeaves to isNewLeaves.
        Set isInits to isNewInits.
    Repeat for isL in isLeaves:
        Let isLk be "{isL}".
        If isInits contains isLk and not isReused contains isLk:
            Let isLk2 be "{isL}".
            Let isLk3 be "{isL}".
            Push (a new CLet with name isLk2 and expr (item isLk3 of isInits)) to isOut.
    Let isThenVals be peChangedLeaves(isShapes, isCands, isT, isLeaves, isInits, peBlockWrites(isThenRes)).
    Let isThenMoves be peLeafMoves(isLeaves, isThenVals, isSt).
    Repeat for isTm in isThenMoves:
        Push isTm to isThenRes.
    Let isElseVals be peChangedLeaves(isShapes, isCands, isF, isLeaves, isInits, peBlockWrites(isElseRes)).
    Let isElseMoves be peLeafMoves(isLeaves, isElseVals, isSt).
    Repeat for isEm in isElseMoves:
        Push isEm to isElseRes.
    Push (a new CIf with cond isCond and thenBlock dceBlock(isThenRes) and elseBlock dceBlock(isElseRes)) to isOut.
    peAbsorbAll(isSt, isF).
    Repeat for isC4 in isCands:
        Let isK9 be "{isC4}".
        Let isFinal be item isK9 of isShapes.
        peBindShape(isSt, isC4, isFinal).
    peMakeDynamic(isSt, isDyn).
    Return true.

## To peUnrefineSum (urSt: mutable PEState) and (urTarget: CExpr) and (urArm: CMatchArm) and (urIdx: Int) and (urCands: Seq of Text):
    Inspect urArm:
        When CWhen (urName, urBinds, urBody):
            If not peStartsWith(urName, "PeSumS"):
                Return.
            Inspect urTarget:
                When CVar (urLeaf):
                    Let urSplitK be "__pe_sumsplit__{urLeaf}".
                    If not ((peSpecResults(urSt)) contains urSplitK):
                        Return.
                    Let urBoxName be peTextOf(item urSplitK of (peSpecResults(urSt))).
                    Let mutable urArgs be a new Seq of CExpr.
                    Push (a new CVar with name urLeaf) to urArgs.
                    Let urBox be a new CCall with name urBoxName and args urArgs.
                    Let urRefined be peSumShape(urBox, urIdx, urBinds, urSt).
                    Repeat for urC in urCands:
                        Let urCk be "{urC}".
                        If (peStaticEnv(urSt)) contains urCk:
                            Let urCk2 be "{urC}".
                            Let urV be item urCk2 of (peStaticEnv(urSt)).
                            Let urNew be peReplaceSum(urV, urRefined, urBox).
                            If not peSameExpr(urNew, urV):
                                Let urCk3 be "{urC}".
                                peBindShape(urSt, urCk3, urNew).
                Otherwise:
                    Let urSkipT be true.
        Otherwise:
            Let urSkipA be true.

## To peInspectShapes (ixTarget: CExpr) and (ixArms: Seq of CMatchArm) and (ixCands: Seq of Text) and (ixDyn: Seq of Text) and (ixSt: mutable PEState) and (ixOut: mutable Seq of CStmt) -> Bool:
    Let mutable ixEntry be a new Map of Text to CExpr.
    Repeat for ixC in ixCands:
        Let ixCk be "{ixC}".
        Let ixCk2 be "{ixC}".
        Set item ixCk of ixEntry to item ixCk2 of (peStaticEnv(ixSt)).
    Let mutable ixResults be a new Seq of Seq of CStmt.
    Let mutable ixStates be a new Seq of PEState.
    Let mutable ixExits be a new Seq of Bool.
    Let mutable ixJoining be 0.
    Repeat for ixArm in ixArms:
        Let mutable ixA be peDrySt(ixSt).
        peMakeDynamic(ixA, ixDyn).
        Repeat for ixB in peArmBindings(ixArm):
            Let ixBk be "{ixB}".
            If (peStaticEnv(ixA)) contains ixBk:
                Let ixBk2 be "{ixB}".
                peStSeDrop(ixA, ixBk2).
            Let ixBk3 be "{ixB}".
            peStEnvDynamic(ixA, ixBk3).
        Let mutable ixRes be specializeStmts(peArmBody(ixArm), ixA).
        peUnrefineSum(ixA, ixTarget, ixArm, (length of ixResults) + 1, ixCands).
        peBranchTail(collectSetVars(peArmBody(ixArm), (peFuncs(ixA))), ixCands, ixA, ixRes).
        peAbsorb(ixSt, ixA).
        Let ixExit be peExits(ixRes).
        If not ixExit:
            Set ixJoining to ixJoining + 1.
        Push ixRes to ixResults.
        Push ixA to ixStates.
        Push ixExit to ixExits.
    If ixJoining equals 0:
        Return false.
    Let mutable ixLeaves be a new Seq of Text.
    Let mutable ixShapes be a new Map of Text to CExpr.
    Repeat for ixC2 in ixCands:
        Let ixK be "{ixC2}".
        Let mutable ixG be item ixK of ixEntry.
        Let mutable ixI be 1.
        Repeat for ixS in ixStates:
            If not (item ixI of ixExits):
                Let ixK2 be "{ixC2}".
                If not ((peStaticEnv(ixS)) contains ixK2):
                    Return false.
                If isResidualVar((peEnv(ixS)), ixC2) and isStaticValue(item ixK of ixEntry):
                    Return false.
                Let ixK3 be "{ixC2}".
                Set ixG to peGenShape(ixG, item ixK3 of (peStaticEnv(ixS)), ixLeaves, ixSt).
            Set ixI to ixI + 1.
        Let ixK4 be "{ixC2}".
        Set item ixK4 of ixShapes to ixG.
    Let mutable ixInits be a new Map of Text to CExpr.
    Repeat for ixC3 in ixCands:
        Let ixK5 be "{ixC3}".
        If not peMatchLeaves(item ixK5 of ixShapes, item ixK5 of ixEntry, ixLeaves, ixInits, ixSt):
            Return false.
        Let mutable ixI2 be 1.
        Repeat for ixS2 in ixStates:
            If not (item ixI2 of ixExits):
                Let mutable ixAt be a new Map of Text to CExpr.
                If not peMatchLeaves(item ixK5 of ixShapes, item ixK5 of (peStaticEnv(ixS2)), ixLeaves, ixAt, ixS2):
                    Return false.
            Set ixI2 to ixI2 + 1.
    Repeat for ixBound in ixLeaves:
        If not ixInits contains ixBound:
            Return false.
    Repeat for ixL in ixLeaves:
        Let ixLk be "{ixL}".
        Let ixLk2 be "{ixL}".
        Push (a new CLet with name ixLk and expr (item ixLk2 of ixInits)) to ixOut.
    Let mutable ixNewArms be a new Seq of CMatchArm.
    Let mutable ixI3 be 1.
    Let mutable ixLast be ixSt.
    Repeat for ixArm2 in ixArms:
        Let mutable ixBody be item ixI3 of ixResults.
        Let ixS3 be item ixI3 of ixStates.
        If not (item ixI3 of ixExits):
            Let ixVals be peChangedLeaves(ixShapes, ixCands, ixS3, ixLeaves, ixInits, peBlockWrites(ixBody)).
            Repeat for ixMv in peLeafMoves(ixLeaves, ixVals, ixSt):
                Push ixMv to ixBody.
            Set ixLast to ixS3.
        Push peWithArmBody(ixArm2, dceBlock(ixBody)) to ixNewArms.
        Set ixI3 to ixI3 + 1.
    Push (a new CInspect with target ixTarget and arms ixNewArms) to ixOut.
    peAbsorbAll(ixSt, ixLast).
    Repeat for ixC4 in ixCands:
        Let ixK6 be "{ixC4}".
        peBindShape(ixSt, ixC4, item ixK6 of ixShapes).
    peMakeDynamic(ixSt, ixDyn).
    Return true.

## To peExits (exStmts: Seq of CStmt) -> Bool:
    Let exN be length of exStmts.
    If exN equals 0:
        Return false.
    Let exLast be item exN of exStmts.
    Inspect exLast:
        When CReturn (exR):
            Return true.
        When CBreak:
            Return true.
        When CFail (exF):
            Return true.
        When CIf (exC, exT, exE):
            If peExits(exT):
                Return peExits(exE).
            Return false.
        When CInspect (exNt, exArms):
            If not peArmsCover(exArms):
                Return false.
            Repeat for exArm in exArms:
                If not peExits(peArmBody(exArm)):
                    Return false.
            Return true.
        Otherwise:
            Return false.

## To peArmBody (abArm: CMatchArm) -> Seq of CStmt:
    Inspect abArm:
        When CWhen (abWn, abWbs, abWbody):
            Return abWbody.
        When COtherwise (abObody):
            Return abObody.

## To peArmBindings (aqArm: CMatchArm) -> Seq of Text:
    Inspect aqArm:
        When CWhen (aqWn, aqWbs, aqWbody):
            Return aqWbs.
        Otherwise:
            Return a new Seq of Text.

## To peWithArmBody (wbArm: CMatchArm) and (wbBody: Seq of CStmt) -> CMatchArm:
    Inspect wbArm:
        When CWhen (wbWn, wbWbs, wbWbody):
            Return a new CWhen with variantName wbWn and bindings wbWbs and body wbBody.
        When COtherwise (wbObody):
            Return a new COtherwise with body wbBody.

## To peArmsCover (acArms: Seq of CMatchArm) -> Bool:
    Repeat for acArm in acArms:
        Inspect acArm:
            When COtherwise (acObody):
                Return true.
            Otherwise:
                Let acSkip be true.
    Return false.

## To peStmtsMention (smStmts: Seq of CStmt) and (smNames: Seq of Text) -> Bool:
    If length of smNames equals 0:
        Return false.
    Let smMap be a new Map of Text to Text.
    Let mutable smRefs be a new Seq of Text.
    Let mutable smWrites be a new Seq of Text.
    Let smWalked be renameStmts(smStmts, smMap, smRefs, smWrites).
    If smRefs contains "__pe_unsupported":
        Return true.
    Repeat for smN in smNames:
        If smRefs contains smN or smWrites contains smN:
            Return true.
    Return false.

## To peTailOf (toStmts: Seq of CStmt) and (toFrom: Int) -> Seq of CStmt:
    Let mutable toOut be a new Seq of CStmt.
    Let mutable toI be 1.
    Repeat for toS in toStmts:
        If toI is at least toFrom:
            Push toS to toOut.
        Set toI to toI + 1.
    Return toOut.

## To peJoinStmts (jsA: Seq of CStmt) and (jsB: Seq of CStmt) -> Seq of CStmt:
    Let mutable jsOut be a new Seq of CStmt.
    Repeat for jsX in jsA:
        Push jsX to jsOut.
    Repeat for jsY in jsB:
        Push jsY to jsOut.
    Return jsOut.

## To peNormalizeReturns (nrStmts: Seq of CStmt) -> Seq of CStmt:
    Let mutable nrOut be a new Seq of CStmt.
    Let mutable nrI be 1.
    Repeat for nrS in nrStmts:
        Inspect nrS:
            When CReturn (nrR):
                Push nrS to nrOut.
                Return nrOut.
            When CIf (nrC, nrT, nrE):
                Let nrTn be peNormalizeReturns(nrT).
                Let nrEn be peNormalizeReturns(nrE).
                Let nrTx be peExits(nrTn).
                Let nrEx be peExits(nrEn).
                If nrTx and nrEx:
                    Push (a new CIf with cond nrC and thenBlock nrTn and elseBlock nrEn) to nrOut.
                    Return nrOut.
                Let nrRest be peTailOf(nrStmts, nrI + 1).
                If length of nrRest is greater than 0:
                    If nrTx:
                        Push (a new CIf with cond nrC and thenBlock nrTn and elseBlock peNormalizeReturns(peJoinStmts(nrEn, nrRest))) to nrOut.
                        Return nrOut.
                    If nrEx:
                        Push (a new CIf with cond nrC and thenBlock peNormalizeReturns(peJoinStmts(nrTn, nrRest)) and elseBlock nrEn) to nrOut.
                        Return nrOut.
                Push (a new CIf with cond nrC and thenBlock nrTn and elseBlock nrEn) to nrOut.
            When CInspect (nrNt, nrArms):
                Let mutable nrNormArms be a new Seq of CMatchArm.
                Let mutable nrOpen be 0.
                Let mutable nrOpenAt be 0.
                Let mutable nrAi be 1.
                Repeat for nrArm in nrArms:
                    Let nrArmN be peNormalizeReturns(peArmBody(nrArm)).
                    Push peWithArmBody(nrArm, nrArmN) to nrNormArms.
                    If not peExits(nrArmN):
                        Set nrOpen to nrOpen + 1.
                        Set nrOpenAt to nrAi.
                    Set nrAi to nrAi + 1.
                Let nrCover be peArmsCover(nrArms).
                If nrCover and nrOpen equals 0:
                    Push (a new CInspect with target nrNt and arms nrNormArms) to nrOut.
                    Return nrOut.
                Let nrIrest be peTailOf(nrStmts, nrI + 1).
                If nrCover and nrOpen equals 1 and length of nrIrest is greater than 0:
                    Let nrOpenArm be item nrOpenAt of nrNormArms.
                    If not peStmtsMention(nrIrest, peArmBindings(nrOpenArm)):
                        Let mutable nrJoined be a new Seq of CMatchArm.
                        Let mutable nrJi be 1.
                        Repeat for nrJa in nrNormArms:
                            If nrJi equals nrOpenAt:
                                Push peWithArmBody(nrJa, peNormalizeReturns(peJoinStmts(peArmBody(nrJa), nrIrest))) to nrJoined.
                            Otherwise:
                                Push nrJa to nrJoined.
                            Set nrJi to nrJi + 1.
                        Push (a new CInspect with target nrNt and arms nrJoined) to nrOut.
                        Return nrOut.
                Push (a new CInspect with target nrNt and arms nrNormArms) to nrOut.
            Otherwise:
                Push nrS to nrOut.
        Set nrI to nrI + 1.
    Return nrOut.

## To peIsReturnTree (rtStmts: Seq of CStmt) -> Bool:
    Let rtN be length of rtStmts.
    If rtN equals 0:
        Return false.
    Let mutable rtI be 1.
    Repeat for rtS in rtStmts:
        If rtI is less than rtN:
            Let rtOne be a new Seq of CStmt.
            Push rtS to rtOne.
            If containsReturn(rtOne):
                Return false.
            If blockBreaks(rtOne):
                Return false.
        Set rtI to rtI + 1.
    Let rtLast be item rtN of rtStmts.
    Inspect rtLast:
        When CReturn (rtR):
            Return true.
        When CFail (rtF):
            Return true.
        When CIf (rtC, rtT, rtE):
            If peIsReturnTree(rtT):
                Return peIsReturnTree(rtE).
            Return false.
        When CInspect (rtNt, rtArms):
            If not peArmsCover(rtArms):
                Return false.
            Repeat for rtArm in rtArms:
                If not peIsReturnTree(peArmBody(rtArm)):
                    Return false.
            Return true.
        Otherwise:
            Return false.

## To peSplitTree (stParams: Seq of Text) and (stArgs: Seq of CExpr) and (stBody: Seq of CStmt) and (stState: mutable PEState) -> Bool:
    If not hoistActive((peSpecResults(stState))):
        Return false.
    Let stTree be peNormalizeReturns(stBody).
    If not peIsReturnTree(stTree):
        Return false.
    Let stLast be item (length of stTree) of stTree.
    Inspect stLast:
        When CIf (stLc, stLt, stLe):
            Let stSkip be true.
        When CInspect (stLnt, stLarms):
            Let stSkipI be true.
        Otherwise:
            Return false.
    Let stBinders be a new Seq of Text.
    collectBinders(stTree, stBinders).
    Let stEmpty be a new Map of Text to Text.
    Let mutable stRefs be a new Seq of Text.
    Let mutable stWrites be a new Seq of Text.
    Let stProbe be renameStmts(stTree, stEmpty, stRefs, stWrites).
    If stRefs contains "__pe_unsupported":
        Return false.
    Repeat for stW in stWrites:
        If not stBinders contains stW:
            If not peStartsWith(stW, "pkv__"):
                Return false.
    Repeat for stR in stRefs:
        If not stBinders contains stR and not (stR equals "__pe_bottom"):
            If not stParams contains stR:
                If not peStartsWith(stR, "pkv__"):
                    Return false.
    Let mutable stMap be a new Map of Text to Text.
    Let mutable stPre be a new Seq of CStmt.
    Let mutable stPi be 1.
    Repeat for stP in stParams:
        Let stPk be "{stP}".
        If stRefs contains stPk:
            Let stArg be item stPi of stArgs.
            Let mutable stBound be false.
            Inspect stArg:
                When CVar (stAv):
                    Let stPkV be "{stP}".
                    Set item stPkV of stMap to stAv.
                    Set stBound to true.
                Otherwise:
                    Let stSkipA be true.
            If not stBound:
                Let stPkF be "{stP}".
                Let stFresh be freshNameSt(stState, stPkF).
                Let stFreshK be "{stFresh}".
                Let stPkM be "{stP}".
                Set item stPkM of stMap to stFreshK.
                Let stArgC be stArg.
                Push (a new CLet with name stFresh and expr stArgC) to stPre.
        Set stPi to stPi + 1.
    Repeat for stB in stBinders:
        Let stBk be "{stB}".
        Let stBk2 be "{stB}".
        Set item stBk of stMap to freshNameSt(stState, stBk2).
    Let stJunkR be a new Seq of Text.
    Let stJunkW be a new Seq of Text.
    Let stRenamed be renameStmts(stTree, stMap, stJunkR, stJunkW).
    Repeat for stRs in stRenamed:
        Push stRs to stPre.
    Let stParamsNone be a new Seq of Text.
    Let stCapNone be a new Seq of Text.
    peStSrBind(stState, "__pe_split_tree", a new CClosure with params stParamsNone and body stPre and captured stCapNone).
    Return true.

## To peIsSplitStmts (psS: Seq of CStmt) -> Bool:
    If length of psS equals 1:
        Let psOne be item 1 of psS.
        Inspect psOne:
            When CEscStmt (psCode):
                Return psCode equals "__pe_split".
            Otherwise:
                Return false.
    Return false.

## To peNoInlineStmts -> Seq of CStmt:
    Let niOut be a new Seq of CStmt.
    Push (a new CEscStmt with code "__pe_no_inline") to niOut.
    Return niOut.

## To peTakeSplit (tsState: mutable PEState) -> Seq of CStmt:
    Let tsOut be a new Seq of CStmt.
    If (peSpecResults(tsState)) contains "__pe_split_tree":
        Let tsHeld be item "__pe_split_tree" of (peSpecResults(tsState)).
        peStSrDrop(tsState, "__pe_split_tree").
        Inspect tsHeld:
            When CClosure (tsP, tsB, tsC):
                Return tsB.
            Otherwise:
                Return tsOut.
    Return tsOut.

## To peIsSplitMarker (smE: CExpr) -> Bool:
    Inspect smE:
        When CVar (smName):
            Return smName equals "__pe_split".
        Otherwise:
            Return false.

## To peGraft (grStmts: Seq of CStmt) and (grLet: Text) and (grRest: Seq of CStmt) -> Seq of CStmt:
    Let mutable grOut be a new Seq of CStmt.
    Repeat for grS in grStmts:
        Inspect grS:
            When CReturn (grR):
                Let grName be "{grLet}".
                Push (a new CLet with name grName and expr grR) to grOut.
                Repeat for grK in grRest:
                    Push grK to grOut.
                Return grOut.
            When CIf (grC, grT, grE):
                Let grOne be a new Seq of CStmt.
                Push grS to grOne.
                If containsReturn(grOne):
                    Push (a new CIf with cond grC and thenBlock peGraft(grT, grLet, grRest) and elseBlock peGraft(grE, grLet, grRest)) to grOut.
                    Return grOut.
                Push grS to grOut.
            When CInspect (grNt, grArms):
                Let grOneI be a new Seq of CStmt.
                Push grS to grOneI.
                If containsReturn(grOneI):
                    Let mutable grNewArms be a new Seq of CMatchArm.
                    Repeat for grArm in grArms:
                        Push peWithArmBody(grArm, peGraft(peArmBody(grArm), grLet, grRest)) to grNewArms.
                    Push (a new CInspect with target grNt and arms grNewArms) to grOut.
                    Return grOut.
                Push grS to grOut.
            Otherwise:
                Push grS to grOut.
    Return grOut.

## To peBranches (brS: CStmt) -> Bool:
    Inspect brS:
        When CIf (brC, brT, brE):
            Return true.
        When CInspect (brNt, brArms):
            Return true.
        Otherwise:
            Return false.

