## To makePeState (e: Map of Text to CVal) and (f: Map of Text to CFunc) and (d: Int) -> PEState:
    Return a new PEStateR with env e and funcs f and depth d and staticEnv (a new Map of Text to CExpr) and specResults (a new Map of Text to CExpr) and onStack (a new Seq of Text).

## To peEnv (st: PEState) -> Map of Text to CVal:
    Inspect st:
        When PEStateR (e, f, d, se, sr, os):
            Return e.

## To peFuncs (st: PEState) -> Map of Text to CFunc:
    Inspect st:
        When PEStateR (e, f, d, se, sr, os):
            Return f.

## To peDepth (st: PEState) -> Int:
    Inspect st:
        When PEStateR (e, f, d, se, sr, os):
            Return d.

## To peStateWithDepth (st: PEState) and (d: Int) -> PEState:
    Inspect st:
        When PEStateR (e, f, oldD, se, sr, os):
            Return a new PEStateR with env e and funcs f and depth d and staticEnv se and specResults sr and onStack os.

## To peSpecResults (st: PEState) -> Map of Text to CExpr:
    Inspect st:
        When PEStateR (e, f, d, se, sr, os):
            Return sr.

## To peOnStack (st: PEState) -> Seq of Text:
    Inspect st:
        When PEStateR (e, f, d, se, sr, os):
            Return os.

## To peStateWithEnvDepth (st: PEState) and (newEnv: Map of Text to CVal) and (d: Int) -> PEState:
    Inspect st:
        When PEStateR (e, f, oldD, se, sr, os):
            Return a new PEStateR with env newEnv and funcs f and depth d and staticEnv (a new Map of Text to CExpr) and specResults sr and onStack (copy of os).

## To peStaticEnv (st: PEState) -> Map of Text to CExpr:
    Inspect st:
        When PEStateR (e, f, d, se, sr, os):
            Return se.

## To peEnvBind (m: mutable Map of Text to CVal) and (k: Text) and (v: CVal):
    Set item k of m to v.

## To markResidual (mrEnv: mutable Map of Text to CVal) and (mrName: Text):
    Let mrKey be "__pe_res__{mrName}".
    Set item mrKey of mrEnv to a new VBool with value true.

## To peEnvDynamic (pdEnv: mutable Map of Text to CVal) and (pdName: Text):
    Let pdKey be "{pdName}".
    Set item pdKey of pdEnv to a new VNothing.
    markResidual(pdEnv, pdName).

## To isResidualVar (irEnv: Map of Text to CVal) and (irName: Text) -> Bool:
    Let irKey be "__pe_res__{irName}".
    Return irEnv contains irKey.

## To peEnvDrop (m: mutable Map of Text to CVal) and (k: Text):
    Remove k from m.

## To peSeBind (m: mutable Map of Text to CExpr) and (k: Text) and (v: CExpr):
    Set item k of m to v.

## To peSeDrop (m: mutable Map of Text to CExpr) and (k: Text):
    Remove k from m.

## To peOsPush (s: mutable Seq of Text) and (v: Text):
    Push v to s.

## To peFuncBind (m: mutable Map of Text to CFunc) and (k: Text) and (v: CFunc):
    Set item k of m to v.

## To exprFreeNames (fnE: CExpr) -> Seq of Text:
    Let fnOut be a new Seq of Text.
    If isStatic(fnE):
        Return fnOut.
    Let fnMap be a new Map of Text to Text.
    Let mutable fnRefs be a new Seq of Text.
    Let mutable fnWrites be a new Seq of Text.
    Let fnWalked be renameExpr(fnE, fnMap, fnRefs, fnWrites).
    Repeat for fnR in fnRefs:
        Let mutable fnName be "{fnR}".
        If fnName equals "__pe_unsupported":
            Set fnName to "*".
        If not fnOut contains fnName:
            Push fnName to fnOut.
    Return fnOut.

## To peSeIndex (siSe: mutable Map of Text to CExpr) and (siK: Text) and (siV: CExpr):
    Let siVars be exprFreeNames(siV).
    If length of siVars is greater than 0:
        Set item "__pe_deps" of siSe to a new CBool with value true.
    Repeat for siU in siVars:
        Let siDk be "__pe_dep__{siU}".
        Let mutable siDeps be a new Seq of CExpr.
        If siSe contains siDk:
            Let siDk2 be "{siDk}".
            Let siOld be item siDk2 of siSe.
            Inspect siOld:
                When CList (siOldItems):
                    Set siDeps to copy of siOldItems.
                Otherwise:
                    Let siSkip be true.
        Let mutable siHas be false.
        Repeat for siD in siDeps:
            Inspect siD:
                When CText (siDn):
                    If siDn equals siK:
                        Set siHas to true.
                Otherwise:
                    Let siSkip2 be true.
        If not siHas:
            Let siKc be "{siK}".
            Push (a new CText with value siKc) to siDeps.
            Let siDk3 be "{siDk}".
            Set item siDk3 of siSe to a new CList with items siDeps.

## To peInvalidateDeps (ivVars: Seq of Text) and (state: mutable PEState) -> Seq of CStmt:
    Let mutable ivOut be a new Seq of CStmt.
    Let ivAll be copy of ivVars.
    Push "*" to ivAll.
    Repeat for ivV in ivAll:
        Let ivDk be "__pe_dep__{ivV}".
        If (peStaticEnv(state)) contains ivDk:
            Let ivDk2 be "{ivDk}".
            Let ivList be item ivDk2 of (peStaticEnv(state)).
            Let ivDk3 be "{ivDk}".
            peStSeDrop(state, ivDk3).
            Let ivLive be a new Seq of Text.
            Inspect ivList:
                When CList (ivItems):
                    Repeat for ivItem in ivItems:
                        Inspect ivItem:
                            When CText (ivK):
                                Let ivK1 be "{ivK}".
                                If (peStaticEnv(state)) contains ivK1:
                                    Let ivK2 be "{ivK}".
                                    Let ivE be item ivK2 of (peStaticEnv(state)).
                                    Let ivNames be exprFreeNames(ivE).
                                    Let ivVk be "{ivV}".
                                    Let ivK3 be "{ivK}".
                                    If ivNames contains ivVk and not ivLive contains ivK3:
                                        Push ivK3 to ivLive.
                            Otherwise:
                                Let ivSkip be true.
                Otherwise:
                    Let ivSkip2 be true.
            If length of ivLive is greater than 0:
                If ivV equals "*":
                    Repeat for ivM in ivLive:
                        Let ivMk be "{ivM}".
                        Let ivMe be item ivMk of (peStaticEnv(state)).
                        If not isResidualVar((peEnv(state)), ivM):
                            Let ivMk2 be "{ivM}".
                            Let ivMe2 be ivMe.
                            peDeclareDynamic(ivMk2, ivMe2, state, ivOut).
                        Let ivMk3 be "{ivM}".
                        peStSeDrop(state, ivMk3).
                        Let ivMk4 be "{ivM}".
                        peStEnvDynamic(state, ivMk4).
                Otherwise:
                    Let ivBase be "{ivV}".
                    Let ivSnap be freshNameSt(state, ivBase).
                    Let ivSnapK be "{ivSnap}".
                    Let ivVc be "{ivV}".
                    Push (a new CLet with name ivSnapK and expr (a new CVar with name ivVc)) to ivOut.
                    Let ivSnapK2 be "{ivSnap}".
                    peStEnvDynamic(state, ivSnapK2).
                    Let mutable ivMap be a new Map of Text to Text.
                    Let ivVc2 be "{ivV}".
                    Let ivSnapK3 be "{ivSnap}".
                    Set item ivVc2 of ivMap to ivSnapK3.
                    Repeat for ivR in ivLive:
                        Let ivRk be "{ivR}".
                        Let ivRe be item ivRk of (peStaticEnv(state)).
                        Let mutable ivRefs be a new Seq of Text.
                        Let mutable ivWrites be a new Seq of Text.
                        Let ivRe2 be renameExpr(ivRe, ivMap, ivRefs, ivWrites).
                        Let ivRk2 be "{ivR}".
                        peStSeBind(state, ivRk2, ivRe2).
    Return ivOut.

## To stmtWriteSet (wsS: CStmt) and (wsFuncs: Map of Text to CFunc) -> Seq of Text:
    Let wsOne be a new Seq of CStmt.
    Push wsS to wsOne.
    Let mutable wsOut be collectSetVars(wsOne, wsFuncs).
    collectBinders(wsOne, wsOut).
    Return wsOut.

## To peEnvShallow (esM: Map of Text to CVal) -> Map of Text to CVal:
    Let mutable esOut be a new Map of Text to CVal.
    Repeat for (esK, esV) in esM:
        Set item esK of esOut to esV.
    Return esOut.

## To peSeShallow (ssM: Map of Text to CExpr) -> Map of Text to CExpr:
    Let mutable ssOut be a new Map of Text to CExpr.
    Repeat for (ssK, ssV) in ssM:
        Set item ssK of ssOut to ssV.
    Return ssOut.

## To peStSetEnv (st: mutable PEState) and (newEnv: Map of Text to CVal):
    Set st to a new PEStateR with env newEnv and funcs (peFuncs(st)) and depth (peDepth(st)) and staticEnv (peStaticEnv(st)) and specResults (peSpecResults(st)) and onStack (peOnStack(st)).

## To peStSetStaticEnv (st: mutable PEState) and (newSe: Map of Text to CExpr):
    Set st to a new PEStateR with env (peEnv(st)) and funcs (peFuncs(st)) and depth (peDepth(st)) and staticEnv newSe and specResults (peSpecResults(st)) and onStack (peOnStack(st)).

## To peStSetSpecResults (st: mutable PEState) and (newSr: Map of Text to CExpr):
    Set st to a new PEStateR with env (peEnv(st)) and funcs (peFuncs(st)) and depth (peDepth(st)) and staticEnv (peStaticEnv(st)) and specResults newSr and onStack (peOnStack(st)).

## To peStSetFuncs (st: mutable PEState) and (newFuncs: Map of Text to CFunc):
    Set st to a new PEStateR with env (peEnv(st)) and funcs newFuncs and depth (peDepth(st)) and staticEnv (peStaticEnv(st)) and specResults (peSpecResults(st)) and onStack (peOnStack(st)).

## To peStSetOnStack (st: mutable PEState) and (newOs: Seq of Text):
    Let newOsOwned be copy of newOs.
    Set st to a new PEStateR with env (peEnv(st)) and funcs (peFuncs(st)) and depth (peDepth(st)) and staticEnv (peStaticEnv(st)) and specResults (peSpecResults(st)) and onStack newOsOwned.

## To peStEnvBind (st: mutable PEState) and (k: Text) and (v: CVal):
    Let mutable stEnv be peEnv(st).
    Set item k of stEnv to v.
    peStSetEnv(st, stEnv).

## To peStEnvDynamic (st: mutable PEState) and (k: Text):
    Let mutable stEnv be peEnv(st).
    peEnvDynamic(stEnv, k).
    peStSetEnv(st, stEnv).

## To peStEnvDrop (st: mutable PEState) and (k: Text):
    Let mutable stEnv be peEnv(st).
    Remove k from stEnv.
    peStSetEnv(st, stEnv).

## To peStMark (st: mutable PEState) and (k: Text):
    Let mutable stEnv be peEnv(st).
    markResidual(stEnv, k).
    peStSetEnv(st, stEnv).

## To peStSeBind (st: mutable PEState) and (k: Text) and (v: CExpr):
    Let mutable stSe be peStaticEnv(st).
    Let stK be "{k}".
    Set item k of stSe to v.
    peSeIndex(stSe, stK, v).
    peStSetStaticEnv(st, stSe).

## To peStSeDrop (st: mutable PEState) and (k: Text):
    Let mutable stSe be peStaticEnv(st).
    Remove k from stSe.
    peStSetStaticEnv(st, stSe).

## To peStSrBind (st: mutable PEState) and (k: Text) and (v: CExpr):
    Let mutable stSr be peSpecResults(st).
    Set item k of stSr to v.
    peStSetSpecResults(st, stSr).

## To peStSrDrop (st: mutable PEState) and (k: Text):
    Let mutable stSr be peSpecResults(st).
    Remove k from stSr.
    peStSetSpecResults(st, stSr).

## To peStFuncBind (st: mutable PEState) and (k: Text) and (v: CFunc):
    Let mutable stFuncs be peFuncs(st).
    Set item k of stFuncs to v.
    peStSetFuncs(st, stFuncs).

## To peStOsPush (st: mutable PEState) and (v: Text):
    Let mutable stOs be peOnStack(st).
    Push v to stOs.
    peStSetOnStack(st, stOs).

## To peRestoreEnvSt (st: mutable PEState) and (snap: Map of Text to CVal):
    Let mutable stEnv be peEnv(st).
    peRestoreEnv(stEnv, snap).
    peStSetEnv(st, stEnv).

## To peRestoreSeSt (st: mutable PEState) and (snap: Map of Text to CExpr):
    Let mutable stSe be peStaticEnv(st).
    peRestoreSe(stSe, snap).
    peStSetStaticEnv(st, stSe).

## To hoistSaveSt (st: mutable PEState) -> CExpr:
    Let mutable stSr be peSpecResults(st).
    Let stSaved be hoistSave(stSr).
    peStSetSpecResults(st, stSr).
    Return stSaved.

## To hoistSuspendSt (st: mutable PEState) -> CExpr:
    Let mutable stSr be peSpecResults(st).
    Let stSaved be hoistSuspend(stSr).
    peStSetSpecResults(st, stSr).
    Return stSaved.

## To hoistRestoreSt (st: mutable PEState) and (saved: CExpr):
    Let mutable stSr be peSpecResults(st).
    hoistRestore(stSr, saved).
    peStSetSpecResults(st, stSr).

## To hoistAppendSt (st: mutable PEState) and (stmts: Seq of CStmt):
    Let mutable stSr be peSpecResults(st).
    hoistAppend(stSr, stmts).
    peStSetSpecResults(st, stSr).

## To hoistCloseSt (st: mutable PEState) and (saved: CExpr) and (block: Seq of CStmt) and (mark: Int) -> Seq of CStmt:
    Let mutable stSr be peSpecResults(st).
    Let stClosed be hoistClose(stSr, saved, block, mark).
    peStSetSpecResults(st, stSr).
    Return stClosed.

## To freshNameSt (st: mutable PEState) and (base: Text) -> Text:
    Let mutable stSr be peSpecResults(st).
    Let stFresh be freshName(stSr, base).
    peStSetSpecResults(st, stSr).
    Return stFresh.

## To peSpecName (snSt: mutable PEState) and (snKey: Text) and (snBase: Text) -> Text:
    Let snSlot be "__pe_name__{snKey}".
    If (peSpecResults(snSt)) contains snSlot:
        Let snSlotRead be "{snSlot}".
        Let snHeld be item snSlotRead of (peSpecResults(snSt)).
        Inspect snHeld:
            When CText (snName):
                Return snName.
            Otherwise:
                Let snSkip be true.
    Let snFresh be freshNameSt(snSt, snBase).
    Let snSlotBind be "{snSlot}".
    Let snFreshCopy be "{snFresh}".
    peStSrBind(snSt, snSlotBind, a new CText with value snFreshCopy).
    Return snFresh.

## To applyPosFactsSt (cond: CExpr) and (st: mutable PEState) -> Bool:
    Let mutable stSe be peStaticEnv(st).
    Let stApplied be applyPosFacts(cond, stSe).
    peStSetStaticEnv(st, stSe).
    Return stApplied.

## To applyNegFactsSt (cond: CExpr) and (st: mutable PEState) -> Bool:
    Let mutable stSe be peStaticEnv(st).
    Let stApplied be applyNegFacts(cond, stSe).
    peStSetStaticEnv(st, stSe).
    Return stApplied.

## To clearGuardFactsSt (cond: CExpr) and (st: mutable PEState) -> Bool:
    Let mutable stSe be peStaticEnv(st).
    Let stCleared be clearGuardFacts(cond, stSe).
    peStSetStaticEnv(st, stSe).
    Return stCleared.

## To peAbsorb (abSt: mutable PEState) and (abChild: PEState):
    peStSetFuncs(abSt, peFuncs(abChild)).
    peStSetSpecResults(abSt, peSpecResults(abChild)).

## To peAbsorbAll (aaSt: mutable PEState) and (aaChild: PEState):
    peStSetEnv(aaSt, peEnv(aaChild)).
    peStSetStaticEnv(aaSt, peStaticEnv(aaChild)).
    peAbsorb(aaSt, aaChild).
    peStSetOnStack(aaSt, peOnStack(aaChild)).

## To peStateWithStaticBinding (st: PEState) and (name: Text) and (val: CExpr) -> PEState:
    Inspect st:
        When PEStateR (e, f, d, se, sr, os):
            peSeBind(se, name, val).
            Return a new PEStateR with env e and funcs f and depth d and staticEnv se and specResults sr and onStack os.

## To peStateRemoveStatic (st: PEState) and (name: Text) -> PEState:
    Inspect st:
        When PEStateR (e, f, d, se, sr, os):
            peSeDrop(se, name).
            Return a new PEStateR with env e and funcs f and depth d and staticEnv se and specResults sr and onStack os.

## To peStateWithEnvDepthStatic (st: PEState) and (newEnv: Map of Text to CVal) and (d: Int) and (newSe: Map of Text to CExpr) -> PEState:
    Inspect st:
        When PEStateR (e, f, oldD, se, sr, os):
            Return a new PEStateR with env newEnv and funcs f and depth d and staticEnv newSe and specResults sr and onStack (copy of os).

## To isVNothing (v: CVal) -> Bool:
    Inspect v:
        When VNothing:
            Return true.
        Otherwise:
            Return false.

## To peHoldsResidualLeaf (hrlExpr: CExpr) -> Bool:
    Inspect hrlExpr:
        When CVar (hrlName):
            Return peStartsWith(hrlName, "pkv__").
        When CNewVariant (hrlTag, hrlNames, hrlVals):
            Return anyHoldsResidualLeaf(hrlVals).
        When CNew (hrlTy, hrlFns, hrlFvs):
            Return anyHoldsResidualLeaf(hrlFvs).
        When CTuple (hrlTup):
            Return anyHoldsResidualLeaf(hrlTup).
        When CList (hrlItems):
            Return anyHoldsResidualLeaf(hrlItems).
        When COptionSome (hrlInner):
            Return peHoldsResidualLeaf(hrlInner).
        When CCopy (hrlCopied):
            Return peHoldsResidualLeaf(hrlCopied).
        When CCall (hrlCallName, hrlCallArgs):
            If peIsBox(hrlExpr) or peIsSum(hrlExpr):
                Return anyHoldsResidualLeaf(hrlCallArgs).
            Return false.
        Otherwise:
            Return false.

## To peIsStaticList (slExpr: CExpr) -> Bool:
    Inspect slExpr:
        When CList (slItems):
            Return isStatic(slExpr).
        When CNewSeq (slElem):
            Return true.
        Otherwise:
            Return false.

## To peListItems (liExpr: CExpr) -> Seq of CExpr:
    Inspect liExpr:
        When CList (liItems):
            Return liItems.
        Otherwise:
            Return a new Seq of CExpr.

## To peRepeatedList (rpList: CExpr) and (rpTimes: Int) -> CExpr:
    Let mutable rpItems be a new Seq of CExpr.
    Let mutable rpI be 0.
    While rpI is less than rpTimes:
        Repeat for rpItem in peListItems(rpList):
            Push rpItem to rpItems.
        Set rpI to rpI + 1.
    Return a new CList with items rpItems.

## To peFoldSeqOp (sqOp: Text) and (sqLeft: CExpr) and (sqRight: CExpr) -> CExpr:
    Let sqLeftList be peIsStaticList(sqLeft).
    Let sqRightList be peIsStaticList(sqRight).
    If (sqOp equals "followed by") or (sqOp equals "+"):
        If sqLeftList and sqRightList:
            If length of peListItems(sqRight) equals 0:
                Return sqLeft.
            If length of peListItems(sqLeft) equals 0:
                Return sqRight.
            Let mutable sqItems be copy of peListItems(sqLeft).
            Repeat for sqRightItem in peListItems(sqRight):
                Push sqRightItem to sqItems.
            Return a new CList with items sqItems.
    If sqOp equals "*":
        Inspect sqLeft:
            When CInt (sqLeftTimes):
                If sqRightList:
                    Return peRepeatedList(sqRight, sqLeftTimes).
            Otherwise:
                Let sqSkipLeft be true.
        Inspect sqRight:
            When CInt (sqRightTimes):
                If sqLeftList:
                    Return peRepeatedList(sqLeft, sqRightTimes).
            Otherwise:
                Let sqSkipRight be true.
    Return a new CVar with name "__pe_no_unfold".

## To isBakeable (bkExpr: CExpr) -> Bool:
    If peHoldsResidualLeaf(bkExpr):
        Return false.
    Return isStatic(bkExpr).

## To anyHoldsResidualLeaf (arExprs: Seq of CExpr) -> Bool:
    Repeat for arExpr in arExprs:
        If peHoldsResidualLeaf(arExpr):
            Return true.
    Return false.

## To peHoistLeaves (hlExprs: Seq of CExpr) and (hlState: mutable PEState) -> Seq of CExpr:
    Let hlOut be a new Seq of CExpr.
    Repeat for hlE in hlExprs:
        Push peHoistLeaf(hlE, hlState) to hlOut.
    Return hlOut.

## To peDeclareDynamic (ddName: Text) and (ddPrior: CExpr) and (ddState: PEState) and (ddOut: mutable Seq of CStmt):
    Inspect ddPrior:
        When CVar (ddV):
            If ddV equals ddName:
                Return.
        Otherwise:
            Let ddSkip be true.
    Let ddK be "{ddName}".
    If peStartsWith(ddName, "pkv__") or isResidualVar((peEnv(ddState)), ddName):
        Push (a new CSet with name ddK and expr ddPrior) to ddOut.
    Otherwise:
        Push (a new CLet with name ddK and expr ddPrior) to ddOut.

## To peListAsBox (lbE: CExpr) and (lbState: mutable PEState) -> CExpr:
    If not hoistActive((peSpecResults(lbState))):
        Return lbE.
    Inspect lbE:
        When CList (lbItems):
            If length of lbItems equals 0:
                Return lbE.
            Let mutable lbTmp be a new Seq of Text.
            Let lbBox be peGenList(lbE, lbE, lbTmp, lbState).
            If isNoUnfold(lbBox) or not (length of lbTmp equals 1):
                Return lbE.
            Let mutable lbVals be a new Map of Text to CExpr.
            If not peMatchList(lbBox, lbE, lbTmp, lbVals, lbState):
                Return lbE.
            Let lbBase be item 1 of lbTmp.
            If not (lbVals contains lbBase):
                Return lbE.
            Let lbBaseK be "{lbBase}".
            Let lbLets be a new Seq of CStmt.
            Push (a new CLet with name lbBaseK and expr (item lbBase of lbVals)) to lbLets.
            hoistAppendSt(lbState, lbLets).
            Return lbBox.
        Otherwise:
            Return lbE.

## To peHoistLeaf (hfExpr: CExpr) and (hfState: mutable PEState) -> CExpr:
    If isStatic(hfExpr):
        Return hfExpr.
    Inspect hfExpr:
        When CNewVariant (hfTag, hfNames, hfVals):
            Return a new CNewVariant with tag hfTag and fnames hfNames and fvals peHoistLeaves(hfVals, hfState).
        When CNew (hfTy, hfFns, hfFvs):
            Return a new CNew with typeName hfTy and fieldNames hfFns and fields peHoistLeaves(hfFvs, hfState).
        When CTuple (hfItems):
            Return a new CTuple with items peHoistLeaves(hfItems, hfState).
        When CList (hfListItems):
            Return a new CList with items peHoistLeaves(hfListItems, hfState).
        When COptionSome (hfInner):
            Return a new COptionSome with inner peHoistLeaf(hfInner, hfState).
        When CDeclaredDefault (hfDefaultType):
            Return hfExpr.
        When CSpelled (hfSpelledCode, hfSpelledAwaits):
            Return hfExpr.
        Otherwise:
            Let hfName be freshNameSt(hfState, "pkv").
            Let hfLets be a new Seq of CStmt.
            Push (a new CLet with name hfName and expr hfExpr) to hfLets.
            hoistAppendSt(hfState, hfLets).
            Return a new CVar with name hfName.

## To isLiteral (e: CExpr) -> Bool:
    Inspect e:
        When CInt (v):
            Return true.
        When CBool (v):
            Return true.
        When CText (v):
            Return true.
        When CFloat (v):
            Return true.
        When CDuration (litAtomDuration):
            Return true.
        When CDate (litAtomDate):
            Return true.
        When CMoment (litAtomMoment):
            Return true.
        When CSpan (litAtomSpan):
            Return true.
        When CTime (litAtomTime):
            Return true.
        When CChar (litAtomChar):
            Return true.
        Otherwise:
            Return false.

## To exprToVal (e: CExpr) -> CVal:
    If peHoldsResidualLeaf(e):
        Return a new VNothing.
    Inspect e:
        When CInt (v):
            Return a new VInt with value v.
        When CBool (v):
            Return a new VBool with value v.
        When CText (v):
            Return a new VText with value v.
        When CFloat (v):
            Return a new VFloat with value v.
        When CDuration (evAtomDuration):
            Return a new VDuration with value evAtomDuration.
        When CDate (evAtomDate):
            Return a new VDate with value evAtomDate.
        When CMoment (evAtomMoment):
            Return a new VMoment with value evAtomMoment.
        When CSpan (evAtomSpan):
            Return a new VSpan with value evAtomSpan.
        When CTime (evAtomTime):
            Return a new VTime with value evAtomTime.
        When CChar (evAtomChar):
            Return a new VChar with value evAtomChar.
        When CList (items):
            Let vals be a new Seq of CVal.
            Repeat for elem in items:
