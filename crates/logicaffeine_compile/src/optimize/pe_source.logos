# The specializer's guards: generated by optimize::core_operators from semantics::operator_overloads.
## To peGuardCondition (gcOp: Text) and (gcLeft: Text) and (gcRight: Text) and (gcReport: Text) and (gcLeftOperand: CExpr) and (gcRightOperand: CExpr) -> CExpr:
    If gcOp equals "%":
        If gcLeft equals "Int" and gcRight equals "Int":
            If gcReport equals "Modulo by zero":
                Return a new CBinOp with op "==" and left gcRightOperand and right (a new CInt with value 0).
    If gcOp equals "**":
        If gcLeft equals "Int" and gcRight equals "Int":
            If gcReport equals "negative exponent on an integer (an Int can't hold a fraction — use a Float base)":
                Return a new CBinOp with op "<" and left gcRightOperand and right (a new CInt with value 0).
    If gcOp equals "/":
        If gcLeft equals "Int" and gcRight equals "Int":
            If gcReport equals "Division by zero":
                Return a new CBinOp with op "==" and left gcRightOperand and right (a new CInt with value 0).
        If gcLeft equals "Int" and gcRight equals "Real":
            If gcReport equals "Division by zero":
                Return a new CBinOp with op "==" and left gcRightOperand and right (a new CFloat with value 0.0).
        If gcLeft equals "Real" and gcRight equals "Int":
            If gcReport equals "Division by zero":
                Return a new CBinOp with op "==" and left gcRightOperand and right (a new CInt with value 0).
        If gcLeft equals "Real" and gcRight equals "Real":
            If gcReport equals "Division by zero":
                Return a new CBinOp with op "==" and left gcRightOperand and right (a new CFloat with value 0.0).
    If gcOp equals "//":
        If gcLeft equals "Int" and gcRight equals "Int":
            If gcReport equals "Division by zero":
                Return a new CBinOp with op "==" and left gcRightOperand and right (a new CInt with value 0).
        If gcLeft equals "Int" and gcRight equals "Real":
            If gcReport equals "Division by zero":
                Return a new CBinOp with op "==" and left gcRightOperand and right (a new CFloat with value 0.0).
        If gcLeft equals "Real" and gcRight equals "Int":
            If gcReport equals "Division by zero":
                Return a new CBinOp with op "==" and left gcRightOperand and right (a new CInt with value 0).
        If gcLeft equals "Real" and gcRight equals "Real":
            If gcReport equals "Division by zero":
                Return a new CBinOp with op "==" and left gcRightOperand and right (a new CFloat with value 0.0).
    Return a new CVar with name "__pe_no_unfold".
# The specializer's guards end.

## To isStatic (e: CExpr) -> Bool:
    Inspect e:
        When CInt (v):
            Return true.
        When CBool (v):
            Return true.
        When CText (v):
            Return true.
        When CFloat (v):
            Return true.
        When CDuration (stAtomDuration):
            Return true.
        When CDate (stAtomDate):
            Return true.
        When CMoment (stAtomMoment):
            Return true.
        When CSpan (stAtomSpan):
            Return true.
        When CTime (stAtomTime):
            Return true.
        When CChar (stAtomChar):
            Return true.
        When CList (items):
            Repeat for elem in items:
                Let s be isStatic(elem).
                If not s:
                    Return false.
            Return true.
        When CNewVariant (tag, names, vals):
            Repeat for v in vals:
                Let s be isStatic(v).
                If not s:
                    Return false.
            Return true.
        When CTuple (items):
            Repeat for elem in items:
                Let s be isStatic(elem).
                If not s:
                    Return false.
            Return true.
        When COptionSome (inner):
            Return isStatic(inner).
        When COptionNone:
            Return true.
        When CNewSeq (peSeqElem2):
            Return true.
        When CNewSet (peSetElem2):
            Return true.
        When CNew (typeName, fieldNames, fieldExprs):
            Repeat for fe in fieldExprs:
                Let s be isStatic(fe).
                If not s:
                    Return false.
            Return true.
        When CRange (start, end):
            Let s1 be isStatic(start).
            Let s2 be isStatic(end).
            Return (s1 and s2).
        When CCopy (target):
            Return isStatic(target).
        When CClosure (clp, clb, clc):
            Return true.
        When CVar (stLeafName):
            Return peStartsWith(stLeafName, "pkv__").
        When CCall (stBoxName, stBoxArgs):
            If peIsBox(e) or peIsSum(e):
                Return isStatic(item 1 of stBoxArgs).
            Return false.
        Otherwise:
            Return false.

## To isStaticValue (e: CExpr) -> Bool:
    Inspect e:
        When CNewSeq (peSeqElem3):
            Return false.
        When CNewSet (peSetElem3):
            Return false.
        When CList (litems):
            Return false.
        When CNew (isvTy, isvNames, isvFields):
            If peIsMapType(isvTy):
                Return false.
            Return isStatic(e).
        Otherwise:
            Return isStatic(e).

## To isCopyPropSafe (e: CExpr) -> Bool:
    Inspect e:
        When CNewSeq (peSeqElem4):
            Return false.
        When CNewSet (peSetElem4):
            Return false.
        When CDeclaredDefault (cpDefaultType):
            Return false.
        Otherwise:
            Return true.

## To isPeValueForCopyProp (e: CExpr) -> Bool:
    Let sv be isStaticValue(e).
    If sv:
        Return true.
    Inspect e:
        When CList (cpvItems):
            Return true.
        When CNewSeq (peSeqElem5):
            Return true.
        When CTuple (cpvTup):
            Return true.
        When CNew (cpvTy, cpvNames, cpvVals):
            Return true.
        When CNewVariant (cpvTag, cpvNms, cpvVls):
            Return true.
        When COptionSome (cpvInner):
            Return true.
        When CRange (cpvS, cpvE):
            Return true.
        Otherwise:
            Return false.

## To exprRefsAnyMutated (e: CExpr) and (muts: Seq of Text) -> Bool:
    Inspect e:
        When CVar (ravVn):
            Repeat for ravM in muts:
                If ravVn is equal to ravM:
                    Return true.
            Return false.
        When CBinOp (ravOp, ravL, ravR):
            Let ravA be exprRefsAnyMutated(ravL, muts).
            If ravA:
                Return true.
            Return exprRefsAnyMutated(ravR, muts).
        When CNot (ravNi):
            Return exprRefsAnyMutated(ravNi, muts).
        When CIndex (ravIc, ravIi):
            Let ravB be exprRefsAnyMutated(ravIc, muts).
            If ravB:
                Return true.
            Return exprRefsAnyMutated(ravIi, muts).
        When CLen (ravLt):
            Return exprRefsAnyMutated(ravLt, muts).
        When CFieldAccess (ravFt, ravFf):
            Return exprRefsAnyMutated(ravFt, muts).
        When CMapGet (ravMt, ravMk):
            Let ravC be exprRefsAnyMutated(ravMt, muts).
            If ravC:
                Return true.
            Return exprRefsAnyMutated(ravMk, muts).
        When CContains (ravCc, ravCe):
            Let ravD be exprRefsAnyMutated(ravCc, muts).
            If ravD:
                Return true.
            Return exprRefsAnyMutated(ravCe, muts).
        When CSlice (ravSc, ravSs, ravSe):
            Let ravE be exprRefsAnyMutated(ravSc, muts).
            If ravE:
                Return true.
            Let ravF be exprRefsAnyMutated(ravSs, muts).
            If ravF:
                Return true.
            Return exprRefsAnyMutated(ravSe, muts).
        When CUnion (ravUl, ravUr):
            Let ravG be exprRefsAnyMutated(ravUl, muts).
            If ravG:
                Return true.
            Return exprRefsAnyMutated(ravUr, muts).
        When CIntersection (ravIl, ravIr):
            Let ravH be exprRefsAnyMutated(ravIl, muts).
            If ravH:
                Return true.
            Return exprRefsAnyMutated(ravIr, muts).
        When CCopy (ravCt):
            Return exprRefsAnyMutated(ravCt, muts).
        When CInt (ravVi):
            Return false.
        When CBool (ravVb):
            Return false.
        When CText (ravVt):
            Return false.
        When CFloat (ravVf):
            Return false.
        When CDuration (ravAtomDuration):
            Return false.
        When CDate (ravAtomDate):
            Return false.
        When CMoment (ravAtomMoment):
            Return false.
        When CSpan (ravAtomSpan):
            Return false.
        When CTime (ravAtomTime):
            Return false.
        When CChar (ravAtomChar):
            Return false.
        Otherwise:
            Return true.

## To shouldCopyProp (e: CExpr) and (muts: Seq of Text) -> Bool:
    Let scpSv be isPeValueForCopyProp(e).
    If scpSv:
        Return true.
    Let scpRm be exprRefsAnyMutated(e, muts).
    If scpRm:
        Return false.
    Return true.

## To isRefAggregate (e: CExpr) -> Bool:
    Inspect e:
        When CList (items):
            Return true.
        When CNewSeq (peSeqElem6):
            Return true.
        When CNewSet (peSetElem5):
            Return true.
        Otherwise:
            Return false.

## To hasKnownTag (e: CExpr) -> Bool:
    Inspect e:
        When CNewVariant (tag, names, vals):
            Return true.
        When CNew (typeName, fieldNames, fieldExprs):
            Return true.
        Otherwise:
            Return false.

## To allStatic (args: Seq of CExpr) -> Bool:
    Repeat for a in args:
        Let s be isStatic(a).
        If not s:
            Return false.
    Return true.

## To allLiteral (args: Seq of CExpr) -> Bool:
    Repeat for a in args:
        Let lit be isLiteral(a).
        If not lit:
            Return false.
    Return true.

## To dynamicOnly (args: Seq of CExpr) -> Bool:
    Repeat for a in args:
        Let lit be isLiteral(a).
        If lit:
            Return false.
    Return true.

## To dynamicArgs (args: Seq of CExpr) -> Seq of CExpr:
    Let filtered be a new Seq of CExpr.
    Repeat for a in args:
        Let lit be isLiteral(a).
        If not lit:
            Push a to filtered.
    Return filtered.

## To hasReturn (stmts: Seq of CStmt) -> Bool:
    Repeat for s in stmts:
        Inspect s:
            When CReturn (retExpr):
                Return true.
            Otherwise:
                Let skip be true.
    Return false.

## To hasBreak (stmts: Seq of CStmt) -> Bool:
    Repeat for s in stmts:
        Inspect s:
            When CBreak:
                Return true.
            Otherwise:
                Let skip be true.
    Return false.

## To peCutAfterFail (cfStmts: Seq of CStmt) -> Seq of CStmt:
    Let mutable cfOut be a new Seq of CStmt.
    Repeat for cfS in cfStmts:
        Push cfS to cfOut.
        Inspect cfS:
            When CFail (cfReason):
                Return cfOut.
            Otherwise:
                Let cfGoesOn be true.
    Return cfOut.

## To hasFail (stmts: Seq of CStmt) -> Bool:
    Repeat for s in stmts:
        Inspect s:
            When CFail (hfReason):
                Return true.
            Otherwise:
                Let skip be true.
    Return false.

## To seqDropLast (items: Seq of CExpr) -> Seq of CExpr:
    Let result be a new Seq of CExpr.
    Let n be length of items.
    Let mutable idx be 1.
    Repeat for it in items:
        If idx is less than n:
            Push it to result.
        Set idx to idx + 1.
    Return result.

## To keyJoin (acc: Text) and (part: Text) -> Text:
    Let n be length of part.
    Return "{acc}_{n}_{part}".


## To exprToKeyPart (e: CExpr) -> Text:
    Inspect e:
        When CInt (v):
            Return "i{v}".
        When CBool (v):
            If v:
                Return "btrue".
            Return "bfalse".
        When CText (v):
            Return "t{v}".
        When CFloat (v):
            Return "f{v}".
        When CList (items):
            Let mutable parts be "l".
            Repeat for elem in items:
                Let ep be exprToKeyPart(elem).
                Set parts to keyJoin(parts, ep).
            Return parts.
        When CNewVariant (tag, names, vals):
            Let mutable parts be keyJoin(keyJoin("v", tag), textsToKeyPart(names)).
            Repeat for fv in vals:
                Let vp be exprToKeyPart(fv).
                Set parts to keyJoin(parts, vp).
            Return parts.
        When CTuple (items):
            Let mutable parts be "tp".
            Repeat for elem in items:
                Let ep be exprToKeyPart(elem).
                Set parts to keyJoin(parts, ep).
            Return parts.
        When COptionSome (inner):
            Let ip be exprToKeyPart(inner).
            Return keyJoin("s", ip).
        When COptionNone:
            Return "none".
        When CNothing:
            Return "nothing".
        When CDeclaredDefault (kpDefaultType):
            Return keyJoin("default", kpDefaultType).
        When CSpelled (kpSpelledCode, kpSpelledAwaits):
            Return keyJoin(keyJoin("spelled", kpSpelledCode), kpSpelledAwaits).
        When CNewSeq (peSeqElem7):
            Return keyJoin("seq", peSeqElem7).
        When CNewSet (peSetElem6):
            Return keyJoin("set", peSetElem6).
        When CVar (varName):
            Return "var{varName}".
        When CBinOp (op, left, right):
            Let lp be exprToKeyPart(left).
            Let rp be exprToKeyPart(right).
            Let opTag be "op{op}".
            Let s1 be keyJoin(opTag, lp).
            Return keyJoin(s1, rp).
        When CNot (inner):
            Let ip be exprToKeyPart(inner).
            Return keyJoin("nt", ip).
        When CCall (fnName, args):
            Let mutable parts be "call{fnName}".
            Repeat for a in args:
                Let ap be exprToKeyPart(a).
                Set parts to keyJoin(parts, ap).
            Return parts.
        When CIndex (coll, idx):
            Let cp be exprToKeyPart(coll).
            Let ip be exprToKeyPart(idx).
            Let s1 be keyJoin("idx", cp).
            Return keyJoin(s1, ip).
        When CLen (target):
            Let tp be exprToKeyPart(target).
            Return keyJoin("len", tp).
        When CMapGet (mapExpr, key):
            Let mp be exprToKeyPart(mapExpr).
            Let kp be exprToKeyPart(key).
            Let s1 be keyJoin("mg", mp).
            Return keyJoin(s1, kp).
        When CFieldAccess (target, field):
            Let tp be exprToKeyPart(target).
            Let s1 be keyJoin("fa", field).
            Return keyJoin(s1, tp).
        When CNew (typeName, fieldNames, fieldExprs):
            Let mutable parts be keyJoin(keyJoin("nw", typeName), textsToKeyPart(fieldNames)).
            Repeat for fv in fieldExprs:
                Let vp be exprToKeyPart(fv).
                Set parts to keyJoin(parts, vp).
            Return parts.
        When CRange (start, end):
            Let sp be exprToKeyPart(start).
            Let ep be exprToKeyPart(end).
            Let s1 be keyJoin("r", sp).
            Return keyJoin(s1, ep).
        When CSlice (coll, startIdx, endIdx):
            Let cp be exprToKeyPart(coll).
            Let sp be exprToKeyPart(startIdx).
            Let ep be exprToKeyPart(endIdx).
            Let s1 be keyJoin("sl", cp).
            Let s2 be keyJoin(s1, sp).
            Return keyJoin(s2, ep).
        When CCopy (target):
            Let tp be exprToKeyPart(target).
            Return keyJoin("cp", tp).
        When CContains (coll, elem):
            Let cp be exprToKeyPart(coll).
            Let ep be exprToKeyPart(elem).
            Let s1 be keyJoin("ct", cp).
            Return keyJoin(s1, ep).
        When CUnion (left, right):
            Let lp be exprToKeyPart(left).
            Let rp be exprToKeyPart(right).
            Let s1 be keyJoin("un", lp).
            Return keyJoin(s1, rp).
        When CIntersection (left, right):
            Let lp be exprToKeyPart(left).
            Let rp be exprToKeyPart(right).
            Let s1 be keyJoin("ix", lp).
            Return keyJoin(s1, rp).
        When CClosure (params, body, captured):
            Return keyJoin(keyJoin(keyJoin("cl", textsToKeyPart(params)), stmtsToKeyPart(body)), textsToKeyPart(captured)).
        When CCallExpr (target, args):
            Let tp be exprToKeyPart(target).
            Return keyJoin(keyJoin("ce", tp), exprsToKeyPart(args)).
        When CInterpolatedString (parts):
            Let mutable ps be "is".
            Repeat for p in parts:
                Inspect p:
                    When CLiteralPart (litVal):
                        Let litTag be "lt{litVal}".
                        Set ps to keyJoin(ps, litTag).
                    When CExprPart (epExpr):
                        Let pp be exprToKeyPart(epExpr).
                        Set ps to keyJoin(ps, pp).
                    When CFormattedPart (fpkExpr, fpkSpec, fpkForm, fpkSize):
                        Let fpkTag be "fs{fpkSpec}".
                        Set ps to keyJoin(ps, fpkTag).
                        Let fpkPart be exprToKeyPart(fpkExpr).
                        Set ps to keyJoin(ps, fpkPart).
            Return ps.
        When CDuration (kpDuration):
            Return keyJoin("duration", format_timestamp(1970-01-01 at 12:00am + kpDuration)).
        When CDate (kpDate):
            Return keyJoin("date", "{kpDate}").
        When CMoment (kpMoment):
            Return keyJoin("moment", format_timestamp(kpMoment)).
        When CSpan (kpSpan):
            Return keyJoin("span", "{kpSpan}").
        When CTime (kpTime):
            Return keyJoin("time", "{kpTime}").
        When CChar (kpChar):
            Return keyJoin("char", "{kpChar}").
        When CTimeNow:
            Return "tnow".
        When CDateToday:
            Return "today".
        When CEscExpr (code):
            Return keyJoin("esc", code).
        When CManifestOf (ek0x0):
            Let mutable ek0k be "CManifestOf".
            Set ek0k to keyJoin(ek0k, exprToKeyPart(ek0x0)).
            Return ek0k.
        When CChunkAt (ek1x0, ek1x1):
            Let mutable ek1k be "CChunkAt".
            Set ek1k to keyJoin(ek1k, exprToKeyPart(ek1x0)).
            Set ek1k to keyJoin(ek1k, exprToKeyPart(ek1x1)).
            Return ek1k.
        Otherwise:
            Return "unk".

## To stmtToKeyPart (sk: CStmt) -> Text:
    Inspect sk:
        When CLet (sk0x0, sk0x1):
            Let mutable sk0k be "CLet".
            Set sk0k to keyJoin(sk0k, sk0x0).
            Set sk0k to keyJoin(sk0k, exprToKeyPart(sk0x1)).
            Return sk0k.
        When CSet (sk1x0, sk1x1):
            Let mutable sk1k be "CSet".
            Set sk1k to keyJoin(sk1k, sk1x0).
            Set sk1k to keyJoin(sk1k, exprToKeyPart(sk1x1)).
            Return sk1k.
        When CIf (sk2x0, sk2x1, sk2x2):
            Let mutable sk2k be "CIf".
            Set sk2k to keyJoin(sk2k, exprToKeyPart(sk2x0)).
            Set sk2k to keyJoin(sk2k, stmtsToKeyPart(sk2x1)).
            Set sk2k to keyJoin(sk2k, stmtsToKeyPart(sk2x2)).
            Return sk2k.
        When CWhile (sk3x0, sk3x1):
            Let mutable sk3k be "CWhile".
            Set sk3k to keyJoin(sk3k, exprToKeyPart(sk3x0)).
            Set sk3k to keyJoin(sk3k, stmtsToKeyPart(sk3x1)).
            Return sk3k.
        When CReturn (sk4x0):
            Let mutable sk4k be "CReturn".
            Set sk4k to keyJoin(sk4k, exprToKeyPart(sk4x0)).
            Return sk4k.
        When CShow (sk5x0):
            Let mutable sk5k be "CShow".
            Set sk5k to keyJoin(sk5k, exprToKeyPart(sk5x0)).
            Return sk5k.
        When CCallS (sk6x0, sk6x1):
            Let mutable sk6k be "CCallS".
            Set sk6k to keyJoin(sk6k, sk6x0).
            Set sk6k to keyJoin(sk6k, exprsToKeyPart(sk6x1)).
            Return sk6k.
        When CPush (sk7x0, sk7x1):
            Let mutable sk7k be "CPush".
            Set sk7k to keyJoin(sk7k, exprToKeyPart(sk7x0)).
            Set sk7k to keyJoin(sk7k, sk7x1).
            Return sk7k.
        When CSetIdx (sk8x0, sk8x1, sk8x2):
            Let mutable sk8k be "CSetIdx".
            Set sk8k to keyJoin(sk8k, sk8x0).
            Set sk8k to keyJoin(sk8k, exprToKeyPart(sk8x1)).
            Set sk8k to keyJoin(sk8k, exprToKeyPart(sk8x2)).
            Return sk8k.
        When CMapSet (sk9x0, sk9x1, sk9x2):
            Let mutable sk9k be "CMapSet".
            Set sk9k to keyJoin(sk9k, sk9x0).
            Set sk9k to keyJoin(sk9k, exprToKeyPart(sk9x1)).
            Set sk9k to keyJoin(sk9k, exprToKeyPart(sk9x2)).
            Return sk9k.
        When CPop (sk10x0):
            Let mutable sk10k be "CPop".
            Set sk10k to keyJoin(sk10k, sk10x0).
            Return sk10k.
        When CPopInto (sk11x0, sk11x1):
            Let mutable sk11k be "CPopInto".
            Set sk11k to keyJoin(sk11k, sk11x0).
            Set sk11k to keyJoin(sk11k, sk11x1).
            Return sk11k.
        When CRepeat (sk12x0, sk12x1, sk12x2):
            Let mutable sk12k be "CRepeat".
            Set sk12k to keyJoin(sk12k, sk12x0).
            Set sk12k to keyJoin(sk12k, exprToKeyPart(sk12x1)).
            Set sk12k to keyJoin(sk12k, stmtsToKeyPart(sk12x2)).
            Return sk12k.
        When CRepeatRange (sk13x0, sk13x1, sk13x2, sk13x3):
            Let mutable sk13k be "CRepeatRange".
            Set sk13k to keyJoin(sk13k, sk13x0).
            Set sk13k to keyJoin(sk13k, exprToKeyPart(sk13x1)).
            Set sk13k to keyJoin(sk13k, exprToKeyPart(sk13x2)).
            Set sk13k to keyJoin(sk13k, stmtsToKeyPart(sk13x3)).
            Return sk13k.
        When CBreak:
            Let mutable sk14k be "CBreak".
            Return sk14k.
        When CAdd (sk15x0, sk15x1):
            Let mutable sk15k be "CAdd".
            Set sk15k to keyJoin(sk15k, exprToKeyPart(sk15x0)).
            Set sk15k to keyJoin(sk15k, sk15x1).
            Return sk15k.
        When CRemove (sk16x0, sk16x1):
            Let mutable sk16k be "CRemove".
            Set sk16k to keyJoin(sk16k, exprToKeyPart(sk16x0)).
            Set sk16k to keyJoin(sk16k, sk16x1).
            Return sk16k.
        When CForceDynamic (sk17x0):
            Let mutable sk17k be "CForceDynamic".
            Set sk17k to keyJoin(sk17k, sk17x0).
            Return sk17k.
        When CSetField (sk18x0, sk18x1, sk18x2):
            Let mutable sk18k be "CSetField".
            Set sk18k to keyJoin(sk18k, sk18x0).
            Set sk18k to keyJoin(sk18k, sk18x1).
            Set sk18k to keyJoin(sk18k, exprToKeyPart(sk18x2)).
            Return sk18k.
        When CAtPath (sk19x0, sk19x1, sk19x2):
            Let mutable sk19k be "CAtPath".
            Set sk19k to keyJoin(sk19k, sk19x0).
            Set sk19k to keyJoin(sk19k, textsToKeyPart(sk19x1)).
            Set sk19k to keyJoin(sk19k, stmtsToKeyPart(sk19x2)).
            Return sk19k.
        When CStructDef (sk20x0, sk20x1):
            Let mutable sk20k be "CStructDef".
            Set sk20k to keyJoin(sk20k, sk20x0).
            Set sk20k to keyJoin(sk20k, textsToKeyPart(sk20x1)).
            Return sk20k.
        When CInspect (sk21x0, sk21x1):
            Let mutable sk21k be "CInspect".
            Set sk21k to keyJoin(sk21k, exprToKeyPart(sk21x0)).
            Set sk21k to keyJoin(sk21k, armsToKeyPart(sk21x1)).
            Return sk21k.
        When CEnumDef (sk22x0, sk22x1):
            Let mutable sk22k be "CEnumDef".
            Set sk22k to keyJoin(sk22k, sk22x0).
            Set sk22k to keyJoin(sk22k, textsToKeyPart(sk22x1)).
            Return sk22k.
        When CRuntimeAssert (sk23x0, sk23x1):
            Let mutable sk23k be "CRuntimeAssert".
            Set sk23k to keyJoin(sk23k, exprToKeyPart(sk23x0)).
            Set sk23k to keyJoin(sk23k, exprToKeyPart(sk23x1)).
            Return sk23k.
        When CHardAssert (sk24x0, sk24x1):
            Let mutable sk24k be "CHardAssert".
            Set sk24k to keyJoin(sk24k, exprToKeyPart(sk24x0)).
            Set sk24k to keyJoin(sk24k, exprToKeyPart(sk24x1)).
            Return sk24k.
        When CFail (sk25x0):
            Let mutable sk25k be "CFail".
            Set sk25k to keyJoin(sk25k, exprToKeyPart(sk25x0)).
            Return sk25k.
        When CGive (sk26x0, sk26x1):
            Let mutable sk26k be "CGive".
            Set sk26k to keyJoin(sk26k, exprToKeyPart(sk26x0)).
            Set sk26k to keyJoin(sk26k, sk26x1).
            Return sk26k.
        When CEscStmt (sk27x0):
            Let mutable sk27k be "CEscStmt".
            Set sk27k to keyJoin(sk27k, sk27x0).
            Return sk27k.
        When CSleep (sk28x0):
            Let mutable sk28k be "CSleep".
            Set sk28k to keyJoin(sk28k, exprToKeyPart(sk28x0)).
            Return sk28k.
        When CReadConsole (sk29x0):
            Let mutable sk29k be "CReadConsole".
            Set sk29k to keyJoin(sk29k, sk29x0).
            Return sk29k.
        When CReadFile (sk30x0, sk30x1):
            Let mutable sk30k be "CReadFile".
            Set sk30k to keyJoin(sk30k, exprToKeyPart(sk30x0)).
            Set sk30k to keyJoin(sk30k, sk30x1).
            Return sk30k.
        When CWriteFile (sk31x0, sk31x1):
            Let mutable sk31k be "CWriteFile".
            Set sk31k to keyJoin(sk31k, exprToKeyPart(sk31x0)).
            Set sk31k to keyJoin(sk31k, exprToKeyPart(sk31x1)).
            Return sk31k.
        When CCheck (sk32x0, sk32x1):
            Let mutable sk32k be "CCheck".
            Set sk32k to keyJoin(sk32k, exprToKeyPart(sk32x0)).
            Set sk32k to keyJoin(sk32k, exprToKeyPart(sk32x1)).
            Return sk32k.
        When CCheckPolicy (sk33x0, sk33x1, sk33x2, sk33x3, sk33x4, sk33x5):
            Let mutable sk33k be "CCheckPolicy".
            Set sk33k to keyJoin(sk33k, sk33x0).
            Set sk33k to keyJoin(sk33k, sk33x1).
            Set sk33k to keyJoin(sk33k, "{sk33x2}").
            Set sk33k to keyJoin(sk33k, sk33x3).
            Set sk33k to keyJoin(sk33k, alternativesToKeyPart(sk33x4)).
            Set sk33k to keyJoin(sk33k, sk33x5).
            Return sk33k.
        When CAssert (sk34x0):
            Let mutable sk34k be "CAssert".
            Set sk34k to keyJoin(sk34k, exprToKeyPart(sk34x0)).
            Return sk34k.
        When CTrust (sk35x0, sk35x1):
            Let mutable sk35k be "CTrust".
            Set sk35k to keyJoin(sk35k, exprToKeyPart(sk35x0)).
            Set sk35k to keyJoin(sk35k, sk35x1).
            Return sk35k.
        When CRequire (sk36x0):
            Let mutable sk36k be "CRequire".
            Set sk36k to keyJoin(sk36k, sk36x0).
            Return sk36k.
        When CMerge (sk37x0, sk37x1):
            Let mutable sk37k be "CMerge".
            Set sk37k to keyJoin(sk37k, sk37x0).
            Set sk37k to keyJoin(sk37k, exprToKeyPart(sk37x1)).
            Return sk37k.
        When CJoin (sk38x0, sk38x1):
            Let mutable sk38k be "CJoin".
            Set sk38k to keyJoin(sk38k, sk38x0).
            Set sk38k to keyJoin(sk38k, exprToKeyPart(sk38x1)).
            Return sk38k.
        When CIncrease (sk39x0, sk39x1):
            Let mutable sk39k be "CIncrease".
            Set sk39k to keyJoin(sk39k, sk39x0).
            Set sk39k to keyJoin(sk39k, exprToKeyPart(sk39x1)).
            Return sk39k.
        When CDecrease (sk40x0, sk40x1):
            Let mutable sk40k be "CDecrease".
            Set sk40k to keyJoin(sk40k, sk40x0).
            Set sk40k to keyJoin(sk40k, exprToKeyPart(sk40x1)).
            Return sk40k.
        When CAppendToSeq (sk41x0, sk41x1):
            Let mutable sk41k be "CAppendToSeq".
            Set sk41k to keyJoin(sk41k, sk41x0).
            Set sk41k to keyJoin(sk41k, exprToKeyPart(sk41x1)).
            Return sk41k.
        When CResolve (sk42x0):
            Let mutable sk42k be "CResolve".
            Set sk42k to keyJoin(sk42k, sk42x0).
            Return sk42k.
        When CResolveTo (sk43x0, sk43x1):
            Let mutable sk43k be "CResolveTo".
            Set sk43k to keyJoin(sk43k, sk43x0).
            Set sk43k to keyJoin(sk43k, exprToKeyPart(sk43x1)).
            Return sk43k.
        When CSync (sk44x0, sk44x1):
            Let mutable sk44k be "CSync".
            Set sk44k to keyJoin(sk44k, sk44x0).
            Set sk44k to keyJoin(sk44k, exprToKeyPart(sk44x1)).
            Return sk44k.
        When CMount (sk45x0, sk45x1):
            Let mutable sk45k be "CMount".
            Set sk45k to keyJoin(sk45k, sk45x0).
            Set sk45k to keyJoin(sk45k, exprToKeyPart(sk45x1)).
            Return sk45k.
        When CConcurrent (sk46x0):
            Let mutable sk46k be "CConcurrent".
            Set sk46k to keyJoin(sk46k, blocksToKeyPart(sk46x0)).
            Return sk46k.
        When CParallel (sk47x0):
            Let mutable sk47k be "CParallel".
            Set sk47k to keyJoin(sk47k, blocksToKeyPart(sk47x0)).
            Return sk47k.
        When CLaunchTask (sk48x0, sk48x1):
            Let mutable sk48k be "CLaunchTask".
            Set sk48k to keyJoin(sk48k, stmtsToKeyPart(sk48x0)).
            Set sk48k to keyJoin(sk48k, sk48x1).
            Return sk48k.
        When CStopTask (sk49x0):
            Let mutable sk49k be "CStopTask".
            Set sk49k to keyJoin(sk49k, exprToKeyPart(sk49x0)).
            Return sk49k.
        When CSelect (sk50x0):
            Let mutable sk50k be "CSelect".
            Set sk50k to keyJoin(sk50k, branchesToKeyPart(sk50x0)).
            Return sk50k.
        When CCreatePipe (sk51x0, sk51x1):
            Let mutable sk51k be "CCreatePipe".
            Set sk51k to keyJoin(sk51k, sk51x0).
            Set sk51k to keyJoin(sk51k, exprToKeyPart(sk51x1)).
            Return sk51k.
        When CSendPipe (sk52x0, sk52x1):
            Let mutable sk52k be "CSendPipe".
            Set sk52k to keyJoin(sk52k, sk52x0).
            Set sk52k to keyJoin(sk52k, exprToKeyPart(sk52x1)).
            Return sk52k.
        When CReceivePipe (sk53x0, sk53x1):
            Let mutable sk53k be "CReceivePipe".
            Set sk53k to keyJoin(sk53k, sk53x0).
            Set sk53k to keyJoin(sk53k, sk53x1).
            Return sk53k.
        When CTrySendPipe (sk54x0, sk54x1):
            Let mutable sk54k be "CTrySendPipe".
            Set sk54k to keyJoin(sk54k, sk54x0).
            Set sk54k to keyJoin(sk54k, exprToKeyPart(sk54x1)).
            Return sk54k.
        When CTryReceivePipe (sk55x0, sk55x1):
            Let mutable sk55k be "CTryReceivePipe".
            Set sk55k to keyJoin(sk55k, sk55x0).
            Set sk55k to keyJoin(sk55k, sk55x1).
            Return sk55k.
        When CSpawn (sk56x0, sk56x1):
            Let mutable sk56k be "CSpawn".
            Set sk56k to keyJoin(sk56k, sk56x0).
            Set sk56k to keyJoin(sk56k, sk56x1).
            Return sk56k.
        When CSendMessage (sk57x0, sk57x1):
            Let mutable sk57k be "CSendMessage".
            Set sk57k to keyJoin(sk57k, exprToKeyPart(sk57x0)).
            Set sk57k to keyJoin(sk57k, exprToKeyPart(sk57x1)).
            Return sk57k.
        When CStreamMessage (sk58x0, sk58x1):
            Let mutable sk58k be "CStreamMessage".
            Set sk58k to keyJoin(sk58k, exprToKeyPart(sk58x0)).
            Set sk58k to keyJoin(sk58k, exprToKeyPart(sk58x1)).
            Return sk58k.
        When CAwaitMessage (sk59x0):
            Let mutable sk59k be "CAwaitMessage".
            Set sk59k to keyJoin(sk59k, sk59x0).
            Return sk59k.
        When CListen (sk60x0, sk60x1):
            Let mutable sk60k be "CListen".
            Set sk60k to keyJoin(sk60k, exprToKeyPart(sk60x0)).
            Set sk60k to keyJoin(sk60k, sk60x1).
            Return sk60k.
        When CConnectTo (sk61x0, sk61x1):
            Let mutable sk61k be "CConnectTo".
            Set sk61k to keyJoin(sk61k, exprToKeyPart(sk61x0)).
            Set sk61k to keyJoin(sk61k, sk61x1).
            Return sk61k.
        When CZone (sk62x0, sk62x1, sk62x2):
            Let mutable sk62k be "CZone".
            Set sk62k to keyJoin(sk62k, sk62x0).
            Set sk62k to keyJoin(sk62k, sk62x1).
            Set sk62k to keyJoin(sk62k, stmtsToKeyPart(sk62x2)).
            Return sk62k.

## To exprsToKeyPart (xeItems: Seq of CExpr) -> Text:
    Let mutable xeKey be "n{length of xeItems}".
    Repeat for xeItem in xeItems:
        Set xeKey to keyJoin(xeKey, exprToKeyPart(xeItem)).
    Return xeKey.

## To stmtsToKeyPart (xsItems: Seq of CStmt) -> Text:
    Let mutable xsKey be "n{length of xsItems}".
    Repeat for xsItem in xsItems:
        Set xsKey to keyJoin(xsKey, stmtToKeyPart(xsItem)).
    Return xsKey.

## To blocksToKeyPart (xbItems: Seq of Seq of CStmt) -> Text:
    Let mutable xbKey be "n{length of xbItems}".
    Repeat for xbItem in xbItems:
        Set xbKey to keyJoin(xbKey, stmtsToKeyPart(xbItem)).
    Return xbKey.

## To armsToKeyPart (xaItems: Seq of CMatchArm) -> Text:
    Let mutable xaKey be "n{length of xaItems}".
    Repeat for xaItem in xaItems:
        Set xaKey to keyJoin(xaKey, armToKeyPart(xaItem)).
    Return xaKey.

## To branchesToKeyPart (xrItems: Seq of CSelectBranch) -> Text:
    Let mutable xrKey be "n{length of xrItems}".
    Repeat for xrItem in xrItems:
        Set xrKey to keyJoin(xrKey, branchToKeyPart(xrItem)).
    Return xrKey.

## To alternativesToKeyPart (xpItems: Seq of CPolicyAlt) -> Text:
    Let mutable xpKey be "n{length of xpItems}".
    Repeat for xpItem in xpItems:
        Set xpKey to keyJoin(xpKey, alternativeToKeyPart(xpItem)).
    Return xpKey.

## To stringPartsToKeyPart (xqItems: Seq of CStringPart) -> Text:
    Let mutable xqKey be "n{length of xqItems}".
    Repeat for xqItem in xqItems:
        Set xqKey to keyJoin(xqKey, stringPartToKeyPart(xqItem)).
    Return xqKey.

## To textsToKeyPart (xtItems: Seq of Text) -> Text:
    Let mutable xtKey be "n{length of xtItems}".
    Repeat for xtItem in xtItems:
        Set xtKey to keyJoin(xtKey, xtItem).
    Return xtKey.

## To armToKeyPart (maV: CMatchArm) -> Text:
    Inspect maV:
        When CWhen (ma0x0, ma0x1, ma0x2):
            Let mutable ma0k be "CWhen".
            Set ma0k to keyJoin(ma0k, ma0x0).
            Set ma0k to keyJoin(ma0k, textsToKeyPart(ma0x1)).
            Set ma0k to keyJoin(ma0k, stmtsToKeyPart(ma0x2)).
            Return ma0k.
        When COtherwise (ma1x0):
            Let mutable ma1k be "COtherwise".
            Set ma1k to keyJoin(ma1k, stmtsToKeyPart(ma1x0)).
            Return ma1k.

## To branchToKeyPart (sbV: CSelectBranch) -> Text:
    Inspect sbV:
        When CSelectRecv (sb0x0, sb0x1, sb0x2):
            Let mutable sb0k be "CSelectRecv".
            Set sb0k to keyJoin(sb0k, sb0x0).
            Set sb0k to keyJoin(sb0k, sb0x1).
            Set sb0k to keyJoin(sb0k, stmtsToKeyPart(sb0x2)).
            Return sb0k.
        When CSelectTimeout (sb1x0, sb1x1):
            Let mutable sb1k be "CSelectTimeout".
            Set sb1k to keyJoin(sb1k, exprToKeyPart(sb1x0)).
            Set sb1k to keyJoin(sb1k, stmtsToKeyPart(sb1x1)).
            Return sb1k.

## To alternativeToKeyPart (paV: CPolicyAlt) -> Text:
    Inspect paV:
        When CPolicyCase (pa0x0, pa0x1):
            Let mutable pa0k be "CPolicyCase".
            Set pa0k to keyJoin(pa0k, pa0x0).
            Set pa0k to keyJoin(pa0k, policyToKeyPart(pa0x1)).
            Return pa0k.

## To stringPartToKeyPart (spV: CStringPart) -> Text:
    Inspect spV:
        When CLiteralPart (sp0x0):
            Let mutable sp0k be "CLiteralPart".
            Set sp0k to keyJoin(sp0k, sp0x0).
            Return sp0k.
        When CExprPart (sp1x0):
            Let mutable sp1k be "CExprPart".
            Set sp1k to keyJoin(sp1k, exprToKeyPart(sp1x0)).
            Return sp1k.
        When CFormattedPart (sp2x0, sp2x1, sp2x2, sp2x3):
            Let mutable sp2k be "CFormattedPart".
            Set sp2k to keyJoin(sp2k, exprToKeyPart(sp2x0)).
            Set sp2k to keyJoin(sp2k, sp2x1).
            Set sp2k to keyJoin(sp2k, sp2x2).
            Set sp2k to keyJoin(sp2k, "{sp2x3}").
            Return sp2k.

## To policyToKeyPart (poV: CPolicy) -> Text:
    Inspect poV:
        When PFieldEquals (po0x0, po0x1, po0x2, po0x3, po0x4, po0x5, po0x6):
            Let mutable po0k be "PFieldEquals".
            Set po0k to keyJoin(po0k, po0x0).
            Set po0k to keyJoin(po0k, po0x1).
            Set po0k to keyJoin(po0k, "{po0x2}").
            Set po0k to keyJoin(po0k, "{po0x3}").
            Set po0k to keyJoin(po0k, "{po0x4}").
            Set po0k to keyJoin(po0k, "{po0x5}").
            Set po0k to keyJoin(po0k, "{po0x6}").
            Return po0k.
        When PFieldBool (po1x0, po1x1):
            Let mutable po1k be "PFieldBool".
            Set po1k to keyJoin(po1k, po1x0).
            Set po1k to keyJoin(po1k, "{po1x1}").
            Return po1k.
        When PFieldsEqual (po2x0, po2x1):
            Let mutable po2k be "PFieldsEqual".
            Set po2k to keyJoin(po2k, po2x0).
            Set po2k to keyJoin(po2k, po2x1).
            Return po2k.
        When PAnd (po3x0, po3x1):
            Let mutable po3k be "PAnd".
            Set po3k to keyJoin(po3k, policyToKeyPart(po3x0)).
            Set po3k to keyJoin(po3k, policyToKeyPart(po3x1)).
            Return po3k.
        When POr (po4x0, po4x1):
            Let mutable po4k be "POr".
            Set po4k to keyJoin(po4k, policyToKeyPart(po4x0)).
            Set po4k to keyJoin(po4k, policyToKeyPart(po4x1)).
            Return po4k.
        When PFalse:
            Let mutable po5k be "PFalse".
            Return po5k.
        When PRecursive (po6x0):
            Let mutable po6k be "PRecursive".
            Set po6k to keyJoin(po6k, po6x0).
            Return po6k.

## To makeKey (fnName: Text) and (args: Seq of CExpr) -> Text:
    Let key be fnName.
    Repeat for a in args:
        Let part be exprToKeyPart(a).
        Set key to keyJoin(key, part).
    Return key.

## To peSameStaticConfig (scPrev: Seq of CExpr) and (scNext: Seq of CExpr) -> Bool:
    If not ((length of scPrev) equals (length of scNext)):
        Return false.
    Let mutable scI be 1.
    Repeat for scA in scPrev:
        Let scB be item scI of scNext.
        If not peHoldsResidualLeaf(scA) and not peHoldsResidualLeaf(scB):
            If not peSameExpr(scA, scB):
                Return false.
        Set scI to scI + 1.
    Return true.

## To argsStrictlyEmbedDeep (sdPrev: Seq of CExpr) and (sdNext: Seq of CExpr) -> Bool:
    If not ((length of sdPrev) equals (length of sdNext)):
        Return false.
    Let mutable sdAll be true.
    Let mutable sdStrict be false.
    Let mutable sdI be 1.
    Repeat for sdA in sdPrev:
        Let sdB be item sdI of sdNext.
        If not exprEmbedsDeep(sdA, sdB):
            Set sdAll to false.
        If not exprEmbedsDeep(sdB, sdA):
            Set sdStrict to true.
        Set sdI to sdI + 1.
    Return sdAll and sdStrict.

## To exprEmbedsDeepAll (daPrev: Seq of CExpr) and (daNext: Seq of CExpr) -> Bool:
    If not ((length of daPrev) equals (length of daNext)):
        Return false.
    Let mutable daI be 1.
    Repeat for daA in daPrev:
        If not exprEmbedsDeep(daA, item daI of daNext):
            Return false.
        Set daI to daI + 1.
    Return true.

## To exprEmbedsDeep (dpPrev: CExpr) and (dpNext: CExpr) -> Bool:
    Inspect dpPrev:
        When CNewVariant (dpTag, dpNs, dpVs):
            Inspect dpNext:
                When CNewVariant (dpTag2, dpNs2, dpVs2):
                    If (dpTag equals dpTag2) and peSameNames(dpNs, dpNs2):
                        Return exprEmbedsDeepAll(dpVs, dpVs2).
                    Return false.
                Otherwise:
                    Return false.
        When CNew (dpTy, dpFns, dpFvs):
            Inspect dpNext:
                When CNew (dpTy2, dpFns2, dpFvs2):
                    If (dpTy equals dpTy2) and peSameNames(dpFns, dpFns2):
                        Return exprEmbedsDeepAll(dpFvs, dpFvs2).
                    Return false.
                Otherwise:
                    Return false.
        When CTuple (dpTi):
            Inspect dpNext:
                When CTuple (dpTi2):
                    Return exprEmbedsDeepAll(dpTi, dpTi2).
                Otherwise:
                    Return false.
        When COptionSome (dpOi):
            Inspect dpNext:
                When COptionSome (dpOi2):
                    Return exprEmbedsDeep(dpOi, dpOi2).
                Otherwise:
                    Return false.
        When CCall (dpFn, dpArgs):
            Inspect dpNext:
                When CCall (dpFn2, dpArgs2):
                    If dpFn equals dpFn2:
                        Return exprEmbedsDeepAll(dpArgs, dpArgs2).
                    Return false.
                Otherwise:
                    Return false.
        Otherwise:
            Return exprEmbeds(dpPrev, dpNext).

## To exprEmbeds (prevExpr: CExpr) and (nextExpr: CExpr) -> Bool:
    Inspect prevExpr:
        When CInt (a):
            Inspect nextExpr:
                When CInt (b):
                    Let mutable absA be a.
                    If a is less than 0:
                        Set absA to 0 - a.
                    Let mutable absB be b.
                    If b is less than 0:
                        Set absB to 0 - b.
                    Return (absA is at most absB).
                Otherwise:
                    Return false.
        When CBool (a):
            Inspect nextExpr:
                When CBool (b):
                    Return true.
                Otherwise:
                    Return false.
        When CText (a):
            Inspect nextExpr:
                When CText (b):
                    Return (length of a is at most length of b).
                Otherwise:
                    Return false.
        When CFloat (a):
            Inspect nextExpr:
                When CFloat (b):
                    Return true.
                Otherwise:
                    Return false.
        When CVar (a):
            Inspect nextExpr:
                When CVar (b):
                    Return true.
                Otherwise:
                    Return false.
        When CBinOp (op1, l1, r1):
            Inspect nextExpr:
                When CBinOp (op2, l2, r2):
                    If op1 equals op2:
                        Return (exprEmbeds(l1, l2) and exprEmbeds(r1, r2)).
                    Return false.
                Otherwise:
                    Return false.
        When CCall (fn1, args1):
            Inspect nextExpr:
                When CCall (fn2, args2):
                    If fn1 equals fn2:
                        Let len1 be length of args1.
                        Let len2 be length of args2.
                        If len1 equals len2:
                            Let mutable allEmbed be true.
                            Let mutable eidx be 1.
                            Repeat for a1 in args1:
                                If eidx is at most len2:
                                    Let a2 be item eidx of args2.
                                    If not exprEmbeds(a1, a2):
                                        Set allEmbed to false.
                                Set eidx to eidx + 1.
                            Return allEmbed.
                    Return false.
                Otherwise:
                    Return false.
        When CList (items1):
            Inspect nextExpr:
                When CList (items2):
                    Let li1 be length of items1.
                    Let li2 be length of items2.
                    If li1 is at most li2:
                        Return true.
                    Return false.
                Otherwise:
                    Return false.
        Otherwise:
            Return false.

## To argsStrictlyEmbed (prevExpr: Seq of CExpr) and (nextExpr: Seq of CExpr) -> Bool:
    Let lenE be length of prevExpr.
    Let lenL be length of nextExpr.
    If not (lenE equals lenL):
        Return false.
    Let mutable allEmbed be true.
    Let mutable someStrict be false.
    Let mutable aidx be 1.
    Repeat for ea in prevExpr:
        If aidx is at most lenL:
            Let la be item aidx of nextExpr.
            If not exprEmbeds(ea, la):
                Set allEmbed to false.
            If not exprEmbeds(la, ea):
                Set someStrict to true.
        Set aidx to aidx + 1.
    Return (allEmbed and someStrict).

## To makeCycleKey (fnName: Text) and (args: Seq of CExpr) -> Text:
    Let key be fnName.
    Repeat for a in args:
        If isStatic(a):
            Let part be exprToKeyPart(a).
            Set key to keyJoin(key, part).
        Otherwise:
            Set key to keyJoin(key, "d").
    Return key.

## To substExpr (e: CExpr) and (name: Text) and (repl: CExpr) -> CExpr:
    Inspect e:
        When CVar (vn):
            If vn equals name:
                Return copy of repl.
            Return e.
        When CBinOp (op, l, r):
            Let nl be substExpr(l, name, repl).
            Let nr be substExpr(r, name, repl).
            Return a new CBinOp with op op and left nl and right nr.
        When CNot (inner):
            Let ni be substExpr(inner, name, repl).
            Return a new CNot with inner ni.
        When CCall (cfn, args):
            Let nargs be a new Seq of CExpr.
            Repeat for a in args:
                Push substExpr(a, name, repl) to nargs.
            Return a new CCall with name cfn and args nargs.
        When CCallExpr (tgt, ceargs):
            Let nt be substExpr(tgt, name, repl).
            Let nca be a new Seq of CExpr.
            Repeat for a in ceargs:
                Push substExpr(a, name, repl) to nca.
            Return a new CCallExpr with target nt and args nca.
        When CIndex (coll, idx):
            Let nc be substExpr(coll, name, repl).
            Let nidx be substExpr(idx, name, repl).
            Return a new CIndex with coll nc and idx nidx.
        When CMapGet (t, k):
            Let nt2 be substExpr(t, name, repl).
            Let nk be substExpr(k, name, repl).
            Return a new CMapGet with target nt2 and key nk.
        When CLen (t):
            Let nt3 be substExpr(t, name, repl).
            Return a new CLen with target nt3.
        When CContains (coll, elem):
            Let nco be substExpr(coll, name, repl).
            Let nel be substExpr(elem, name, repl).
            Return a new CContains with coll nco and elem nel.
        When CList (items):
            Let nitems be a new Seq of CExpr.
            Repeat for it in items:
                Push substExpr(it, name, repl) to nitems.
            Return a new CList with items nitems.
        When CTuple (titems):
            Let ntitems be a new Seq of CExpr.
            Repeat for it in titems:
                Push substExpr(it, name, repl) to ntitems.
            Return a new CTuple with items ntitems.
        When CNewVariant (nvTag, nvNames, nvVals):
            Let nnv be a new Seq of CExpr.
            Repeat for v in nvVals:
                Push substExpr(v, name, repl) to nnv.
            Return a new CNewVariant with tag nvTag and fnames nvNames and fvals nnv.
        When CNew (cnTy, cnNames, cnFields):
            Let ncn be a new Seq of CExpr.
            Repeat for v in cnFields:
                Push substExpr(v, name, repl) to ncn.
            Return a new CNew with typeName cnTy and fieldNames cnNames and fields ncn.
        When CRange (rs, re):
            Let nrs be substExpr(rs, name, repl).
            Let nre be substExpr(re, name, repl).
            Return a new CRange with start nrs and end nre.
        When CSlice (sc, ss, se2):
            Let nsc be substExpr(sc, name, repl).
            Let nss be substExpr(ss, name, repl).
            Let nse be substExpr(se2, name, repl).
            Return a new CSlice with coll nsc and startIdx nss and endIdx nse.
        When CCopy (ct):
            Let nct be substExpr(ct, name, repl).
            Return a new CCopy with target nct.
        When CUnion (ul, ur):
            Let nul be substExpr(ul, name, repl).
            Let nur be substExpr(ur, name, repl).
            Return a new CUnion with left nul and right nur.
        When CIntersection (il, ir):
            Let nil be substExpr(il, name, repl).
            Let nir be substExpr(ir, name, repl).
            Return a new CIntersection with left nil and right nir.
        When COptionSome (osinner):
            Let nos be substExpr(osinner, name, repl).
            Return a new COptionSome with inner nos.
        When CFieldAccess (fatarget, fafield):
            Let nfa be substExpr(fatarget, name, repl).
            Return a new CFieldAccess with target nfa and field fafield.
        When CInterpolatedString (isParts):
            Let mutable nisParts be a new Seq of CStringPart.
            Repeat for isPart in isParts:
                Inspect isPart:
                    When CExprPart (isPe):
                        Push (a new CExprPart with expr substExpr(isPe, name, repl)) to nisParts.
                    When CFormattedPart (isFe, isFs, isFf, isFz):
                        Push (a new CFormattedPart with expr substExpr(isFe, name, repl) and spec isFs and form isFf and size isFz) to nisParts.
                    Otherwise:
                        Push isPart to nisParts.
            Return a new CInterpolatedString with parts nisParts.
        Otherwise:
            Return e.

## To applyPosFacts (cond: CExpr) and (se: mutable Map of Text to CExpr) -> Bool:
    Inspect cond:
        When CBinOp (cop, cleft, cright):
            If cop equals "&&":
                Let posL be applyPosFacts(cleft, se).
                Let posR be applyPosFacts(cright, se).
                Return true.
            If cop equals "==":
                Inspect cleft:
                    When CVar (vn):
                        If isLiteral(cright):
                            Let vk be "{vn}".
                            Let crCopy be cright.
                            Set item vk of se to crCopy.
                    Otherwise:
                        Let skpP1 be true.
                Inspect cright:
                    When CVar (vn2):
                        If isLiteral(cleft):
                            Let vk2 be "{vn2}".
                            Let clCopy be cleft.
                            Set item vk2 of se to clCopy.
                    Otherwise:
                        Let skpP2 be true.
                Return true.
            Return true.
        Otherwise:
            Return true.

## To applyNegFacts (cond: CExpr) and (se: mutable Map of Text to CExpr) -> Bool:
    Inspect cond:
        When CBinOp (cop, cleft, cright):
            If cop equals "==":
                Inspect cleft:
                    When CVar (vn):
                        If isLiteral(cright):
                            Let vk be "__neg_{vn}".
                            Let crCopy be cright.
                            Set item vk of se to crCopy.
                    Otherwise:
                        Let skpN1 be true.
                Inspect cright:
                    When CVar (vn2):
                        If isLiteral(cleft):
                            Let vk2 be "__neg_{vn2}".
                            Let clCopy be cleft.
                            Set item vk2 of se to clCopy.
                    Otherwise:
                        Let skpN2 be true.
                Return true.
            Return true.
        Otherwise:
            Return true.

## To clearGuardFacts (cond: CExpr) and (se: mutable Map of Text to CExpr) -> Bool:
    Inspect cond:
        When CBinOp (cop, cleft, cright):
            If cop equals "&&":
                Let cgL be clearGuardFacts(cleft, se).
                Let cgR be clearGuardFacts(cright, se).
                Return true.
            If cop equals "==":
                Inspect cleft:
                    When CVar (vn):
                        Let vk be "{vn}".
                        If se contains vk:
                            Remove vk from se.
                        Let nk be "__neg_{vn}".
                        If se contains nk:
                            Remove nk from se.
                    Otherwise:
                        Let skpC1 be true.
                Inspect cright:
                    When CVar (vn2):
                        Let vk2 be "{vn2}".
                        If se contains vk2:
                            Remove vk2 from se.
                        Let nk2 be "__neg_{vn2}".
                        If se contains nk2:
                            Remove nk2 from se.
                    Otherwise:
                        Let skpC2 be true.
                Return true.
            Return true.
        Otherwise:
            Return true.

## To checkNegEq (varExpr: CExpr) and (litExpr: CExpr) and (state: PEState) -> Bool:
    Inspect varExpr:
        When CVar (vn):
            If isLiteral(litExpr):
                Let se be peStaticEnv(state).
                Let nk be "__neg_{vn}".
                If se contains nk:
                    Let excluded be item nk of se.
                    Let ek1 be exprToKeyPart(excluded).
                    Let ek2 be exprToKeyPart(litExpr).
                    Let ek1s be "{ek1}".
                    Let ek2s be "{ek2}".
                    If ek1s equals ek2s:
                        Return true.
            Return false.
        Otherwise:
            Return false.

## To hoistSave (sr: mutable Map of Text to CExpr) -> CExpr:
    Let hsK be "__pe_hoist".
    Let mutable hsSaved be a new CVar with name "__pe_no_hoist".
    If sr contains hsK:
        Set hsSaved to item hsK of sr.
    Let hsK2 be "__pe_hoist".
    Let hsP be a new Seq of Text.
    Let hsB be a new Seq of CStmt.
    Let hsC be a new Seq of Text.
    Let hsK2Val be a new CClosure with params hsP and body hsB and captured hsC.
    peSeBind(sr, hsK2, hsK2Val).
    Return hsSaved.

## To hoistSuspend (sr: mutable Map of Text to CExpr) -> CExpr:
    Let hpK be "__pe_hoist".
    Let mutable hpSaved be a new CVar with name "__pe_no_hoist".
    If sr contains hpK:
        Set hpSaved to item hpK of sr.
        Let hpK2 be "__pe_hoist".
        peSeDrop(sr, hpK2).
    Return hpSaved.

## To hoistRestore (sr: mutable Map of Text to CExpr) and (saved: CExpr):
    Let hrK be "__pe_hoist".
    Inspect saved:
        When CVar (hrName):
            If sr contains hrK:
                Let hrK2 be "__pe_hoist".
                peSeDrop(sr, hrK2).
        Otherwise:
            Let hrK3 be "__pe_hoist".
            peSeBind(sr, hrK3, saved).

## To hoistActive (sr: Map of Text to CExpr) -> Bool:
    Let haK be "__pe_hoist".
    Return sr contains haK.

## To hoistPending (sr: Map of Text to CExpr) -> Seq of CStmt:
    Let hnOut be a new Seq of CStmt.
    Let hnK be "__pe_hoist".
    If sr contains hnK:
        Let hnC be item hnK of sr.
        Inspect hnC:
            When CClosure (hnP, hnB, hnCap):
                Repeat for hnS in hnB:
                    Push hnS to hnOut.
            Otherwise:
                Let hnSkip be true.
    Return hnOut.

## To hoistAppend (sr: mutable Map of Text to CExpr) and (stmts: Seq of CStmt):
    Let hxPrior be hoistPending(sr).
    Let hxJoined be a new Seq of CStmt.
    Repeat for hxP in hxPrior:
        Push hxP to hxJoined.
    Repeat for hxN in stmts:
        Push hxN to hxJoined.
    Let hxK be "__pe_hoist".
    Let hxPs be a new Seq of Text.
    Let hxCs be a new Seq of Text.
    Let hxKVal be a new CClosure with params hxPs and body hxJoined and captured hxCs.
    peSeBind(sr, hxK, hxKVal).

## To hoistClose (sr: mutable Map of Text to CExpr) and (saved: CExpr) and (block: Seq of CStmt) and (mark: Int) -> Seq of CStmt:
    Let hcPending be hoistPending(sr).
    hoistRestore(sr, saved).
    If length of hcPending equals 0:
        Return block.
    Let hcOut be a new Seq of CStmt.
    Let mutable hcI be 1.
    Repeat for hcB in block:
        If hcI is at most mark:
            Push hcB to hcOut.
        Set hcI to hcI + 1.
    Repeat for hcP in hcPending:
        Push hcP to hcOut.
    Set hcI to 1.
    Repeat for hcB2 in block:
        If hcI is greater than mark:
            Push hcB2 to hcOut.
        Set hcI to hcI + 1.
    Return hcOut.

## To freshName (sr: mutable Map of Text to CExpr) and (base: Text) -> Text:
    Let fnK be "__pe_fresh".
    Let mutable fnN be 1.
    If sr contains fnK:
        Let fnV be item fnK of sr.
        Inspect fnV:
            When CInt (fnPrev):
                Set fnN to fnPrev + 1.
            Otherwise:
                Let fnSkip be true.
    Let fnK2 be "__pe_fresh".
    Let fnK2Val be a new CInt with value fnN.
    peSeBind(sr, fnK2, fnK2Val).
    Return "{base}__{fnN}".

## To peWithout (pwColl: CExpr) and (pwElem: CExpr) -> CExpr:
    Let mutable pwKey be "".
    Let mutable pwKnown be false.
    Inspect pwColl:
        When CNew (pwTag, pwNames, pwVals):
            If peIsSetType(pwTag):
                If isStatic(pwElem):
                    Set pwKey to exprToKeyPart(pwElem).
                    Set pwKnown to true.
            If peIsMapType(pwTag):
                Inspect pwElem:
                    When CText (pwText):
                        Set pwKey to pwText.
                        Set pwKnown to true.
                    Otherwise:
                        Let pwSkip be true.
            If pwKnown:
                Let pwKeptNames be a new Seq of Text.
                Let pwKeptVals be a new Seq of CExpr.
                Let mutable pwAt be 1.
                Repeat for pwName in pwNames:
                    If pwName is not pwKey:
                        Push pwName to pwKeptNames.
                        Push item pwAt of pwVals to pwKeptVals.
                    Set pwAt to pwAt + 1.
                Return a new CNew with typeName pwTag and fieldNames pwKeptNames and fields pwKeptVals.
        When CNewVariant (pwvTag, pwvNames, pwvVals):
            If peIsMapType(pwvTag):
                Inspect pwElem:
                    When CText (pwvText):
                        Let pwvKeptNames be a new Seq of Text.
                        Let pwvKeptVals be a new Seq of CExpr.
                        Let mutable pwvAt be 1.
                        Repeat for pwvName in pwvNames:
                            If pwvName is not pwvText:
                                Push pwvName to pwvKeptNames.
                                Push item pwvAt of pwvVals to pwvKeptVals.
                            Set pwvAt to pwvAt + 1.
                        Return a new CNewVariant with tag pwvTag and fnames pwvKeptNames and fvals pwvKeptVals.
                    Otherwise:
                        Let pwvSkip be true.
        Otherwise:
            Let pwOther be true.
    Return a new CVar with name "__pe_no_unfold".

## To peCharCount (pcText: Text) -> Int:
    Let mutable pcCount be 0.
    Repeat for pcCh in pcText:
        Set pcCount to pcCount + 1.
    Return pcCount.

## To peSpaces (psCount: Int) -> Text:
    Let mutable psOut be "".
    Let mutable psAt be 0.
    While psAt is less than psCount:
        Set psOut to "{psOut} ".
        Set psAt to psAt + 1.
    Return psOut.

## To peFormattedText (ftText: Text) and (ftForm: Text) and (ftSize: Int) -> Text:
    If ftForm equals "$":
        Return "${ftText}".
    If ftForm equals ".":
        Return ftText.
    Let ftGap be ftSize - peCharCount(ftText).
    If ftGap is at most 0:
        Return ftText.
    If ftForm equals "<":
        Return "{ftText}{peSpaces(ftGap)}".
    If ftForm equals "^":
        Let ftLeft be ftGap / 2.
        Return "{peSpaces(ftLeft)}{ftText}{peSpaces(ftGap - ftLeft)}".
    Return "{peSpaces(ftGap)}{ftText}".

# The specializer's precisions: generated by optimize::core_formats from semantics::format.
## To pePrecision (ppExpr: CExpr) and (ppDigits: Int) -> CExpr:
    Inspect ppExpr:
        When CInt (ppInt):
            If ppDigits equals 0:
                Return a new CText with value "{ppInt:.0}".
            If ppDigits equals 1:
                Return a new CText with value "{ppInt:.1}".
            If ppDigits equals 2:
                Return a new CText with value "{ppInt:.2}".
            If ppDigits equals 3:
                Return a new CText with value "{ppInt:.3}".
            If ppDigits equals 4:
                Return a new CText with value "{ppInt:.4}".
            If ppDigits equals 5:
                Return a new CText with value "{ppInt:.5}".
