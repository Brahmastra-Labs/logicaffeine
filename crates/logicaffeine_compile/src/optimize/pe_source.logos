                            Let rpCk4 be "{rpC}".
                            Set item rpCk3 of rpEntry to item rpCk4 of (peStaticEnv(state)).
                        Let mutable rpPre be a new Seq of CStmt.
                        Repeat for rpD in rpDyn:
                            Let rpDk be "{rpD}".
                            If (peStaticEnv(state)) contains rpDk:
                                Let rpDk2 be "{rpD}".
                                Let rpDv be item rpDk2 of (peStaticEnv(state)).
                                Let rpDk3 be "{rpD}".
                                peDeclareDynamic(rpDk3, rpDv, state, rpPre).
                        Let mutable rpLeaves be a new Seq of Text.
                        Let rpHead be a new CRepeat with var repVar and coll peColl and body (a new Seq of CStmt).
                        Let rpLoop be peLoopShapes(rpHead, rpResVar, repBody, rpCands, rpDyn, rpShapes, rpLeaves, state).
                        Inspect rpLoop:
                            When CRepeat (rpLv, rpLc, rpLb):
                                Let mutable rpInits be a new Map of Text to CExpr.
                                Repeat for rpIc in rpCands:
                                    Let rpIk be "{rpIc}".
                                    Let rpIk2 be "{rpIc}".
                                    Let rpIok be peMatchLeaves(item rpIk of rpShapes, item rpIk2 of rpEntry, rpLeaves, rpInits, state).
                                Repeat for rpPs in rpPre:
                                    Push rpPs to blockResult.
                                Repeat for rpL in rpLeaves:
                                    Let rpLk be "{rpL}".
                                    If rpInits contains rpLk:
                                        Let rpLk2 be "{rpL}".
                                        Let rpLk3 be "{rpL}".
                                        Push (a new CLet with name rpLk2 and expr (item rpLk3 of rpInits)) to blockResult.
                                Push rpLoop to blockResult.
                                Set rpDone to true.
                            Otherwise:
                                Let rpSkip be true.
                    If not rpDone and peIsBox(peColl):
                        Repeat for rbm in repModVars:
                            Let rbmK be "{rbm}".
                            If (peStaticEnv(state)) contains rbmK:
                                Let rbmK2 be "{rbm}".
                                Let rbmPrev be item rbmK2 of (peStaticEnv(state)).
                                Let rbmK3 be "{rbm}".
                                peDeclareDynamic(rbmK3, rbmPrev, state, blockResult).
                                Let rbmK4 be "{rbm}".
                                peStSeDrop(state, rbmK4).
                                Let rbmK5 be "{rbm}".
                                peStEnvDynamic(state, rbmK5).
                        peBindLoopVar(state, repVar, peColl, rpResVar).
                        Let rbBody be peBlock(repBody, state).
                        peMakeDynamic(state, repModVars).
                        If (peStaticEnv(state)) contains repVar:
                            peStSeDrop(state, repVar).
                        Push (a new CRepeat with var rpResVar and coll (peLoopColl(peColl)) and body rbBody) to blockResult.
                        Set rpDone to true.
                    If not rpDone:
                        Repeat for rmv in repModVars:
                            Let rmvK1 be "{rmv}".
                            If (peStaticEnv(state)) contains rmvK1:
                                Let rmvK2 be "{rmv}".
                                Let rmvPrev be item rmvK2 of (peStaticEnv(state)).
                                Let rmvK3 be "{rmv}".
                                peDeclareDynamic(rmvK3, rmvPrev, state, blockResult).
                                Let rmvK4 be "{rmv}".
                                peStSeDrop(state, rmvK4).
                                Let rmvK5 be "{rmv}".
                                peStEnvDynamic(state, rmvK5).
                        If (peStaticEnv(state)) contains repVar:
                            peStSeDrop(state, repVar).
                        Let repVarEnvKey be "{repVar}".
                        peStEnvDynamic(state, repVarEnvKey).
                        Let peBody be peBlock(repBody, state).
                        Repeat for rmv2 in repModVars:
                            Let rmv2K be "{rmv2}".
                            If (peStaticEnv(state)) contains rmv2K:
                                peStSeDrop(state, rmv2K).
                        If (peStaticEnv(state)) contains repVar:
                            peStSeDrop(state, repVar).
                        Push (a new CRepeat with var repVar and coll peColl and body peBody) to blockResult.
            When CRepeatRange (rrVar, rrStart, rrEnd, rrBody):
                Let peStart be peExpr(rrStart, state).
                Let peEnd be peExpr(rrEnd, state).
                Let startStatic be isStatic(peStart).
                Let endStatic be isStatic(peEnd).
                Let mutable didUnrollRR be false.
                If startStatic and endStatic:
                    Inspect peStart:
                        When CInt (startVal):
                            Inspect peEnd:
                                When CInt (endVal):
                                    Let rangeSize be endVal - startVal.
                                    If rangeSize is less than 64:
                                        Let rrEnvSnap be peEnvShallow((peEnv(state))).
                                        Let rrSeSnap be peSeShallow((peStaticEnv(state))).
                                        Let rrMark be length of blockResult.
                                        Let mutable rrValid be true.
                                        Let mutable ri be startVal.
                                        Let mutable stopUnrollRR be false.
                                        While ri is at most endVal:
                                            If rrValid and not stopUnrollRR:
                                                Let rrKey be "{rrVar}".
                                                peStEnvBind(state, rrKey, (a new VInt with value ri)).
                                                Let rrValExpr be a new CInt with value ri.
                                                Let rrKey2 be "{rrVar}".
                                                peStSeBind(state, rrKey2, rrValExpr).
                                                Let unrolledBody be specializeStmts(rrBody, state).
                                                If loopExitOf(unrolledBody) equals "nested":
                                                    Set rrValid to false.
                                                Otherwise:
                                                    Repeat for us in unrolledBody:
                                                        If not stopUnrollRR:
                                                            Inspect us:
                                                                When CBreak:
                                                                    Set stopUnrollRR to true.
                                                                When CReturn (rrRetX):
                                                                    Push us to blockResult.
                                                                    Set stopUnrollRR to true.
                                                                When CFail (rrFailX):
                                                                    Push us to blockResult.
                                                                    Set stopUnrollRR to true.
                                                                Otherwise:
                                                                    Push us to blockResult.
                                            Set ri to ri + 1.
                                        If rrValid:
                                            Set didUnrollRR to true.
                                        Otherwise:
                                            peRestoreEnvSt(state, rrEnvSnap).
                                            peRestoreSeSt(state, rrSeSnap).
                                            Set blockResult to truncateStmts(blockResult, rrMark).
                                Otherwise:
                                    Let skip be true.
                        Otherwise:
                            Let skip be true.
                If not didUnrollRR:
                    Let rrModVars be collectSetVars(rrBody, (peFuncs(state))).
                    Repeat for rrmv in rrModVars:
                        Let rrmvK1 be "{rrmv}".
                        If (peStaticEnv(state)) contains rrmvK1:
                            Let rrmvK2 be "{rrmv}".
                            Let rrmvPrev be item rrmvK2 of (peStaticEnv(state)).
                            Let rrmvK3 be "{rrmv}".
                            peDeclareDynamic(rrmvK3, rrmvPrev, state, blockResult).
                            Let rrmvK4 be "{rrmv}".
                            peStSeDrop(state, rrmvK4).
                            Let rrmvK5 be "{rrmv}".
                            peStEnvDynamic(state, rrmvK5).
                    Let peBody be peBlock(rrBody, state).
                    Repeat for rrmv2 in rrModVars:
                        Let rrmv2K be "{rrmv2}".
                        If (peStaticEnv(state)) contains rrmv2K:
                            peStSeDrop(state, rrmv2K).
                    If (peStaticEnv(state)) contains rrVar:
                        peStSeDrop(state, rrVar).
                    Push (a new CRepeatRange with var rrVar and start peStart and end peEnd and body peBody) to blockResult.
            When CBreak:
                Let bkFrame be peFrame(state).
                If not (bkFrame equals ""):
                    Let bkId be freshNameSt(state, "pkvbrk").
                    peRecordBreak(state, bkFrame, bkId).
                    Let bkIdK be "{bkId}".
                    Push (a new CCallS with name bkIdK and args (a new Seq of CExpr)) to blockResult.
                Push a new CBreak to blockResult.
            When CForceDynamic (fdName):
                Let fdk be "{fdName}".
                If (peStaticEnv(state)) contains fdk:
                    Let fdk2 be "{fdName}".
                    Let fdkRead be "{fdName}".
                    Let fdPrev be item fdkRead of (peStaticEnv(state)).
                    peDeclareDynamic(fdName, fdPrev, state, blockResult).
                    peStSeDrop(state, fdk).
                    peStEnvDynamic(state, fdk2).
            When CAdd (addElem, addTarget):
                Let peVal be peExpr(addElem, state).
                Let adk1 be "{addTarget}".
                Let mutable addHandled be false.
                If (peStaticEnv(state)) contains adk1:
                    Let adPrev be item adk1 of (peStaticEnv(state)).
                    Let addSafe be isStatic(peVal) and isCopyPropSafe(peVal).
                    Inspect adPrev:
                        When CNew (adTag, adNames, adVals):
                            If peIsSetType(adTag):
                                If addSafe:
                                    Let elemKey be exprToKeyPart(peVal).
                                    Let elemKeyS be "{elemKey}".
                                    Let mutable existsAd be false.
                                    Repeat for anm in adNames:
                                        If anm equals elemKeyS:
                                            Set existsAd to true.
                                    Let newAdNames be copy of adNames.
                                    Let newAdVals be copy of adVals.
                                    If not existsAd:
                                        Push elemKeyS to newAdNames.
                                        Push peVal to newAdVals.
                                    Let adUpdatedType be "{adTag}".
                                    Let adUpdated be a new CNew with typeName adUpdatedType and fieldNames newAdNames and fields newAdVals.
                                    Let adk6 be "{addTarget}".
                                    peStSeBind(state, adk6, adUpdated).
                                    Set addHandled to true.
                        Otherwise:
                            Let skipAd be true.
                    If not addHandled:
                        Let adk3 be "{addTarget}".
                        peDeclareDynamic(adk3, adPrev, state, blockResult).
                        Let adk4 be "{addTarget}".
                        peStSeDrop(state, adk4).
                        Let adk5 be "{addTarget}".
                        peStEnvDynamic(state, adk5).
                If not addHandled or isResidualVar((peEnv(state)), addTarget):
                    Push (a new CAdd with elem peVal and target addTarget) to blockResult.
            When CRemove (remElem, remTarget):
                Let peVal be peExpr(remElem, state).
                Let rmk1 be "{remTarget}".
                If (peStaticEnv(state)) contains rmk1:
                    Let rmk2 be "{remTarget}".
                    Let rmPrev be item rmk2 of (peStaticEnv(state)).
                    Let rmk3 be "{remTarget}".
                    peDeclareDynamic(rmk3, rmPrev, state, blockResult).
                    Let rmKnown be peWithout(rmPrev, peVal).
                    Inspect rmKnown:
                        When CVar (rmNoName):
                            Let rmk4 be "{remTarget}".
                            peStSeDrop(state, rmk4).
                            Let rmk5 be "{remTarget}".
                            peStEnvDynamic(state, rmk5).
                        Otherwise:
                            Let rmk6 be "{remTarget}".
                            peStSeBind(state, rmk6, rmKnown).
                Push (a new CRemove with elem peVal and target remTarget) to blockResult.
            When CSetField (sfTarget, sfField, sfValExpr):
                Let peVal be peExpr(sfValExpr, state).
                Let sfk1 be "{sfTarget}".
                If (peStaticEnv(state)) contains sfk1:
                    Let sfk2 be "{sfTarget}".
                    Let sfPrev be item sfk2 of (peStaticEnv(state)).
                    Let sfUpdated be setRecordField(sfPrev, sfField, peVal).
                    If isNoUnfold(sfUpdated):
                        Let sfk3 be "{sfTarget}".
                        peDeclareDynamic(sfk3, sfPrev, state, blockResult).
                        Let sfk4 be "{sfTarget}".
                        peStSeDrop(state, sfk4).
                        Let sfk5 be "{sfTarget}".
                        peStEnvDynamic(state, sfk5).
                        Push (a new CSetField with target sfTarget and field sfField and val peVal) to blockResult.
                    Otherwise:
                        Let sfk6 be "{sfTarget}".
                        peStSeBind(state, sfk6, sfUpdated).
                        If isResidualVar((peEnv(state)), sfTarget):
                            Push (a new CSetField with target sfTarget and field sfField and val peVal) to blockResult.
                Otherwise:
                    Push (a new CSetField with target sfTarget and field sfField and val peVal) to blockResult.
            When CStructDef (sdName, sdFieldNames):
                Push (a new CStructDef with name sdName and fieldNames sdFieldNames) to blockResult.
            When CEnumDef (edName, edVariants):
                Push (a new CEnumDef with name edName and variants edVariants) to blockResult.
            When CInspect (inspTarget, inspArms):
                Let peTarget be peExpr(inspTarget, state).
                Let mutable inspHeld be a new CVar with name "__pe_no_unfold".
                If peIsSum(peTarget):
                    Set inspHeld to peTarget.
                If not isNoUnfold(inspHeld):
                    Set blockResult to hoistCloseSt(state, hoistSaved, blockResult, hoistMark).
                    Let inspSumHead be a new CInspect with target peTarget and arms inspArms.
                    Let inspSumSrc be peSumSplit(inspHeld, inspSumHead, peTailOf(placedStmts, stmtIdx + 1), state).
                    Repeat for inspSumR in specializeStmts(inspSumSrc, state):
                        Push inspSumR to blockResult.
                    Return blockResult.
                Let mutable inspTag be "".
                Let mutable inspVals be a new Seq of CExpr.
                Let mutable inspKnown be false.
                Inspect peTarget:
                    When CNewVariant (nvTag, nvNames, nvVals):
                        Set inspTag to nvTag.
                        Set inspVals to nvVals.
                        Set inspKnown to true.
                    When CNew (cnTypeName, cnFieldNames, cnFieldVals):
                        Set inspTag to cnTypeName.
                        Set inspVals to cnFieldVals.
                        Set inspKnown to true.
                    Otherwise:
                        Let inspSkip be true.
                If inspKnown:
                    Let mutable inspChosen be false.
                    Repeat for inspArm in inspArms:
                        If not inspChosen:
                            Inspect inspArm:
                                When CWhen (wName, wBindings, wBody):
                                    If wName equals inspTag:
                                        Set inspChosen to true.
                                        Let mutable bidx be 1.
                                        Repeat for b in wBindings:
                                            If bidx is at most length of inspVals:
                                                Let bval be item bidx of inspVals.
                                                If isStatic(bval):
                                                    Let bS1 be "{b}".
                                                    Let bvalCopy be bval.
                                                    peStSeBind(state, bS1, bvalCopy).
                                                    Let bS2 be "{b}".
                                                    peStEnvBind(state, bS2, exprToVal(bval)).
                                                Otherwise:
                                                    Let bD1 be "{b}".
                                                    If (peStaticEnv(state)) contains bD1:
                                                        Let bD2 be "{b}".
                                                        peStSeDrop(state, bD2).
                                                    Let bD3 be "{b}".
                                                    peStEnvDynamic(state, bD3).
                                                    Let bD4 be "{b}".
                                                    Let bvalCopy2 be bval.
                                                    Push (a new CLet with name bD4 and expr bvalCopy2) to blockResult.
                                            Set bidx to bidx + 1.
                                        Let matchedBody be specializeStmts(wBody, state).
                                        Repeat for ms in matchedBody:
                                            Push ms to blockResult.
                                Otherwise:
                                    Let skipArmI be true.
                    If not inspChosen:
                        Repeat for inspArm2 in inspArms:
                            If not inspChosen:
                                Inspect inspArm2:
                                    When COtherwise (oBody):
                                        Set inspChosen to true.
                                        Let otherwiseBody be specializeStmts(oBody, state).
                                        Repeat for os in otherwiseBody:
                                            Push os to blockResult.
                                    Otherwise:
                                        Let skipArmO be true.
                Otherwise:
                    Let inspMods be a new Seq of Text.
                    Repeat for inspArm3 in inspArms:
                        Let mutable armModBody be a new Seq of CStmt.
                        Inspect inspArm3:
                            When CWhen (mwName, mwBindings, mwBody):
                                Set armModBody to mwBody.
                            When COtherwise (moBody):
                                Set armModBody to moBody.
                        Let armMods be collectSetVars(armModBody, (peFuncs(state))).
                        Repeat for amv in armMods:
                            If not inspMods contains amv:
                                Push amv to inspMods.
                    Let mutable ixCandsS be a new Seq of Text.
                    Let mutable ixDynS be a new Seq of Text.
                    Repeat for ixM in inspMods:
                        Let ixMk be "{ixM}".
                        Let mutable ixShapeable be false.
                        If (peStaticEnv(state)) contains ixMk:
                            Let ixMk2 be "{ixM}".
                            Set ixShapeable to peLoopCandidate(item ixMk2 of (peStaticEnv(state))).
                        Let ixMk3 be "{ixM}".
                        If ixShapeable:
                            Push ixMk3 to ixCandsS.
                        Otherwise:
                            Push ixMk3 to ixDynS.
                    Let mutable inspShaped be false.
                    If length of ixCandsS is greater than 0:
                        Let mutable ixPre be a new Seq of CStmt.
                        Repeat for ixDm in ixDynS:
                            Let ixDk be "{ixDm}".
                            If (peStaticEnv(state)) contains ixDk:
                                Let ixDk2 be "{ixDm}".
                                Let ixDk3 be "{ixDm}".
                                peDeclareDynamic(ixDk3, item ixDk2 of (peStaticEnv(state)), state, ixPre).
                        Let mutable ixOutS be a new Seq of CStmt.
                        Set inspShaped to peInspectShapes(peTarget, inspArms, ixCandsS, ixDynS, state, ixOutS).
                        If inspShaped:
                            Repeat for ixP in ixPre:
                                Push ixP to blockResult.
                            Repeat for ixO in ixOutS:
                                Push ixO to blockResult.
                    If not inspShaped:
                        Repeat for imv in inspMods:
                            Let imvK1 be "{imv}".
                            If (peStaticEnv(state)) contains imvK1:
                                Let imvK2 be "{imv}".
                                Let imvPrev be item imvK2 of (peStaticEnv(state)).
                                Let imvK3 be "{imv}".
                                peDeclareDynamic(imvK3, imvPrev, state, blockResult).
                                Let imvK4 be "{imv}".
                                peStSeDrop(state, imvK4).
                                Let imvK5 be "{imv}".
                                peStEnvDynamic(state, imvK5).
                        Let peArms be a new Seq of CMatchArm.
                        Let inspEnvSnap be peEnvShallow((peEnv(state))).
                        Let inspSeSnap be peSeShallow((peStaticEnv(state))).
                        Repeat for inspArm4 in inspArms:
                            peRestoreEnvSt(state, peEnvShallow(inspEnvSnap)).
                            peRestoreSeSt(state, peSeShallow(inspSeSnap)).
                            Let mutable armBindings be a new Seq of Text.
                            Let mutable armBody be a new Seq of CStmt.
                            Let mutable armIsWhen be false.
                            Let mutable armName be "".
                            Inspect inspArm4:
                                When CWhen (dwName, dwBindings, dwBody):
                                    Set armBindings to dwBindings.
                                    Set armBody to dwBody.
                                    Set armIsWhen to true.
                                    Set armName to dwName.
                                When COtherwise (doBody):
                                    Set armBody to doBody.
                            Repeat for db in armBindings:
                                Let dbK1 be "{db}".
                                If (peStaticEnv(state)) contains dbK1:
                                    Let dbK2 be "{db}".
                                    peStSeDrop(state, dbK2).
                                Let dbK3 be "{db}".
                                peStEnvDynamic(state, dbK3).
                            Let armRes be peBlock(armBody, state).
                            Let armFinal be a new Seq of CStmt.
                            Repeat for ars in armRes:
                                Push ars to armFinal.
                            Repeat for imv2 in inspMods:
                                Let imv2K1 be "{imv2}".
                                If (peStaticEnv(state)) contains imv2K1:
                                    Let imv2K2 be "{imv2}".
                                    Let imv2V be item imv2K2 of (peStaticEnv(state)).
                                    Let imv2K3 be "{imv2}".
                                    Push (a new CSet with name imv2K3 and expr imv2V) to armFinal.
                                    Let imv2K4 be "{imv2}".
                                    peStSeDrop(state, imv2K4).
                                    Let imv2K5 be "{imv2}".
                                    peStEnvDynamic(state, imv2K5).
                            Repeat for db2 in armBindings:
                                Let db2K1 be "{db2}".
                                If (peStaticEnv(state)) contains db2K1:
                                    Let db2K2 be "{db2}".
                                    peStSeDrop(state, db2K2).
                            If armIsWhen:
                                Let armBindingsC be copy of armBindings.
                                Push (a new CWhen with variantName armName and bindings armBindingsC and body armFinal) to peArms.
                            Otherwise:
                                Push (a new COtherwise with body armFinal) to peArms.
                        peRestoreEnvSt(state, inspEnvSnap).
                        peRestoreSeSt(state, inspSeSnap).
                        Push (a new CInspect with target peTarget and arms peArms) to blockResult.
            When CRuntimeAssert (raCond, raMsg):
                Let peRaCond be peExpr(raCond, state).
                Let peRaMsg be peExpr(raMsg, state).
                Push (a new CRuntimeAssert with cond peRaCond and msg peRaMsg) to blockResult.
            When CHardAssert (raCond, raMsg):
                Let peRaCond be peExpr(raCond, state).
                Let peRaMsg be peExpr(raMsg, state).
                Push (a new CHardAssert with cond peRaCond and msg peRaMsg) to blockResult.
            When CFail (failReason):
                Let peFailReason be peExpr(failReason, state).
                Push (a new CFail with reason peFailReason) to blockResult.
            When CGive (giveExpr, giveTarget):
                Let peGiveExpr be peExpr(giveExpr, state).
                Push (a new CGive with expr peGiveExpr and target giveTarget) to blockResult.
            When CEscStmt (escCode):
                Push (a new CEscStmt with code escCode) to blockResult.
            When CSleep (sleepDur):
                Let peSleepDur be peExpr(sleepDur, state).
                Push (a new CSleep with duration peSleepDur) to blockResult.
            When CReadConsole (rcTarget):
                Push (a new CReadConsole with target rcTarget) to blockResult.
            When CReadFile (rfPath, rfTarget):
                Let peRfPath be peExpr(rfPath, state).
                Push (a new CReadFile with path peRfPath and target rfTarget) to blockResult.
            When CWriteFile (wfPath, wfContent):
                Let peWfPath be peExpr(wfPath, state).
                Let peWfContent be peExpr(wfContent, state).
                Push (a new CWriteFile with path peWfPath and content peWfContent) to blockResult.
            When CCheckPolicy (cpSubject, cpObject, cpCapability, cpRule, cpAlts, cpSource):
                Push (a new CCheckPolicy with subject cpSubject and object cpObject and capability cpCapability and rule cpRule and alternatives cpAlts and source cpSource) to blockResult.
            When CCheck (chkPred, chkMsg):
                Let peChkPred be peExpr(chkPred, state).
                Let peChkMsg be peExpr(chkMsg, state).
                Push (a new CCheck with predicate peChkPred and msg peChkMsg) to blockResult.
            When CAssert (assertProp):
                Let peAssertProp be peExpr(assertProp, state).
                Push (a new CAssert with proposition peAssertProp) to blockResult.
            When CTrust (trustProp, trustJust):
                Let peTrustProp be peExpr(trustProp, state).
                Push (a new CTrust with proposition peTrustProp and justification trustJust) to blockResult.
            When CRequire (reqDep):
                Push (a new CRequire with dependency reqDep) to blockResult.
            When CMerge (mergeTarget, mergeOther):
                Let peMergeOther be peExpr(mergeOther, state).
                Push (a new CMerge with target mergeTarget and other peMergeOther) to blockResult.
            When CJoin (joinTarget, joinOther):
                Let peJoinOther be peExpr(joinOther, state).
                Push (a new CJoin with target joinTarget and other peJoinOther) to blockResult.
            When CIncrease (incTarget, incAmount):
                Let peIncAmount be peExpr(incAmount, state).
                Push (a new CIncrease with target incTarget and amount peIncAmount) to blockResult.
            When CDecrease (decTarget, decAmount):
                Let peDecAmount be peExpr(decAmount, state).
                Push (a new CDecrease with target decTarget and amount peDecAmount) to blockResult.
            When CAppendToSeq (asTarget, asValue):
                Let peAsValue be peExpr(asValue, state).
                Push (a new CAppendToSeq with target asTarget and value peAsValue) to blockResult.
            When CResolve (resTarget):
                Push (a new CResolve with target resTarget) to blockResult.
            When CResolveTo (rtTarget, rtValueExpr):
                Let peRtValue be peExpr(rtValueExpr, state).
                Push (a new CResolveTo with target rtTarget and value peRtValue) to blockResult.
            When CSync (syncTarget, syncChannel):
                Let peSyncChannel be peExpr(syncChannel, state).
                Push (a new CSync with target syncTarget and channel peSyncChannel) to blockResult.
            When CMount (mountTarget, mountPath):
                Let peMountPath be peExpr(mountPath, state).
                Push (a new CMount with target mountTarget and path peMountPath) to blockResult.
            When CConcurrent (concBranches):
                Let peConcBranches be a new Seq of Seq of CStmt.
                Repeat for concBranch in concBranches:
                    Push peBlock(concBranch, state) to peConcBranches.
                Push (a new CConcurrent with branches peConcBranches) to blockResult.
            When CParallel (parBranches):
                Let peParBranches be a new Seq of Seq of CStmt.
                Repeat for parBranch in parBranches:
                    Push peBlock(parBranch, state) to peParBranches.
                Push (a new CParallel with branches peParBranches) to blockResult.
            When CLaunchTask (ltBody, ltHandle):
                Let peLtBody be peBlock(ltBody, state).
                Push (a new CLaunchTask with body peLtBody and handle ltHandle) to blockResult.
            When CStopTask (stHandle):
                Let peStHandle be peExpr(stHandle, state).
                Push (a new CStopTask with handle peStHandle) to blockResult.
            When CSelect (selBranches):
                Let peSelBranches be a new Seq of CSelectBranch.
                Repeat for selBr in selBranches:
                    Inspect selBr:
                        When CSelectRecv (selChan, selVar, selBody):
                            Let peSelBody be peBlock(selBody, state).
                            Push (a new CSelectRecv with chan selChan and var selVar and body peSelBody) to peSelBranches.
                        When CSelectTimeout (selDur, selBody):
                            Let peSelDur be peExpr(selDur, state).
                            Let peSelBody be peBlock(selBody, state).
                            Push (a new CSelectTimeout with duration peSelDur and body peSelBody) to peSelBranches.
                Push (a new CSelect with branches peSelBranches) to blockResult.
            When CCreatePipe (cpName, cpCapacity):
                Let peCpCapacity be peExpr(cpCapacity, state).
                Push (a new CCreatePipe with name cpName and capacity peCpCapacity) to blockResult.
            When CSendPipe (spPipe, spValue):
                Let peSpValue be peExpr(spValue, state).
                Push (a new CSendPipe with chan spPipe and value peSpValue) to blockResult.
            When CReceivePipe (rpPipe, rpTarget):
                Push (a new CReceivePipe with chan rpPipe and target rpTarget) to blockResult.
            When CTrySendPipe (tspPipe, tspValue):
                Let peTspValue be peExpr(tspValue, state).
                Push (a new CTrySendPipe with chan tspPipe and value peTspValue) to blockResult.
            When CTryReceivePipe (trpPipe, trpTarget):
                Push (a new CTryReceivePipe with chan trpPipe and target trpTarget) to blockResult.
            When CSpawn (spawnType, spawnTarget):
                Push (a new CSpawn with agentType spawnType and target spawnTarget) to blockResult.
            When CSendMessage (smTarget, smMsg):
                Let peSmTarget be peExpr(smTarget, state).
                Let peSmMsg be peExpr(smMsg, state).
                Push (a new CSendMessage with target peSmTarget and msg peSmMsg) to blockResult.
            When CStreamMessage (stTarget, stVals):
                Let peStTarget be peExpr(stTarget, state).
                Let peStVals be peExpr(stVals, state).
                Push (a new CStreamMessage with target peStTarget and values peStVals) to blockResult.
            When CAwaitMessage (amTarget):
                Push (a new CAwaitMessage with target amTarget) to blockResult.
            When CListen (listenAddr, listenHandler):
                Let peListenAddr be peExpr(listenAddr, state).
                Push (a new CListen with addr peListenAddr and handler listenHandler) to blockResult.
            When CConnectTo (connAddr, connTarget):
                Let peConnAddr be peExpr(connAddr, state).
                Push (a new CConnectTo with addr peConnAddr and target connTarget) to blockResult.
            When CZone (zoneName, zoneKind, zoneBody):
                Let peZoneBody be peBlock(zoneBody, state).
                Push (a new CZone with name zoneName and kind zoneKind and body peZoneBody) to blockResult.
            Otherwise:
                Let skip be true.
        If peIsLoopStmt(s):
            peSetFrame(state, stmtFrame).
        Set blockResult to hoistCloseSt(state, hoistSaved, blockResult, hoistMark).
        If peBottomPass(state):
            Let btCut be peCutAtBottom(blockResult, hoistMark).
            If length of btCut is greater than 0:
                Return btCut.
    Return peCutAfterFail(blockResult).

## To validateExtractReturn (result: CExpr) and (bodyStmts: Seq of CStmt) -> CExpr:
    Inspect result:
        When CVar (retName):
            If retName equals "__no_return__":
                Return result.
            If retName equals "__unresolvable":
                Return result.
            Repeat for s in bodyStmts:
                Inspect s:
                    When CLet (letName, letExpr):
                        If letName equals retName:
                            Return a new CVar with name "__no_return__".
                    Otherwise:
                        Let skip be true.
            Return result.
        Otherwise:
            Return result.

## To extractReturn (stmts: Seq of CStmt) -> CExpr:
    Let mutable idx be length of stmts.
    While idx is at least 1:
        Let s be item idx of stmts.
        Inspect s:
            When CReturn (retExpr):
                Return retExpr.
            Otherwise:
                Set idx to idx - 1.
    Return a new CVar with name "__no_return__".

## To peStartsWith (swText: Text) and (swPrefix: Text) -> Bool:
    Let mutable swTextChars be a new Seq of Text.
    Repeat for swTextCh in swText:
        Push swTextCh to swTextChars.
    Let mutable swAt be 1.
    Repeat for swPrefixCh in swPrefix:
        If swAt is greater than length of swTextChars:
            Return false.
        If item swAt of swTextChars is not swPrefixCh:
            Return false.
        Set swAt to swAt + 1.
    Return true.

## To peIsSetType (setTypeName: Text) -> Bool:
    If setTypeName equals "Set":
        Return true.
    Return peStartsWith(setTypeName, "Set of ").

## To peIsMapType (mapTypeName: Text) -> Bool:
    If mapTypeName equals "Map":
        Return true.
    Return peStartsWith(mapTypeName, "Map of ").
