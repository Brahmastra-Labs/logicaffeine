            If ppDigits equals 15:
                Return a new CText with value "{ppReal:.15}".
            If ppDigits equals 16:
                Return a new CText with value "{ppReal:.16}".
            If ppDigits equals 17:
                Return a new CText with value "{ppReal:.17}".
            If ppDigits equals 18:
                Return a new CText with value "{ppReal:.18}".
            If ppDigits equals 19:
                Return a new CText with value "{ppReal:.19}".
            If ppDigits equals 20:
                Return a new CText with value "{ppReal:.20}".
            If ppDigits equals 21:
                Return a new CText with value "{ppReal:.21}".
            If ppDigits equals 22:
                Return a new CText with value "{ppReal:.22}".
            If ppDigits equals 23:
                Return a new CText with value "{ppReal:.23}".
            If ppDigits equals 24:
                Return a new CText with value "{ppReal:.24}".
            If ppDigits equals 25:
                Return a new CText with value "{ppReal:.25}".
            If ppDigits equals 26:
                Return a new CText with value "{ppReal:.26}".
            If ppDigits equals 27:
                Return a new CText with value "{ppReal:.27}".
            If ppDigits equals 28:
                Return a new CText with value "{ppReal:.28}".
            If ppDigits equals 29:
                Return a new CText with value "{ppReal:.29}".
            If ppDigits equals 30:
                Return a new CText with value "{ppReal:.30}".
            If ppDigits equals 31:
                Return a new CText with value "{ppReal:.31}".
            If ppDigits equals 32:
                Return a new CText with value "{ppReal:.32}".
        Otherwise:
            Let ppSkip be true.
    Return a new CVar with name "__pe_no_unfold".
# The specializer's precisions end.

## To peKnownShown (ksExpr: CExpr) -> CExpr:
    Inspect ksExpr:
        When CText (ksText):
            Return ksExpr.
        When CInt (ksInt):
            Return a new CText with value "{ksInt}".
        When CFloat (ksReal):
            Return a new CText with value "{ksReal}".
        When CBool (ksBool):
            Return a new CText with value "{ksBool}".
        When CDuration (ksDuration):
            Return a new CText with value "{ksDuration}".
        When CDate (ksDate):
            Return a new CText with value "{ksDate}".
        When CMoment (ksMoment):
            Return a new CText with value "{ksMoment}".
        When CSpan (ksSpan):
            Return a new CText with value "{ksSpan}".
        When CTime (ksTime):
            Return a new CText with value "{ksTime}".
        When CChar (ksChar):
            Return a new CText with value "{ksChar}".
        When CList (ksItems):
            Return peKnownShownJoined(ksItems, "[", "]").
        When CNewSeq (ksElem):
            Return a new CText with value "[]".
        When CTuple (ksTuple):
            Return peKnownShownJoined(ksTuple, "(", ")").
        Otherwise:
            Return a new CVar with name "__pe_no_unfold".

## To pePushShownText (stOut: mutable Seq of CStringPart) and (stText: Text):
    Let stN be length of stOut.
    If stN is greater than 0:
        Inspect item stN of stOut:
            When CLiteralPart (stPrev):
                Set item stN of stOut to a new CLiteralPart with value "{stPrev}{stText}".
                Return.
            Otherwise:
                Let stSkip be true.
    Push a new CLiteralPart with value stText to stOut.

## To peShownItems (siItems: Seq of CExpr) and (siOpen: Text) and (siClose: Text) and (siOut: mutable Seq of CStringPart):
    pePushShownText(siOut, siOpen).
    Let mutable siFirst be true.
    Repeat for siItem in siItems:
        If not siFirst:
            pePushShownText(siOut, ", ").
        Set siFirst to false.
        peShownParts(siItem, siOut).
    pePushShownText(siOut, siClose).

## To peShownParts (spE: CExpr) and (spOut: mutable Seq of CStringPart):
    Let spKnown be peKnownShown(spE).
    Inspect spKnown:
        When CText (spText):
            pePushShownText(spOut, spText).
            Return.
        Otherwise:
            Let spSkipK be true.
    Inspect spE:
        When CList (spItems):
            peShownItems(spItems, "[", "]", spOut).
        When CTuple (spTuple):
            peShownItems(spTuple, "(", ")", spOut).
        Otherwise:
            Push a new CExprPart with expr spE to spOut.

## To peKnownShownJoined (kjItems: Seq of CExpr) and (kjOpen: Text) and (kjClose: Text) -> CExpr:
    Let mutable kjText be "".
    Let mutable kjFirst be true.
    Repeat for kjItem in kjItems:
        Let kjShown be peKnownShown(kjItem).
        Inspect kjShown:
            When CText (kjPart):
                If kjFirst:
                    Set kjText to kjPart.
                    Set kjFirst to false.
                Otherwise:
                    Set kjText to "{kjText}, {kjPart}".
            Otherwise:
                Return kjShown.
    Return a new CText with value "{kjOpen}{kjText}{kjClose}".

## To peFormattedKnown (fkExpr: CExpr) and (fkForm: Text) and (fkSize: Int) -> CExpr:
    Let fkShown be peKnownShown(fkExpr).
    If isNoUnfold(fkShown):
        Return fkShown.
    Let mutable fkNumber be false.
    Inspect fkExpr:
        When CInt (fkInt):
            Set fkNumber to true.
        When CFloat (fkReal):
            Set fkNumber to true.
        Otherwise:
            Let fkOther be true.
    If fkNumber:
        If fkForm equals "$":
            Let fkCents be pePrecision(fkExpr, 2).
            Inspect fkCents:
                When CText (fkCentsText):
                    Return a new CText with value "${fkCentsText}".
                Otherwise:
                    Return fkCents.
        If fkForm equals ".":
            Return pePrecision(fkExpr, fkSize).
    Inspect fkShown:
        When CText (fkText):
            Return a new CText with value peFormattedText(fkText, fkForm, fkSize).
        Otherwise:
            Return fkShown.

## To isNoUnfold (e: CExpr) -> Bool:
    Inspect e:
        When CVar (nuName):
            Return nuName equals "__pe_no_unfold".
        Otherwise:
            Return false.

## To renameName (n: Text) and (m: Map of Text to Text) -> Text:
    Let rnK be "{n}".
    If m contains rnK:
        Return item rnK of m.
    Return n.

## To renameExprs (es: Seq of CExpr) and (m: Map of Text to Text) and (refs: mutable Seq of Text) and (writes: mutable Seq of Text) -> Seq of CExpr:
    Let resOut be a new Seq of CExpr.
    Repeat for resE in es:
        Push renameExpr(resE, m, refs, writes) to resOut.
    Return resOut.

## To renameExpr (e: CExpr) and (m: Map of Text to Text) and (refs: mutable Seq of Text) and (writes: mutable Seq of Text) -> CExpr:
    Inspect e:
        When CVar (reVn):
            Let reVk be "{reVn}".
            If m contains reVk:
                Return a new CVar with name (item reVk of m).
            Push reVk to refs.
            Return e.
        When CInt (reI):
            Return e.
        When CFloat (reF):
            Return e.
        When CBool (reB):
            Return e.
        When CText (reT):
            Return e.
        When CNewSeq (peSeqElem8):
            Return e.
        When CNewSet (peSetElem7):
            Return e.
        When COptionNone:
            Return e.
        When CNothing:
            Return e.
        When CDeclaredDefault (rnDefaultType):
            Return e.
        When CSpelled (rnSpelledCode, rnSpelledAwaits):
            Return e.
        When CTimeNow:
            Return e.
        When CDateToday:
            Return e.
        When CBinOp (reOp, reL, reR):
            Let reL2 be renameExpr(reL, m, refs, writes).
            Let reR2 be renameExpr(reR, m, refs, writes).
            Return a new CBinOp with op reOp and left reL2 and right reR2.
        When CNot (reIn):
            Let reIn2 be renameExpr(reIn, m, refs, writes).
            Return a new CNot with inner reIn2.
        When CCall (reFn, reArgs):
            Let reArgs2 be renameExprs(reArgs, m, refs, writes).
            Return a new CCall with name reFn and args reArgs2.
        When CIndex (reColl, reIdx):
            Let reColl2 be renameExpr(reColl, m, refs, writes).
            Let reIdx2 be renameExpr(reIdx, m, refs, writes).
            Return a new CIndex with coll reColl2 and idx reIdx2.
        When CLen (reLt):
            Let reLt2 be renameExpr(reLt, m, refs, writes).
            Return a new CLen with target reLt2.
        When CMapGet (reMt, reMk):
            Let reMt2 be renameExpr(reMt, m, refs, writes).
            Let reMk2 be renameExpr(reMk, m, refs, writes).
            Return a new CMapGet with target reMt2 and key reMk2.
        When CNewVariant (reTag, reNames, reVals):
            Let reVals2 be renameExprs(reVals, m, refs, writes).
            Return a new CNewVariant with tag reTag and fnames reNames and fvals reVals2.
        When CList (reItems):
            Let reItems2 be renameExprs(reItems, m, refs, writes).
            Return a new CList with items reItems2.
        When CRange (reRs, reRe):
            Let reRs2 be renameExpr(reRs, m, refs, writes).
            Let reRe2 be renameExpr(reRe, m, refs, writes).
            Return a new CRange with start reRs2 and end reRe2.
        When CSlice (reSc, reSs, reSe):
            Let reSc2 be renameExpr(reSc, m, refs, writes).
            Let reSs2 be renameExpr(reSs, m, refs, writes).
            Let reSe2 be renameExpr(reSe, m, refs, writes).
            Return a new CSlice with coll reSc2 and startIdx reSs2 and endIdx reSe2.
        When CCopy (reCt):
            Let reCt2 be renameExpr(reCt, m, refs, writes).
            Return a new CCopy with target reCt2.
        When CContains (reCc, reCe):
            Let reCc2 be renameExpr(reCc, m, refs, writes).
            Let reCe2 be renameExpr(reCe, m, refs, writes).
            Return a new CContains with coll reCc2 and elem reCe2.
        When CUnion (reUl, reUr):
            Let reUl2 be renameExpr(reUl, m, refs, writes).
            Let reUr2 be renameExpr(reUr, m, refs, writes).
            Return a new CUnion with left reUl2 and right reUr2.
        When CIntersection (reIl, reIr):
            Let reIl2 be renameExpr(reIl, m, refs, writes).
            Let reIr2 be renameExpr(reIr, m, refs, writes).
            Return a new CIntersection with left reIl2 and right reIr2.
        When COptionSome (reOs):
            Let reOs2 be renameExpr(reOs, m, refs, writes).
            Return a new COptionSome with inner reOs2.
        When CTuple (reTup):
            Let reTup2 be renameExprs(reTup, m, refs, writes).
            Return a new CTuple with items reTup2.
        When CNew (reTy, reFn2, reFv):
            Let reFv2 be renameExprs(reFv, m, refs, writes).
            Return a new CNew with typeName reTy and fieldNames reFn2 and fields reFv2.
        When CFieldAccess (reFt, reFf):
            Let reFt2 be renameExpr(reFt, m, refs, writes).
            Return a new CFieldAccess with target reFt2 and field reFf.
        When CClosure (reCp, reCb, reCcap):
            Let reInner be copy of m.
            Repeat for reP in reCp:
                Let rePk be "{reP}".
                If reInner contains rePk:
                    Remove rePk from reInner.
            Let reCap2 be a new Seq of Text.
            Repeat for reCn in reCcap:
                Let reCnk be "{reCn}".
                If m contains reCnk:
                    Push (item reCnk of m) to reCap2.
                Otherwise:
                    Let reCnk2 be "{reCn}".
                    Push reCnk to refs.
                    Push reCnk2 to reCap2.
            Let reCb2 be renameStmts(reCb, reInner, refs, writes).
            Return a new CClosure with params reCp and body reCb2 and captured reCap2.
        When CCallExpr (reTgt, reCa):
            Let reTgt2 be renameExpr(reTgt, m, refs, writes).
            Let reCa2 be renameExprs(reCa, m, refs, writes).
            Return a new CCallExpr with target reTgt2 and args reCa2.
        When CInterpolatedString (reParts):
            Let reParts2 be a new Seq of CStringPart.
            Repeat for rePart in reParts:
                Inspect rePart:
                    When CLiteralPart (reLv):
                        Push rePart to reParts2.
                    When CExprPart (rePe):
                        Let rePe2 be renameExpr(rePe, m, refs, writes).
                        Push (a new CExprPart with expr rePe2) to reParts2.
                    When CFormattedPart (reFe, reFs, reFf, reFz):
                        Let reFe2 be renameExpr(reFe, m, refs, writes).
                        Push (a new CFormattedPart with expr reFe2 and spec reFs and form reFf and size reFz) to reParts2.
            Return a new CInterpolatedString with parts reParts2.
        When CDuration (reAtomDuration):
            Return e.
        When CDate (reAtomDate):
            Return e.
        When CMoment (reAtomMoment):
            Return e.
        When CSpan (reAtomSpan):
            Return e.
        When CTime (reAtomTime):
            Return e.
        When CChar (reAtomChar):
            Return e.
        When CManifestOf (reZn):
            Let reZn2 be renameExpr(reZn, m, refs, writes).
            Return a new CManifestOf with zn reZn2.
        When CChunkAt (reCi, reCz):
            Let reCi2 be renameExpr(reCi, m, refs, writes).
            Let reCz2 be renameExpr(reCz, m, refs, writes).
            Return a new CChunkAt with idx reCi2 and zn reCz2.
        Otherwise:
            Push "__pe_unsupported" to refs.
            Return e.

## To renameWriteTarget (t: Text) and (m: Map of Text to Text) and (writes: mutable Seq of Text) -> Text:
    Let rwK be "{t}".
    If m contains rwK:
        Return item rwK of m.
    Push rwK to writes.
    Return t.

## To renameStmts (stmts: Seq of CStmt) and (m: Map of Text to Text) and (refs: mutable Seq of Text) and (writes: mutable Seq of Text) -> Seq of CStmt:
    Let rsOut be a new Seq of CStmt.
    Repeat for rsS in stmts:
        Inspect rsS:
            When CLet (rsLn, rsLe):
                Let rsLn2 be renameName(rsLn, m).
                Let rsLe2 be renameExpr(rsLe, m, refs, writes).
                Push (a new CLet with name rsLn2 and expr rsLe2) to rsOut.
            When CSet (rsSn, rsSe):
                Let rsSn2 be renameWriteTarget(rsSn, m, writes).
                Let rsSe2 be renameExpr(rsSe, m, refs, writes).
                Push (a new CSet with name rsSn2 and expr rsSe2) to rsOut.
            When CIf (rsIc, rsIt, rsIe):
                Let rsIc2 be renameExpr(rsIc, m, refs, writes).
                Let rsIt2 be renameStmts(rsIt, m, refs, writes).
                Let rsIe2 be renameStmts(rsIe, m, refs, writes).
                Push (a new CIf with cond rsIc2 and thenBlock rsIt2 and elseBlock rsIe2) to rsOut.
            When CWhile (rsWc, rsWb):
                Let rsWc2 be renameExpr(rsWc, m, refs, writes).
                Let rsWb2 be renameStmts(rsWb, m, refs, writes).
                Push (a new CWhile with cond rsWc2 and body rsWb2) to rsOut.
            When CReturn (rsRe):
                Let rsRe2 be renameExpr(rsRe, m, refs, writes).
                Push (a new CReturn with expr rsRe2) to rsOut.
            When CShow (rsSh):
                Let rsSh2 be renameExpr(rsSh, m, refs, writes).
                Push (a new CShow with expr rsSh2) to rsOut.
            When CSleep (rsSl):
                Let rsSl2 be renameExpr(rsSl, m, refs, writes).
                Push (a new CSleep with duration rsSl2) to rsOut.
            When CCallS (rsCn, rsCa):
                Let rsCa2 be renameExprs(rsCa, m, refs, writes).
                Push (a new CCallS with name rsCn and args rsCa2) to rsOut.
            When CPush (rsPe, rsPt):
                Let rsPe2 be renameExpr(rsPe, m, refs, writes).
                Let rsPt2 be renameWriteTarget(rsPt, m, writes).
                Push (a new CPush with expr rsPe2 and target rsPt2) to rsOut.
            When CSetIdx (rsXt, rsXi, rsXv):
                Let rsXt2 be renameWriteTarget(rsXt, m, writes).
                Let rsXi2 be renameExpr(rsXi, m, refs, writes).
                Let rsXv2 be renameExpr(rsXv, m, refs, writes).
                Push (a new CSetIdx with target rsXt2 and idx rsXi2 and val rsXv2) to rsOut.
            When CMapSet (rsMt, rsMk, rsMv):
                Let rsMt2 be renameWriteTarget(rsMt, m, writes).
                Let rsMk2 be renameExpr(rsMk, m, refs, writes).
                Let rsMv2 be renameExpr(rsMv, m, refs, writes).
                Push (a new CMapSet with target rsMt2 and key rsMk2 and val rsMv2) to rsOut.
            When CPop (rsPop):
                Let rsPop2 be renameWriteTarget(rsPop, m, writes).
                Push (a new CPop with target rsPop2) to rsOut.
            When CPopInto (rsPiT, rsPiI):
                Let rsPiT2 be renameWriteTarget(rsPiT, m, writes).
                Let rsPiI2 be renameName(rsPiI, m).
                Push (a new CPopInto with target rsPiT2 and into rsPiI2) to rsOut.
            When CRepeat (rsRv, rsRc, rsRb):
                Let rsRv2 be renameName(rsRv, m).
                Let rsRc2 be renameExpr(rsRc, m, refs, writes).
                Let rsRb2 be renameStmts(rsRb, m, refs, writes).
                Push (a new CRepeat with var rsRv2 and coll rsRc2 and body rsRb2) to rsOut.
            When CRepeatRange (rsQv, rsQs, rsQe, rsQb):
                Let rsQv2 be renameName(rsQv, m).
                Let rsQs2 be renameExpr(rsQs, m, refs, writes).
                Let rsQe2 be renameExpr(rsQe, m, refs, writes).
                Let rsQb2 be renameStmts(rsQb, m, refs, writes).
                Push (a new CRepeatRange with var rsQv2 and start rsQs2 and end rsQe2 and body rsQb2) to rsOut.
            When CBreak:
                Push rsS to rsOut.
            When CAdd (rsAe, rsAt):
                Let rsAe2 be renameExpr(rsAe, m, refs, writes).
                Let rsAt2 be renameWriteTarget(rsAt, m, writes).
                Push (a new CAdd with elem rsAe2 and target rsAt2) to rsOut.
            When CRemove (rsDe, rsDt):
                Let rsDe2 be renameExpr(rsDe, m, refs, writes).
                Let rsDt2 be renameWriteTarget(rsDt, m, writes).
                Push (a new CRemove with elem rsDe2 and target rsDt2) to rsOut.
            When CSetField (rsFt, rsFf, rsFv):
                Let rsFt2 be renameWriteTarget(rsFt, m, writes).
                Let rsFv2 be renameExpr(rsFv, m, refs, writes).
                Push (a new CSetField with target rsFt2 and field rsFf and val rsFv2) to rsOut.
            When CInspect (rsNt, rsNa):
                Let rsNt2 be renameExpr(rsNt, m, refs, writes).
                Let rsNa2 be a new Seq of CMatchArm.
                Repeat for rsArm in rsNa:
                    Inspect rsArm:
                        When CWhen (rsWn, rsWbs, rsWbody):
                            Let rsWbs2 be a new Seq of Text.
                            Repeat for rsWbn in rsWbs:
                                Push renameName(rsWbn, m) to rsWbs2.
                            Let rsWbody2 be renameStmts(rsWbody, m, refs, writes).
                            Push (a new CWhen with variantName rsWn and bindings rsWbs2 and body rsWbody2) to rsNa2.
                        When COtherwise (rsOb):
                            Let rsOb2 be renameStmts(rsOb, m, refs, writes).
                            Push (a new COtherwise with body rsOb2) to rsNa2.
                Push (a new CInspect with target rsNt2 and arms rsNa2) to rsOut.
            When CRuntimeAssert (rsAc, rsAm):
                Let rsAc2 be renameExpr(rsAc, m, refs, writes).
                Let rsAm2 be renameExpr(rsAm, m, refs, writes).
                Push (a new CRuntimeAssert with cond rsAc2 and msg rsAm2) to rsOut.
            When CHardAssert (rsHc, rsHm):
                Let rsHc2 be renameExpr(rsHc, m, refs, writes).
                Let rsHm2 be renameExpr(rsHm, m, refs, writes).
                Push (a new CHardAssert with cond rsHc2 and msg rsHm2) to rsOut.
            When CFail (rsFr):
                Let rsFr2 be renameExpr(rsFr, m, refs, writes).
                Push (a new CFail with reason rsFr2) to rsOut.
            Otherwise:
                Push "__pe_unsupported" to refs.
                Push rsS to rsOut.
    Return rsOut.

## To collectBinders (stmts: Seq of CStmt) and (found: mutable Seq of Text):
    Repeat for cbS in stmts:
        Inspect cbS:
            When CLet (cbLn, cbLe):
                Let cbLk be "{cbLn}".
                If not found contains cbLk:
                    Push cbLk to found.
            When CPopInto (cbPiT, cbPiI):
                Let cbPik be "{cbPiI}".
                If not found contains cbPik:
                    Push cbPik to found.
            When CIf (cbIc, cbIt, cbIe):
                collectBinders(cbIt, found).
                collectBinders(cbIe, found).
            When CWhile (cbWc, cbWb):
                collectBinders(cbWb, found).
            When CRepeat (cbRv, cbRc, cbRb):
                Let cbRk be "{cbRv}".
                If not found contains cbRk:
                    Push cbRk to found.
                collectBinders(cbRb, found).
            When CRepeatRange (cbQv, cbQs, cbQe, cbQb):
                Let cbQk be "{cbQv}".
                If not found contains cbQk:
                    Push cbQk to found.
                collectBinders(cbQb, found).
            When CInspect (cbNt, cbNa):
                Repeat for cbArm in cbNa:
                    Inspect cbArm:
                        When CWhen (cbWn, cbWbs, cbWbody):
                            Repeat for cbB in cbWbs:
                                Let cbBk be "{cbB}".
                                If not found contains cbBk:
                                    Push cbBk to found.
                            collectBinders(cbWbody, found).
                        When COtherwise (cbOb):
                            collectBinders(cbOb, found).
            Otherwise:
                Let cbSkip be true.

## To containsReturn (stmts: Seq of CStmt) -> Bool:
    Repeat for crS in stmts:
        Inspect crS:
            When CReturn (crE):
                Return true.
            When CIf (crIc, crIt, crIe):
                If containsReturn(crIt):
                    Return true.
                If containsReturn(crIe):
                    Return true.
            When CWhile (crWc, crWb):
                If containsReturn(crWb):
                    Return true.
            When CRepeat (crRv, crRc, crRb):
                If containsReturn(crRb):
                    Return true.
            When CRepeatRange (crQv, crQs, crQe, crQb):
                If containsReturn(crQb):
                    Return true.
            When CInspect (crNt, crNa):
                Repeat for crArm in crNa:
                    Inspect crArm:
                        When CWhen (crWn, crWbs, crWbody):
                            If containsReturn(crWbody):
                                Return true.
                        When COtherwise (crOb):
                            If containsReturn(crOb):
                                Return true.
            Otherwise:
                Let crSkip be true.
    Return false.

## To unfoldResult (params: Seq of Text) and (args: Seq of CExpr) and (mutableParam: Bool) and (body: Seq of CStmt) and (state: mutable PEState) -> CExpr:
    Let ufNo be a new CVar with name "__pe_no_unfold".
    Let ufN be length of body.
    If ufN equals 0:
        Return ufNo.
    Let ufLast be item ufN of body.
    Let mutable ufRet be a new CVar with name "__pe_no_unfold".
    Let mutable ufHasRet be false.
    Let mutable ufFails be false.
    Inspect ufLast:
        When CReturn (ufRe):
            Set ufRet to ufRe.
            Set ufHasRet to true.
        When CFail (ufFr):
            Set ufRet to a new CVar with name "__pe_bottom".
            Set ufFails to true.
        Otherwise:
            Let ufSkip0 be true.
    If not ufHasRet and not ufFails:
        Return ufNo.
    Let ufPrefix be a new Seq of CStmt.
    Let mutable ufI be 1.
    Repeat for ufS in body:
        If ufI is less than ufN or ufFails:
            Push ufS to ufPrefix.
        Set ufI to ufI + 1.
    If containsReturn(ufPrefix):
        Return ufNo.
    If length of ufPrefix is greater than 0:
        If not hoistActive((peSpecResults(state))):
            Return ufNo.
        If mutableParam:
            Return ufNo.
    Let ufBinders be a new Seq of Text.
    collectBinders(ufPrefix, ufBinders).
    Let ufEmpty be a new Map of Text to Text.
    Let ufRefs be a new Seq of Text.
    Let ufWrites be a new Seq of Text.
    Let ufProbeBody be renameStmts(ufPrefix, ufEmpty, ufRefs, ufWrites).
    Let ufProbeRet be renameExpr(ufRet, ufEmpty, ufRefs, ufWrites).
    If ufRefs contains "__pe_unsupported":
        Return ufNo.
    Repeat for ufW in ufWrites:
        If not ufBinders contains ufW:
            If not peStartsWith(ufW, "pkv__"):
                Return ufNo.
    If length of ufPrefix is greater than 0:
        Repeat for ufR in ufRefs:
            If not ufBinders contains ufR and not (ufR equals "__pe_bottom"):
                If not params contains ufR:
                    If not peStartsWith(ufR, "pkv__"):
                        Return ufNo.
    Let ufMap be a new Map of Text to Text.
    Let ufPre be a new Seq of CStmt.
    Let mutable ufPi be 1.
    Repeat for ufP in params:
        Let ufPk be "{ufP}".
        If ufRefs contains ufPk:
            Let ufArg be item ufPi of args.
            Let mutable ufBound be false.
            Inspect ufArg:
                When CVar (ufAv):
                    Let ufPkV be "{ufP}".
                    Set item ufPkV of ufMap to ufAv.
                    Set ufBound to true.
                Otherwise:
                    Let ufSkipA be true.
            If not ufBound:
                If not hoistActive((peSpecResults(state))):
                    Return ufNo.
                Let ufPkF be "{ufP}".
                Let ufFresh be freshNameSt(state, ufPkF).
                Let ufFreshK be "{ufFresh}".
                Let ufPkM be "{ufP}".
                Set item ufPkM of ufMap to ufFreshK.
                Let ufArgC be ufArg.
                Push (a new CLet with name ufFresh and expr ufArgC) to ufPre.
        Set ufPi to ufPi + 1.
    Repeat for ufB in ufBinders:
        Let ufBk be "{ufB}".
        Let ufBk2 be "{ufB}".
        Set item ufBk of ufMap to freshNameSt(state, ufBk2).
    Let ufJunkR be a new Seq of Text.
    Let ufJunkW be a new Seq of Text.
    Let ufBody2 be renameStmts(ufPrefix, ufMap, ufJunkR, ufJunkW).
    Let ufRet2 be renameExpr(ufRet, ufMap, ufJunkR, ufJunkW).
    Repeat for ufB2 in ufBody2:
        Push ufB2 to ufPre.
    If length of ufPre is greater than 0:
        hoistAppendSt(state, ufPre).
    Return ufRet2.

## To anyMutableParam (types: Seq of Text) -> Bool:
    Repeat for amT in types:
        If amT contains "mutable":
            Return true.
    Return false.

## To callMutVars (cmvName: Text) and (cmvArgs: Seq of CExpr) and (cmvFuncs: Map of Text to CFunc) -> Seq of Text:
    Let cmvOut be a new Seq of Text.
    Let cmvKey be "{cmvName}".
    If cmvFuncs contains cmvKey:
        Let cmvF be item cmvKey of cmvFuncs.
        Inspect cmvF:
            When CFuncDef (cmvN, cmvPs, cmvTs, cmvR, cmvB):
                Let mutable cmvI be 1.
                Repeat for cmvT in cmvTs:
                    If cmvT contains "mutable":
                        If cmvI is at most (length of cmvArgs):
                            Let cmvA be item cmvI of cmvArgs.
                            Inspect cmvA:
                                When CVar (cmvV):
                                    Let cmvVk be "{cmvV}".
                                    Push cmvVk to cmvOut.
                                Otherwise:
                                    Let cmvSkipA be true.
                    Set cmvI to cmvI + 1.
            Otherwise:
                Let cmvSkipF be true.
    Return cmvOut.

## To exprMutVars (emE: CExpr) and (emFuncs: Map of Text to CFunc) and (emOut: mutable Seq of Text):
    Inspect emE:
        When CCall (emFn, emArgs):
            Let emMv be callMutVars(emFn, emArgs, emFuncs).
            Repeat for emV in emMv:
                Push emV to emOut.
            Repeat for emA in emArgs:
                exprMutVars(emA, emFuncs, emOut).
        When CBinOp (emOp, emL, emR):
            exprMutVars(emL, emFuncs, emOut).
            exprMutVars(emR, emFuncs, emOut).
        When CNot (emN):
            exprMutVars(emN, emFuncs, emOut).
        When CIndex (emIc, emIi):
            exprMutVars(emIc, emFuncs, emOut).
            exprMutVars(emIi, emFuncs, emOut).
        When CLen (emLt):
            exprMutVars(emLt, emFuncs, emOut).
        When CMapGet (emMt, emMk):
            exprMutVars(emMt, emFuncs, emOut).
            exprMutVars(emMk, emFuncs, emOut).
        When CNewVariant (emVt, emVn, emVv):
            Repeat for emVx in emVv:
                exprMutVars(emVx, emFuncs, emOut).
        When CList (emLi):
            Repeat for emLx in emLi:
                exprMutVars(emLx, emFuncs, emOut).
        When CRange (emRs, emRe):
            exprMutVars(emRs, emFuncs, emOut).
            exprMutVars(emRe, emFuncs, emOut).
        When CSlice (emSc, emSs, emSe):
            exprMutVars(emSc, emFuncs, emOut).
            exprMutVars(emSs, emFuncs, emOut).
            exprMutVars(emSe, emFuncs, emOut).
        When CCopy (emCt):
            exprMutVars(emCt, emFuncs, emOut).
        When CContains (emCc, emCe):
            exprMutVars(emCc, emFuncs, emOut).
            exprMutVars(emCe, emFuncs, emOut).
        When CUnion (emUl, emUr):
            exprMutVars(emUl, emFuncs, emOut).
            exprMutVars(emUr, emFuncs, emOut).
        When CIntersection (emXl, emXr):
            exprMutVars(emXl, emFuncs, emOut).
            exprMutVars(emXr, emFuncs, emOut).
        When COptionSome (emOi):
            exprMutVars(emOi, emFuncs, emOut).
        When CTuple (emTi):
            Repeat for emTx in emTi:
                exprMutVars(emTx, emFuncs, emOut).
        When CNew (emNt, emNn, emNv):
            Repeat for emNx in emNv:
                exprMutVars(emNx, emFuncs, emOut).
        When CFieldAccess (emFt, emFf):
            exprMutVars(emFt, emFuncs, emOut).
        When CCallExpr (emCt2, emCa):
            exprMutVars(emCt2, emFuncs, emOut).
            Repeat for emCx in emCa:
                exprMutVars(emCx, emFuncs, emOut).
        When CInterpolatedString (emParts):
            Repeat for emPart in emParts:
                Inspect emPart:
                    When CExprPart (emPe):
                        exprMutVars(emPe, emFuncs, emOut).
                    When CFormattedPart (emFe, emFs, emFf, emFz):
                        exprMutVars(emFe, emFuncs, emOut).
                    Otherwise:
                        Let emSkipP be true.
        When CManifestOf (emMz):
            exprMutVars(emMz, emFuncs, emOut).
        When CChunkAt (emCi, emCz):
            exprMutVars(emCi, emFuncs, emOut).
            exprMutVars(emCz, emFuncs, emOut).
        Otherwise:
            Let emSkip be true.

## To stmtMutVars (smS: CStmt) and (smFuncs: Map of Text to CFunc) and (smOut: mutable Seq of Text):
    Inspect smS:
        When CLet (smLn, smLe):
            exprMutVars(smLe, smFuncs, smOut).
        When CSet (smSn, smSe):
            exprMutVars(smSe, smFuncs, smOut).
        When CShow (smSh):
            exprMutVars(smSh, smFuncs, smOut).
        When CReturn (smRe):
            exprMutVars(smRe, smFuncs, smOut).
        When CPush (smPe, smPt):
            exprMutVars(smPe, smFuncs, smOut).
        When CSetIdx (smXt, smXi, smXv):
            exprMutVars(smXi, smFuncs, smOut).
            exprMutVars(smXv, smFuncs, smOut).
        When CMapSet (smMt, smMk, smMv):
            exprMutVars(smMk, smFuncs, smOut).
            exprMutVars(smMv, smFuncs, smOut).
        When CSetField (smFt, smFf, smFv):
            exprMutVars(smFv, smFuncs, smOut).
        When CIf (smIc, smIt, smIe):
            exprMutVars(smIc, smFuncs, smOut).
        When CWhile (smWc, smWb):
            exprMutVars(smWc, smFuncs, smOut).
        When CRepeat (smRv, smRc, smRb):
            exprMutVars(smRc, smFuncs, smOut).
        When CRepeatRange (smQv, smQs, smQe, smQb):
            exprMutVars(smQs, smFuncs, smOut).
            exprMutVars(smQe, smFuncs, smOut).
        When CInspect (smNt, smNa):
            exprMutVars(smNt, smFuncs, smOut).
        When CCallS (smCn, smCa):
            Let smMv be callMutVars(smCn, smCa, smFuncs).
            Repeat for smV in smMv:
                Push smV to smOut.
            Repeat for smA in smCa:
                exprMutVars(smA, smFuncs, smOut).
        When CRuntimeAssert (smAc, smAm):
            exprMutVars(smAc, smFuncs, smOut).
            exprMutVars(smAm, smFuncs, smOut).
        When CHardAssert (smHc, smHm):
            exprMutVars(smHc, smFuncs, smOut).
            exprMutVars(smHm, smFuncs, smOut).
        When CFail (smFr):
            exprMutVars(smFr, smFuncs, smOut).
        When CAtPath (smAr, smAp, smAb):
            Repeat for smAw in smAb:
                stmtMutVars(smAw, smFuncs, smOut).
        Otherwise:
            Let smSkip be true.

## To peMaterializeVars (pmvNames: Seq of Text) and (state: mutable PEState) -> Seq of CStmt:
    Let mutable pmvOut be a new Seq of CStmt.
    Repeat for pmvX in pmvNames:
        Let pmvK be "{pmvX}".
        If (peStaticEnv(state)) contains pmvK:
            Let pmvK2 be "{pmvX}".
            Let pmvVal be item pmvK2 of (peStaticEnv(state)).
            Let pmvK3 be "{pmvX}".
            peDeclareDynamic(pmvK3, pmvVal, state, pmvOut).
            Let pmvK4 be "{pmvX}".
            peStSeDrop(state, pmvK4).
            Let pmvK5 be "{pmvX}".
            peStEnvDynamic(state, pmvK5).
    Return pmvOut.

## To peMutArgs (pmaName: Text) and (pmaArgs: Seq of CExpr) and (pmaPeArgs: Seq of CExpr) and (pmaFuncs: Map of Text to CFunc) -> Seq of CExpr:
    Let pmaOut be copy of pmaPeArgs.
    Let pmaKey be "{pmaName}".
    If pmaFuncs contains pmaKey:
        Let pmaF be item pmaKey of pmaFuncs.
        Inspect pmaF:
            When CFuncDef (pmaN, pmaPs, pmaTs, pmaR, pmaB):
                Let pmaRebuilt be a new Seq of CExpr.
                Let mutable pmaI be 1.
                Repeat for pmaPe in pmaPeArgs:
                    Let mutable pmaArg be copy of pmaPe.
                    If pmaI is at most (length of pmaTs):
                        Let pmaT be item pmaI of pmaTs.
                        If pmaT contains "mutable":
                            Let pmaOrig be item pmaI of pmaArgs.
                            Inspect pmaOrig:
                                When CVar (pmaV):
                                    Set pmaArg to copy of pmaOrig.
                                Otherwise:
                                    Let pmaSkipV be true.
                    Push pmaArg to pmaRebuilt.
                    Set pmaI to pmaI + 1.
                Return pmaRebuilt.
            Otherwise:
                Let pmaSkipF be true.
    Return pmaOut.

## To isNoInline (nis: Seq of CStmt) -> Bool:
    If length of nis equals 1:
        Let nisS be item 1 of nis.
        Inspect nisS:
            When CEscStmt (nisCode):
                Return nisCode equals "__pe_no_inline".
            Otherwise:
                Return false.
    Return false.

## To peInlineBody (ibName: Text) and (ibArgs: Seq of CExpr) and (ibPeArgs: Seq of CExpr) and (wantValue: Bool) and (state: mutable PEState) -> Seq of CStmt:
    Let ibNo be a new Seq of CStmt.
    Push (a new CEscStmt with code "__pe_no_inline") to ibNo.
    Let ibDepth be peDepth(state).
    If ibDepth is at most 0:
        Return ibNo.
    Let ibFk be "{ibName}".
    If not ((peFuncs(state)) contains ibFk):
        Return ibNo.
    Let ibF be item ibFk of (peFuncs(state)).
    Inspect ibF:
        When CFuncDef (ibFn, ibParams, ibTypes, ibRet, ibBody):
            Let ibMap be a new Map of Text to Text.
            Let ibMutVars be a new Seq of Text.
            Let ibKeyArgs be a new Seq of CExpr.
            Let ibIsMut be a new Seq of Bool.
            Let mutable ibAllStatic be true.
            Let mutable ibI be 1.
            Repeat for ibP in ibParams:
                Let mutable ibMut be false.
                If ibI is at most (length of ibTypes):
                    Let ibT be item ibI of ibTypes.
                    If ibT contains "mutable":
                        Let ibA be item ibI of ibArgs.
                        Inspect ibA:
                            When CVar (ibAv):
                                Let ibPk be "{ibP}".
                                Let ibAvk be "{ibAv}".
                                Set item ibPk of ibMap to ibAvk.
                                Let ibAvk2 be "{ibAv}".
                                Push ibAvk2 to ibMutVars.
                                Set ibMut to true.
                                Let ibAvk3 be "{ibAv}".
                                If (peStaticEnv(state)) contains ibAvk3:
                                    Let ibShadow be item ibAvk3 of (peStaticEnv(state)).
                                    Push ibShadow to ibKeyArgs.
                                Otherwise:
                                    Set ibAllStatic to false.
                                    Push (a new CVar with name "__dyn__") to ibKeyArgs.
                            Otherwise:
                                Let ibSkipA be true.
                If not ibMut:
                    Let ibPk2 be "{ibP}".
                    Let ibPk3 be "{ibP}".
                    Set item ibPk2 of ibMap to freshNameSt(state, ibPk3).
                    Let ibPa be item ibI of ibPeArgs.
                    If not isStatic(ibPa):
                        Set ibAllStatic to false.
                    Push ibPa to ibKeyArgs.
                Push ibMut to ibIsMut.
                Set ibI to ibI + 1.
            Let ibKey0 be makeKey(ibName, ibKeyArgs).
            Let ibKey be "__inl_{ibKey0}".
            If (peOnStack(state)) contains ibKey:
                Return ibNo.
            Let ibFnMark be "__inl_fn_{ibName}".
            If not ibAllStatic:
                If (peOnStack(state)) contains ibFnMark:
                    Return ibNo.
            Let ibBinders be a new Seq of Text.
            collectBinders(ibBody, ibBinders).
            Repeat for ibB in ibBinders:
                Let ibBk be "{ibB}".
                If not (ibMap contains ibBk):
                    Let ibBk2 be "{ibB}".
                    Let ibBk3 be "{ibB}".
                    Set item ibBk2 of ibMap to freshNameSt(state, ibBk3).
            Let ibRefs be a new Seq of Text.
            Let ibWrites be a new Seq of Text.
            Let ibRenamed be renameStmts(ibBody, ibMap, ibRefs, ibWrites).
            If length of ibRefs is greater than 0:
                Return ibNo.
            If length of ibWrites is greater than 0:
                Return ibNo.
            Let ibEnv be peEnvShallow((peEnv(state))).
            Let ibSe be peSeShallow((peStaticEnv(state))).
            Let ibPre be a new Seq of CStmt.
            Let mutable ibJ be 1.
            Repeat for ibP2 in ibParams:
                Let ibMutJ be item ibJ of ibIsMut.
                If not ibMutJ:
                    Let ibPk4 be "{ibP2}".
                    Let ibQ be item ibPk4 of ibMap.
                    Let ibArgJ be item ibJ of ibPeArgs.
                    If isStaticValue(ibArgJ):
                        Let ibQk be "{ibQ}".
                        peEnvBind(ibEnv, ibQk, exprToVal(ibArgJ)).
                        Let ibQk2 be "{ibQ}".
                        peSeBind(ibSe, ibQk2, ibArgJ).
                        Let ibQk6 be "{ibQ}".
                        peSeIndex(ibSe, ibQk6, ibArgJ).
                    Otherwise:
                        Let ibQk3 be "{ibQ}".
                        Let ibArgC be ibArgJ.
                        Push (a new CLet with name ibQk3 and expr ibArgC) to ibPre.
                        Let ibQk4 be "{ibQ}".
                        peEnvDynamic(ibEnv, ibQk4).
                        If isPeValueForCopyProp(ibArgJ):
                            Let ibQk5 be "{ibQ}".
                            peSeBind(ibSe, ibQk5, ibArgJ).
                            Let ibQk7 be "{ibQ}".
                            peSeIndex(ibSe, ibQk7, ibArgJ).
                Set ibJ to ibJ + 1.
            Let ibStack be copy of (peOnStack(state)).
            peOsPush(ibStack, ibKey).
            Let ibFnMark2 be "{ibFnMark}".
            peOsPush(ibStack, ibFnMark2).
            Let mutable ibState be a new PEStateR with env ibEnv and funcs (peFuncs(state)) and depth (ibDepth - 1) and staticEnv ibSe and specResults (peSpecResults(state)) and onStack ibStack.
            Let ibPe be specializeStmts(ibRenamed, ibState).
            peAbsorb(state, ibState).
            Let ibN be length of ibPe.
            If wantValue:
                If ibN equals 0:
                    Return ibNo.
                Let ibLast be item ibN of ibPe.
                Let mutable ibHasRet be false.
                Let mutable ibFails be false.
                Inspect ibLast:
                    When CReturn (ibRe):
                        Set ibHasRet to true.
                    When CFail (ibFr):
                        Set ibFails to not containsReturn(ibPe).
                    Otherwise:
                        Let ibSkipR be true.
                If not ibFails and (not ibHasRet or containsReturn(truncateStmts(ibPe, ibN - 1))):
                    If hoistActive((peSpecResults(state))):
                        Let ibTree be peNormalizeReturns(ibPe).
                        If peIsReturnTree(ibTree):
                            Let ibTreeLast be item (length of ibTree) of ibTree.
                            If peBranches(ibTreeLast):
                                Let mutable ibSplit be a new Seq of CStmt.
                                Repeat for ibPs in ibPre:
                                    Push ibPs to ibSplit.
                                Repeat for ibTs in ibTree:
                                    Push ibTs to ibSplit.
                                Let ibNoP be a new Seq of Text.
                                Let ibNoC be a new Seq of Text.
                                peStSrBind(state, "__pe_split_tree", a new CClosure with params ibNoP and body ibSplit and captured ibNoC).
                                Let ibMarker be a new Seq of CStmt.
                                Push (a new CEscStmt with code "__pe_split") to ibMarker.
                                Return ibMarker.
                If not ibHasRet and not ibFails:
                    Return ibNo.
                Let ibPrefix be a new Seq of CStmt.
                Let mutable ibK be 1.
                Repeat for ibS in ibPe:
                    If ibK is less than ibN:
                        Push ibS to ibPrefix.
                    Set ibK to ibK + 1.
                If containsReturn(ibPrefix):
                    Return ibNo.
                If (length of ibPrefix) + (length of ibPre) is greater than 0:
                    If not hoistActive((peSpecResults(state))):
                        Return ibNo.
            Otherwise:
                If containsReturn(ibPe):
                    Return ibNo.
            Let ibSeAfter be peStaticEnv(ibState).
            Let ibEnvAfter be peEnv(ibState).
            Repeat for ibX in ibMutVars:
                Let ibXk be "{ibX}".
                If ibSeAfter contains ibXk:
                    Let ibXk2 be "{ibX}".
                    Let ibXv be item ibXk2 of ibSeAfter.
                    Let ibXk3 be "{ibX}".
                    peStSeBind(state, ibXk3, ibXv).
                Otherwise:
                    Let ibXk4 be "{ibX}".
                    If (peStaticEnv(state)) contains ibXk4:
                        Let ibXk5 be "{ibX}".
                        peStSeDrop(state, ibXk5).
                Let ibXk6 be "{ibX}".
                If ibEnvAfter contains ibXk6:
                    Let ibXk7 be "{ibX}".
                    Let ibXk8 be "{ibX}".
                    peStEnvBind(state, ibXk7, (item ibXk8 of ibEnvAfter)).
                If isResidualVar(ibEnvAfter, ibX):
                    peStMark(state, ibX).
            Let ibOut be copy of ibPre.
            Repeat for ibPs in ibPe:
                Push ibPs to ibOut.
            Return ibOut.
        Otherwise:
            Return ibNo.

## To breaksBelow (bbS: CStmt) -> Bool:
    Inspect bbS:
        When CIf (bbC, bbT, bbE):
            If blockBreaks(bbT):
                Return true.
            Return blockBreaks(bbE).
        When CInspect (bbNt, bbNa):
            Repeat for bbArm in bbNa:
                Inspect bbArm:
                    When CWhen (bbWn, bbWbs, bbWbody):
                        If blockBreaks(bbWbody):
                            Return true.
                    When COtherwise (bbOb):
                        If blockBreaks(bbOb):
                            Return true.
            Return false.
        When CZone (bbZn, bbZk, bbZb):
            Return blockBreaks(bbZb).
        Otherwise:
            Return false.

## To blockBreaks (bkStmts: Seq of CStmt) -> Bool:
    Repeat for bkS in bkStmts:
        Inspect bkS:
            When CBreak:
                Return true.
            Otherwise:
                If breaksBelow(bkS):
                    Return true.
    Return false.

## To loopExitOf (leStmts: Seq of CStmt) -> Text:
    Repeat for leS in leStmts:
        Inspect leS:
            When CBreak:
                Return "break".
            When CReturn (leR):
                Return "return".
            When CFail (leF):
                Return "fail".
            Otherwise:
                If breaksBelow(leS):
                    Return "nested".
    Return "none".

## To peRestoreEnv (preM: mutable Map of Text to CVal) and (preSnap: Map of Text to CVal):
    Let preDrop be a new Seq of Text.
    Repeat for (preK, preV) in preM:
        If not (preSnap contains preK):
            Let preKd be "{preK}".
            Push preKd to preDrop.
    Repeat for preD in preDrop:
        Remove preD from preM.
    Repeat for (preK2, preV2) in preSnap:
        Let preK3 be "{preK2}".
        Set item preK3 of preM to preV2.

## To peRestoreSe (prsM: mutable Map of Text to CExpr) and (prsSnap: Map of Text to CExpr):
    Let prsDrop be a new Seq of Text.
    Repeat for (prsK, prsV) in prsM:
        If not (prsSnap contains prsK):
            Let prsKd be "{prsK}".
            Push prsKd to prsDrop.
    Repeat for prsD in prsDrop:
        Remove prsD from prsM.
    Repeat for (prsK2, prsV2) in prsSnap:
        Let prsK3 be "{prsK2}".
        Set item prsK3 of prsM to prsV2.

## To truncateStmts (tsStmts: Seq of CStmt) and (tsN: Int) -> Seq of CStmt:
    Let tsOut be a new Seq of CStmt.
    Let mutable tsI be 1.
    Repeat for tsS in tsStmts:
        If tsI is at most tsN:
            Push tsS to tsOut.
        Set tsI to tsI + 1.
    Return tsOut.

## To staticIterItems (siColl: CExpr) -> Seq of CExpr:
    Let siNo be a new Seq of CExpr.
    Push (a new CVar with name "__pe_not_iterable") to siNo.
    If not isStatic(siColl):
        Return siNo.
    Inspect siColl:
        When CNewSeq (peSeqElem9):
            Return a new Seq of CExpr.
        When CNewSet (peSetElem8):
            Return a new Seq of CExpr.
        When CList (siListItems):
            Return siListItems.
        When CRange (siRs, siRe):
            Inspect siRs:
                When CInt (siFrom):
                    Inspect siRe:
                        When CInt (siTo):
                            If siTo is less than siFrom:
                                Return a new Seq of CExpr.
                            If siTo - siFrom is less than 1024:
                                Let mutable siRange be a new Seq of CExpr.
                                Let mutable siAt be siFrom.
                                While siAt is at most siTo:
                                    Push (a new CInt with value siAt) to siRange.
                                    Set siAt to siAt + 1.
                                Return siRange.
                        Otherwise:
                            Let siSkipE be true.
                Otherwise:
                    Let siSkipS be true.
            Return siNo.
        When CText (siText):
            Let siChars be a new Seq of CExpr.
            Repeat for siCh in siText:
                Push (a new CText with value siCh) to siChars.
            Return siChars.
        When CNew (siTy, siNames, siVals):
            If peIsSetType(siTy):
                Return siVals.
            If peIsMapType(siTy):
                Let siPairs be a new Seq of CExpr.
                Let mutable siI be 1.
                Repeat for siKey in siNames:
                    Let siPair be a new Seq of CExpr.
                    Push (a new CText with value siKey) to siPair.
                    Push (item siI of siVals) to siPair.
                    Push (a new CTuple with items siPair) to siPairs.
                    Set siI to siI + 1.
                Return siPairs.
            Return siNo.
        Otherwise:
            Return siNo.

## To isNotIterable (niItems: Seq of CExpr) -> Bool:
    If length of niItems equals 1:
        Let niX be item 1 of niItems.
        Inspect niX:
            When CVar (niName):
                Return niName equals "__pe_not_iterable".
