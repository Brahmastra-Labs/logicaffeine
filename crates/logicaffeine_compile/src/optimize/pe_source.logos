## To peBuiltinKnown (pbName: Text) -> Bool:
    Return (pbName equals "mapOf") or (pbName equals "setOf") or (pbName equals "chr").

## To isTrivialCapture (tcE: CExpr) -> Bool:
    If isStatic(tcE):
        Return true.
    Inspect tcE:
        When CVar (tcN):
            Return true.
        When CNew (tcTy, tcNames, tcFields):
            Repeat for tcF in tcFields:
                If not isTrivialCapture(tcF):
                    Return false.
            Return true.
        When CNewVariant (tcTag, tcVn, tcVv):
            Repeat for tcV in tcVv:
                If not isTrivialCapture(tcV):
                    Return false.
            Return true.
        When CList (tcItems):
            Repeat for tcI in tcItems:
                If not isTrivialCapture(tcI):
                    Return false.
            Return true.
        When CTuple (tcTup):
            Repeat for tcT in tcTup:
                If not isTrivialCapture(tcT):
                    Return false.
            Return true.
        When COptionSome (tcInner):
            Return isTrivialCapture(tcInner).
        Otherwise:
            Return false.

## To setRecordField (srRec: CExpr) and (srField: Text) and (srVal: CExpr) -> CExpr:
    Let srNo be a new CVar with name "__pe_no_unfold".
    If not (isTrivialCapture(srVal) and isCopyPropSafe(srVal)):
        Return srNo.
    Inspect srRec:
        When CNew (srTy, srNames, srVals):
            If peIsMapType(srTy) or peIsSetType(srTy):
                Return srNo.
            If not (srNames contains srField):
                Return srNo.
            Let srNewVals be a new Seq of CExpr.
            Let mutable srI be 1.
            Repeat for srName in srNames:
                If srName equals srField:
                    Push srVal to srNewVals.
                Otherwise:
                    Push (item srI of srVals) to srNewVals.
                Set srI to srI + 1.
            Let srNamesCopy be copy of srNames.
            Let srTyCopy be "{srTy}".
            Return a new CNew with typeName srTyCopy and fieldNames srNamesCopy and fields srNewVals.
        Otherwise:
            Return srNo.

## To peApplyClosure (acParams: Seq of Text) and (acBody: Seq of CStmt) and (acArgs: Seq of CExpr) and (state: mutable PEState) -> CExpr:
    Let acEnv be peEnvShallow((peEnv(state))).
    Let acSe be peSeShallow((peStaticEnv(state))).
    Let mutable acI be 1.
    Repeat for acP in acParams:
        If acI is at most (length of acArgs):
            Let acArg be item acI of acArgs.
            Let acPk be "{acP}".
            Let acArgC be acArg.
            Set item acPk of acSe to acArgC.
            Let acPk3 be "{acP}".
            peSeIndex(acSe, acPk3, acArg).
            Let acPk2 be "{acP}".
            If isStatic(acArg):
                Set item acPk2 of acEnv to exprToVal(acArg).
            Otherwise:
                peEnvDynamic(acEnv, acPk2).
        Set acI to acI + 1.
    Let mutable acState be a new PEStateR with env acEnv and funcs (peFuncs(state)) and depth ((peDepth(state)) - 1) and staticEnv acSe and specResults (peSpecResults(state)) and onStack (peOnStack(state)).
    Let acBodyRes be peBlock(acBody, acState).
    peAbsorb(state, acState).
    Let acNoParams be a new Seq of Text.
    Let acNoArgs be a new Seq of CExpr.
    Return unfoldResult(acNoParams, acNoArgs, false, acBodyRes, state).

## To peExpr (e: CExpr) and (state: mutable PEState) -> CExpr:
    Let depth be peDepth(state).
    Inspect e:
        When CInt (v):
            Return a new CInt with value v.
        When CBool (v):
            Return a new CBool with value v.
        When CText (v):
            Return a new CText with value v.
        When CVar (varName):
            Let svn be "{varName}".
            If (peStaticEnv(state)) contains svn:
                Let staticVal be item svn of (peStaticEnv(state)).
                Return staticVal.
            Let vn be "{varName}".
            If (peEnv(state)) contains vn:
                Let val be item vn of (peEnv(state)).
                Let dyn be isVNothing(val).
                If dyn:
                    Return a new CVar with name varName.
                Return valToExpr(val).
            Return a new CVar with name varName.
        When CBinOp (binOp, left, right):
            If binOp equals "&&" or binOp equals "||":
                Let scLeft be peExpr(left, state).
                Inspect scLeft:
                    When CBool (scB):
                        If binOp equals "&&":
                            If not scB:
                                Return a new CBool with value false.
                        Otherwise:
                            If scB:
                                Return a new CBool with value true.
                        Let scDecided be peExpr(right, state).
                        Inspect scDecided:
                            When CBool (scRb):
                                Return a new CBool with value scRb.
                            Otherwise:
                                Return a new CBinOp with op binOp and left scLeft and right scDecided.
                    Otherwise:
                        Let scSkip be true.
                Let scMut be a new Seq of Text.
                exprMutVars(right, (peFuncs(state)), scMut).
                If length of scMut is greater than 0:
                    Let scPre be peMaterializeVars(scMut, state).
                    If length of scPre is greater than 0:
                        If hoistActive((peSpecResults(state))):
                            hoistAppendSt(state, scPre).
                        Otherwise:
                            Return a new CEscExpr with code "__pe_unsound_inout".
                Let scSaved be hoistSuspendSt(state).
                Let scRight be peExpr(right, state).
                hoistRestoreSt(state, scSaved).
                Return a new CBinOp with op binOp and left scLeft and right scRight.
            Let peLeft be peExpr(left, state).
            Let peRight be peExpr(right, state).
            Let seqFolded be peFoldSeqOp(binOp, peLeft, peRight).
            If not isNoUnfold(seqFolded):
                Return seqFolded.
            Let leftLit be isLiteral(peLeft).
            Let rightLit be isLiteral(peRight).
            If leftLit and rightLit:
                Let lv be exprToVal(peLeft).
                Let rv be exprToVal(peRight).
                Let computed be evalBinOp(binOp, lv, rv).
                Let unfoldable be isVNothing(computed).
                If unfoldable:
                    Return a new CBinOp with op binOp and left peLeft and right peRight.
                Return valToExpr(computed).
            If binOp equals "==":
                Let negFalse be checkNegEq(peLeft, peRight, state).
                If negFalse:
                    Return a new CBool with value false.
                Let negFalse2 be checkNegEq(peRight, peLeft, state).
                If negFalse2:
                    Return a new CBool with value false.
            Return a new CBinOp with op binOp and left peLeft and right peRight.
        When CNot (inner):
            Let peInner be peExpr(inner, state).
            Let innerLit be isLiteral(peInner).
            If innerLit:
                Inspect peInner:
                    When CBool (b):
                        Return a new CBool with value (not b).
                    Otherwise:
                        Return a new CNot with inner peInner.
            Return a new CNot with inner peInner.
        When CCall (fnName, argExprs):
            Let mutable splitOk be false.
            If (peSpecResults(state)) contains "__pe_split_ok":
                Set splitOk to true.
                peStSrDrop(state, "__pe_split_ok").
            If depth is at most 0:
                Let residArgs be a new Seq of CExpr.
                Repeat for a in argExprs:
                    Let mutable d0State be peStateWithDepth(state, 0).
                    Push peExpr(a, d0State) to residArgs.
                    peAbsorbAll(state, d0State).
                Return a new CCall with name fnName and args residArgs.
            Let fn1 be "{fnName}".
            Let peArgs be a new Seq of CExpr.
            Repeat for a in argExprs:
                Push peExpr(a, state) to peArgs.
            If peIsSpecialized(fn1, state):
                Return a new CCall with name fn1 and args peArgs.
            If not ((peFuncs(state)) contains fn1):
                If allStatic(peArgs):
                    Let pfFolded be peFoldBuiltin(fn1, peArgs).
                    If not isNoUnfold(pfFolded):
                        Return pfFolded.
                If peBuiltinKnown(fn1):
                    If allStatic(peArgs):
                        Let bfFolded be foldBuiltinCtor(fn1, peArgs).
                        If not isNoUnfold(bfFolded):
                            Return bfFolded.
