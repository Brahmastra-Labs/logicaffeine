## To foldBuiltinCtor (fbName: Text) and (fbArgs: Seq of CExpr) -> CExpr:
    Let fbNo be a new CVar with name "__pe_no_unfold".
    If fbName equals "mapOf":
        Let fbKeys be a new Seq of Text.
        Let mutable fbVals be a new Seq of CExpr.
        Let mutable fbI be 1.
        While fbI is less than (length of fbArgs):
            Let fbK be item fbI of fbArgs.
            Inspect fbK:
                When CText (fbKt):
                    Let fbKt2 be "{fbKt}".
                    If fbKeys contains fbKt2:
                        Let fbNewVals be a new Seq of CExpr.
                        Let mutable fbJ be 1.
                        Repeat for fbExisting in fbKeys:
                            If fbExisting equals fbKt2:
                                Push (item (fbI + 1) of fbArgs) to fbNewVals.
                            Otherwise:
                                Push (item fbJ of fbVals) to fbNewVals.
                            Set fbJ to fbJ + 1.
                        Set fbVals to fbNewVals.
                    Otherwise:
                        Push fbKt2 to fbKeys.
                        Push (item (fbI + 1) of fbArgs) to fbVals.
                Otherwise:
                    Return fbNo.
            Set fbI to fbI + 2.
        Return a new CNew with typeName "Map" and fieldNames fbKeys and fields fbVals.
    If fbName equals "setOf":
        Let fbSetKeys be a new Seq of Text.
        Let fbSetVals be a new Seq of CExpr.
        Repeat for fbE in fbArgs:
            Let fbEk be exprToKeyPart(fbE).
            Let fbEk2 be "{fbEk}".
            If not (fbSetKeys contains fbEk2):
                Push fbEk2 to fbSetKeys.
                Push fbE to fbSetVals.
        Return a new CNew with typeName "Set" and fieldNames fbSetKeys and fields fbSetVals.
    If fbName equals "chr":
        Inspect item 1 of fbArgs:
            When CInt (fbCode):
                Return a new CText with value chr(fbCode).
            Otherwise:
                Return fbNo.
    Return fbNo.

