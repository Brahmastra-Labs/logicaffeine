## To peFoldBuiltin (fbName: Text) and (fbArgs: Seq of CExpr) -> CExpr:
    Let fbLength be length of fbName.
    If fbLength equals 3:
        If fbName equals "abs":
            Return peFoldBuiltinAbs(fbArgs).
        If fbName equals "max":
            Return peFoldBuiltinMax(fbArgs).
        If fbName equals "min":
            Return peFoldBuiltinMin(fbArgs).
    If fbLength equals 4:
        If fbName equals "sqrt":
            Return peFoldBuiltinSqrt(fbArgs).
    If fbLength equals 6:
        If fbName equals "day_of":
            Return peFoldBuiltinDayOf(fbArgs).
    If fbLength equals 7:
        If fbName equals "date_of":
            Return peFoldBuiltinDateOf(fbArgs).
        If fbName equals "hour_of":
            Return peFoldBuiltinHourOf(fbArgs).
        If fbName equals "time_of":
            Return peFoldBuiltinTimeOf(fbArgs).
        If fbName equals "week_of":
            Return peFoldBuiltinWeekOf(fbArgs).
        If fbName equals "year_of":
            Return peFoldBuiltinYearOf(fbArgs).
    If fbLength equals 8:
        If fbName equals "contains":
            Return peFoldBuiltinContains(fbArgs).
        If fbName equals "month_of":
            Return peFoldBuiltinMonthOf(fbArgs).
    If fbLength equals 9:
        If fbName equals "minute_of":
            Return peFoldBuiltinMinuteOf(fbArgs).
        If fbName equals "second_of":
            Return peFoldBuiltinSecondOf(fbArgs).
    If fbLength equals 10:
        If fbName equals "quarter_of":
            Return peFoldBuiltinQuarterOf(fbArgs).
        If fbName equals "text_bytes":
            Return peFoldBuiltinTextBytes(fbArgs).
        If fbName equals "weekday_of":
            Return peFoldBuiltinWeekdayOf(fbArgs).
    If fbLength equals 11:
        If fbName equals "add_seconds":
            Return peFoldBuiltinAddSeconds(fbArgs).
    If fbLength equals 13:
        If fbName equals "years_between":
            Return peFoldBuiltinYearsBetween(fbArgs).
    If fbLength equals 14:
        If fbName equals "months_between":
            Return peFoldBuiltinMonthsBetween(fbArgs).
    If fbLength equals 15:
        If fbName equals "seconds_between":
            Return peFoldBuiltinSecondsBetween(fbArgs).
    If fbLength equals 16:
        If fbName equals "format_timestamp":
            Return peFoldBuiltinFormatTimestamp(fbArgs).
    Return a new CVar with name "__pe_no_unfold".

