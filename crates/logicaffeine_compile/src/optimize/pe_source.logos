            If ppDigits equals 9:
                Return a new CText with value "{ppInt:.9}".
            If ppDigits equals 10:
                Return a new CText with value "{ppInt:.10}".
            If ppDigits equals 11:
                Return a new CText with value "{ppInt:.11}".
            If ppDigits equals 12:
                Return a new CText with value "{ppInt:.12}".
            If ppDigits equals 13:
                Return a new CText with value "{ppInt:.13}".
