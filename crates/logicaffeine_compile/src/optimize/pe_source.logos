                Return a new CText with value "{ppInt:.17}".
            If ppDigits equals 18:
                Return a new CText with value "{ppInt:.18}".
            If ppDigits equals 19:
                Return a new CText with value "{ppInt:.19}".
            If ppDigits equals 20:
                Return a new CText with value "{ppInt:.20}".
            If ppDigits equals 21:
                Return a new CText with value "{ppInt:.21}".
            If ppDigits equals 22:
                Return a new CText with value "{ppInt:.22}".
            If ppDigits equals 23:
                Return a new CText with value "{ppInt:.23}".
            If ppDigits equals 24:
                Return a new CText with value "{ppInt:.24}".
            If ppDigits equals 25:
                Return a new CText with value "{ppInt:.25}".
            If ppDigits equals 26:
                Return a new CText with value "{ppInt:.26}".
            If ppDigits equals 27:
                Return a new CText with value "{ppInt:.27}".
            If ppDigits equals 28:
                Return a new CText with value "{ppInt:.28}".
            If ppDigits equals 29:
                Return a new CText with value "{ppInt:.29}".
            If ppDigits equals 30:
                Return a new CText with value "{ppInt:.30}".
            If ppDigits equals 31:
                Return a new CText with value "{ppInt:.31}".
            If ppDigits equals 32:
                Return a new CText with value "{ppInt:.32}".
        When CFloat (ppReal):
            If ppDigits equals 0:
                Return a new CText with value "{ppReal:.0}".
            If ppDigits equals 1:
                Return a new CText with value "{ppReal:.1}".
            If ppDigits equals 2:
                Return a new CText with value "{ppReal:.2}".
