    Set item "__pe_en__VClosure" of ftSr to a new CText with value "CVal".
    Set item "__pe_en__VDuration" of ftSr to a new CText with value "CVal".
    Set item "__pe_en__VDate" of ftSr to a new CText with value "CVal".
    Set item "__pe_en__VMoment" of ftSr to a new CText with value "CVal".
    Set item "__pe_en__VSpan" of ftSr to a new CText with value "CVal".
    Set item "__pe_en__VTime" of ftSr to a new CText with value "CVal".
    Set item "__pe_en__VChar" of ftSr to a new CText with value "CVal".
    Set item "__pe_en__VCrdt" of ftSr to a new CText with value "CVal".
    Set item "__pe_en__CoreNext" of ftSr to a new CText with value "CoreOut".
    Set item "__pe_en__CoreReturn" of ftSr to a new CText with value "CoreOut".
    Set item "__pe_en__CoreBreak" of ftSr to a new CText with value "CoreOut".
    Set item "__pe_en__CoreFail" of ftSr to a new CText with value "CoreOut".
    Set item "__pe_ft_ready" of ftSr to a new CBool with value true.

## To peFieldType (fyState: mutable PEState) and (fyCtor: Text) and (fyAt: Int) -> Text:
    If not ((peSpecResults(fyState)) contains "__pe_ft_ready"):
        Let mutable fySr be peSpecResults(fyState).
        peInstallFieldTypes(fySr).
        peStSetSpecResults(fyState, fySr).
    Let fyKey be "__pe_ft__{fyCtor}__{fyAt}".
    If (peSpecResults(fyState)) contains fyKey:
        Let fyHeld be item fyKey of (peSpecResults(fyState)).
        Inspect fyHeld:
            When CText (fyTy):
                Return fyTy.
            Otherwise:
                Return "".
    Return "".

## To peMapValueType (mvState: mutable PEState) and (mvTy: Text) -> Text:
    Let mvProbe be peFieldType(mvState, "", 0).
    Let mvKey be "__pe_mv__{mvTy}".
    If (peSpecResults(mvState)) contains mvKey:
        Let mvHeld be item mvKey of (peSpecResults(mvState)).
        Inspect mvHeld:
            When CText (mvV):
                Return mvV.
            Otherwise:
                Return "".
    Return "".

## To peCollectTypedLeaves (clE: CExpr) and (clTy: Text) and (clNames: mutable Seq of Text) and (clTypes: mutable Seq of Text) and (clState: mutable PEState) -> Bool:
    Inspect clE:
        When CVar (clV):
            If peStartsWith(clV, "pkv__"):
                If clNames contains clV:
                    Return true.
                If clTy equals "":
                    Return false.
                Let clVk be "{clV}".
                Push clVk to clNames.
                Let clTyK be "{clTy}".
                Push clTyK to clTypes.
            Return true.
        When CNewVariant (clTag, clFns, clFvs):
            Let mutable clI be 1.
            Repeat for clFv in clFvs:
                Let clFt be peFieldType(clState, clTag, clI).
                If not peCollectTypedLeaves(clFv, clFt, clNames, clTypes, clState):
                    Return false.
                Set clI to clI + 1.
            Return true.
        When CNew (clNt, clNfns, clNfvs):
            Let mutable clJ be 1.
            Repeat for clNfv in clNfvs:
                Let mutable clNft be "".
                If peIsMapType(clNt):
                    Set clNft to peMapValueType(clState, clNt).
                Otherwise:
                    Set clNft to peFieldType(clState, clNt, clJ).
                If not peCollectTypedLeaves(clNfv, clNft, clNames, clTypes, clState):
                    Return false.
                Set clJ to clJ + 1.
            Return true.
        When CTuple (clTi):
            Repeat for clTx in clTi:
                If not peCollectTypedLeaves(clTx, "", clNames, clTypes, clState):
                    Return false.
            Return true.
        When CList (clLi):
            Repeat for clLx in clLi:
                If not peCollectTypedLeaves(clLx, "", clNames, clTypes, clState):
                    Return false.
            Return true.
        When COptionSome (clOi):
            Return peCollectTypedLeaves(clOi, "", clNames, clTypes, clState).
        When CCall (clCallName, clCallArgs):
            If peIsSum(clE):
                Return peCollectTypedLeaves(item 1 of clCallArgs, "PeSum", clNames, clTypes, clState).
            If peIsBox(clE):
                Let clDef be peBoxDef(clE, clState).
                Let clPayload be peTextOf(peBoxPart(clDef, 2)).
                If clPayload equals "":
                    Return false.
                Return peCollectTypedLeaves(item 1 of clCallArgs, "Seq of {clPayload}", clNames, clTypes, clState).
            Return true.
        Otherwise:
            Return true.

## To peLeafNames (lnExprs: Seq of CExpr) -> Seq of Text:
    Let mutable lnOut be a new Seq of Text.
    Repeat for lnE in lnExprs:
        Let lnRefs be peExprRefs(lnE).
        Repeat for lnR in lnRefs:
            If peStartsWith(lnR, "pkv__"):
                If not lnOut contains lnR:
                    Let lnRk be "{lnR}".
                    Push lnRk to lnOut.
    Return lnOut.

## To peShapeKey (skFn: Text) and (skArgs: Seq of CExpr) -> Text:
    Let skLeaves be peLeafNames(skArgs).
    Let mutable skMap be a new Map of Text to Text.
    Let mutable skI be 1.
    Repeat for skL in skLeaves:
        Let skLk be "{skL}".
        Set item skLk of skMap to "pkv__@{skI}".
        Set skI to skI + 1.
    Let skJunkR be a new Seq of Text.
    Let skJunkW be a new Seq of Text.
    Let skCanon be renameExprs(skArgs, skMap, skJunkR, skJunkW).
    Return makeKey(skFn, skCanon).

## To peReturnTails (rtsStmts: Seq of CStmt) and (rtsOut: mutable Seq of CExpr):
    Let rtsN be length of rtsStmts.
    If rtsN equals 0:
        Return.
    Let rtsLast be item rtsN of rtsStmts.
    Inspect rtsLast:
        When CReturn (rtsE):
            Push rtsE to rtsOut.
        When CIf (rtsC, rtsT, rtsF):
            peReturnTails(rtsT, rtsOut).
            peReturnTails(rtsF, rtsOut).
        When CInspect (rtsNt, rtsArms):
            Repeat for rtsArm in rtsArms:
                peReturnTails(peArmBody(rtsArm), rtsOut).
        Otherwise:
            Let rtsSkip be true.

## To peAllReturns (arStmts: Seq of CStmt) and (arOut: mutable Seq of CExpr):
    Repeat for arS in arStmts:
        Inspect arS:
            When CReturn (arE):
                Push arE to arOut.
            When CIf (arC, arT, arF):
                peAllReturns(arT, arOut).
                peAllReturns(arF, arOut).
            When CInspect (arNt, arArms):
                Repeat for arArm in arArms:
                    peAllReturns(peArmBody(arArm), arOut).
            When CWhile (arWc, arWb):
                peAllReturns(arWb, arOut).
            When CRepeat (arRv, arRc, arRb):
                peAllReturns(arRb, arOut).
            When CRepeatRange (arQv, arQs, arQe, arQb):
                peAllReturns(arQb, arOut).
            Otherwise:
                Let arSkip be true.

## To peAlwaysReturns (awStmts: Seq of CStmt) -> Bool:
    Let awN be length of awStmts.
    If awN equals 0:
        Return false.
    Let awLast be item awN of awStmts.
    Inspect awLast:
        When CReturn (awR):
            Return true.
        When CFail (awF):
            Return true.
        When CIf (awC, awT, awE):
            If peAlwaysReturns(awT):
                Return peAlwaysReturns(awE).
            Return false.
        When CInspect (awNt, awArms):
            If not peArmsCover(awArms):
                Return false.
            Repeat for awArm in awArms:
                If not peAlwaysReturns(peArmBody(awArm)):
                    Return false.
            Return true.
        Otherwise:
            Return false.

## To peWidenShape (wsE: CExpr) and (wsParams: Seq of Text) and (wsNews: mutable Seq of Text) and (wsState: mutable PEState) -> CExpr:
    If peIsBox(wsE):
        Inspect wsE:
            When CCall (wsBn, wsBa):
                Let mutable wsBnew be a new Seq of CExpr.
                Repeat for wsBx in wsBa:
                    Push peWidenShape(wsBx, wsParams, wsNews, wsState) to wsBnew.
                Return a new CCall with name wsBn and args wsBnew.
            Otherwise:
                Let wsSkipB be true.
    Inspect wsE:
        When CVar (wsV):
            If wsParams contains wsV:
                Return wsE.
        When CText (wsT):
            Return wsE.
        When CNewVariant (wsTag, wsNs, wsVs):
            Let wsOut be a new Seq of CExpr.
            Repeat for wsX in wsVs:
                Push peWidenShape(wsX, wsParams, wsNews, wsState) to wsOut.
            Return a new CNewVariant with tag wsTag and fnames wsNs and fvals wsOut.
        When CNew (wsTy, wsFns, wsFvs):
            Let wsOut2 be a new Seq of CExpr.
            Repeat for wsY in wsFvs:
                Push peWidenShape(wsY, wsParams, wsNews, wsState) to wsOut2.
            Return a new CNew with typeName wsTy and fieldNames wsFns and fields wsOut2.
        When CTuple (wsTi):
            Let wsOut3 be a new Seq of CExpr.
            Repeat for wsZ in wsTi:
                Push peWidenShape(wsZ, wsParams, wsNews, wsState) to wsOut3.
            Return a new CTuple with items wsOut3.
        Otherwise:
            Let wsSkip be true.
    Let wsLeaf be freshNameSt(wsState, "pkv").
    Let wsLeafK be "{wsLeaf}".
    Push wsLeafK to wsNews.
    Return a new CVar with name wsLeaf.

## To peBaseShape (bsTails: Seq of CExpr) and (bsParams: Seq of Text) and (bsNews: mutable Seq of Text) and (bsState: mutable PEState) -> CExpr:
    Let mutable bsHave be false.
    Let mutable bsG be a new CNothing.
    Let mutable bsTmp be a new Seq of Text.
    Repeat for bsT in bsTails:
        If isStatic(bsT):
            If bsHave:
                Set bsG to peGenShape(bsG, bsT, bsTmp, bsState).
            Otherwise:
                Set bsG to bsT.
                Set bsHave to true.
    If not bsHave:
        Return a new CNothing.
    Return peWidenShape(bsG, bsParams, bsNews, bsState).

## To peTailsMatch (tmTails: Seq of CExpr) and (tmR: CExpr) and (tmNews: Seq of Text) and (tmState: PEState) -> Bool:
    Repeat for tmT in tmTails:
        Let mutable tmScratch be a new Map of Text to CExpr.
        If not peMatchLeaves(tmR, tmT, tmNews, tmScratch, tmState):
            Return false.
    Return true.

## To peRewriteReturns (rrStmts: Seq of CStmt) and (rrR: CExpr) and (rrNews: Seq of Text) and (rrState: PEState) -> Seq of CStmt:
    Let mutable rrOut be a new Seq of CStmt.
    Repeat for rrS in rrStmts:
        Inspect rrS:
            When CReturn (rrE):
                Let mutable rrVals be a new Map of Text to CExpr.
                Let rrOk be peMatchLeaves(rrR, rrE, rrNews, rrVals, rrState).
                If length of rrNews equals 0:
                    Push (a new CReturn with expr (a new CNothing)) to rrOut.
                Otherwise:
                    If length of rrNews equals 1:
                        Let rrLeaf be item 1 of rrNews.
                        Push (a new CReturn with expr (item rrLeaf of rrVals)) to rrOut.
                    Otherwise:
                        Let mutable rrItems be a new Seq of CExpr.
                        Repeat for rrN in rrNews:
                            Let rrNk be "{rrN}".
                            Push (item rrNk of rrVals) to rrItems.
                        Push (a new CReturn with expr (a new CTuple with items rrItems)) to rrOut.
            When CIf (rrC, rrT, rrF):
                Push (a new CIf with cond rrC and thenBlock peRewriteReturns(rrT, rrR, rrNews, rrState) and elseBlock peRewriteReturns(rrF, rrR, rrNews, rrState)) to rrOut.
            When CInspect (rrNt, rrArms):
                Let mutable rrNewArms be a new Seq of CMatchArm.
                Repeat for rrArm in rrArms:
                    Push peWithArmBody(rrArm, peRewriteReturns(peArmBody(rrArm), rrR, rrNews, rrState)) to rrNewArms.
                Push (a new CInspect with target rrNt and arms rrNewArms) to rrOut.
            When CWhile (rrWc, rrWb):
                Push (a new CWhile with cond rrWc and body peRewriteReturns(rrWb, rrR, rrNews, rrState)) to rrOut.
            When CRepeat (rrRv, rrRc, rrRb):
                Push (a new CRepeat with var rrRv and coll rrRc and body peRewriteReturns(rrRb, rrR, rrNews, rrState)) to rrOut.
            When CRepeatRange (rrQv, rrQs, rrQe, rrQb):
                Push (a new CRepeatRange with var rrQv and start rrQs and end rrQe and body peRewriteReturns(rrQb, rrR, rrNews, rrState)) to rrOut.
            Otherwise:
                Push rrS to rrOut.
    Return rrOut.

## To peDegenerateShape (dgR: CExpr) and (dgNews: Seq of Text) -> Bool:
    Inspect dgR:
        When CNothing:
            Return true.
        When CVar (dgV):
            Return dgNews contains dgV.
        Otherwise:
            Return false.

## To peIsBottom (ibE: CExpr) -> Bool:
    Inspect ibE:
        When CVar (ibName):
            Return ibName equals "__pe_bottom".
        Otherwise:
            Return false.

## To peBottomPass (bpSt: PEState) -> Bool:
    Return (peSpecResults(bpSt)) contains "__pe_bottom_pass".

## To peOwnExprs (oeS: CStmt) -> Seq of CExpr:
    Let mutable oeOut be a new Seq of CExpr.
    Inspect oeS:
        When CLet (oeLn, oeLe):
            Push oeLe to oeOut.
        When CSet (oeSn, oeSe):
            Push oeSe to oeOut.
        When CReturn (oeR):
            Push oeR to oeOut.
        When CShow (oeW):
            Push oeW to oeOut.
        When CIf (oeC, oeT, oeE):
            Push oeC to oeOut.
        When CWhile (oeWc, oeWb):
            Push oeWc to oeOut.
        When CRepeat (oeRv, oeRc, oeRb):
            Push oeRc to oeOut.
        When CRepeatRange (oeQv, oeQs, oeQe, oeQb):
            Push oeQs to oeOut.
            Push oeQe to oeOut.
        When CInspect (oeNt, oeNa):
            Push oeNt to oeOut.
        When CCallS (oeCn, oeCa):
            Repeat for oeA in oeCa:
                Push oeA to oeOut.
        When CPush (oePe, oePt):
            Push oePe to oeOut.
        When CSetIdx (oeXt, oeXi, oeXv):
            Push oeXi to oeOut.
            Push oeXv to oeOut.
        When CMapSet (oeMt, oeMk, oeMv):
            Push oeMk to oeOut.
            Push oeMv to oeOut.
        When CSetField (oeFt, oeFf, oeFv):
            Push oeFv to oeOut.
        When CAdd (oeAe, oeAt):
            Push oeAe to oeOut.
        When CRemove (oeRe, oeRt):
            Push oeRe to oeOut.
        Otherwise:
            Let oeSkip be true.
    Return oeOut.

## To peReadsBottom (rbS: CStmt) -> Bool:
    Repeat for rbE in peOwnExprs(rbS):
        If peExprRefs(rbE) contains "__pe_bottom":
            Return true.
    Return false.

## To peCutAtBottom (cbStmts: Seq of CStmt) and (cbFrom: Int) -> Seq of CStmt:
    Let mutable cbI be 1.
    Repeat for cbS in cbStmts:
        If cbI is greater than cbFrom and peReadsBottom(cbS):
            Let mutable cbOut be peSlice(cbStmts, 1, cbI - 1).
            Push (a new CReturn with expr (a new CVar with name "__pe_bottom")) to cbOut.
            Return cbOut.
        Set cbI to cbI + 1.
    Return a new Seq of CStmt.

## To peBottomBase (bbBody: Seq of CStmt) and (bbParams: Seq of Text) and (bbArgs: Seq of CExpr) and (bbStackKey: Text) and (bbSlot: Text) and (bbSpecName: Text) and (bbNewParams: Seq of Text) and (bbNews: mutable Seq of Text) and (bbSt: mutable PEState) -> CExpr:
    If not hoistActive((peSpecResults(bbSt))):
        Return a new CNothing.
    Let bbSaved be copy of (peSpecResults(bbSt)).
    Let bbFuncsSaved be copy of (peFuncs(bbSt)).
    Let bbNoNews be a new Seq of Text.
    peStSrBind(bbSt, bbSlot, peShapedInfo(bbSpecName, a new CVar with name "__pe_bottom", bbNoNews, bbNewParams)).
    peStSrBind(bbSt, "__pe_bottom_pass", a new CBool with value true).
    Let bbBodyB be peShapedBody(bbBody, bbParams, bbArgs, bbStackKey, bbSt).
    Let mutable bbTails be a new Seq of CExpr.
    peAllReturns(peNormalizeReturns(bbBodyB), bbTails).
    Let mutable bbRestored be bbSaved.
    If (peSpecResults(bbSt)) contains "__pe_fresh":
        Set item "__pe_fresh" of bbRestored to item "__pe_fresh" of (peSpecResults(bbSt)).
    peStSetSpecResults(bbSt, bbRestored).
    peStSetFuncs(bbSt, bbFuncsSaved).
    Return peBaseShape(bbTails, bbNewParams, bbNews, bbSt).

## To peTightenShape (tsR: CExpr) and (tsNews: Seq of Text) and (tsTails: Seq of CExpr) and (tsParams: Seq of Text) and (tsKept: mutable Seq of Text) and (tsSt: PEState) -> CExpr:
    Let mutable tsOut be tsR.
    Repeat for tsL in tsNews:
        Let tsLk be "{tsL}".
        Let mutable tsVal be a new CNothing.
        Let mutable tsHave be false.
        Let mutable tsSame be true.
        Repeat for tsT in tsTails:
            Let mutable tsVals be a new Map of Text to CExpr.
            If peMatchLeaves(tsR, tsT, tsNews, tsVals, tsSt) and tsVals contains tsLk:
                Let tsV be item tsLk of tsVals.
                If tsHave:
                    If not peSameExpr(tsVal, tsV):
                        Set tsSame to false.
                Otherwise:
                    Set tsVal to tsV.
                    Set tsHave to true.
            Otherwise:
                Set tsSame to false.
        If tsHave and tsSame and peFixedByCall(tsVal, tsParams):
            Set tsOut to substExpr(tsOut, tsLk, tsVal).
        Otherwise:
            Let tsLk2 be "{tsL}".
            Push tsLk2 to tsKept.
    Return tsOut.

## To peFixedByCall (fcE: CExpr) and (fcParams: Seq of Text) -> Bool:
    If not isPureForDce(fcE):
        Return false.
    Repeat for fcR in peExprRefs(fcE):
        If not (fcParams contains fcR):
            Return false.
    Return true.

## To peDropTailReturns (dtStmts: Seq of CStmt) -> Seq of CStmt:
    Let dtN be length of dtStmts.
    If dtN equals 0:
        Return dtStmts.
    Let mutable dtOut be peSlice(dtStmts, 1, dtN - 1).
    Let dtLast be item dtN of dtStmts.
    Inspect dtLast:
        When CReturn (dtR):
            Inspect dtR:
                When CNothing:
                    Return dtOut.
                Otherwise:
                    Push dtLast to dtOut.
        When CIf (dtC, dtT, dtE):
            Push (a new CIf with cond dtC and thenBlock peDropTailReturns(dtT) and elseBlock peDropTailReturns(dtE)) to dtOut.
        When CInspect (dtNt, dtArms):
            Let mutable dtNewArms be a new Seq of CMatchArm.
            Repeat for dtArm in dtArms:
                Push peWithArmBody(dtArm, peDropTailReturns(peArmBody(dtArm))) to dtNewArms.
            Push (a new CInspect with target dtNt and arms dtNewArms) to dtOut.
        Otherwise:
            Push dtLast to dtOut.
    Return dtOut.

## To peShapedSlots (slSt: PEState) -> Seq of Text:
    Let mutable slOut be a new Seq of Text.
    Repeat for (slK, slV) in peSpecResults(slSt):
        If peStartsWith(slK, "__pe_shaped__"):
            Let slKk be "{slK}".
            Push slKk to slOut.
    Return slOut.

## To peDropShapedSince (dsSt: mutable PEState) and (dsBefore: Seq of Text) and (dsKeep: Text):
    Repeat for dsK in peShapedSlots(dsSt):
        If not (dsBefore contains dsK) and not (dsK equals dsKeep):
            peStSrDrop(dsSt, dsK).

## To peLeavesType (ltNews: Seq of Text) and (ltNames: Seq of Text) and (ltTypes: Seq of Text) -> Text:
    Let mutable ltParts be "".
    Let mutable ltAt be 1.
    Repeat for ltN in ltNews:
        Let mutable ltType be "".
        Let mutable ltI be 1.
        Repeat for ltName in ltNames:
            If ltName equals ltN:
                Let ltRaw be item ltI of ltTypes.
                Set ltType to "{ltRaw}".
            Set ltI to ltI + 1.
        If ltType equals "":
            Return "".
        If ltAt equals 1:
            Set ltParts to ltType.
        Otherwise:
            Set ltParts to "{ltParts}, {ltType}".
        Set ltAt to ltAt + 1.
    If length of ltNews equals 1:
        Return ltParts.
    Return "({ltParts})".

## To peShapedInfoKeep (skName: Text) and (skRet: CExpr) and (skNews: Seq of Text) and (skParams: Seq of Text) and (skKeep: Seq of Bool) -> CExpr:
    Let skBase be peShapedInfo(skName, skRet, skNews, skParams).
    Inspect skBase:
        When CNewVariant (skTag, skNs, skVs):
            Let mutable skNs2 be copy of skNs.
            Push "keep" to skNs2.
            Let mutable skVs2 be copy of skVs.
            Let mutable skKeepE be a new Seq of CExpr.
            Repeat for skK in skKeep:
                Push (a new CBool with value skK) to skKeepE.
            Push (a new CList with items skKeepE) to skVs2.
            Return a new CNewVariant with tag "__pe_shaped" and fnames skNs2 and fvals skVs2.
        Otherwise:
            Return skBase.

## To peShapedKeep (sqInfo: CExpr) -> Seq of Bool:
    Let mutable sqOut be a new Seq of Bool.
    Inspect sqInfo:
        When CNewVariant (sqTag, sqNs, sqVs):
            If length of sqVs is at least 5:
                Inspect item 5 of sqVs:
                    When CList (sqItems):
                        Repeat for sqI in sqItems:
                            Inspect sqI:
                                When CBool (sqB):
                                    Push sqB to sqOut.
                                Otherwise:
                                    Push true to sqOut.
                    Otherwise:
                        Let sqSkip be true.
        Otherwise:
            Let sqSkip2 be true.
    Return sqOut.

## To peShapedInfo (siName: Text) and (siRet: CExpr) and (siNews: Seq of Text) and (siParams: Seq of Text) -> CExpr:
    Let siNewsE be a new Seq of CExpr.
    Repeat for siN in siNews:
        Let siNk be "{siN}".
        Push (a new CText with value siNk) to siNewsE.
    Let siParamsE be a new Seq of CExpr.
    Repeat for siP in siParams:
        Let siPk be "{siP}".
        Push (a new CText with value siPk) to siParamsE.
    Let siFields be a new Seq of Text.
    Push "name" to siFields.
    Push "ret" to siFields.
    Push "news" to siFields.
    Push "params" to siFields.
    Let siVals be a new Seq of CExpr.
    Let siNameK be "{siName}".
    Push (a new CText with value siNameK) to siVals.
    Push siRet to siVals.
    Push (a new CList with items siNewsE) to siVals.
    Push (a new CList with items siParamsE) to siVals.
    Return a new CNewVariant with tag "__pe_shaped" and fnames siFields and fvals siVals.

## To peTextsOf (toE: CExpr) -> Seq of Text:
    Let mutable toOut be a new Seq of Text.
    Inspect toE:
        When CList (toItems):
            Repeat for toI in toItems:
                Inspect toI:
                    When CText (toT):
                        Push toT to toOut.
                    Otherwise:
                        Let toSkip be true.
        Otherwise:
            Let toSkip2 be true.
    Return toOut.

## To peShapedCall (scInfo: CExpr) and (scArgs: Seq of CExpr) and (scState: mutable PEState) -> CExpr:
    Inspect scInfo:
        When CNewVariant (scTag, scNs, scVs):
            Let scNameE be item 1 of scVs.
            Let scRet be item 2 of scVs.
            Let scNews be peTextsOf(item 3 of scVs).
            Let scParams be peTextsOf(item 4 of scVs).
            Let mutable scName be "".
            Inspect scNameE:
                When CText (scN):
                    Set scName to scN.
                Otherwise:
                    Return a new CVar with name "__pe_no_unfold".
            Inspect scRet:
                When CNothing:
                    Return a new CCall with name scName and args scArgs.
                Otherwise:
                    Let scSkip be true.
            If peIsBottom(scRet):
                Return scRet.
            If not hoistActive((peSpecResults(scState))):
                Return a new CVar with name "__pe_no_unfold".
            Let scT be freshNameSt(scState, "pkv").
            Let scTk be "{scT}".
            Let scLets be a new Seq of CStmt.
            Let scCallArgs be peKeepArgs(scArgs, peShapedKeep(scInfo)).
            If length of scNews equals 0:
                Push (a new CCallS with name scName and args scCallArgs) to scLets.
            Otherwise:
                Push (a new CLet with name scTk and expr (a new CCall with name scName and args scCallArgs)) to scLets.
            hoistAppendSt(scState, scLets).
            Let mutable scMap be a new Map of Text to Text.
            Let mutable scI be 1.
            Repeat for scP in scParams:
                Let scA be item scI of scArgs.
                Inspect scA:
                    When CVar (scAv):
                        Let scPk be "{scP}".
                        Set item scPk of scMap to scAv.
                    Otherwise:
                        Let scSkipA be true.
                Set scI to scI + 1.
            If length of scNews equals 1:
                Let scNw1 be item 1 of scNews.
                Let scNwk be "{scNw1}".
                Let scTk2 be "{scT}".
                Set item scNwk of scMap to scTk2.
            Otherwise:
                Let mutable scParts be a new Seq of CStmt.
                Let mutable scAt be 1.
                Repeat for scNw in scNews:
                    Let scPart be freshNameSt(scState, "pkv").
                    Let scPartK be "{scPart}".
                    Push (a new CLet with name scPartK and expr (a new CIndex with coll (a new CVar with name scTk) and idx (a new CInt with value scAt))) to scParts.
                    Let scNwk2 be "{scNw}".
                    Let scPartK2 be "{scPart}".
                    Set item scNwk2 of scMap to scPartK2.
                    Set scAt to scAt + 1.
                hoistAppendSt(scState, scParts).
            Let scJunkR be a new Seq of Text.
            Let scJunkW be a new Seq of Text.
            Return renameExpr(scRet, scMap, scJunkR, scJunkW).
        Otherwise:
            Return a new CVar with name "__pe_no_unfold".

## To peShapedBody (sbBody: Seq of CStmt) and (sbParams: Seq of Text) and (sbArgs: Seq of CExpr) and (sbStackKey: Text) and (sbState: mutable PEState) -> Seq of CStmt:
    Let mutable sbCallEnv be a new Map of Text to CVal.
    Let mutable sbChildSe be a new Map of Text to CExpr.
    Let mutable sbPi be 1.
    Repeat for sbPn in sbParams:
        Let sbArgE be item sbPi of sbArgs.
        Let sbPnK be "{sbPn}".
        Set item sbPnK of sbCallEnv to exprToVal(sbArgE).
        If isCopyPropSafe(sbArgE):
            Let sbPnK2 be "{sbPn}".
            Set item sbPnK2 of sbChildSe to sbArgE.
        Set sbPi to sbPi + 1.
    Let sbDepth be peDepth(sbState).
    Let mutable sbChild be peStateWithEnvDepthStatic(sbState, sbCallEnv, sbDepth - 1, sbChildSe).
    Let mutable sbStack be a new Seq of Text.
    Let sbKey be "{sbStackKey}".
    Push sbKey to sbStack.
    peStSetOnStack(sbChild, sbStack).
    Let sbOut be peBlock(sbBody, sbChild).
    peAbsorb(sbState, sbChild).
    Return sbOut.

## To peWritesAny (waStmts: Seq of CStmt) and (waNames: Seq of Text) -> Bool:
    Let waMap be a new Map of Text to Text.
    Let mutable waRefs be a new Seq of Text.
    Let mutable waWrites be a new Seq of Text.
    Let waWalked be renameStmts(waStmts, waMap, waRefs, waWrites).
    Repeat for waW in waWrites:
        If waNames contains waW:
            Return true.
    Return false.

## To peMutableParams (mpParams: Seq of Text) and (mpTypes: Seq of Text) -> Seq of Text:
    Let mutable mpOut be a new Seq of Text.
    Let mutable mpI be 1.
    Repeat for mpP in mpParams:
        If mpI is at most length of mpTypes:
            Let mpT be item mpI of mpTypes.
            If mpT contains "mutable":
                Let mpPk be "{mpP}".
                Push mpPk to mpOut.
        Set mpI to mpI + 1.
    Return mpOut.

## To peMarkSpecialized (msName: Text) and (msState: mutable PEState):
    Let msKey be "__pe_spec_fn__{msName}".
    peStSrBind(msState, msKey, a new CBool with value true).

## To peIsSpecialized (isName: Text) and (isState: PEState) -> Bool:
    Let isKey be "__pe_spec_fn__{isName}".
    Return (peSpecResults(isState)) contains isKey.

## To peSelfPasses (spStmts: Seq of CStmt) and (spFn: Text) and (spAt: Int) and (spName: Text) -> Int:
    Let mutable spN be 0.
    Repeat for spS in spStmts:
        Let mutable spCallE be a new CNothing.
        Inspect spS:
            When CLet (spL0, spE0):
                Set spCallE to spE0.
            When CSet (spS0, spE1):
                Set spCallE to spE1.
            When CCallS (spCn0, spCa0):
                Set spCallE to a new CCall with name spCn0 and args spCa0.
            Otherwise:
                Let spSkip0 be true.
        Inspect spS:
            When CLet (spL, spE2):
                Let spSkipL be true.
            When CSet (spSn, spE3):
                Let spSkipS be true.
            Otherwise:
                Let spSkip1 be true.
        Inspect spCallE:
            When CCall (spC, spArgs):
                If spC equals spFn and spAt is at most length of spArgs:
                    Let spA be item spAt of spArgs.
                    Inspect spA:
                        When CVar (spV):
                            If spV equals spName:
                                Set spN to spN + 1.
                        Otherwise:
                            Let spSkipA be true.
            Otherwise:
                Let spSkipE be true.
        Inspect spS:
            When CLet (spL, spE):
                Let spInert be true.
            When CIf (spIc, spIt, spIe):
                Set spN to spN + peSelfPasses(spIt, spFn, spAt, spName) + peSelfPasses(spIe, spFn, spAt, spName).
            When CWhile (spWc, spWb):
                Set spN to spN + peSelfPasses(spWb, spFn, spAt, spName).
            When CRepeat (spRv, spRc, spRb):
                Set spN to spN + peSelfPasses(spRb, spFn, spAt, spName).
            When CRepeatRange (spQv, spQs, spQe, spQb):
                Set spN to spN + peSelfPasses(spQb, spFn, spAt, spName).
            When CInspect (spNt, spArms):
                Repeat for spArm in spArms:
                    Set spN to spN + peSelfPasses(peArmBody(spArm), spFn, spAt, spName).
            Otherwise:
                Let spSkip be true.
    Return spN.

## To peKeepArgs (kaArgs: Seq of CExpr) and (kaKeep: Seq of Bool) -> Seq of CExpr:
    Let mutable kaOut be a new Seq of CExpr.
    Let mutable kaI be 1.
    Repeat for kaA in kaArgs:
        If kaI is at most length of kaKeep:
            If item kaI of kaKeep:
                Push kaA to kaOut.
        Otherwise:
            Push kaA to kaOut.
        Set kaI to kaI + 1.
    Return kaOut.

## To peFilterSelfCalls (fsStmts: Seq of CStmt) and (fsFn: Text) and (fsKeep: Seq of Bool) -> Seq of CStmt:
    Let mutable fsOut be a new Seq of CStmt.
    Repeat for fsS in fsStmts:
        Let mutable fsDone be false.
        Inspect fsS:
            When CLet (fsL, fsE):
                Inspect fsE:
                    When CCall (fsC, fsArgs):
                        If fsC equals fsFn:
                            Let fsLk be "{fsL}".
                            Let fsCk be "{fsC}".
                            Push (a new CLet with name fsLk and expr (a new CCall with name fsCk and args peKeepArgs(fsArgs, fsKeep))) to fsOut.
                            Set fsDone to true.
                    Otherwise:
                        Let fsSkipE be true.
            When CSet (fsSt, fsSe):
                Inspect fsSe:
                    When CCall (fsSc, fsSargs):
                        If fsSc equals fsFn:
                            Let fsStk be "{fsSt}".
                            Let fsSck be "{fsSc}".
                            Push (a new CSet with name fsStk and expr (a new CCall with name fsSck and args peKeepArgs(fsSargs, fsKeep))) to fsOut.
                            Set fsDone to true.
                    Otherwise:
                        Let fsSkipSe be true.
            When CCallS (fsCn, fsCa):
                If fsCn equals fsFn:
                    Let fsCnk be "{fsCn}".
                    Push (a new CCallS with name fsCnk and args peKeepArgs(fsCa, fsKeep)) to fsOut.
                    Set fsDone to true.
            When CIf (fsIc, fsIt, fsIe):
                Push (a new CIf with cond fsIc and thenBlock peFilterSelfCalls(fsIt, fsFn, fsKeep) and elseBlock peFilterSelfCalls(fsIe, fsFn, fsKeep)) to fsOut.
                Set fsDone to true.
            When CWhile (fsWc, fsWb):
                Push (a new CWhile with cond fsWc and body peFilterSelfCalls(fsWb, fsFn, fsKeep)) to fsOut.
                Set fsDone to true.
            When CRepeat (fsRv, fsRc, fsRb):
                Push (a new CRepeat with var fsRv and coll fsRc and body peFilterSelfCalls(fsRb, fsFn, fsKeep)) to fsOut.
                Set fsDone to true.
            When CRepeatRange (fsQv, fsQs, fsQe, fsQb):
                Push (a new CRepeatRange with var fsQv and start fsQs and end fsQe and body peFilterSelfCalls(fsQb, fsFn, fsKeep)) to fsOut.
                Set fsDone to true.
            When CInspect (fsNt, fsArms):
                Let mutable fsNewArms be a new Seq of CMatchArm.
                Repeat for fsArm in fsArms:
                    Push peWithArmBody(fsArm, peFilterSelfCalls(peArmBody(fsArm), fsFn, fsKeep)) to fsNewArms.
                Push (a new CInspect with target fsNt and arms fsNewArms) to fsOut.
                Set fsDone to true.
            Otherwise:
                Let fsSkip be true.
        If not fsDone:
            Push fsS to fsOut.
    Return fsOut.

## To peTextList (tlNames: Seq of Text) -> CExpr:
    Let mutable tlOut be a new Seq of CExpr.
    Repeat for tlN in tlNames:
        Let tlK be "{tlN}".
        Push (a new CText with value tlK) to tlOut.
    Return a new CList with items tlOut.

## To peWidenParamAt (wpE: CExpr) and (wpParams: Seq of Text) and (wpAt: Int) and (wpCount: mutable Seq of Int) and (wpNews: mutable Seq of Text) and (wpState: mutable PEState) -> CExpr:
    Inspect wpE:
        When CVar (wpV):
            If wpParams contains wpV:
                Let wpSeen be (item 1 of wpCount) + 1.
                Set item 1 of wpCount to wpSeen.
                If wpSeen equals wpAt:
                    Let wpLeaf be freshNameSt(wpState, "pkv").
                    Let wpLeafK be "{wpLeaf}".
                    Push wpLeafK to wpNews.
                    Return a new CVar with name wpLeaf.
            Return wpE.
        When CNewVariant (wpTag, wpNs, wpVs):
            Let mutable wpOut be a new Seq of CExpr.
            Repeat for wpX in wpVs:
                Push peWidenParamAt(wpX, wpParams, wpAt, wpCount, wpNews, wpState) to wpOut.
            Return a new CNewVariant with tag wpTag and fnames wpNs and fvals wpOut.
        When CNew (wpTy, wpFns, wpFvs):
            Let mutable wpOut2 be a new Seq of CExpr.
            Repeat for wpY in wpFvs:
                Push peWidenParamAt(wpY, wpParams, wpAt, wpCount, wpNews, wpState) to wpOut2.
            Return a new CNew with typeName wpTy and fieldNames wpFns and fields wpOut2.
        When CTuple (wpTi):
            Let mutable wpOut3 be a new Seq of CExpr.
            Repeat for wpZ in wpTi:
                Push peWidenParamAt(wpZ, wpParams, wpAt, wpCount, wpNews, wpState) to wpOut3.
            Return a new CTuple with items wpOut3.
        Otherwise:
            Return wpE.

## To peSpecializeShaped (ssFn: Text) and (ssArgs: Seq of CExpr) and (ssState: mutable PEState) -> CExpr:
    Let ssNo be a new CVar with name "__pe_no_unfold".
    If not ((peFuncs(ssState)) contains ssFn):
        Return ssNo.
    Let ssFnK be "{ssFn}".
    Let ssFunc be item ssFnK of (peFuncs(ssState)).
    Inspect ssFunc:
        When CFuncDef (ssName0, ssParams, ssParamTypes, ssReturnType, ssBody):
            Let mutable ssLeaves be a new Seq of Text.
            Let mutable ssTypes be a new Seq of Text.
            Let mutable ssAt be 1.
            Repeat for ssA in ssArgs:
                Let mutable ssPt be "".
                If ssAt is at most length of ssParamTypes:
                    Let ssPtRaw be item ssAt of ssParamTypes.
                    Set ssPt to "{ssPtRaw}".
                If not peCollectTypedLeaves(ssA, ssPt, ssLeaves, ssTypes, ssState):
                    Return ssNo.
                Set ssAt to ssAt + 1.
            If length of ssLeaves equals 0:
                Return ssNo.
            Let mutable ssParamMap be a new Map of Text to Text.
            Let mutable ssNewParams be a new Seq of Text.
            Let mutable ssCallArgs be a new Seq of CExpr.
            Repeat for ssL in ssLeaves:
                Let ssP be freshNameSt(ssState, "pkv").
                Let ssLk2 be "{ssL}".
                Let ssPk be "{ssP}".
                Set item ssLk2 of ssParamMap to ssPk.
                Let ssPk2 be "{ssP}".
                Push ssPk2 to ssNewParams.
                Let ssLk3 be "{ssL}".
                Push (a new CVar with name ssLk3) to ssCallArgs.
            Let ssKey be peShapeKey(ssFn, ssArgs).
            Let ssSlot be "__pe_shaped__{ssKey}".
            If (peSpecResults(ssState)) contains ssSlot:
                Let ssHeld be item ssSlot of (peSpecResults(ssState)).
                Return peShapedCall(ssHeld, ssCallArgs, ssState).
            Let ssBase be "{ssFn}".
            Let ssSpecName be freshNameSt(ssState, ssBase).
            Let ssNoNews be a new Seq of Text.
            peStSrBind(ssState, ssSlot, peShapedInfo(ssSpecName, a new CNothing, ssNoNews, ssNewParams)).
            Let ssPhName be "{ssSpecName}".
            Let ssPhParams be copy of ssNewParams.
            Let ssPhTypes be copy of ssTypes.
            Let ssPhRet be "{ssReturnType}".
            Let ssPh be a new Seq of CStmt.
            peStFuncBind(ssState, ssPhName, a new CFuncDef with name ssPhName and params ssPhParams and paramTypes ssPhTypes and returnType ssPhRet and body ssPh).
            peMarkSpecialized(ssSpecName, ssState).
            Let ssJunkR2 be a new Seq of Text.
            Let ssJunkW2 be a new Seq of Text.
            Let ssChildArgs be renameExprs(ssArgs, ssParamMap, ssJunkR2, ssJunkW2).
            Let ssStackKey be "__shape__{ssKey}".
            Let ssSlotsBefore be peShapedSlots(ssState).
            Let ssBody0 be peShapedBody(ssBody, ssParams, ssChildArgs, ssStackKey, ssState).
            Let ssMutables be peMutableParams(ssParams, ssParamTypes).
            If length of ssMutables is greater than 0:
                If peWritesAny(ssBody0, ssMutables):
                    peStSrDrop(ssState, ssSlot).
                    Return ssNo.
            Let mutable ssFinal be ssBody0.
            Let mutable ssFinalRet be "{ssReturnType}".
            Let mutable ssUnboxed be false.
            Let mutable ssUnboxedInfo be a new CNothing.
            If hoistActive((peSpecResults(ssState))):
                Let mutable ssTails0 be a new Seq of CExpr.
                peAllReturns(peNormalizeReturns(ssBody0), ssTails0).
                Let mutable ssNews0 be a new Seq of Text.
                Let ssR0 be peBaseShape(ssTails0, ssNewParams, ssNews0, ssState).
                Let mutable ssCands be a new Seq of CExpr.
                Let mutable ssCandNews be a new Seq of CExpr.
                If peDegenerateShape(ssR0, ssNews0):
                    Let mutable ssBotNews be a new Seq of Text.
                    peDropShapedSince(ssState, ssSlotsBefore, ssSlot).
                    Let ssBotR be peBottomBase(ssBody, ssParams, ssChildArgs, ssStackKey, ssSlot, ssSpecName, ssNewParams, ssBotNews, ssState).
                    If not peDegenerateShape(ssBotR, ssBotNews):
                        Push ssBotR to ssCands.
                        Push (peTextList(ssBotNews)) to ssCandNews.
                Otherwise:
                    Push ssR0 to ssCands.
                    Push (peTextList(ssNews0)) to ssCandNews.
                    If length of ssNews0 equals 0:
                        Let mutable ssOcc be 1.
                        While ssOcc is at most 4:
                            Let mutable ssWnews be a new Seq of Text.
                            Let mutable ssCounter be a new Seq of Int.
                            Push 0 to ssCounter.
                            Let ssWr be peWidenParamAt(ssR0, ssNewParams, ssOcc, ssCounter, ssWnews, ssState).
                            If length of ssWnews equals 1:
                                Push ssWr to ssCands.
                                Push (peTextList(ssWnews)) to ssCandNews.
                            Set ssOcc to ssOcc + 1.
                Let mutable ssCi be 1.
                Let mutable ssMatchedTails be a new Seq of CExpr.
                Let mutable ssR be a new CNothing.
                Let mutable ssNews be a new Seq of Text.
                Let mutable ssTries be 0.
                Let mutable ssGoing be false.
                While ssCi is at most length of ssCands and not ssUnboxed:
                    Set ssR to item ssCi of ssCands.
                    Set ssNews to peTextsOf(item ssCi of ssCandNews).
                    Set ssCi to ssCi + 1.
                    Set ssTries to 0.
                    Set ssGoing to true.
                    While ssGoing and ssTries is less than 4:
                        Set ssTries to ssTries + 1.
                        If length of ssNews equals 0:
                            Set ssGoing to false.
                        Otherwise:
                            Let mutable ssNewNames be a new Seq of Text.
                            Let mutable ssNewTypes be a new Seq of Text.
                            Let ssTyOk be peCollectTypedLeaves(ssR, "", ssNewNames, ssNewTypes, ssState).
                            Let ssLeafType be peLeavesType(ssNews, ssNewNames, ssNewTypes).
                            If ssLeafType equals "":
                                Set ssGoing to false.
                            Otherwise:
                                Let ssInfo be peShapedInfo(ssSpecName, ssR, ssNews, ssNewParams).
                                peStSrBind(ssState, ssSlot, ssInfo).
                                Let ssPhName2 be "{ssSpecName}".
                                Let ssPhParams2 be copy of ssNewParams.
                                Let ssPhTypes2 be copy of ssTypes.
                                Let ssPhRet2 be "{ssLeafType}".
                                Let ssPh2 be a new Seq of CStmt.
                                peStFuncBind(ssState, ssPhName2, a new CFuncDef with name ssPhName2 and params ssPhParams2 and paramTypes ssPhTypes2 and returnType ssPhRet2 and body ssPh2).
                                peDropShapedSince(ssState, ssSlotsBefore, ssSlot).
                                Let ssBodyK be peShapedBody(ssBody, ssParams, ssChildArgs, ssStackKey, ssState).
                                Let ssNormK be peNormalizeReturns(ssBodyK).
                                Let mutable ssTailsK be a new Seq of CExpr.
                                peAllReturns(ssNormK, ssTailsK).
                                If peAlwaysReturns(ssNormK) and peTailsMatch(ssTailsK, ssR, ssNews, ssState):
                                    Set ssMatchedTails to ssTailsK.
                                    Set ssFinal to peRewriteReturns(ssNormK, ssR, ssNews, ssState).
                                    Set ssFinalRet to "{ssLeafType}".
                                    Set ssUnboxed to true.
                                    Set ssUnboxedInfo to ssInfo.
                                    Set ssGoing to false.
                                Otherwise:
                                    Repeat for ssTk in ssTailsK:
                                        Set ssR to peGenShape(ssR, ssTk, ssNews, ssState).
                If ssUnboxed:
                    Let mutable ssKept be a new Seq of Text.
                    Let ssTightR be peTightenShape(ssR, ssNews, ssMatchedTails, ssNewParams, ssKept, ssState).
                    If length of ssKept is less than length of ssNews:
                        Let mutable ssTightType be "Nothing".
                        If length of ssKept is greater than 0:
                            Let mutable ssTightNames be a new Seq of Text.
                            Let mutable ssTightTypes be a new Seq of Text.
                            Let ssTightOk be peCollectTypedLeaves(ssTightR, "", ssTightNames, ssTightTypes, ssState).
                            Set ssTightType to peLeavesType(ssKept, ssTightNames, ssTightTypes).
                        If not (ssTightType equals ""):
                            Let ssTightInfo be peShapedInfo(ssSpecName, ssTightR, ssKept, ssNewParams).
                            peStSrBind(ssState, ssSlot, ssTightInfo).
                            Let ssTightName be "{ssSpecName}".
                            Let ssTightParams be copy of ssNewParams.
                            Let ssTightPTypes be copy of ssTypes.
                            Let ssTightRet be "{ssTightType}".
                            Let ssTightPh be a new Seq of CStmt.
                            peStFuncBind(ssState, ssTightName, a new CFuncDef with name ssTightName and params ssTightParams and paramTypes ssTightPTypes and returnType ssTightRet and body ssTightPh).
                            peDropShapedSince(ssState, ssSlotsBefore, ssSlot).
                            Let ssTightBody be peShapedBody(ssBody, ssParams, ssChildArgs, ssStackKey, ssState).
                            Let ssTightNorm be peNormalizeReturns(ssTightBody).
                            Let mutable ssTightTails be a new Seq of CExpr.
                            peAllReturns(ssTightNorm, ssTightTails).
                            If peAlwaysReturns(ssTightNorm) and peTailsMatch(ssTightTails, ssTightR, ssKept, ssState):
                                Let ssTightFinal be peRewriteReturns(ssTightNorm, ssTightR, ssKept, ssState).
                                If length of ssKept equals 0:
                                    Set ssFinal to peDropTailReturns(ssTightFinal).
                                Otherwise:
                                    Set ssFinal to ssTightFinal.
                                Set ssFinalRet to "{ssTightType}".
                                Set ssUnboxedInfo to ssTightInfo.
                            Otherwise:
                                peStSrBind(ssState, ssSlot, ssUnboxedInfo).
            Let mutable ssKeep be a new Seq of Bool.
            Let mutable ssAnyDead be false.
            If ssUnboxed:
                Let mutable ssPi2 be 1.
                Repeat for ssP3 in ssNewParams:
                    If peCountRefs(ssP3, ssFinal) is greater than peSelfPasses(ssFinal, ssSpecName, ssPi2, ssP3):
                        Push true to ssKeep.
                    Otherwise:
                        Push false to ssKeep.
                        Set ssAnyDead to true.
                    Set ssPi2 to ssPi2 + 1.
            Let mutable ssDefParams be copy of ssNewParams.
            Let mutable ssDefTypes be copy of ssTypes.
            If ssUnboxed:
                Inspect ssUnboxedInfo:
                    When CNewVariant (ssUiTag, ssUiNs, ssUiVs):
                        Let ssUiRet be item 2 of ssUiVs.
                        Let ssUiNews be peTextsOf(item 3 of ssUiVs).
                        peStSrBind(ssState, ssSlot, peShapedInfoKeep(ssSpecName, ssUiRet, ssUiNews, ssNewParams, ssKeep)).
                    Otherwise:
                        peStSrBind(ssState, ssSlot, ssUnboxedInfo).
                If ssAnyDead:
                    Set ssFinal to peFilterSelfCalls(ssFinal, ssSpecName, ssKeep).
                    Let mutable ssKeptParams be a new Seq of Text.
                    Let mutable ssKeptTypes be a new Seq of Text.
                    Let mutable ssKi be 1.
                    Repeat for ssKp in ssNewParams:
                        If item ssKi of ssKeep:
                            Let ssKpk be "{ssKp}".
                            Push ssKpk to ssKeptParams.
                            Let ssKt be item ssKi of ssTypes.
                            Let ssKtk be "{ssKt}".
                            Push ssKtk to ssKeptTypes.
                        Set ssKi to ssKi + 1.
                    Set ssDefParams to ssKeptParams.
                    Set ssDefTypes to ssKeptTypes.
            Otherwise:
                peStSrBind(ssState, ssSlot, peShapedInfo(ssSpecName, a new CNothing, ssNoNews, ssNewParams)).
            Let ssDefName be "{ssSpecName}".
            peStFuncBind(ssState, ssDefName, a new CFuncDef with name ssDefName and params ssDefParams and paramTypes ssDefTypes and returnType ssFinalRet and body ssFinal).
            Let ssFinalInfo be item ssSlot of (peSpecResults(ssState)).
            Return peShapedCall(ssFinalInfo, ssCallArgs, ssState).
        Otherwise:
            Return ssNo.

## To peEnumOf (eoState: mutable PEState) and (eoCtor: Text) -> Text:
    Let eoProbe be peFieldType(eoState, "", 0).
    Let eoKey be "__pe_en__{eoCtor}".
    If (peSpecResults(eoState)) contains eoKey:
        Let eoHeld be item eoKey of (peSpecResults(eoState)).
        Inspect eoHeld:
            When CText (eoName):
                Return eoName.
            Otherwise:
                Return "".
    Return "".

## To peBoxDef (bdE: CExpr) and (bdState: PEState) -> CExpr:
    Inspect bdE:
        When CCall (bdName, bdArgs):
            If length of bdArgs equals 1:
                Let bdKey be "__pe_boxdef__{bdName}".
                If (peSpecResults(bdState)) contains bdKey:
                    Return item bdKey of (peSpecResults(bdState)).
        Otherwise:
            Let bdSkip be true.
    Return a new CNothing.

## To peIsBox (ibE: CExpr) -> Bool:
    Inspect ibE:
        When CCall (ibName, ibArgs):
            If peStartsWith(ibName, "peBox__"):
                Return length of ibArgs equals 1.
            Return false.
        Otherwise:
            Return false.

## To peBoxBase (bbE: CExpr) -> Text:
    Inspect bbE:
        When CCall (bbName, bbArgs):
            Let bbArg be item 1 of bbArgs.
            Inspect bbArg:
                When CVar (bbV):
                    Return bbV.
                Otherwise:
                    Return "".
        Otherwise:
            Return "".

## To peBoxPart (bpDef: CExpr) and (bpAt: Int) -> CExpr:
    Inspect bpDef:
        When CNewVariant (bpTag, bpNs, bpVs):
            Return item bpAt of bpVs.
        Otherwise:
            Return a new CNothing.

## To peTextOf (txE: CExpr) -> Text:
    Inspect txE:
        When CText (txV):
            Return txV.
        Otherwise:
            Return "".

## To peThroughIdentity (tiE: CExpr) and (tiState: PEState) -> CExpr:
    Inspect tiE:
        When CCall (tiF, tiArgs):
            If length of tiArgs equals 1 and (peFuncs(tiState)) contains tiF:
                Inspect item tiF of (peFuncs(tiState)):
                    When CFuncDef (tiFn, tiPs, tiPt, tiRt, tiBody):
                        If length of tiPs equals 1 and length of tiBody equals 1:
                            Inspect item 1 of tiBody:
                                When CReturn (tiR):
                                    Inspect tiR:
                                        When CVar (tiRv):
                                            If tiRv equals item 1 of tiPs:
                                                Return item 1 of tiArgs.
                                        Otherwise:
                                            Let tiSkipR be true.
                                Otherwise:
                                    Let tiSkipB be true.
                    Otherwise:
                        Let tiSkipD be true.
        Otherwise:
            Let tiSkip be true.
    Return tiE.

## To peBareType (btText: Text) -> Text:
    Let mutable btChars be a new Seq of Text.
    Repeat for btCh in btText:
        Push "{btCh}" to btChars.
    Let btN be length of btChars.
    If btN is less than 2:
        Return btText.
    If not (item 1 of btChars equals "(") or not (item btN of btChars equals ")"):
        Return btText.
    Let mutable btOut be "".
    Let mutable btAt be 1.
    Repeat for btC in btChars:
        If btAt is greater than 1 and btAt is less than btN:
            Set btOut to "{btOut}{btC}".
        Set btAt to btAt + 1.
    Return btOut.

## To peBoxName (bnShape: CExpr) and (bnPayload: Text) and (bnBoxed: Text) and (bnState: mutable PEState) -> Text:
    Let bnShapeKey be exprToKeyPart(bnShape).
    Let bnKey be "__pe_boxkey__{bnShapeKey}__{bnPayload}__{bnBoxed}".
    If (peSpecResults(bnState)) contains bnKey:
        Let bnHeld be item bnKey of (peSpecResults(bnState)).
        Return peTextOf(bnHeld).
    Let bnName be freshNameSt(bnState, "peBox").
    Let mutable bnRen be a new Map of Text to Text.
    Set item "__pe_hole" of bnRen to "pbX".
    Let bnJunkR be a new Seq of Text.
    Let bnJunkW be a new Seq of Text.
    Let bnElem be peThroughIdentity(renameExpr(bnShape, bnRen, bnJunkR, bnJunkW), bnState).
    Let mutable bnBody be a new Seq of CStmt.
    Let bnBoxedK be "{bnBoxed}".
    Let mutable bnIdentity be peBareType(bnPayload) equals peBareType(bnBoxed).
    Let mutable bnCopies be false.
    Inspect bnElem:
        When CVar (bnEv):
            If not (bnEv equals "pbX"):
                Set bnIdentity to false.
        When CCopy (bnEc):
            Inspect bnEc:
                When CVar (bnEcv):
                    If bnEcv equals "pbX":
                        Set bnCopies to bnIdentity.
                Otherwise:
                    Let bnEcSkip be true.
            Set bnIdentity to false.
        Otherwise:
            Set bnIdentity to false.
    If bnIdentity:
        Push (a new CReturn with expr (a new CVar with name "pbItems")) to bnBody.
    Otherwise:
        If bnCopies:
            Push (a new CReturn with expr (a new CCopy with target (a new CVar with name "pbItems"))) to bnBody.
    If not bnIdentity and not bnCopies:
        Push (a new CLet with name "pbOut" and expr (a new CNewSeq with elementType bnBoxedK)) to bnBody.
        Let mutable bnLoop be a new Seq of CStmt.
        Push (a new CPush with expr bnElem and target "pbOut") to bnLoop.
        Push (a new CRepeat with var "pbX" and coll (a new CVar with name "pbItems") and body bnLoop) to bnBody.
        Push (a new CReturn with expr (a new CVar with name "pbOut")) to bnBody.
    Let mutable bnParams be a new Seq of Text.
    Push "pbItems" to bnParams.
    Let mutable bnTypes be a new Seq of Text.
    Push "Seq of {bnPayload}" to bnTypes.
    Let bnRet be "Seq of {bnBoxed}".
    Let bnDefName be "{bnName}".
    peStFuncBind(bnState, bnDefName, a new CFuncDef with name bnDefName and params bnParams and paramTypes bnTypes and returnType bnRet and body bnBody).
    peMarkSpecialized(bnName, bnState).
    Let bnNameK be "{bnName}".
    peStSrBind(bnState, bnKey, a new CText with value bnNameK).
    Let mutable bnDefNs be a new Seq of Text.
    Push "shape" to bnDefNs.
    Push "payload" to bnDefNs.
    Push "boxed" to bnDefNs.
    Let mutable bnDefVs be a new Seq of CExpr.
    Push bnShape to bnDefVs.
    Let bnPayloadK be "{bnPayload}".
    Push (a new CText with value bnPayloadK) to bnDefVs.
    Let bnBoxedK2 be "{bnBoxed}".
    Push (a new CText with value bnBoxedK2) to bnDefVs.
    Let bnDefKey be "__pe_boxdef__{bnName}".
    peStSrBind(bnState, bnDefKey, a new CNewVariant with tag "__pe_boxdef" and fnames bnDefNs and fvals bnDefVs).
    Return bnName.

## To peListLike (llE: CExpr) -> Bool:
    Inspect llE:
        When CList (llI):
            Return true.
        When CNewSeq (llT):
            Return true.
        Otherwise:
            Return peIsBox(llE).

## To peGenList (glA: CExpr) and (glB: CExpr) and (glLeaves: mutable Seq of Text) and (glState: mutable PEState) -> CExpr:
    Let glNo be a new CVar with name "__pe_no_unfold".
    Let mutable glElems be a new Seq of CExpr.
    Let mutable glBoxed be "".
    Let mutable glPayload be "".
    Let mutable glSides be a new Seq of CExpr.
    Push glA to glSides.
    Push glB to glSides.
    Repeat for glS in glSides:
        Inspect glS:
            When CList (glItems):
                Repeat for glIt in glItems:
                    Push glIt to glElems.
            When CNewSeq (glEt):
                Set glBoxed to "{glEt}".
            Otherwise:
                Let glDef be peBoxDef(glS, glState).
                Inspect glDef:
                    When CNothing:
                        Return glNo.
                    Otherwise:
                        Let glShape be peBoxPart(glDef, 1).
                        Let mutable glHoleMap be a new Map of Text to Text.
                        Let glHoleTmp be freshNameSt(glState, "pkv").
                        Let glHoleTmpK be "{glHoleTmp}".
                        Set item "__pe_hole" of glHoleMap to glHoleTmpK.
                        Let glJr be a new Seq of Text.
                        Let glJw be a new Seq of Text.
                        Push renameExpr(glShape, glHoleMap, glJr, glJw) to glElems.
                        Set glPayload to peTextOf(peBoxPart(glDef, 2)).
                        Set glBoxed to peTextOf(peBoxPart(glDef, 3)).
    If length of glElems equals 0:
        Return glNo.
    Let mutable glTmp be a new Seq of Text.
    Let mutable glS0 be item 1 of glElems.
    Let mutable glI be 1.
    Repeat for glE in glElems:
        If glI is greater than 1:
            Set glS0 to peGenShape(glS0, glE, glTmp, glState).
        Set glI to glI + 1.
    Let mutable glHole be "".
    If length of glTmp equals 1:
        Set glHole to item 1 of glTmp.
    Otherwise:
        If length of glTmp equals 0:
            Let mutable glNews be a new Seq of Text.
            Let glNoParams be a new Seq of Text.
            Set glS0 to peWidenShape(glS0, glNoParams, glNews, glState).
            If length of glNews equals 1:
                Set glHole to item 1 of glNews.
    If glHole equals "":
        Return glNo.
    Let mutable glToHole be a new Map of Text to Text.
    Set item glHole of glToHole to "__pe_hole".
    Let glJr2 be a new Seq of Text.
    Let glJw2 be a new Seq of Text.
    Let glShapeFinal be renameExpr(glS0, glToHole, glJr2, glJw2).
    If glBoxed equals "":
        Inspect glShapeFinal:
            When CNewVariant (glTag, glFns, glFvs):
                Set glBoxed to peEnumOf(glState, glTag).
            Otherwise:
                Let glSkipB be true.
    If glBoxed equals "":
        Return glNo.
    If glPayload equals "":
        Inspect glShapeFinal:
            When CVar (glHv):
                Set glPayload to "{glBoxed}".
            Otherwise:
                Let mutable glPns be a new Seq of Text.
                Let mutable glPts be a new Seq of Text.
                Let mutable glProbeMap be a new Map of Text to Text.
                Set item "__pe_hole" of glProbeMap to "pkv__hole".
                Let glJr3 be a new Seq of Text.
                Let glJw3 be a new Seq of Text.
                Let glProbe be renameExpr(glShapeFinal, glProbeMap, glJr3, glJw3).
                Let glTyped be peCollectTypedLeaves(glProbe, glBoxed, glPns, glPts, glState).
                If length of glPts equals 1:
                    Let glPt be item 1 of glPts.
                    Set glPayload to "{glPt}".
    If glPayload equals "":
        Return glNo.
    Let glName be peBoxName(glShapeFinal, glPayload, glBoxed, glState).
    Let glBase be freshNameSt(glState, "pkv").
    Let glBaseK be "{glBase}".
    Push glBaseK to glLeaves.
    Let mutable glArgs be a new Seq of CExpr.
    Push (a new CVar with name glBase) to glArgs.
    Return a new CCall with name glName and args glArgs.

## To peMatchList (mlbP: CExpr) and (mlbV: CExpr) and (mlbLeaves: Seq of Text) and (mlbOut: mutable Map of Text to CExpr) and (mlbState: PEState) -> Bool:
    Let mlbDef be peBoxDef(mlbP, mlbState).
    Inspect mlbDef:
        When CNothing:
            Return false.
        Otherwise:
            Let mlbSkip be true.
    Let mlbBase be peBoxBase(mlbP).
    If not mlbLeaves contains mlbBase:
        Return peSameExpr(mlbP, mlbV).
    Let mlbShape be peBoxPart(mlbDef, 1).
    Let mlbPayload be peTextOf(peBoxPart(mlbDef, 2)).
    If peIsBox(mlbV):
        Inspect mlbP:
            When CCall (mlbPn, mlbPa):
                Inspect mlbV:
                    When CCall (mlbVn, mlbVa):
                        If mlbPn equals mlbVn:
                            Let mlbBk be "{mlbBase}".
                            Set item mlbBk of mlbOut to item 1 of mlbVa.
                            Return true.
                        Return false.
                    Otherwise:
                        Return false.
            Otherwise:
                Return false.
    Inspect mlbV:
        When CNewSeq (mlbEt):
            Let mlbBk2 be "{mlbBase}".
            Let mlbPk be "{mlbPayload}".
            Set item mlbBk2 of mlbOut to a new CNewSeq with elementType mlbPk.
            Return true.
        When CList (mlbItems):
            Let mutable mlbPayloads be a new Seq of CExpr.
            Let mutable mlbHoleLeaves be a new Seq of Text.
            Push "__pe_hole" to mlbHoleLeaves.
            Repeat for mlbIt in mlbItems:
                Let mutable mlbScratch be a new Map of Text to CExpr.
                If not peMatchLeaves(mlbShape, mlbIt, mlbHoleLeaves, mlbScratch, mlbState):
                    Return false.
                If not (mlbScratch contains "__pe_hole"):
                    Return false.
                Push (item "__pe_hole" of mlbScratch) to mlbPayloads.
            Let mlbBk3 be "{mlbBase}".
            If length of mlbPayloads equals 0:
                Let mlbPk2 be "{mlbPayload}".
                Set item mlbBk3 of mlbOut to a new CNewSeq with elementType mlbPk2.
            Otherwise:
                Set item mlbBk3 of mlbOut to a new CList with items mlbPayloads.
            Return true.
        Otherwise:
            Return false.

## To peBoxElement (beBox: CExpr) and (bePayload: CExpr) and (beState: PEState) -> CExpr:
    Let beDef be peBoxDef(beBox, beState).
    Let beShape be peBoxPart(beDef, 1).
    Return substExpr(beShape, "__pe_hole", bePayload).

## To peBoxPayload (bpBox: CExpr) and (bpVal: CExpr) and (bpState: PEState) -> CExpr:
    Let bpDef be peBoxDef(bpBox, bpState).
    Let bpShape be peBoxPart(bpDef, 1).
    Let mutable bpHole be a new Seq of Text.
    Push "__pe_hole" to bpHole.
    Let mutable bpScratch be a new Map of Text to CExpr.
    If peMatchLeaves(bpShape, bpVal, bpHole, bpScratch, bpState):
        If bpScratch contains "__pe_hole":
            Return item "__pe_hole" of bpScratch.
    Return a new CVar with name "__pe_no_unfold".

## To specializeStmts (stmts: Seq of CStmt) and (state: mutable PEState) -> Seq of CStmt:
    Let depth be peDepth(state).
    Let mutable blockMutatedDone be false.
    Let mutable blockMutated be a new Seq of Text.
    Let mutable blockResult be a new Seq of CStmt.
    Let placedStmts be peExpandPlaces(stmts).
    Let mutable stmtIdx be 0.
    Repeat for s in placedStmts:
        Set stmtIdx to stmtIdx + 1.
        Let alreadyReturned be hasReturn(blockResult).
        If alreadyReturned:
            Return blockResult.
        Let alreadyBroke be hasBreak(blockResult).
        If alreadyBroke:
            Return blockResult.
        If hasFail(blockResult):
            Return peCutAfterFail(blockResult).
        If peHasHead(s):
            Let rdBox be peSumRead(peHeadOf(s), state).
            If not isNoUnfold(rdBox):
                Let rdSrc be peSumSplit(rdBox, s, peTailOf(placedStmts, stmtIdx + 1), state).
                Repeat for rdR in specializeStmts(rdSrc, state):
                    Push rdR to blockResult.
                Return peCutAfterFail(blockResult).
        If (peStaticEnv(state)) contains "__pe_deps":
            Let ivWrites be stmtWriteSet(s, (peFuncs(state))).
            Let ivPre be peInvalidateDeps(ivWrites, state).
            Repeat for ivP in ivPre:
                Push ivP to blockResult.
        Let hoistSaved be hoistSaveSt(state).
        Let hoistMark be length of blockResult.
        Let stmtFrame be peFrame(state).
        If peIsLoopStmt(s):
            peSetFrame(state, "").
        Inspect s:
            When CLet (letName, letExpr):
                Inspect letExpr:
                    When CCall (lsCallName, lsCallArgs):
                        If (peFuncs(state)) contains lsCallName:
                            peStSrBind(state, "__pe_split_ok", a new CBool with value true).
                    Otherwise:
                        Let lsSkip be true.
                Let mutable peVal be peExpr(letExpr, state).
                If (peSpecResults(state)) contains "__pe_split_ok":
                    peStSrDrop(state, "__pe_split_ok").
                If peIsSplitMarker(peVal):
                    Let lsTree be peTakeSplit(state).
                    Let lsRest be peTailOf(placedStmts, stmtIdx + 1).
                    Let lsSrc be peGraft(lsTree, letName, lsRest).
                    Set blockResult to hoistCloseSt(state, hoistSaved, blockResult, hoistMark).
                    Let lsRes be specializeStmts(lsSrc, state).
                    Repeat for lsR in lsRes:
                        Push lsR to blockResult.
                    Return blockResult.
                Let lsHeld be peHeldSum(peVal).
                If not isNoUnfold(lsHeld) and peInspectsName(peTailOf(placedStmts, stmtIdx + 1), letName):
                    Let lsHeldName be "{letName}".
                    Let lsHead be a new CLet with name lsHeldName and expr peVal.
                    Set blockResult to hoistCloseSt(state, hoistSaved, blockResult, hoistMark).
                    Let lsSumSrc be peSumSplit(lsHeld, lsHead, peTailOf(placedStmts, stmtIdx + 1), state).
                    Repeat for lsSumR in specializeStmts(lsSumSrc, state):
                        Push lsSumR to blockResult.
                    Return blockResult.
                Let mutable letHandled be false.
                Inspect peVal:
                    When CNewSet (peSetElem13):
                        Let setEmptyNames be a new Seq of Text.
                        Let setEmptyVals be a new Seq of CExpr.
                        Let trackedSetType be "Set of {peSetElem13}".
                        Let trackedSet be a new CNew with typeName trackedSetType and fieldNames setEmptyNames and fields setEmptyVals.
                        Let lsk be "{letName}".
                        peStSeBind(state, lsk, trackedSet).
                        Let lsk2 be "{letName}".
                        peStEnvDynamic(state, lsk2).
                        Let lsName be "{letName}".
                        Let lsVal be peVal.
                        Push (a new CLet with name lsName and expr lsVal) to blockResult.
                        Set letHandled to true.
                    Otherwise:
                        Let skipLs be true.
                If not letHandled:
                    If peStartsWith(letName, "pkv__"):
                        Let lkLeaf be "{letName}".
                        peStEnvDynamic(state, lkLeaf).
                        Let lkLeaf2 be "{letName}".
                        Push (a new CLet with name lkLeaf2 and expr peVal) to blockResult.
                        Set letHandled to true.
                If not letHandled:
                    If peShapeable(peVal) and not isStatic(peVal):
                        If hoistActive((peSpecResults(state))):
                            Set peVal to peHoistLeaf(peVal, state).
                    Let valSV be isStaticValue(peVal).
                    Let cpvL be isPeValueForCopyProp(peVal).
                    Let mutable cpOk be cpvL.
                    If not cpvL:
                        If not blockMutatedDone:
                            Set blockMutated to collectSetVars(stmts, (peFuncs(state))).
                            Set blockMutatedDone to true.
                        Let rmmL be exprRefsAnyMutated(peVal, blockMutated).
                        If not rmmL:
                            Set cpOk to true.
                    If cpOk:
                        Let letNameS be "{letName}".
                        Let peValS be peVal.
                        peStSeBind(state, letNameS, peValS).
                    Otherwise:
                        Let letNameR be "{letName}".
                        If (peStaticEnv(state)) contains letNameR:
                            peStSeDrop(state, letNameR).
                    If valSV:
                        Let letWasResidual be isResidualVar((peEnv(state)), letName).
                        peStEnvBind(state, letName, exprToVal(peVal)).
                        If letWasResidual:
                            Let letNameRes be "{letName}".
                            Let peValLetRes be peVal.
                            Push (a new CLet with name letNameRes and expr peValLetRes) to blockResult.
                    Otherwise:
                        Let letKey be "{letName}".
                        peStEnvDynamic(state, letKey).
                        Push (a new CLet with name letName and expr peVal) to blockResult.
            When CSet (setName, setExpr):
                Let mutable peVal be peExpr(setExpr, state).
                If peShapeable(peVal) and not isStatic(peVal):
                    If hoistActive((peSpecResults(state))):
                        Set peVal to peHoistLeaf(peVal, state).
                Let valSV2 be isStaticValue(peVal).
                Let cpvSL be isPeValueForCopyProp(peVal).
                Let mutable cpOkS be cpvSL.
                If not cpvSL:
                    If not blockMutatedDone:
                        Set blockMutated to collectSetVars(stmts, (peFuncs(state))).
                        Set blockMutatedDone to true.
                    Let rmmSL be exprRefsAnyMutated(peVal, blockMutated).
                    If not rmmSL:
                        Set cpOkS to true.
                Let setNameChk be "{setName}".
                Let mutable priorWasStatic be false.
                Let mutable priorStaticVal be (a new CInt with value 0).
                If (peStaticEnv(state)) contains setNameChk:
                    Let setNameItm be "{setName}".
                    Let priorCV be item setNameItm of (peStaticEnv(state)).
                    Let pcvStatic be isStaticValue(priorCV).
                    If pcvStatic:
                        Set priorWasStatic to true.
                        Set priorStaticVal to priorCV.
                If cpOkS:
                    Let setNameS be "{setName}".
                    Let peValS be peVal.
                    peStSeBind(state, setNameS, peValS).
                Otherwise:
                    Let setNameR be "{setName}".
                    If (peStaticEnv(state)) contains setNameR:
                        Let setNameD be "{setName}".
                        peStSeDrop(state, setNameD).
                If valSV2:
                    peStEnvBind(state, setName, exprToVal(peVal)).
                    If isResidualVar((peEnv(state)), setName):
                        Let setNameRes be "{setName}".
                        Let peValRes be peVal.
                        Push (a new CSet with name setNameRes and expr peValRes) to blockResult.
                Otherwise:
                    If priorWasStatic:
                        Let setNameL be "{setName}".
                        peDeclareDynamic(setNameL, priorStaticVal, state, blockResult).
                    Let setKey be "{setName}".
                    peStEnvDynamic(state, setKey).
                    Push (a new CSet with name setName and expr peVal) to blockResult.
            When CIf (ifCond, thenBlock, elseBlock):
                Let peCond be peExpr(ifCond, state).
                Let condLit be isLiteral(peCond).
                If condLit:
                    Inspect peCond:
                        When CBool (b):
                            If b:
                                Let thenRes be specializeStmts(thenBlock, state).
                                Repeat for ts in thenRes:
                                    Push ts to blockResult.
                            Otherwise:
                                Let elseRes be specializeStmts(elseBlock, state).
                                Repeat for es in elseRes:
                                    Push es to blockResult.
                        Otherwise:
                            Let thenRes2 be peBlock(thenBlock, state).
                            Let elseRes2 be peBlock(elseBlock, state).
                            Push (a new CIf with cond peCond and thenBlock thenRes2 and elseBlock elseRes2) to blockResult.
                Otherwise:
                    Let thenModsIf be collectSetVars(thenBlock, (peFuncs(state))).
                    Let elseModsIf be collectSetVars(elseBlock, (peFuncs(state))).
                    Let allModsIf be a new Seq of Text.
                    Repeat for tmI in thenModsIf:
                        Push tmI to allModsIf.
                    Repeat for emI in elseModsIf:
                        Push emI to allModsIf.
                    Let ifCands be a new Seq of Text.
                    Let ifDyn be a new Seq of Text.
                    Repeat for icM in allModsIf:
                        Let icK be "{icM}".
                        Let mutable icShape be false.
                        If (peStaticEnv(state)) contains icK:
                            Let icK2 be "{icM}".
                            Set icShape to peLoopCandidate(item icK2 of (peStaticEnv(state))).
                        Let icK3 be "{icM}".
                        If icShape:
                            If not ifCands contains icK3:
                                Push icK3 to ifCands.
                        Otherwise:
                            If not ifDyn contains icK3:
                                Push icK3 to ifDyn.
                    Let mutable ifShaped be false.
                    If length of ifCands is greater than 0:
                        Let mutable ifPre be a new Seq of CStmt.
                        Repeat for ipM in ifDyn:
                            Let ipK be "{ipM}".
                            If (peStaticEnv(state)) contains ipK:
                                Let ipK2 be "{ipM}".
                                Let ipV be item ipK2 of (peStaticEnv(state)).
                                Let ipK3 be "{ipM}".
                                peDeclareDynamic(ipK3, ipV, state, ifPre).
                        Let mutable ifOut be a new Seq of CStmt.
                        Set ifShaped to peIfShapes(peCond, thenBlock, elseBlock, thenModsIf, elseModsIf, ifCands, ifDyn, state, ifOut).
                        If ifShaped:
                            Repeat for ifP in ifPre:
                                Push ifP to blockResult.
                            Repeat for ifO in ifOut:
                                Push ifO to blockResult.
                    If not ifShaped:
                        Repeat for pmI in allModsIf:
                            Let pmK1 be "{pmI}".
                            If (peStaticEnv(state)) contains pmK1:
                                Let pmK2 be "{pmI}".
                                Let pmV be item pmK2 of (peStaticEnv(state)).
                                Let pmK3 be "{pmI}".
                                peDeclareDynamic(pmK3, pmV, state, blockResult).
                                Let pmK4 be "{pmI}".
                                peStSeDrop(state, pmK4).
                                Let pmK5 be "{pmI}".
                                peStEnvDynamic(state, pmK5).
                        Let posR be applyPosFactsSt(peCond, state).
                        Let thenRes3 be peBlock(thenBlock, state).
                        Let thenFinal be a new Seq of CStmt.
                        Repeat for tstmt in thenRes3:
                            Push tstmt to thenFinal.
                        Repeat for tmv in thenModsIf:
                            Let tmvK1 be "{tmv}".
                            If (peStaticEnv(state)) contains tmvK1 and not isResidualVar((peEnv(state)), tmv):
                                Let tmvK2 be "{tmv}".
                                Let tmvV be item tmvK2 of (peStaticEnv(state)).
                                Let tmvK3 be "{tmv}".
                                Push (a new CSet with name tmvK3 and expr tmvV) to thenFinal.
                        Let clr1 be clearGuardFactsSt(peCond, state).
                        Repeat for rmv in allModsIf:
                            Let rmvK1 be "{rmv}".
                            If (peStaticEnv(state)) contains rmvK1:
                                Let rmvK2 be "{rmv}".
                                peStSeDrop(state, rmvK2).
                                Let rmvK3 be "{rmv}".
                                peStEnvDynamic(state, rmvK3).
                        Let negR be applyNegFactsSt(peCond, state).
