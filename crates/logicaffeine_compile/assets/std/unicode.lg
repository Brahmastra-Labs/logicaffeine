        Let key be item ((mid * 2) + 1) of tbl.
        If r is less than key:
            Set hi to mid - 1.
        Otherwise:
            If r is greater than key:
                Set lo to mid + 1.
            Otherwise:
                Set res to item ((mid * 2) + 2) of tbl.
                Set lo to hi + 1.
    Return res.

## Note
