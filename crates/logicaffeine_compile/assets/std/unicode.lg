## Note
The general-category integer code (0-28, or 29 for `Cn`/unassigned) of codepoint `cp`, via binary search over `unicodeCatTable`.

## To unicodeCategoryCode (cp: Int) -> Int:
    Let tbl be unicodeCatTable().
    Let cnt be (length of tbl) / 3.
    Let mutable lo be 0.
    Let mutable hi be cnt - 1.
    Let mutable found be 29.
    While lo is at most hi:
        Let mid be (lo + hi) / 2.
        Let s be item ((mid * 3) + 1) of tbl.
        Let e be item ((mid * 3) + 2) of tbl.
        If cp is less than s:
            Set hi to mid - 1.
        Otherwise:
            If cp is greater than e:
                Set lo to mid + 1.
            Otherwise:
                Set found to item ((mid * 3) + 3) of tbl.
                Set lo to hi + 1.
    Return found.

## Note
The two-letter general category of the first character of `ch` (`unicodedata.category`), e.g. `Lu`, `Ll`, `Nd`, `Zs`; `Cn` for an unassigned codepoint.

## To unicodedataCategory (ch: Text) -> Text:
    Let cb be text_bytes(ch).
    Let sz be utf8DecodeSize(cb, 1).
    Let cp be utf8DecodeCodepoint(cb, 1, sz).
    Let code be unicodeCategoryCode(cp).
    Let names be ["Cc", "Cf", "Co", "Cs", "Ll", "Lm", "Lo", "Lt", "Lu", "Mc", "Me", "Mn", "Nd", "Nl", "No", "Pc", "Pd", "Pe", "Pf", "Pi", "Po", "Ps", "Sc", "Sk", "Sm", "So", "Zl", "Zp", "Zs", "Cn"].
    Return item (code + 1) of names.

## Note
True when codepoint `r` is a mark (general category Mn, Mc, or Me) (`unicode.IsMark`).

## To unicodeIsMark (r: Int) -> Bool:
    Let code be unicodeCategoryCode(r).
    If code is at least 9:
        If code is at most 11:
            Return true.
    Return false.

## Note
True when codepoint `r` is a symbol (general category Sm, Sc, Sk, or So) (`unicode.IsSymbol`).

## To unicodeIsSymbol (r: Int) -> Bool:
    Let code be unicodeCategoryCode(r).
    If code is at least 22:
        If code is at most 25:
            Return true.
    Return false.

## Note
The mirrored-range table: `[start, end]` pairs for codepoints whose glyph is mirrored in bidirectional text.

## To unicodeMirTable () -> Seq of Int:
    Return [40, 41, 60, 60, 62, 62, 91, 91, 93, 93, 123, 123, 125, 125, 171, 171, 187, 187, 3898, 3901, 5787, 5788, 8249, 8250, 8261, 8262, 8317, 8318, 8333, 8334, 8512, 8512, 8705, 8708, 8712, 8717, 8721, 8721, 8725, 8726, 8730, 8733, 8735, 8738, 8740, 8740, 8742, 8742, 8747, 8755, 8761, 8761, 8763, 8780, 8786, 8789, 8799, 8800, 8802, 8802, 8804, 8811, 8814, 8844, 8847, 8850, 8856, 8856, 8866, 8867, 8870, 8888, 8894, 8895, 8905, 8909, 8912, 8913, 8918, 8941, 8944, 8959, 8968, 8971, 8992, 8993, 9001, 9002, 10088, 10101, 10176, 10176, 10179, 10182, 10184, 10185, 10187, 10189, 10195, 10198, 10204, 10206, 10210, 10223, 10627, 10648, 10651, 10656, 10658, 10671, 10680, 10680, 10688, 10693, 10697, 10697, 10702, 10706, 10708, 10709, 10712, 10716, 10721, 10721, 10723, 10725, 10728, 10729, 10740, 10745, 10748, 10749, 10762, 10780, 10782, 10785, 10788, 10788, 10790, 10790, 10793, 10793, 10795, 10798, 10804, 10805, 10812, 10814, 10839, 10840, 10852, 10853, 10858, 10861, 10863, 10864, 10867, 10868, 10873, 10915, 10918, 10925, 10927, 10966, 10972, 10972, 10974, 10974, 10978, 10982, 10988, 10990, 10995, 10995, 10999, 11003, 11005, 11005, 11262, 11262, 11778, 11781, 11785, 11786, 11788, 11789, 11804, 11805, 11808, 11817, 11861, 11868, 12296, 12305, 12308, 12315, 65113, 65118, 65124, 65125, 65288, 65289, 65308, 65308, 65310, 65310, 65339, 65339, 65341, 65341, 65371, 65371, 65373, 65373, 65375, 65376, 65378, 65379, 120539, 120539, 120597, 120597, 120655, 120655, 120713, 120713, 120771, 120771].

## Note
True (1) when codepoint `r`'s glyph is mirrored in right-to-left text, else 0 (`unicodedata.mirrored`).

The lookup binary-searches the mirrored-range table.

## To unicodedataMirrored (r: Int) -> Int:
    Let tbl be unicodeMirTable().
    Let cnt be (length of tbl) / 2.
    Let mutable lo be 0.
    Let mutable hi be cnt - 1.
    Let mutable res be 0.
    While lo is at most hi:
        Let mid be (lo + hi) / 2.
        Let s be item ((mid * 2) + 1) of tbl.
        Let e be item ((mid * 2) + 2) of tbl.
        If r is less than s:
            Set hi to mid - 1.
        Otherwise:
            If r is greater than e:
                Set lo to mid + 1.
            Otherwise:
                Set res to 1.
                Set lo to hi + 1.
    Return res.

