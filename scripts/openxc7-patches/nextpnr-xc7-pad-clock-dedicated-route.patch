--- a/xilinx/arch.cc
+++ b/xilinx/arch.cc
@@ -827,6 +827,15 @@
         else if (clk_net->users.entries() == 1 && (*clk_net->users.begin()).cell->type == id_PLLE2_ADV_PLLE2_ADV &&
                  (*clk_net->users.begin()).port == id_CLKIN1)
             is_global = true;
+        else if (clk_net->driver.cell->type.in(id_IOB33_INBUF_EN, id_IOB18_INBUF_DCIEN) && clk_net->users.entries() > 0) {
+            // A clock pad's input buffer feeding only global buffers takes the pad's dedicated path to them, bound here
+            // as a PLL's input is: left to the router, a congested route can take the pad's clock through a regional
+            // buffer's mux the device database has no bits for, and the bitstream cannot be assembled.
+            is_global = true;
+            for (auto &usr : clk_net->users)
+                if (!usr.cell->type.in(id_BUFGCTRL, id_BUFG_BUFG))
+                    is_global = false;
+        }
         if (!is_global)
             continue;
 
