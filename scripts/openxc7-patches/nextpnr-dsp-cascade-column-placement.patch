+bool Arch::getClusterPlacement(ClusterId cluster, BelId root_bel,
+                               std::vector<std::pair<CellInfo *, BelId>> &placement) const
+{
+    CellInfo *root = getClusterRootCell(cluster);
+    if (root->type != id_DSP48E1_DSP48E1)
+        return BaseArch<ArchRanges>::getClusterPlacement(cluster, root_bel, placement);
+    placement.clear();
+    Loc loc = getBelLocation(root_bel);
+    if (root->constr_abs_z)
+        loc.z = root->constr_z;
+    BelId bel = getBelByLocation(loc);
+    if (bel == BelId() || !isValidBelForCellType(root->type, bel))
+        return false;
+    placement.emplace_back(root, bel);
+    for (auto child : root->constr_children) {
+        Loc next = loc;
+        next.z = child->constr_z;
+        if (child->constr_z == BEL_LOWER_DSP) {
+            // The next tile up the column holding a DSP: five rows on, six across an HCLK row.
+            bool found = false;
+            for (int dy = 1; dy <= 8 && !found; dy++) {
+                Loc probe(loc.x, loc.y - dy, BEL_LOWER_DSP);
+                BelId b = getBelByLocation(probe);
+                if (b != BelId() && isValidBelForCellType(child->type, b)) {
+                    next = probe;
+                    found = true;
+                }
+            }
+            if (!found)
+                return false;
+        }
+        BelId child_bel = getBelByLocation(next);
+        if (child_bel == BelId() || !isValidBelForCellType(child->type, child_bel))
+            return false;
+        placement.emplace_back(child, child_bel);
+        loc = next;
+    }
+    return true;
+}
