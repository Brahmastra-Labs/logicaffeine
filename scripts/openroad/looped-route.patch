+// Does the route, its points taken by location and its parallel segments as one,
+// close a cycle? The walk below follows every adjacent point but the one it came
+// from, so on a cycle it never ends.
+static bool
+routeHasCycle(GRoutePtAdjacents &adjacents)
+{
+  typedef std::pair<int, int> Loc;
+  std::set<std::pair<Loc, Loc>> edges;
+  for (auto &[pt, adjs] : adjacents) {
+    for (RoutePt &adj : adjs) {
+      Loc a(pt.x(), pt.y());
+      Loc b(adj.x(), adj.y());
+      if (a != b)
+        edges.insert(std::minmax(a, b));
+    }
+  }
+  // Union-find, by size with path halving: no recursion, however long the route.
+  std::map<Loc, Loc> parent;
+  std::map<Loc, size_t> size;
+  auto root = [&](Loc p) {
+    if (parent.emplace(p, p).second)
+      size[p] = 1;
+    while (parent[p] != p) {
+      parent[p] = parent[parent[p]];
+      p = parent[p];
+    }
+    return p;
+  };
+  for (auto &[a, b] : edges) {
+    Loc ra = root(a);
+    Loc rb = root(b);
+    if (ra == rb)
+      return true;
+    if (size[ra] < size[rb])
+      std::swap(ra, rb);
+    parent[rb] = ra;
+    size[ra] += size[rb];
+  }
+  return false;
+}
