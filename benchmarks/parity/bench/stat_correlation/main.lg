## To native args () -> Seq of Text
## To native parseInt (s: Text) -> Int

## Main
Let arguments be args().
Let reps be parseInt(item 2 of arguments).
Let m be 4096.
Let mutable xs be a new Seq of Real.
Let mutable k be 0.
While k is less than m:
    Push toReal((k * 2654435761) % 999 + 1) to xs.
    Set k to k + 1.
Let mutable ys be a new Seq of Real.
Let mutable k2 be 0.
While k2 is less than m:
    Push toReal((k2 * 1013904223 + 12345) % 997 + 1) to ys.
    Set k2 to k2 + 1.
Let mutable checksum be 0.
Let mutable r be 0.
While r is less than reps:
    Set item ((r % m) + 1) of xs to toReal((r % 999) + 1).
    Set checksum to checksum + trunc(correlationReal(xs, ys) * 1000000.0).
    Set r to r + 1.
Show checksum.
