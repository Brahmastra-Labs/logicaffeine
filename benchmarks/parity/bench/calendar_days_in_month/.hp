import sys
n = int(sys.argv[1])


def leap(y):
    if y % 400 == 0:
        return True
    if y % 100 == 0:
        return False
    return y % 4 == 0


def dim(y, m):
    if m == 2:
        return 29 if leap(y) else 28
    if m in (4, 6, 9, 11):
        return 30
    return 31


s = 0
for i in range(n):
    y = 2000 + (i % 400)
    m = 1 + (i % 12)
    s += dim(y, m)
print(s)
