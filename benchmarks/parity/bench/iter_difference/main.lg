## To native args () -> Seq of Text
## To native parseInt (s: Text) -> Int

## Main
Let arguments be args().
Let reps be parseInt(item 2 of arguments).
Let m be 2048.
Let mutable xs be a new Seq of Int.
Let mutable k be 0.
While k is less than m:
    Push (k * 2654435761) % 1048576 to xs.
    Set k to k + 1.
Let mutable ys be a new Seq of Int.
Let mutable k2 be 0.
While k2 is less than m:
    Push (k2 * 1013904223 + 12345) % 1048576 to ys.
    Set k2 to k2 + 1.
Let mutable checksum be 0.
Let mutable r be 0.
While r is less than reps:
    Set item ((r % m) + 1) of xs to r % 1048576.
    Set checksum to checksum + length of seqDifference(xs, ys).
    Set r to r + 1.
Show checksum.
