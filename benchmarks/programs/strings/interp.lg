## To checkStrings (n: Int) -> Text:
    Let mutable result be "" with capacity n * 6.
    Let mutable i be 0.
    While i is less than n:
        Set result to result + i + " ".
        Set i to i + 1.
    Let mutable spaces be 0.
    Let mutable j be 0.
    While j is less than the length of result:
        If item (j + 1) of result equals " ":
            Set spaces to spaces + 1.
        Set j to j + 1.
    Let bytes be text_bytes(result).
    Let mutable h be 0.
    Repeat for b in bytes:
        Set h to (h * 31 + b) & 268435455.
    Return "" + spaces + " " + h.

## Main
Show checkStrings(1000).
