## To benchmark (n: Int) -> Text:
    Let mutable m be a new Map of Int to Int.
    Let mutable seed be 42.
    Let mutable i be 0.
    While i is less than n:
        Set seed to (seed * 1103515245 + 12345) % 2147483648.
        Set m at seed to seed * 2.
        Set i to i + 1.
    Let mutable hit be 42.
    Let mutable miss be seed.
    Let mutable found be 0.
    Let mutable h be 0.
    Set i to 0.
    While i is less than n:
        Set hit to (hit * 1103515245 + 12345) % 2147483648.
        If m contains hit:
            Set found to found + 1.
            Set h to (h * 31 + item hit of m) & 268435455.
        Set miss to (miss * 1103515245 + 12345) % 2147483648.
        If m contains miss:
            Set found to found + 1.
            Set h to (h * 31 + item miss of m) & 268435455.
        Set i to i + 1.
    Return "" + found + " " + h.

## Main
Show benchmark(1000).
