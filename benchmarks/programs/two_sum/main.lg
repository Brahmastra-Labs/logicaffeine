## To native args () -> Seq of Text
## To native parseInt (s: Text) -> Int

## Main
Let arguments be args().
Let n be parseInt(item 2 of arguments).
Let target be 2147483647.
Let arr be a new Seq of Int.
Let seed be 42.
Let i be 0.
While i is less than n:
    Set seed to (seed * 1103515245 + 12345) % 2147483648.
    If i is greater than 0 and seed / 268435456 equals 0:
        Push target - item (seed % i + 1) of arr to arr.
    Otherwise:
        Push seed to arr.
    Set i to i + 1.
Let seen be a new Map of Int to Int.
Let count be 0.
Set i to 1.
While i is at most n:
    Let x be item i of arr.
    Let complement be target - x.
    If seen contains complement:
        Set count to count + 1.
    Set seen at x to 1.
    Set i to i + 1.
Show count.
