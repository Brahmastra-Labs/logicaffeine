## Main
Let n be 64.
Let ng be 32.
Let mutable groups be a new Seq of Int.
Let mutable gi be 0.
While gi is less than ng:
    Push 0 to groups.
    Set gi to gi + 1.
Let mutable seed be 42.
Let mutable kept be 0.
Let mutable r be 0.
While r is less than n:
    Set seed to (seed * 25173 + 13849) % 65536.
    Let key be (seed / 2) % 32768.
    Set seed to (seed * 25173 + 13849) % 65536.
    Let value be (seed / 2) % 32768.
    If value % 3 is greater than 0:
        Let contrib be (value * key + 7) % 1000000007.
        Let g be key % ng.
        Set item (g + 1) of groups to (item (g + 1) of groups + contrib) % 1000000007.
        Set kept to kept + 1.
    Set r to r + 1.
Let mutable checksum be 0.
Let mutable g be 0.
While g is less than ng:
    Set checksum to (checksum + item (g + 1) of groups) % 1000000007.
    Set g to g + 1.
Show kept.
Show checksum.
