Let toks be a new Seq of Float.
Push 1.0 to toks.
Push 2.0 to toks.
Push 3.0 to toks.
Let n be 3.
Let ascale be 1.0 / sqrt(8.0).
Let eps be 0.000000999999999999999954748112.
Let x be a new Seq of Float.
Let p be 0.
While p is less than n:
    Let tok be item (p + 1) of toks.
    Let tokd be floor(tok) * 16.
    Let jj be 0.
    While jj is less than 16:
        Push item (tokd + jj + 1) of EMB to x.
        Set jj to jj + 1.
    Set p to p + 1.
Let xn be a new Seq of Float.
Set p to 0.
While p is less than n:
