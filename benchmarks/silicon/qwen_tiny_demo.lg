    Let hh be 0.
    While hh is less than 2:
        Let hb be p * 16 + hh * 8.
        Let ss be 0.0.
        Let ri be 0.
        While ri is less than 8:
            Let rv be item (hb + ri + 1) of Q.
            Set ss to ss + rv * rv.
            Set ri to ri + 1.
        Let rscale be 1.0 / sqrt((ss / 8.0) + eps).
        Set ri to 0.
        While ri is less than 8:
            Let rv be item (hb + ri + 1) of Q.
            Set item (hb + ri + 1) of Q to (rv * rscale) * (item (ri + 1) of q_norm_1).
            Set ri to ri + 1.
        Let rb be p * 4.
        Let ci be 0.
        While ci is less than 4:
            Let cc be item (rb + ci + 1) of RC.
            Let sinv be item (rb + ci + 1) of RS.
            Let x0 be item (hb + ci + 1) of Q.
            Let x1 be item (hb + ci + 4 + 1) of Q.
            Set item (hb + ci + 1) of Q to x0 * cc - x1 * sinv.
            Set item (hb + ci + 4 + 1) of Q to x0 * sinv + x1 * cc.
            Set ci to ci + 1.
        Set hh to hh + 1.
    Set p to p + 1.
Set p to 0.
While p is less than n:
    Let hh be 0.
    While hh is less than 1:
        Let hb be p * 8 + hh * 8.
        Let ss be 0.0.
        Let ri be 0.
        While ri is less than 8:
            Let rv be item (hb + ri + 1) of K.
            Set ss to ss + rv * rv.
            Set ri to ri + 1.
        Let rscale be 1.0 / sqrt((ss / 8.0) + eps).
        Set ri to 0.
        While ri is less than 8:
            Let rv be item (hb + ri + 1) of K.
            Set item (hb + ri + 1) of K to (rv * rscale) * (item (ri + 1) of k_norm_1).
            Set ri to ri + 1.
        Let rb be p * 4.
        Let ci be 0.
        While ci is less than 4:
            Let cc be item (rb + ci + 1) of RC.
            Let sinv be item (rb + ci + 1) of RS.
            Let x0 be item (hb + ci + 1) of K.
            Let x1 be item (hb + ci + 4 + 1) of K.
            Set item (hb + ci + 1) of K to x0 * cc - x1 * sinv.
            Set item (hb + ci + 4 + 1) of K to x0 * sinv + x1 * cc.
            Set ci to ci + 1.
        Set hh to hh + 1.
    Set p to p + 1.
Let attn be a new Seq of Float.
Let z be 0.
While z is less than n * 16:
    Push 0.0 to attn.
    Set z to z + 1.
Let head be 0.
While head is less than 2:
    Let kvh be head / 2.
    Let qi be 0.
    While qi is less than n:
        Let scores be a new Seq of Float.
        Let kj be 0.
        While kj is at most qi:
            Let d be 0.0.
            Let e be 0.
            While e is less than 8:
                Set d to d + (item (qi * 16 + head * 8 + e + 1) of Q) * (item (kj * 8 + kvh * 8 + e + 1) of K).
                Set e to e + 1.
            Push d * ascale to scores.
            Set kj to kj + 1.
        Let mx be item 1 of scores.
        Let si be 2.
        While si is at most (qi + 1):
            If item si of scores is greater than mx:
                Set mx to item si of scores.
            Set si to si + 1.
        Let ex be a new Seq of Float.
        Let den be 0.0.
        Set si to 0.
        While si is at most qi:
            Let ev be expT((item (si + 1) of scores) - mx).
            Push ev to ex.
            Set den to den + ev.
            Set si to si + 1.
        Let e be 0.
        While e is less than 8:
            Let acc be 0.0.
            Set si to 0.
            While si is at most qi:
                Set acc to acc + (item (si + 1) of ex) * (item (si * 8 + kvh * 8 + e + 1) of V).
                Set si to si + 1.
            Set item (qi * 16 + head * 8 + e + 1) of attn to acc / den.
            Set e to e + 1.
        Set qi to qi + 1.
    Set head to head + 1.
Let ao be a new Seq of Float.
Set p to 0.
While p is less than n:
    Let mo be 0.
    While mo is less than 16:
        Let acc be 0.0.
        Let mi be 0.
        While mi is less than 16:
            Set acc to acc + (item (mo * 16 + mi + 1) of wo_1) * (item (p * 16 + mi + 1) of attn).
            Set mi to mi + 1.
        Push acc to ao.
        Set mo to mo + 1.
    Set p to p + 1.
Set p to 0.
While p is less than n * 16:
    Set item (p + 1) of x to (item (p + 1) of x) + (item (p + 1) of ao).
    Set p to p + 1.
Let xn2 be a new Seq of Float.
Set p to 0.
While p is less than n:
    Let ss be 0.0.
    Let ri be 0.
    While ri is less than 16:
        Let rv be item (p * 16 + ri + 1) of x.
        Set ss to ss + rv * rv.
        Set ri to ri + 1.
    Let rscale be 1.0 / sqrt((ss / 16.0) + eps).
    Set ri to 0.
    While ri is less than 16:
        Let rv be item (p * 16 + ri + 1) of x.
        Push (rv * rscale) * (item (ri + 1) of ffn_norm_1) to xn2.
        Set ri to ri + 1.
    Set p to p + 1.
Let hid be a new Seq of Float.
Set p to 0.
While p is less than n:
    Let gg be a new Seq of Float.
    Let mo be 0.
    While mo is less than 32:
        Let acc be 0.0.
        Let mi be 0.
        While mi is less than 16:
            Set acc to acc + (item (mo * 16 + mi + 1) of gate_1) * (item (p * 16 + mi + 1) of xn2).
            Set mi to mi + 1.
        Push acc to gg.
        Set mo to mo + 1.
    Let uu be a new Seq of Float.
    Let mo be 0.
    While mo is less than 32:
        Let acc be 0.0.
        Let mi be 0.
        While mi is less than 16:
            Set acc to acc + (item (mo * 16 + mi + 1) of up_1) * (item (p * 16 + mi + 1) of xn2).
            Set mi to mi + 1.
        Push acc to uu.
        Set mo to mo + 1.
    Let fi be 0.
    While fi is less than 32:
        Push siluT(item (fi + 1) of gg) * (item (fi + 1) of uu) to hid.
        Set fi to fi + 1.
    Set p to p + 1.
Let dn be a new Seq of Float.
Set p to 0.
While p is less than n:
    Let mo be 0.
    While mo is less than 16:
        Let acc be 0.0.
        Let mi be 0.
        While mi is less than 32:
            Set acc to acc + (item (mo * 32 + mi + 1) of down_1) * (item (p * 32 + mi + 1) of hid).
            Set mi to mi + 1.
        Push acc to dn.
        Set mo to mo + 1.
    Set p to p + 1.
Set p to 0.
While p is less than n * 16:
    Set item (p + 1) of x to (item (p + 1) of x) + (item (p + 1) of dn).
    Set p to p + 1.
Let xf be a new Seq of Float.
Let ss be 0.0.
Let ri be 0.
While ri is less than 16:
    Let rv be item ((n - 1) * 16 + ri + 1) of x.
    Set ss to ss + rv * rv.
    Set ri to ri + 1.
Let rscale be 1.0 / sqrt((ss / 16.0) + eps).
Set ri to 0.
While ri is less than 16:
    Let rv be item ((n - 1) * 16 + ri + 1) of x.
    Push (rv * rscale) * (item (ri + 1) of ONORM) to xf.
    Set ri to ri + 1.
Let best be 0.0 - 1000000000.0.
Let bestIdx be 0.
Let o be 0.
While o is less than 16:
    Let acc be 0.0.
    Let i be 0.
    While i is less than 16:
        Set acc to acc + (item (o * 16 + i + 1) of OUTP) * (item (i + 1) of xf).
        Set i to i + 1.
    If acc is greater than best:
        Set best to acc.
        Set bestIdx to o.
    Set o to o + 1.
Show bestIdx.
