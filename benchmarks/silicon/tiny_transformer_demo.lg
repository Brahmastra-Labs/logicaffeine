## To to8 (x: Int, m: Int) -> Int:
    Let y be (x * m) shifted right by 24.
    If y is greater than 127:
        Return 127.
    If y is less than -128:
        Return -128.
    Return y.
## To rqf (x: Int, m: Int) -> Int:
    Return (x * m) shifted right by 24.

## To forwardStep (toks: Seq of Int, W: Seq of Int) -> Int:
    Let n be length of toks.
    Let d be 16.
    Let hd be 8.
    Let dff be 32.
    Let V be 14.
    Let stream be a new Seq of Int.
    Let p be 0.
    While p is less than n:
        Let tok be item (p + 1) of toks.
        Let j be 0.
        While j is less than d:
            Push (item (2272 + tok * d + j + 1) of W) + (item (2496 + p * d + j + 1) of W) to stream.
            Set j to j + 1.
        Set p to p + 1.
    Let Xi be a new Seq of Int.
    Repeat for sv in stream:
        Push to8(sv, 16777216) to Xi.
    Let Q be a new Seq of Int.
    Set p to 0.
    While p is less than n:
        Let o be 0.
        While o is less than d:
            Let acc be 0.
            Let i be 0.
            While i is less than d:
                Set acc to acc + (item (p * d + i + 1) of Xi) * (item (0 + i * d + o + 1) of W).
                Set i to i + 1.
            Push to8(acc, 104593) to Q.
            Set o to o + 1.
        Set p to p + 1.
    Let K be a new Seq of Int.
    Set p to 0.
    While p is less than n:
        Let o be 0.
        While o is less than d:
            Let acc be 0.
            Let i be 0.
            While i is less than d:
                Set acc to acc + (item (p * d + i + 1) of Xi) * (item (256 + i * d + o + 1) of W).
                Set i to i + 1.
            Push to8(acc, 92752) to K.
            Set o to o + 1.
        Set p to p + 1.
    Let Vv be a new Seq of Int.
    Set p to 0.
    While p is less than n:
        Let o be 0.
        While o is less than d:
            Let acc be 0.
            Let i be 0.
            While i is less than d:
                Set acc to acc + (item (p * d + i + 1) of Xi) * (item (512 + i * d + o + 1) of W).
                Set i to i + 1.
            Push to8(acc, 137432) to Vv.
            Set o to o + 1.
        Set p to p + 1.
    Let ctx be a new Seq of Int.
    Let z be 0.
    While z is less than n * d:
        Push 0 to ctx.
        Set z to z + 1.
    Let head be 0.
    While head is less than 2:
        Let lo be head * hd.
        Let i be 0.
        While i is less than n:
            Let sc be a new Seq of Int.
            Let j be 0.
            While j is at most i:
                Let a be 0.
                Let c be 0.
                While c is less than hd:
                    Set a to a + (item (i * d + lo + c + 1) of Q) * (item (j * d + lo + c + 1) of K).
                    Set c to c + 1.
                Push a to sc.
                Set j to j + 1.
            Let mx be item 1 of sc.
            Set j to 2.
            While j is at most (i + 1):
                If item j of sc is greater than mx:
                    Set mx to item j of sc.
                Set j to j + 1.
            Let num be a new Seq of Int.
            Let c be 0.
            While c is less than hd:
                Push 0 to num.
                Set c to c + 1.
            Let den be 0.
            Set j to 0.
            While j is at most i:
                Let dfc be mx - (item (j + 1) of sc).
                Let idx be (dfc * 21076) shifted right by 24.
                If idx is less than 0:
                    Set idx to 0.
                If idx is greater than 255:
                    Set idx to 255.
                Let wgt be item (2880 + idx + 1) of W.
                Set c to 0.
                While c is less than hd:
                    Set item (c + 1) of num to (item (c + 1) of num) + wgt * (item (j * d + lo + c + 1) of Vv).
                    Set c to c + 1.
                Set den to den + wgt.
                Set j to j + 1.
            Set c to 0.
            While c is less than hd:
                Set item (i * d + lo + c + 1) of ctx to (item (c + 1) of num) // den.
                Set c to c + 1.
            Set i to i + 1.
        Set head to head + 1.
    Let Ci be a new Seq of Int.
    Repeat for cv in ctx:
        Push to8(cv, 16998164) to Ci.
    Set p to 0.
    While p is less than n:
        Let o be 0.
        While o is less than d:
            Let acc be 0.
            Let i be 0.
            While i is less than d:
                Set acc to acc + (item (p * d + i + 1) of Ci) * (item (768 + i * d + o + 1) of W).
                Set i to i + 1.
            Set item (p * d + o + 1) of stream to (item (p * d + o + 1) of stream) + rqf(acc, 144532).
            Set o to o + 1.
        Set p to p + 1.
    Let Hi be a new Seq of Int.
    Repeat for hv in stream:
        Push to8(hv, 7070613) to Hi.
    Let hid be a new Seq of Int.
    Set p to 0.
    While p is less than n:
        Let o be 0.
        While o is less than dff:
            Let acc be 0.
            Let i be 0.
            While i is less than d:
                Set acc to acc + (item (p * d + i + 1) of Hi) * (item (1024 + i * dff + o + 1) of W).
                Set i to i + 1.
            Let hv2 be rqf(acc, 104471).
            If hv2 is less than 0:
                Set hv2 to 0.
            Push hv2 to hid.
            Set o to o + 1.
        Set p to p + 1.
    Let Fi be a new Seq of Int.
    Repeat for fv in hid:
        Push to8(fv, 16777216) to Fi.
    Set p to 0.
    While p is less than n:
        Let o be 0.
        While o is less than d:
            Let acc be 0.
            Let i be 0.
            While i is less than dff:
                Set acc to acc + (item (p * dff + i + 1) of Fi) * (item (1536 + i * d + o + 1) of W).
                Set i to i + 1.
            Set item (p * d + o + 1) of stream to (item (p * d + o + 1) of stream) + rqf(acc, 996383).
            Set o to o + 1.
        Set p to p + 1.
    Let Oi be a new Seq of Int.
    Repeat for ov in stream:
        Push to8(ov, 591734) to Oi.
    Let last be (n - 1) * d.
    Let best be -1000000000.
    Let bestIdx be 0.
    Let o be 0.
    While o is less than V:
        Let acc be 0.
        Let i be 0.
        While i is less than d:
            Set acc to acc + (item (last + i + 1) of Oi) * (item (2048 + o * d + i + 1) of W).
            Set i to i + 1.
        If acc is greater than best:
            Set best to acc.
            Set bestIdx to o.
        Set o to o + 1.
    Return bestIdx.
